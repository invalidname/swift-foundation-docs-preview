abilityPrefix":[{"text":"Available when","type":"text"}]}},"doc://FoundationEssentials/Se":{"title":"Swift.Decodable","identifier":"doc:\/\/FoundationEssentials\/Se","type":"unresolvable"},"doc://FoundationEssentials/documentation/FoundationEssentials":{"role":"collection","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","abstract":[{"type":"text","text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app."}],"kind":"symbol","url":"\/documentation\/foundationessentials","title":"FoundationEssentials"},"doc://FoundationEssentials/documentation/FoundationEssentials/DiscreteFormatStyle":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscreteFormatStyle","kind":"identifier"}],"title":"DiscreteFormatStyle","kind":"symbol","navigatorTitle":[{"text":"DiscreteFormatStyle","kind":"identifier"}],"url":"\/documentation\/foundationessentials\/discreteformatstyle","type":"topic","abstract":[{"text":"A format style that transforms a continuous input into a discrete output and provides","type":"text"},{"text":" ","type":"text"},{"text":"information about its discretization boundaries.","type":"text"}],"role":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle":{"fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"FormatStyle"}],"title":"FormatStyle","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"FormatStyle"}],"url":"\/documentation\/foundationessentials\/formatstyle","type":"topic","abstract":[{"text":"A type that converts a given data type into a representation in another type, such as a string.","type":"text"}],"role":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle