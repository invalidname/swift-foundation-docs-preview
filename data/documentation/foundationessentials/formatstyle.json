{"type":"text","text":", "},{"code":"01","type":"codeVoice"},{"type":"text","text":", "},{"code":"Jan","type":"codeVoice"},{"type":"text","text":", "},{"code":"2000","type":"codeVoice"},{"type":"text","text":", "},{"code":"00:00:00","type":"codeVoice"},{"type":"text","text":", "},{"code":"GMT","type":"codeVoice"},{"type":"text","text":". Note that missing fields may result in an invalid date or time. Other values in the "},{"code":"DateComponents","type":"codeVoice"},{"type":"text","text":" are ignored."}]},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/format(_:)":{"type":"topic","title":"format(_:)","required":true,"role":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/format(_:)","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)","kind":"symbol","abstract":[{"type":"text","text":"Formats a value, using this style."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"format"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","kind":"typeIdentifier","text":"FormatInput"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"text":".","kind":"text"},{"text":"FormatOutput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa","kind":"typeIdentifier"}]},"doc://FoundationEssentials/SH":{"identifier":"doc:\/\/FoundationEssentials\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://FoundationEssentials/documentation/FoundationEssentials/ParseableFormatStyle":{"fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"ParseableFormatStyle"}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"ParseableFormatStyle","kind":"identifier"}],"title":"ParseableFormatStyle","role":"symbol","abstract":[{"text":"A type 