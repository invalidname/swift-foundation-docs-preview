mbol","type":"topic"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/FormatInput":{"type":"topic","url":"\/documentation\/foundationessentials\/formatstyle\/formatinput","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FormatInput","kind":"identifier"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","required":true,"role":"symbol","kind":"symbol","abstract":[{"text":"The type this format style accepts as input.","type":"text"}],"title":"FormatInput"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/FormatOutput":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput","type":"topic","abstract":[{"type":"text","text":"The type this format style produces as output."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatOutput"}],"required":true,"title":"FormatOutput","role":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/formatoutput"},"doc://FoundationEssentials/SE":{"type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SE","title":"Swift.Encodable"},"doc://FoundationEssentials/SH":{"type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SH","title":"Swift.Hashable"},"doc://FoundationEssentials/Se":{"type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/Se","title":"Swift.Decodable"},"https://www.rfc-editor.org/rfc/rfc9110.html#http.date":{"titleInlineContent":[{"text":"RFC 9110 § 5.6.7","type":"text"}],"url":"https:\/\/www.rfc-editor.org\/rfc\/rfc9110.html#http.date","type":"link","identifier":"https:\/\/www.rfc-editor.org\/rfc\/rfc9110.html#http.date","title":"RFC 9110 § 5.6.7"},"doc://FoundationEssentials/documentation/FoundationEssentials/DateComponents/ISO8601FormatStyle":{"url":"\/documentation\/foundationessentials\/datecomponents\/iso8601formatstyle","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ISO8601FormatStyle","kind":"identifier"}],"abstract":[{"type":"text","text":"Options for generating and parsing string representations of dates following the ISO 8601 standard."}],"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/ISO8601FormatStyle","title":"DateComponents.ISO8601FormatStyle","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ISO8601FormatStyle"}],"role":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/DateComponents/HTTPFormatStyle":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HTTPFormatStyle"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","url":"\/documentation\/foundationessentials\/datecomponents\/httpformatstyle","role":"symbol","abstract":[{"text":"Converts ","type":"text"},{"type":"codeVoice","code":"DateComponents"},{"text":" into RFC 9110-compatible “HTTP date” ","type":"text"},{"type":"codeVoice","code":"String"},{"text":", and parses in the reverse direction.","type":"text"},{"text":" ","type":"text"},{"text":"This parser does not do validation on the individual values of the components. An optional date can be created from the result using ","type":"text"},{"type":"codeVoice","code":"Calendar(identifier: .gregorian).date(from: ...)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"When formatting, missing or invalid fields are filled with default values: "},{"type":"codeVoice","code":"Sun"},{"type":"text","text":", "},{"type":"codeVoice","code":"01"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Jan"},{"type":"text","text":", "},{"type":"codeVoice","code":"2000"},{"type":"text","text":", "},{"type":"codeVoice","code":"00:00:00"},{"text":", ","type":"text"},{"type":"codeVoice","code":"GMT"},{"text":". Note that missing fields may result in an invalid date or time. Other values in the ","type":"text"},{"type":"codeVoice","code":"DateComponents"},{"text":" are ignored.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"HTTPFormatStyle","kind":"identifier"}],"type":"topic","title":"DateComponents.HTTPFormatStyle"},"doc://FoundationEssentials/SQ":{"type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SQ","title":"Swift.Equatable"},"doc://FoundationEssentials/documentation/FoundationEssentials/Date/HTTPFormatStyle":{"kind":"symbol","title":"Date.HTTPFormatStyle","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","role":"symbol","abstract":[{"text":"Options for generating and parsing string representations of dates following the HTTP date format from ","type":"text"},{"identifier":"https:\/\/www.rfc-editor.org\/rfc\/rfc9110.html#http.date","type":"reference","isActive":true},{"text":".","type":"text"}],"navigatorTitle":[{"text":"HTTPFormatStyle","kind":"identifier"}],"url":"\/documentation\/foundationessentials\/date\/httpformatstyle","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"HTTPFormatStyle","kind":"identifier"}]},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/iso8601-2hxhp":{"kind":"symbol","conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" is "},{"code":"Date.ISO8601FormatStyle","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-2hxhp","url":"\/documentation\/foundationessentials\/formatstyle\/iso8601-2hxhp","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"iso8601","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV18ISO8601FormatStyleV","text":"ISO8601FormatStyle","kind":"typeIdentifier"}],"abstract":[],"title":"iso8601","role":"symbol","type":"topic"},"doc://FoundationEssentials/documentation/FoundationEssentials/ParseableFormatStyle":{"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ParseableFormatStyle"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle","role":"symbol","title":"ParseableFormatStyle","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ParseableFormatStyle"}],"abstract":[{"text":"A type that can convert a given input data type into a representation in an output type.","type":"text"}],"url":"\/documentation\/foundationessentials\/parseableformatstyle"},"doc://FoundationEssentials/documentation/FoundationEssentials":{"title":"FoundationEssentials","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","abstract":[{"type":"text","text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app."}],"type":"topic","role":"collection","url":"\/documentation\/foundationessentials","kind":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle":{"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","url":"\/documentation\/foundationessentials\/formatstyle","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatStyle"}],"abstract":[{"type":"text","text":"A type that converts a given data type into a representation in another type, such as a s