{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","metadata":{"platforms":[{"deprecated":false,"name":"iOS","introducedAt":"15.0","beta":false,"unavailable":false},{"deprecated":false,"name":"iPadOS","introducedAt":"15.0","beta":false,"unavailable":false},{"deprecated":false,"name":"Mac Catalyst","introducedAt":"15.0","beta":false,"unavailable":false},{"deprecated":false,"name":"macOS","introducedAt":"12.0","beta":false,"unavailable":false},{"deprecated":false,"name":"tvOS","introducedAt":"15.0","beta":false,"unavailable":false},{"deprecated":false,"name":"watchOS","introducedAt":"8.0","beta":false,"unavailable":false}],"title":"FormatStyle","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FormatStyle","kind":"identifier"}],"navigatorTitle":[{"text":"FormatStyle","kind":"identifier"}],"modules":[{"name":"FoundationEssentials"}],"role":"symbol","externalID":"s:20FoundationEssentials11FormatStyleP","symbolKind":"protocol","roleHeading":"Protocol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/formatstyle"]}],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","interfaceLanguage":"swift"},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH"],"title":"Inherits From","type":"inheritsFrom"},{"kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"title":"Inherited By","type":"inheritedBy"},{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/ISO8601FormatStyle"],"kind":"relationships","title":"Conforming Types","type":"conformingTypes"}],"topicSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)"],"anchor":"Performing-formatting","title":"Performing formatting"},{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/locale(_:)"],"anchor":"Setting-style-locale","title":"Setting style locale"},{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput"],"anchor":"Declaring-input-and-output-types","title":"Declaring input and output types"},{"anchor":"Type-Properties","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-26iub","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-3z94y","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-1jmw1","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-2hxhp"],"title":"Type Properties","generated":true}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"sections":[],"abstract":[{"text":"A type that converts a given data type into a representation in another type, such as a string.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"generated":true,"title":"Data formatting","anchor":"Data-formatting"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatStyle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"FormatInput","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"FormatOutput","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa"},{"kind":"text","text":"> : "},{"kind":"typeIdentifier","text":"Decodable","preciseIdentifier":"s:Se"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Encodable","preciseIdentifier":"s:SE"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Types conforming to the ","type":"text"},{"type":"codeVoice","code":"FormatStyle"},{"text":" protocol take their input type and produce formatted","type":"text"},{"text":" ","type":"text"},{"text":"instances of their output type. The formatting process accounts for locale-specific conventions,","type":"text"},{"text":" ","type":"text"},{"text":"like grouping and separators for numbers, and presentation of units for measurements. The format","type":"text"},{"text":" ","type":"text"},{"text":"styles Foundation provides produce their output as ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":" instances. You","type":"text"},{"text":" ","type":"text"},{"text":"can also create custom styles that format their output as any type, like XML or JSON ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"text":"an image.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There are two basic approaches to using a "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Create an instance of a type that conforms to ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" and apply it to one or more","type":"text"},{"text":" ","type":"text"},{"text":"instances of the input type, by calling the style’s ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)","type":"reference","isActive":true},{"text":" method. Use this when you","type":"text"},{"text":" ","type":"text"},{"text":"want to customize a style once and apply it repeatedly to many instances.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass an instance of a type that conforms to "},{"type":"codeVoice","code":"FormatStyle"},{"text":" to the data type’s ","type":"text"},{"type":"codeVoice","code":"formatted(_:)"},{"type":"text","text":" "},{"type":"text","text":"method, which takes the style as a parameter. Use this for one-off formatting scenarios, or"},{"type":"text","text":" "},{"type":"text","text":"when you want to apply different format styles to the same data value. For the simplest cases,"},{"type":"text","text":" "},{"type":"text","text":"most types that support formatting also have a no-argument "},{"type":"codeVoice","code":"formatted()"},{"type":"text","text":" method that applies a"},{"type":"text","text":" "},{"type":"text","text":"locale-appropriate default format style."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Foundation provides format styles for integers ("},{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":"), floating-point numbers"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"FloatingPointFormatStyle"},{"type":"text","text":"), decimals ("},{"type":"codeVoice","code":"Decimal.FormatStyle"},{"type":"text","text":"), measurements"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Measurement.FormatStyle"},{"type":"text","text":"), arrays ("},{"type":"codeVoice","code":"ListFormatStyle"},{"type":"text","text":"), and more. The numeric format styles"},{"type":"text","text":" "},{"type":"text","text":"also provide supporting format styles to format currency and percent values, like"},{"type":"text","text":" "},{"type":"codeVoice","code":"IntegerFormatStyle.Currency"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Decimal.FormatStyle.Percent"},{"text":".","type":"text"}]},{"anchor":"Modifying-a-format-style","text":"Modifying a format style","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Format styles include modifier methods that return a new format style with an adjusted behavior.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The following example creates an "},{"code":"IntegerFormatStyle","type":"codeVoice"},{"type":"text","text":", then applies modifiers to round values"},{"type":"text","text":" "},{"type":"text","text":"down to the nearest 1,000 and applies formatting appropriate to the "},{"code":"fr_FR","type":"codeVoice"},{"type":"text","text":" locale:"}]},{"type":"codeListing","syntax":"swift","code":["let style = IntegerFormatStyle<Int>()","    .rounded(rule: .down, increment: 1000)","    .locale(Locale(identifier: \"fr_FR\"))","let rounded = 123456789.formatted(style) \/\/ \"123 456 000\""]},{"type":"paragraph","inlineContent":[{"text":"Foundation caches identical instances of a customized format style, so you don’t need to pass","type":"text"},{"text":" ","type":"text"},{"text":"format style instances around unrelated parts of your app’s source code.","type":"text"}]},{"anchor":"Accessing-static-instances","type":"heading","level":3,"text":"Accessing static instances"},{"type":"paragraph","inlineContent":[{"text":"Types that conform to ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" typically extend the base protocol with type properties or","type":"text"},{"text":" ","type":"text"},{"text":"type methods to provide convenience instances. These are available for use in a data type’s","type":"text"},{"text":" ","type":"text"},{"code":"formatted(_:)","type":"codeVoice"},{"text":" method when the format style’s input type matches the data type. For example,","type":"text"},{"text":" ","type":"text"},{"text":"the various numeric format styles define ","type":"text"},{"code":"number","type":"codeVoice"},{"text":" properties with generic constraints to match","type":"text"},{"text":" ","type":"text"},{"text":"the different numeric types (","type":"text"},{"code":"Double","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Float16","type":"codeVoice"},{"text":", and so on).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To see how this works, consider this example of a default formatter for an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" value. Because"},{"type":"text","text":" "},{"type":"codeVoice","code":"123456789"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"BinaryInteger"},{"type":"text","text":", its "},{"type":"codeVoice","code":"formatted(_:)"},{"type":"text","text":" method accepts an "},{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":" "},{"type":"text","text":"parameter. The following example shows the style’s default behavior in the "},{"type":"codeVoice","code":"en_US"},{"type":"text","text":" locale."}]},{"type":"codeListing","syntax":"swift","code":["let formatted = 123456789.formatted(IntegerFormatStyle()) \/\/ \"123,456,789\""]},{"type":"paragraph","inlineContent":[{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":" extends ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" with multiple type properties called ","type":"text"},{"code":"number","type":"codeVoice"},{"text":", each","type":"text"},{"text":" ","type":"text"},{"text":"of which is an ","type":"text"},{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":" instance; these properties differ by which","type":"text"},{"text":" ","type":"text"},{"code":"BinaryInteger","type":"codeVoice"},{"text":"-conforming type they take as input. Since one of these statically-defined","type":"text"},{"text":" ","type":"text"},{"text":"properties takes ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" as its input, you can use this type property instead of instantiating a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"new format style instance. Using dot notation to access this property on the inferred"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FormatStyle"},{"text":" makes the call point much easier to read, as seen here:","type":"text"}]},{"type":"codeListing","code":["let formatted = 123456789.formatted(.number) \/\/ \"123,456,789\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Furthermore, since you can customize these statically-accessed format style instances, you can","type":"text"},{"text":" ","type":"text"},{"text":"rewrite the example from the previous section without instantiating a new ","type":"text"},{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"like this:","type":"text"}]},{"type":"codeListing","code":["let rounded = 123456789.formatted(.number","    .rounded(rule: .down, increment: 1000)","    .locale(Locale(identifier: \"fr_FR\"))) \/\/ \"123 456 000\""],"syntax":"swift"},{"level":3,"text":"Parsing with a format style","anchor":"Parsing-with-a-format-style","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"To perform the opposite conversion — from formatted output type to input data type — some","type":"text"},{"text":" ","type":"text"},{"text":"format styles provide a corresponding ","type":"text"},{"code":"ParseStrategy","type":"codeVoice"},{"text":" type. These format styles typically expose","type":"text"},{"text":" ","type":"text"},{"text":"an instance of this type as a variable, called ","type":"text"},{"code":"parseStrategy","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can use a ","type":"text"},{"type":"codeVoice","code":"ParseStrategy"},{"text":" one of two ways:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Initialize the data type by calling an initializer of that type that takes a formatted","type":"text"},{"text":" ","type":"text"},{"text":"instance and a parse strategy as parameters. For example, you can create a ","type":"text"},{"code":"Decimal","type":"codeVoice"},{"text":" from a","type":"text"},{"text":" ","type":"text"},{"text":"formatted string with the initializer ","type":"text"},{"code":"Decimal.init(_:format:lenient:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Create a parse strategy and call its ","type":"text"},{"type":"codeVoice","code":"parse(_:)"},{"text":" method on one or more formatted instances.","type":"text"}]}]}],"type":"unorderedList"}]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials":{"role":"collection","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","abstract":[{"type":"text","text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app."}],"title":"FoundationEssentials","type":"topic","url":"\/documentation\/foundationessentials","kind":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/DateComponents/ISO8601FormatStyle":{"role":"symbol","abstract":[{"text":"Options for generating and parsing string representations of dates following the ISO 8601 standard.","type":"text"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/ISO8601FormatStyle","navigatorTitle":[{"text":"ISO8601FormatStyle","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ISO8601FormatStyle","kind":"identifier"}],"url":"\/documentation\/foundationessentials\/datecomponents\/iso8601formatstyle","kind":"symbol","type":"topic","title":"DateComponents.ISO8601FormatStyle"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle":{"kind":"symbol","url":"\/documentation\/foundationessentials\/formatstyle","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","title":"FormatStyle","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatStyle"}],"navigatorTitle":[{"kind":"identifier","text":"FormatStyle"}],"abstract":[{"text":"A type that converts a given data type into a representation in another type, such as a string.","type":"text"}]},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/FormatOutput":{"role":"symbol","title":"FormatOutput","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput","abstract":[{"text":"The type this format style produces as output.","type":"text"}],"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FormatOutput","kind":"identifier"}],"url":"\/documentation\/foundationessentials\/formatstyle\/formatoutput","kind":"symbol","required":true,"type":"topic"},"doc://FoundationEssentials/documentation/FoundationEssentials/DateComponents/HTTPFormatStyle":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPFormatStyle","kind":"identifier"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","abstract":[{"text":"Converts ","type":"text"},{"type":"codeVoice","code":"DateComponents"},{"text":" into RFC 9110-compatible “HTTP date” ","type":"text"},{"type":"codeVoice","code":"String"},{"text":", and parses in the reverse direction.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"This parser does not do validation on the individual values of the components. An optional date can be created from the result using "},{"type":"codeVoice","code":"Calendar(identifier: .gregorian).date(from: ...)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"When formatting, missing or invalid fields are filled with default values: "},{"type":"codeVoice","code":"Sun"},{"type":"text","text":", "},{"type":"codeVoice","code":"01"},{"type":"text","text":", "},{"type":"codeVoice","code":"Jan"},{"type":"text","text":", "},{"type":"codeVoice","code":"2000"},{"type":"text","text":", "},{"type":"codeVoice","code":"00:00:00"},{"type":"text","text":", "},{"type":"codeVoice","code":"GMT"},{"type":"text","text":". Note that missing fields may result in an invalid date or time. Other values in the "},{"type":"codeVoice","code":"DateComponents"},{"type":"text","text":" are ignored."}],"url":"\/documentation\/foundationessentials\/datecomponents\/httpformatstyle","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"HTTPFormatStyle","kind":"identifier"}],"title":"DateComponents.HTTPFormatStyle"},"doc://FoundationEssentials/SE":{"title":"Swift.Encodable","type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SE"},"doc://FoundationEssentials/SH":{"identifier":"doc:\/\/FoundationEssentials\/SH","type":"unresolvable","title":"Swift.Hashable"},"https://www.rfc-editor.org/rfc/rfc9110.html#http.date":{"url":"https:\/\/www.rfc-editor.org\/rfc\/rf