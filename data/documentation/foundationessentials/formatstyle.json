sing string representations of dates following the HTTP date format from "},{"isActive":true,"identifier":"https:\/\/www.rfc-editor.org\/rfc\/rfc9110.html#http.date","type":"reference"},{"text":".","type":"text"}],"role":"symbol","title":"Date.HTTPFormatStyle","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","url":"\/documentation\/foundationessentials\/date\/httpformatstyle","navigatorTitle":[{"text":"HTTPFormatStyle","kind":"identifier"}]},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/FormatInput":{"type":"topic","kind":"symbol","required":true,"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatInput"}],"abstract":[{"type":"text","text":"The type this format style accepts as input."}],"role":"symbol","title":"FormatInput","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","url":"\/documentation\/foundationessentials\/formatstyle\/formatinput"},"doc://FoundationEssentials/SQ":{"type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SQ","title":"Swift.Equatable"},"doc://FoundationEssentials/documentation/FoundationEssentials":{"kind":"symbol","title":"FoundationEssentials","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","role":"collection","type":"topic","abstract":[{"text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app.","type":"text"}],"url":"\/documentation\/foundationessentials"},"doc://FoundationEssentials/documentation/FoundationEssentials/DiscreteFormatStyle":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DiscreteFormatStyle"}],"navigatorTitle":[{"kind":"identifier","text":"DiscreteFormatStyle"}],"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","role":"symbol","type":"topic","title":"DiscreteFormatStyle","url":"\/documentation\/foundationessentials\/discreteformatstyle","abstract":[{"text":"A format style that transforms a continuous input into a discrete output and provides","type":"text"},{"text":" ","type":"text"},{"text":"information about its discretization boundaries.","type":"text"}]},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle":{"url":"\/documentation\/foundationessentials\/formatstyle","type":"topic","role":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","abstract":[{"type":"text","text":"A type that converts a given data type into a representation in another type, such as a string."}],"title":"FormatStyle","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatStyle"}],"navigatorTitle":[{"kind":"identifier","text":"FormatStyle"}],"kind":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/iso8601-2hxhp":{"kind":"symbol","abstract":[],"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-2hxhp","url":"\/documentation\/foundationessentials\/formatstyle\/iso8601-2hxhp","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"iso8601"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"ISO8601FormatStyle","preciseIdentifier":"s:20FoundationEssentials4DateV18ISO8601FormatStyleV"}],"title":"iso8601","role":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Da