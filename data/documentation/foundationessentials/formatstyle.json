tstyle","kind":"symbol","abstract":[{"type":"text","text":"Options for generating and parsing string representations of dates following the ISO 8601 standard."}],"navigatorTitle":[{"text":"ISO8601FormatStyle","kind":"identifier"}]},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle":{"url":"\/documentation\/foundationessentials\/formatstyle","role":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","abstract":[{"type":"text","text":"A type that converts a given data type into a representation in another type, such as a string."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatStyle"}],"navigatorTitle":[{"kind":"identifier","text":"FormatStyle"}],"kind":"symbol","type":"topic","title":"FormatStyle"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/format(_:)":{"abstract":[{"type":"text","text":"Formats a value, using this style."}],"required":true,"title":"format(_:)","kind":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/format(_:)","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"format"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"FormatInput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"FormatOutput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa"}]},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/FormatInput":{"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","abstract":[{"type":"text","text":"The type this format style accepts as input."}],"required":true,"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatInput"}],"title":"FormatInput","url":"\/documentation\/foundationessentials\/formatstyle\/formatinput"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/locale(_:)":{"kind":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/locale(_:)","abstract":[{"type":"text","text":"Modifies the format style to use the specified locale."}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/locale(_:)","title":"locale(_:)","required":true,"defaultImplementations":1,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"locale","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Locale","preciseIdentifier":"s:20FoundationEssentials6LocaleV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"}],"role":"symbol","type":"topic"},"doc://FoundationEssentials/Se":{"identifier":"doc:\/\/FoundationEssentials\/Se","type":"unresolvable","title":"Swift.Decodable"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/iso8601-1jmw1":{"url":"\/documentation\/foundationessentials\/formatstyle\/iso8601-1jmw1","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"iso8601"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"DateComponents","preciseIdentifier":"s:20FoundationEssentials14DateComponentsV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"ISO8601FormatStyle","preciseIdentifier":"s:20FoundationEssentials14DateComponentsV18ISO8601FormatStyleV"}],"role":"symbol","title":"iso8601","abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-1jmw1","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"DateComponents.ISO8601FormatStyle"},{"text":".","type":"text"}]}},"doc://FoundationEssentials/documentation/FoundationEssentials":{"title":"FoundationEssentials","kind":"symbol","abstract":[{"text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app.","type":"text"}],"url":"\/documentation\/foundationessentials","role":"collection","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/FormatOutput":{"title":"FormatOutput","required":true,"role":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/formatoutput","type":"topic","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FormatOutput","kind":"identifier"}],"abstract":[{"type":"text","text":"The type this format style produces as output."}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput","kind":"symbol"},"doc://FoundationEssentials/SQ":{"identifier":"doc:\/\/FoundationEssentials\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://FoundationEssentials/SH":{"identifier":"doc:\/\/FoundationEssentials\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://FoundationEssentials/documentation/FoundationEssentials/ParseableFormatStyle":{"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ParseableFormatStyle"}],"abstract":[{"type":"text","text":"A type that can convert a given input data type into a representation in an output type."}],"title":"ParseableFormatStyle","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ParseableFormatStyle"}],"url":"\/documentation\/foundationessentials\/parseableformatstyle"},"doc://FoundationEssentials/documentation/FoundationEssentials/Date/HTTPFormatStyle":{"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","type":"topic","navigatorTitle":[{"text":"HTTPFormatStyle","kind":"identifier"}],"abstract":[{"text":"Options for generating and parsing string representations of dates following the HTTP date format from ","type":"text"},{"type":"reference","identifier":"https:\/\/www.rfc-editor.org\/rfc\/rfc9110.html#http.date","isActive":true},{"text":".","type":"text"}],"title":"Date.HTTPFormatStyle","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPFormatStyle"}],"url":"\/documentation\/foundationessentials\/date\/httpformatstyle"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/http-26iub":{"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-26iub","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Self"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Date.HTTPFormatStyle"},{"text":".","type":"text"}]},"abstract":[],"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"http"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"HTTPFormatStyle","preciseIdentifier":"s:20FoundationEssentials4DateV15HTTPFormatStyleV"}],"kind":"symbol","title":"http","url":"\/documentation\/foundationessentials\/formatstyle\/http-26iub"},"doc://FoundationEssentials/documentation/FoundationEssentials/DateComponents/HTTPFormatStyle":{"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","type":"topic","navigatorTitle":[{"kind":"identifier","text":"HTTPFormatStyle"}],"abstract":[{"type":"text","text":"Converts "},{"type":"codeVoice","code":"DateComponents"},{"type":"text","text":" into RFC 9110-compatible “HTTP date” "},{"type":"codeVoice","code":"String"},{"type":"text","text":", and parses in the reverse direction."},{"text":" ","type":"text"},{"text":"This parser does not do validation on the individual values of the components. An optional date can be created from the result using ","type":"text"},{"code":"Calendar(identifier: .gregorian).date(from: ...)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"When formatting, missing or invalid fields are filled with default values: ","type":"text"},{"code":"Sun","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"01"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Jan"},{"text":", ","type":"text"},{"type":"codeVoice","code":"2000"},{"text":", ","type":"text"},{"type":"codeVoice","code":"00:00:00"},{"text":", ","type":"text"},{"type":"codeVoice","code":"GMT"},{"text":". Note that missing fields may result in an invalid date or time. Other values in the ","type":"text"},{"type":"codeVoice","code":"DateComponents"},{"text":" are ignored.","type":"text"}],"title":"DateComponents.HTTPFormatStyle","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"HTTPFormatStyle"}],"url":"\/documentation\/foundationessentials\/datecomponents\/httpformatstyle"},"doc://FoundationEssentials/documentation/FoundationEssentials/Date/ISO8601FormatStyle":{"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ISO8601FormatStyle"}],"abstract":[{"type":"text","text":"A type that converts between dates and their ISO-8601 string representations."}],"title":"Date.ISO8601FormatStyle","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ISO8601FormatStyle"}],"url":"\/documentation\/foundationessentials\/date\/iso8601formatstyle"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/http-3z94y":{"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-3z94y","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"DateComponents.HTTPFormatStyle"},{"type":"text","text":"."}]},"abstract":[],"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"http"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials14DateComponentsV","text":"DateComponents"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"HTTPFormatStyle","preciseIdentifier":"s:20FoundationEssentials14DateComponentsV15HTTPFormatStyleV"}],"kind":"symbol","title":"http","url":"\/documentation\/foundationessentials\/formatstyle\/http-3z94y"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/iso8601-2hxhp":{"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-2hxhp","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Date.ISO8601FormatStyle"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"abstract":[],"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"iso8601","kind":"identifier"},{"kind":"text","text":": "},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV18ISO8601FormatStyleV","text":"ISO8601FormatStyle"}],"kind":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/iso8601-2hxhp","title":"iso8601"},"doc://FoundationEssentials/SE":{"title":"Swift.Encodable","identifier":"doc:\/\/FoundationEssentials\/SE","type":"unresolvable"},"https://www.rfc-editor.org/rfc/rfc9110.html#http.date":{"titleInlineContent":[{"type":"text","text":"RFC 9110 § 5.6.7"}],"url":"https:\/\/www.rfc-editor.org\/rfc\/rfc9110.html#http.date","title":"RFC 9110 § 5.6.7","identifier":"https:\/\/www.rfc-editor.org\/rfc\/rfc9110.html#http.date","type":"link"},"doc://FoundationEssentials/documentation/FoundationEssentials/DiscreteFormatStyle":{"url":"\/documentation\/foundationessentials\/discreteformatstyle","role":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","abstract":[{"type":"text","text":"A format style that transforms a continuous input into a discrete output and provides"},{"type":"text","text":" "},{"type":"text","text":"information about its discretization boundaries."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DiscreteFormatStyle"}],"navigatorTitle":[{"kind":"identifier","text":"DiscreteFormatStyle"}],"kind":"symbol","type":"topic","title":"DiscreteFormatStyle"}}}