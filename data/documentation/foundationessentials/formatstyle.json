e":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A type that converts a given data type into a representation in another type, such as a string."}]},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/FormatInput":{"abstract":[{"text":"The type this format style accepts as input.","type":"text"}],"kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FormatInput","kind":"identifier"}],"role":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/formatinput","required":true,"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","title":"FormatInput"},"doc://FoundationEssentials/documentation/FoundationEssentials/DateComponents/HTTPFormatStyle":{"url":"\/documentation\/foundationessentials\/datecomponents\/httpformatstyle","title":"DateComponents.HTTPFormatStyle","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPFormatStyle"}],"navigatorTitle":[{"kind":"identifier","text":"HTTPFormatStyle"}],"abstract":[{"type":"text","text":"Converts "},{"type":"codeVoice","code":"DateComponents"},{"type":"text","text":" into RFC 9110-compatible “HTTP date” "},{"type":"codeVoice","code":"String"},{"type":"text","text":", and parses in the reverse direction."},{"type":"text","text":" "},{"type":"text","text":"This parser does not do validation on the individual values of the components. An optional date can be created from the result using "},{"code":"Calendar(identifier: .gregorian).date(from: ...)","type":"codeVoice"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"When formatting, missing or invalid fields are filled with default values: ","type":"text"},{"code":"Sun","type":"codeVoice"},{"type":"text","text":", "},{"code":"01","type":"codeVoice"},{"type":"text","text":", "},{"code":"Jan","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"2000"},{"text":", ","type":"text"},{"type":"codeVoice","code":"00:00:00"},{"text":", ","type":"text"},{"code":"GMT","type":"codeVoice"},{"type":"text","text":". Note that missing fields may result in an invalid date or time. Other values in the "},{"code":"DateComponents","type":"codeVoice"},{"type":"text","text":" are ignored."}],"type":"topic","role":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/Date/ISO8601FormatStyle":{"abstract":[{"type":"text","text":"A type that converts between dates and their ISO-8601 string representations."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"ISO8601FormatStyle","kind":"identifier"}],"role":"symbol","title":"Date.ISO8601FormatStyle","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"ISO8601FormatStyle","kind":"identifier"}],"url":"\/documentation\/foundationessentials\/date\/iso8601formatstyle"},"doc://FoundationEssentials/documentation/FoundationEssentials/DiscreteFormatStyle":{"abstract":[{"text":"A format style that transforms a continuous input into a discrete output and provides","type":"text"},{"text":" ","type":"text"},{"text":"information about its discretization boundaries.","type":"text"}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscreteFormatStyle","kind":"identifier"}],"role":"symbol","url":"\/documentation\/foundationessentials\/discreteformatstyle","navigatorTitle":[{"text":"DiscreteFormatStyle","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","title":"DiscreteFormatStyle"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/http-26iub":{"abstract":[],"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Self"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Date.HTTPFormatStyle"},{"text":".","type":"text"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"http"},{"kind":"text","text":": "},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":".","kind":"text"},{"text":"HTTPFormatStyle","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV15HTTPFormatStyleV"}],"role":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/http-26iub","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-26iub","title":"http"},"doc://FoundationEssentials/SQ":{"type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SQ","title":"Swift.Equatable"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/format(_:)":{"abstract":[{"text":"Formats a value, using this style.","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"format","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"FormatInput","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"FormatOutput","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa"}],"role":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/format(_:)","required":true,"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)","title":"format(_:)"}}}