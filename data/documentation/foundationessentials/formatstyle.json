,"type":"codeVoice"},{"text":" into RFC 9110-compatible “HTTP date” ","type":"text"},{"code":"String","type":"codeVoice"},{"text":", and parses in the reverse direction.","type":"text"},{"text":" ","type":"text"},{"text":"This parser does not do validation on the individual values of the components. An optional date can be created from the result using ","type":"text"},{"code":"Calendar(identifier: .gregorian).date(from: ...)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"When formatting, missing or invalid fields are filled with default values: ","type":"text"},{"code":"Sun","type":"codeVoice"},{"text":", ","type":"text"},{"code":"01","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Jan","type":"codeVoice"},{"text":", ","type":"text"},{"code":"2000","type":"codeVoice"},{"text":", ","type":"text"},{"code":"00:00:00","type":"codeVoice"},{"text":", ","type":"text"},{"code":"GMT","type":"codeVoice"},{"text":". Note that missing fields may result in an invalid date or time. Other values in the ","type":"text"},{"code":"DateComponents","type":"codeVoice"},{"text":" are ignored.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"HTTPFormatStyle","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/foundationessentials\/datecomponents\/httpformatstyle","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPFormatStyle","kind":"identifier"}],"title":"DateComponents.HTTPFormatStyle"},"doc://FoundationEssentials/documentation/FoundationEssentials":{"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","title":"FoundationEssentials","type":"topic","role":"collection","abstract":[{"type":"text","text":"Access essential data types, collections, and operating-system services to define the base layer of functionality 