{"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"kind":"symbol","abstract":[{"type":"text","text":"A type that converts a given data type into a representation in another type, such as a string."}],"seeAlsoSections":[{"anchor":"Data-formatting","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"generated":true,"title":"Data formatting"}],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","interfaceLanguage":"swift"},"sections":[],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH"],"title":"Inherits From","type":"inheritsFrom"},{"kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"title":"Inherited By","type":"inheritedBy"},{"kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/ISO8601FormatStyle"],"title":"Conforming Types","type":"conformingTypes"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatStyle"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","kind":"typeIdentifier","text":"FormatInput","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput"},{"kind":"text","text":", "},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa","kind":"typeIdentifier","text":"FormatOutput","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput"},{"kind":"text","text":"> : "},{"preciseIdentifier":"s:Se","kind":"typeIdentifier","text":"Decodable"},{"kind":"text","text":", "},{"preciseIdentifier":"s:SE","kind":"typeIdentifier","text":"Encodable"},{"kind":"text","text":", "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"Types conforming to the ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" protocol take their input type and produce formatted","type":"text"},{"text":" ","type":"text"},{"text":"instances of their output type. The formatting process accounts for locale-specific conventions,","type":"text"},{"text":" ","type":"text"},{"text":"like grouping and separators for numbers, and presentation of units for measurements. The format","type":"text"},{"text":" ","type":"text"},{"text":"styles Foundation provides produce their output as ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":" instances. You","type":"text"},{"text":" ","type":"text"},{"text":"can also create custom styles that format their output as any type, like XML or JSON ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"text":"an image.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"There are two basic approaches to using a ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Create an instance of a type that conforms to ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" and apply it to one or more","type":"text"},{"text":" ","type":"text"},{"text":"instances of the input type, by calling the style’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)","isActive":true},{"text":" method. Use this when you","type":"text"},{"text":" ","type":"text"},{"text":"want to customize a style once and apply it repeatedly to many instances.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Pass an instance of a type that conforms to ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" to the data type’s ","type":"text"},{"code":"formatted(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"method, which takes the style as a parameter. Use this for one-off formatting scenarios, or","type":"text"},{"text":" ","type":"text"},{"text":"when you want to apply different format styles to the same data value. For the simplest cases,","type":"text"},{"text":" ","type":"text"},{"text":"most types that support formatting also have a no-argument ","type":"text"},{"code":"formatted()","type":"codeVoice"},{"text":" method that applies a","type":"text"},{"text":" ","type":"text"},{"text":"locale-appropriate default format style.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Foundation provides format styles for integers (","type":"text"},{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":"), floating-point numbers","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"FloatingPointFormatStyle","type":"codeVoice"},{"text":"), decimals (","type":"text"},{"code":"Decimal.FormatStyle","type":"codeVoice"},{"text":"), measurements","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"Measurement.FormatStyle","type":"codeVoice"},{"text":"), arrays (","type":"text"},{"code":"ListFormatStyle","type":"codeVoice"},{"text":"), and more. The numeric format styles","type":"text"},{"text":" ","type":"text"},{"text":"also provide supporting format styles to format currency and percent values, like","type":"text"},{"text":" ","type":"text"},{"code":"IntegerFormatStyle.Currency","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Decimal.FormatStyle.Percent","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Modifying a format style","anchor":"Modifying-a-format-style"},{"inlineContent":[{"text":"Format styles include modifier methods that return a new format style with an adjusted behavior.","type":"text"},{"text":" ","type":"text"},{"text":"The following example creates an ","type":"text"},{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":", then applies modifiers to round values","type":"text"},{"text":" ","type":"text"},{"text":"down to the nearest 1,000 and applies formatting appropriate to the ","type":"text"},{"code":"fr_FR","type":"codeVoice"},{"text":" locale:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let style = IntegerFormatStyle<Int>()","    .rounded(rule: .down, increment: 1000)","    .locale(Locale(identifier: \"fr_FR\"))","let rounded = 123456789.formatted(style) \/\/ \"123 456 000\""]},{"inlineContent":[{"text":"Foundation caches identical instances of a customized format style, so you don’t need to pass","type":"text"},{"text":" ","type":"text"},{"text":"format style instances around unrelated parts of your app’s source code.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Accessing static instances","anchor":"Accessing-static-instances"},{"inlineContent":[{"text":"Types that conform to ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" typically extend the base protocol with type properties or","type":"text"},{"text":" ","type":"text"},{"text":"type methods to provide convenience instances. These are available for use in a data type’s","type":"text"},{"text":" ","type":"text"},{"code":"formatted(_:)","type":"codeVoice"},{"text":" method when the format style’s input type matches the data type. For example,","type":"text"},{"text":" ","type":"text"},{"text":"the various numeric format styles define ","type":"text"},{"code":"number","type":"codeVoice"},{"text":" properties with generic constraints to match","type":"text"},{"text":" ","type":"text"},{"text":"the different numeric types (","type":"text"},{"code":"Double","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Float16","type":"codeVoice"},{"text":", and so on).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To see how this works, consider this example of a default formatter for an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" value. Because","type":"text"},{"text":" ","type":"text"},{"code":"123456789","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"BinaryInteger","type":"codeVoice"},{"text":", its ","type":"text"},{"code":"formatted(_:)","type":"codeVoice"},{"text":" method accepts an ","type":"text"},{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":" ","type":"text"},{"text":"parameter. The following example shows the style’s default behavior in the ","type":"text"},{"code":"en_US","type":"codeVoice"},{"text":" locale.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let formatted = 123456789.formatted(IntegerFormatStyle()) \/\/ \"123,456,789\""]},{"inlineContent":[{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":" extends ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" with multiple type properties called ","type":"text"},{"code":"number","type":"codeVoice"},{"text":", each","type":"text"},{"text":" ","type":"text"},{"text":"of which is an ","type":"text"},{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":" instance; these properties differ by which","type":"text"},{"text":" ","type":"text"},{"code":"BinaryInteger","type":"codeVoice"},{"text":"-conforming type they take as input. Since one of these statically-defined","type":"text"},{"text":" ","type":"text"},{"text":"properties takes ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" as its input, you can use this type property instead of instantiating a","type":"text"},{"text":" ","type":"text"},{"text":"new format style instance. Using dot notation to access this property on the inferred","type":"text"},{"text":" ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" makes the call point much easier to read, as seen here:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let formatted = 123456789.formatted(.number) \/\/ \"123,456,789\""]},{"inlineContent":[{"text":"Furthermore, since you can customize these statically-accessed format style instances, you can","type":"text"},{"text":" ","type":"text"},{"text":"rewrite the example from the previous section without instantiating a new ","type":"text"},{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"like this:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let rounded = 123456789.formatted(.number","    .rounded(rule: .down, increment: 1000)","    .locale(Locale(identifier: \"fr_FR\"))) \/\/ \"123 456 000\""]},{"type":"heading","level":3,"text":"Parsing with a format style","anchor":"Parsing-with-a-format-style"},{"inlineContent":[{"text":"To perform the opposite conversion — from formatted output type to input data type — some","type":"text"},{"text":" ","type":"text"},{"text":"format styles provide a corresponding ","type":"text"},{"code":"ParseStrategy","type":"codeVoice"},{"text":" type. These format styles typically expose","type":"text"},{"text":" ","type":"text"},{"text":"an instance of this type as a variable, called ","type":"text"},{"code":"parseStrategy","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can use a ","type":"text"},{"code":"ParseStrategy","type":"codeVoice"},{"text":" one of two ways:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Initialize the data type by calling an initializer of that type that takes a formatted","type":"text"},{"text":" ","type":"text"},{"text":"instance and a parse strategy as parameters. For example, you can create a ","type":"text"},{"code":"Decimal","type":"codeVoice"},{"text":" from a","type":"text"},{"text":" ","type":"text"},{"text":"formatted string with the initializer ","type":"text"},{"code":"Decimal.init(_:format:lenient:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Create a parse strategy and call its ","type":"text"},{"code":"parse(_:)","type":"codeVoice"},{"text":" method on one or more formatted instances.","type":"text"}]}]}],"type":"unorderedList"}]}],"topicSections":[{"anchor":"Performing-formatting","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)"],"title":"Performing formatting"},{"anchor":"Setting-style-locale","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/locale(_:)"],"title":"Setting style locale"},{"anchor":"Declaring-input-and-output-types","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput"],"title":"Declaring input and output types"},{"anchor":"Applying-date-and-time-styles","identifiers":["doc:\/\/FoundationEssentials\/documenta