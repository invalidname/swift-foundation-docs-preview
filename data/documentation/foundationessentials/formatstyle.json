format(_:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"format","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","text":"FormatInput","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa","text":"FormatOutput","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Formats a value, using this style."}],"url":"\/documentation\/foundationessentials\/formatstyle\/format(_:)","title":"format(_:)","required":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)","type":"topic"},"doc://FoundationEssentials/SE":{"type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SE","title":"Swift.Encodable"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/iso8601-2hxhp":{"abstract":[],"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/iso8601-2hxhp","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-2hxhp","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"iso8601","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV18ISO8601FormatStyleV","text":"ISO8601FormatStyle","kind":"typeIdentifier"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Date.ISO8601FormatStyle"},{"type":"text","text":"."}]},"title":"iso8601"}}}