{"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"A type that converts a given data type into a representation in another type, such as a string.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)"],"title":"Performing formatting","anchor":"Performing-formatting"},{"title":"Setting style locale","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/locale(_:)"],"anchor":"Setting-style-locale"},{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput"],"title":"Declaring input and output types","anchor":"Declaring-input-and-output-types"},{"title":"Applying date and time styles","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-1jmw1","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-2hxhp","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-26iub","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-3z94y"],"anchor":"Applying-date-and-time-styles"}],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH"]},{"type":"inheritedBy","kind":"relationships","title":"Inherited By","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"]},{"title":"Conforming Types","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/ISO8601FormatStyle"],"type":"conformingTypes"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"FormatStyle"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","kind":"typeIdentifier","text":"FormatInput"},{"kind":"text","text":", "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa","kind":"typeIdentifier","text":"FormatOutput"},{"text":"> : ","kind":"text"},{"preciseIdentifier":"s:Se","kind":"typeIdentifier","text":"Decodable"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:SE","kind":"typeIdentifier","text":"Encodable"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Types conforming to the ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" protocol take their input type and produce formatted","type":"text"},{"type":"text","text":" "},{"type":"text","text":"instances of their output type. The formatting process accounts for locale-specific conventions,"},{"type":"text","text":" "},{"type":"text","text":"like grouping and separators for numbers, and presentation of units for measurements. The format"},{"type":"text","text":" "},{"type":"text","text":"styles Foundation provides produce their output as "},{"code":"String","type":"codeVoice"},{"type":"text","text":" or "},{"code":"AttributedString","type":"codeVoice"},{"type":"text","text":" instances. You"},{"type":"text","text":" "},{"type":"text","text":"can also create custom styles that format their output as any type, like XML or JSON "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"an image."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are two basic approaches to using a "},{"code":"FormatStyle","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Create an instance of a type that conforms to "},{"code":"FormatStyle","type":"codeVoice"},{"type":"text","text":" and apply it to one or more"},{"type":"text","text":" "},{"type":"text","text":"instances of the input type, by calling the style’s "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)","isActive":true},{"type":"text","text":" method. Use this when you"},{"type":"text","text":" "},{"type":"text","text":"want to customize a style once and apply it repeatedly to many instances."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Pass an instance of a type that conforms to "},{"code":"FormatStyle","type":"codeVoice"},{"type":"text","text":" to the data type’s "},{"type":"codeVoice","code":"formatted(_:)"},{"type":"text","text":" "},{"type":"text","text":"method, which takes the style as a parameter. Use this for one-off formatting scenarios, or"},{"type":"text","text":" "},{"type":"text","text":"when you want to apply different format styles to the same data value. For the simplest cases,"},{"type":"text","text":" "},{"type":"text","text":"most types that support formatting also have a no-argument "},{"code":"formatted()","type":"codeVoice"},{"type":"text","text":" method that applies a"},{"type":"text","text":" "},{"type":"text","text":"locale-appropriate default format style."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Foundation provides format styles for integers (","type":"text"},{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":"), floating-point numbers","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"("},{"type":"codeVoice","code":"FloatingPointFormatStyle"},{"type":"text","text":"), decimals ("},{"type":"codeVoice","code":"Decimal.FormatStyle"},{"type":"text","text":"), measurements"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Measurement.FormatStyle"},{"type":"text","text":"), arrays ("},{"code":"ListFormatStyle","type":"codeVoice"},{"text":"), and more. The numeric format styles","type":"text"},{"type":"text","text":" "},{"type":"text","text":"also provide supporting format styles to format currency and percent values, like"},{"type":"text","text":" "},{"code":"IntegerFormatStyle.Currency","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Decimal.FormatStyle.Percent","type":"codeVoice"},{"text":".","type":"text"}]},{"level":3,"type":"heading","anchor":"Modifying-a-format-style","text":"Modifying a format style"},{"type":"paragraph","inlineContent":[{"text":"Format styles include modifier methods that return a new format style with an adjusted behavior.","type":"text"},{"text":" ","type":"text"},{"text":"The following example creates an ","type":"text"},{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":", then applies modifiers to round values","type":"text"},{"text":" ","type":"text"},{"text":"down to the nearest 1,000 and applies formatting appropriate to the ","type":"text"},{"code":"fr_FR","type":"codeVoice"},{"text":" locale:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let style = IntegerFormatStyle<Int>()","    .rounded(rule: .down, increment: 1000)","    .locale(Locale(identifier: \"fr_FR\"))","let rounded = 123456789.formatted(style) \/\/ \"123 456 000\""]},{"type":"paragraph","inlineContent":[{"text":"Foundation caches identical instances of a customized format style, so you don’t need to pass","type":"text"},{"text":" ","type":"text"},{"text":"format style instances around unrelated parts of your app’s source code.","type":"text"}]},{"level":3,"type":"heading","anchor":"Accessing-static-instances","text":"Accessing static instances"},{"type":"paragraph","inlineContent":[{"text":"Types that conform to ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" typically extend the base protocol with type properties or","type":"text"},{"text":" ","type":"text"},{"text":"type methods to provide convenience instances. These are available for use in a data type’s","type":"text"},{"text":" ","type":"text"},{"code":"formatted(_:)","type":"codeVoice"},{"text":" method when the format style’s input type matches the data type. For example,","type":"text"},{"text":" ","type":"text"},{"text":"the various numeric format styles define ","type":"text"},{"code":"number","type":"codeVoice"},{"text":" properties with generic constraints to match","type":"text"},{"text":" ","type":"text"},{"text":"the different numeric types (","type":"text"},{"code":"Double","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Float16","type":"codeVoice"},{"text":", and so on).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To see how this works, consider this example of a default formatter for an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" value. Because","type":"text"},{"text":" ","type":"text"},{"code":"123456789","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"BinaryInteger","type":"codeVoice"},{"text":", its ","type":"text"},{"code":"formatted(_:)","type":"codeVoice"},{"text":" method accepts an ","type":"text"},{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":" ","type":"text"},{"text":"parameter. The following example shows the style’s default behavior in the ","type":"text"},{"code":"en_US","type":"codeVoice"},{"text":" locale.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let formatted = 123456789.formatted(IntegerFormatStyle()) \/\/ \"123,456,789\""]},{"type":"paragraph","inlineContent":[{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":" extends ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" with multiple type properties called ","type":"text"},{"code":"number","type":"codeVoice"},{"text":", each","type":"text"},{"text":" ","type":"text"},{"text":"of which is an ","type":"text"},{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":" instance; these properties differ by which","type":"text"},{"text":" ","type":"text"},{"code":"BinaryInteger","type":"codeVoice"},{"text":"-conforming type they take as input. Since one of these statically-defined","type":"text"},{"text":" ","type":"text"},{"text":"properties takes ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" as its input, you can use this type property instead of instantiating a","type":"text"},{"text":" ","type":"text"},{"text":"new format style instance. Using dot notation to access this property on the inferred","type":"text"},{"text":" ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" makes the call point much easier to read, as seen here:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let formatted = 123456789.formatted(.number) \/\/ \"123,456,789\""]},{"type":"paragraph","inlineContent":[{"text":"Furthermore, since you can customize these statically-accessed format style instances, you can","type":"text"},{"text":" ","type":"text"},{"text":"rewrite the example from the previous section without instantiating a new ","type":"text"},{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"like this:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let rounded = 123456789.formatted(.number","    .rounded(rule: .down, increment: 1000)","    .locale(Locale(identifier: \"fr_FR\"))) \/\/ \"123 456 000\""]},{"level":3,"type":"heading","anchor":"Parsing-with-a-format-style","text":"Parsing with a format style"},{"type":"paragraph","inlineContent":[{"text":"To perform the opposite conversion — from formatted output type to input data type — some","type":"text"},{"text":" ","type":"text"},{"text":"format styles provide a corresponding ","type":"text"},{"code":"ParseStrategy","type":"codeVoice"},{"text":" type. These format styles typically expose","type":"text"},{"text":" ","type":"text"},{"text":"an instance of this type as a variable, called ","type":"text"},{"code":"parseStrategy","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can use a ","type":"text"},{"code":"ParseStrategy","type":"codeVoice"},{"text":" one of two ways:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Initialize the data type by calling an initializer of that type that takes a formatted","type":"text"},{"text":" ","type":"text"},{"text":"instance and a parse strategy as parameters. For example, you can create a ","type":"text"},{"code":"Decimal","type":"codeVoice"},{"text":" from a","type":"text"},{"text":" ","type":"text"},{"text":"formatted string with the initializer ","type":"text"},{"code":"Decimal.init(_:format:lenient:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Create a parse strategy and call its ","type":"text"},{"code":"parse(_:)","type":"codeVoice"},{"text":" method on one or more formatted instances.","type":"text"}]}]}]}],"kind":"content"}],"variants":[{"path