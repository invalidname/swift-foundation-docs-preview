:"text"},{"code":"Jan","type":"codeVoice"},{"text":", ","type":"text"},{"code":"2000","type":"codeVoice"},{"text":", ","type":"text"},{"code":"00:00:00","type":"codeVoice"},{"text":", ","type":"text"},{"code":"GMT","type":"codeVoice"},{"text":". Note that missing fields may result in an invalid date or time. Other values in the ","type":"text"},{"code":"DateComponents","type":"codeVoice"},{"text":" are ignored.","type":"text"}],"type":"topic","title":"DateComponents.HTTPFormatStyle","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPFormatStyle","kind":"identifier"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","url":"\/documentation\/foundationessentials\/datecomponents\/httpformatstyle"},"doc://FoundationEssentials/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/FoundationEssentials\/SH","type":"unresolvable"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/iso8601-2hxhp":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"iso8601","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV18ISO8601FormatStyleV","text":"ISO8601FormatStyle","kind":"typeIdentifier"}],"title":"iso8601","kind":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/iso8601-2hxhp","abstract":[],"type":"topic","role":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-2hxhp","conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Date.ISO8601FormatStyle"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]}},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/FormatInput":{"abstract":[{"type":"text","text":"The type this format style accepts as input."}],"kind":"symbol","required":true,"url":"\/documentation\/foundationessentials\/formatstyle\/formatinput","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FormatInput","kind":"identifier"}],"title":"FormatInput","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/locale(_:)":{"abstract":[{"text":"Modifies the format style to use the specified locale.","type":"text"}],"defaultImplementations":1,"kind":"symbol","required":true,"url":"\/documentation\/foundationessentials\/formatstyle\/locale(_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"locale","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Locale","preciseIdentifier":"s:20FoundationEssentials6LocaleV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"}],"title":"locale(_:)","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/locale(_:)"},"doc://FoundationEssentials/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SQ"},"doc://FoundationEssentials/SE":{"title":"Swift.Encodable","identifier":"doc:\/\/FoundationEssentials\/SE","type":"unresolvable"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/FormatOutput":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"text":"FormatOutput","kind":"identifier"}],"title":"FormatOutput","kind":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/formatoutput","abstract":[{"text":"The type