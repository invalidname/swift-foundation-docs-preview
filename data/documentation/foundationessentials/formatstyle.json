umentation\/foundationessentials\/discreteformatstyle","role":"symbol","type":"topic","abstract":[{"type":"text","text":"A format style that transforms a continuous input into a discrete output and provides"},{"type":"text","text":" "},{"type":"text","text":"information about its discretization boundaries."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DiscreteFormatStyle"}]},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/locale(_:)":{"title":"locale(_:)","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/locale(_:)","defaultImplementations":1,"abstract":[{"type":"text","text":"Modifies the format style to use the specified locale."}],"type":"topic","role":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/locale(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"locale"},{"kind":"text","text":"("},{"preciseIdentifier":"s:20FoundationEssentials6LocaleV","kind":"typeIdentifier","text":"Locale"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"}],"required":true},"doc://FoundationEssentials/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SH"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/FormatOutput":{"url":"\/documentation\/foundationessentials\/formatstyle\/formatoutput","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput","type":"topic","required":true,"abstract":[{"text":"The type this format style produces as output.","type":"text"}],"role":"symbol","kind":"symbol","title":"FormatOutput","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FormatOutput","kind":"identifier"}]},"doc://FoundationEssentials/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SQ"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/format(_:)":{"kind":"symbol","type":"topic","required":true,"url":"\/documentation\/foundationessentials\/formatstyle\/format(_:)","title":"format(_:)","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)","abstract":[{"type":"text","text":"Formats a value, using this style."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"format"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"FormatInput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"FormatOutput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa"}],"role":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials":{"abstract":[{"type":"text","text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app."}],"kind":"symbol","role":"collection","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","url":"\/documentation\/foundationessentials","type":"topic","title":"FoundationEssentials"},"doc://FoundationEssentials/documentation/FoundationEssentials/Date/ISO8601FormatStyle":{"kind":"symbol","title":"Date.ISO8601FormatStyle","type":"topic","role":"symbol","url":"\/documentation\/foundationessentials\/date\/iso8601formatstyle","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ISO8601FormatStyle"}],"navigatorTitle":[{"kind":"identifier","text":"ISO8601FormatStyle"}],"abstract":[{"type":"text","text":"A type that converts between dates and their ISO-8601 string representations."}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle"}}}