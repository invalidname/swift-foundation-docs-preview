nEssentials/FormatStyle/http-3z94y":{"kind":"symbol","abstract":[],"title":"http","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-3z94y","url":"\/documentation\/foundationessentials\/formatstyle\/http-3z94y","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"http","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DateComponents","preciseIdentifier":"s:20FoundationEssentials14DateComponentsV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"HTTPFormatStyle","preciseIdentifier":"s:20FoundationEssentials14DateComponentsV15HTTPFormatStyleV","kind":"typeIdentifier"}],"type":"topic","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"DateComponents.HTTPFormatStyle"},{"text":".","type":"text"}]},"role":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/ParseableFormatStyle":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ParseableFormatStyle"}],"abstract":[{"type":"text","text":"A type that can convert a given input data type into a representation in an output type."}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle","title":"ParseableFormatStyle","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ParseableFormatStyle"}],"kind":"symbol","url":"\/documentation\/foundationessentials\/parseableformatstyle","type":"topic"},"doc://FoundationEssentials/SE":{"title":"Swift.Encodable","type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SE"},"doc://FoundationEssentials/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SH"},"doc