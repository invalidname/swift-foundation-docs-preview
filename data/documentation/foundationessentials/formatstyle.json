{"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"title":"Performing formatting","anchor":"Performing-formatting","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)"]},{"title":"Setting style locale","anchor":"Setting-style-locale","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/locale(_:)"]},{"title":"Declaring input and output types","anchor":"Declaring-input-and-output-types","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput"]},{"title":"Applying date and time styles","anchor":"Applying-date-and-time-styles","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-1jmw1","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-2hxhp","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-26iub","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-3z94y"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatStyle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"FormatInput","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"FormatOutput","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa"},{"kind":"text","text":"> : "},{"kind":"typeIdentifier","text":"Decodable","preciseIdentifier":"s:Se"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Encodable","preciseIdentifier":"s:SE"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Types conforming to the "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":" protocol take their input type and produce formatted"},{"type":"text","text":" "},{"type":"text","text":"instances of their output type. The formatting process accounts for locale-specific conventions,"},{"type":"text","text":" "},{"type":"text","text":"like grouping and separators for numbers, and presentation of units for measurements. The format"},{"type":"text","text":" "},{"type":"text","text":"styles Foundation provides produce their output as "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or "},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":" instances. You"},{"type":"text","text":" "},{"type":"text","text":"can also create custom styles that format their output as any type, like XML or JSON "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"an image."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There are two basic approaches to using a "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Create an instance of a type that conforms to ","type":"text"},{"type":"codeVoice","code":"FormatStyle"},{"text":" and apply it to one or more","type":"text"},{"text":" ","type":"text"},{"text":"instances of the input type, by calling the style’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)","isActive":true},{"text":" method. Use this when you","type":"text"},{"text":" ","type":"text"},{"text":"want to customize a style once and apply it repeatedly to many instances.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pass an instance of a type that conforms to ","type":"text"},{"type":"codeVoice","code":"FormatStyle"},{"text":" to the data type’s ","type":"text"},{"type":"codeVoice","code":"formatted(_:)"},{"text":" ","type":"text"},{"text":"method, which takes the style as a parameter. Use this for one-off formatting scenarios, or","type":"text"},{"text":" ","type":"text"},{"text":"when you want to apply different format styles to the same data value. For the simplest cases,","type":"text"},{"text":" ","type":"text"},{"text":"most types that support formatting also have a no-argument ","type":"text"},{"type":"codeVoice","code":"formatted()"},{"text":" method that applies a","type":"text"},{"text":" ","type":"text"},{"text":"locale-appropriate default format style.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Foundation provides format styles for integers ("},{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":"), floating-point numbers"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"FloatingPointFormatStyle"},{"type":"text","text":"), decimals ("},{"type":"codeVoice","code":"Decimal.FormatStyle"},{"type":"text","text":"), measurements"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Measurement.FormatStyle"},{"type":"text","text":"), arrays ("},{"type":"codeVoice","code":"ListFormatStyle"},{"type":"text","text":"), and more. The numeric format styles"},{"type":"text","text":" "},{"type":"text","text":"also provide supporting format styles to format currency and percent values, like"},{"type":"text","text":" "},{"type":"codeVoice","code":"IntegerFormatStyle.Currency"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Decimal.FormatStyle.Percent"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Modifying a format style","anchor":"Modifying-a-format-style","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Format styles include modifier methods that return a new format style with an adjusted behavior."},{"type":"text","text":" "},{"type":"text","text":"The following example creates an "},{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":", then applies modifiers to round values"},{"type":"text","text":" "},{"type":"text","text":"down to the nearest 1,000 and applies formatting appropriate to the "},{"type":"codeVoice","code":"fr_FR"},{"type":"text","text":" locale:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let style = IntegerFormatStyle<Int>()","    .rounded(rule: .down, increment: 1000)","    .locale(Locale(identifier: \"fr_FR\"))","let rounded = 123456789.formatted(style) \/\/ \"123 456 000\""]},{"inlineContent":[{"text":"Foundation caches identical instances of a customized format style, so you don’t need to pass","type":"text"},{"text":" ","type":"text"},{"text":"format style instances around unrelated parts of your app’s source code.","type":"text"}],"type":"paragraph"},{"text":"Accessing static instances","anchor":"Accessing-static-instances","level":3,"type":"heading"},{"inlineContent":[{"text":"Types that conform to ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" typically extend the base protocol with type properties or","type":"text"},{"text":" ","type":"text"},{"text":"type methods to provide convenience instances. These are available for use in a data type’s","type":"text"},{"text":" ","type":"text"},{"code":"formatted(_:)","type":"codeVoice"},{"text":" method when the format style’s input type matches the data type. For example,","type":"text"},{"text":" ","type":"text"},{"text":"the various numeric format styles define ","type":"text"},{"code":"number","type":"codeVoice"},{"text":" properties with generic constraints to match","type":"text"},{"text":" ","type":"text"},{"text":"the different numeric types (","type":"text"},{"code":"Double","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Float16","type":"codeVoice"},{"text":", and so on).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To see how this works, consider this example of a default formatter for an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" value. Because","type":"text"},{"text":" ","type":"text"},{"code":"123456789","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"BinaryInteger","type":"codeVoice"},{"text":", its ","type":"text"},{"code":"formatted(_:)","type":"codeVoice"},{"text":" method accepts an ","type":"text"},{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":" ","type":"text"},{"text":"parameter. The following example shows the style’s default behavior in the ","type":"text"},{"code":"en_US","type":"codeVoice"},{"text":" locale.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let formatted = 123456789.formatted(IntegerFormatStyle()) \/\/ \"123,456,789\""]},{"inlineContent":[{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":" extends ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" with multiple type properties called ","type":"text"},{"code":"number","type":"codeVoice"},{"text":", each","type":"text"},{"text":" ","type":"text"},{"text":"of which is an ","type":"text"},{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":" instance; these properties differ by which","type":"text"},{"text":" ","type":"text"},{"code":"BinaryInteger","type":"codeVoice"},{"text":"-conforming type they take as input. Since one of these statically-defined","type":"text"},{"text":" ","type":"text"},{"text":"properties takes ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" as its input, you can use this type property instead of instantiating a","type":"text"},{"text":" ","type":"text"},{"text":"new format style instance. Using dot notation to access this property on the inferred","type":"text"},{"text":" ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" makes the call point much easier to read, as seen here:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let formatted = 123456789.formatted(.number) \/\/ \"123,456,789\""]},{"inlineContent":[{"text":"Furthermore, since you can customize these statically-accessed format style instances, you can","type":"text"},{"text":" ","type":"text"},{"text":"rewrite the example from the previous section without instantiating a new ","type":"text"},{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"like this:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let rounded = 123456789.formatted(.number","    .rounded(rule: .down, increment: 1000)","    .locale(Locale(identifier: \"fr_FR\"))) \/\/ \"123 456 000\""]},{"text":"Parsing with a format style","anchor":"Parsing-with-a-format-style","level":3,"type":"heading"},{"inlineContent":[{"text":"To perform the opposite conversion — from formatted output type to input data type — some","type":"text"},{"text":" ","type":"text"},{"text":"format styles provide a corresponding ","type":"text"},{"code":"ParseStrategy","type":"codeVoice"},{"text":" type. These format styles typically expose","type":"text"},{"text":" ","type":"text"},{"text":"an instance of this type as a variable, called ","type":"text"},{"code":"parseStrategy","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can use a ","type":"text"},{"code":"ParseStrategy","type":"codeVoice"},{"text":" one of two ways:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Initialize the data type by calling an initializer of that type that takes a formatted","type":"text"},{"text":" ","type":"text"},{"text":"instance and a parse strategy as parameters. For example, you can create a ","type":"text"},{"type":"codeVoice","code":"Decimal"},{"text":" from a","type":"text"},{"text":" ","type":"text"},{"text":"formatted string with the initializer ","type":"text"},{"type":"codeVoice","code":"Decimal.init(_:format:lenient:)"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Create a parse strategy and call its ","type":"text"},{"type":"codeVoice","code":"parse(_:)"},{"text":" method on one or more formatted instances.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"abstract":[{"text":"A type that converts a given data type into a representation in another type, such as a string.","type":"text"}],"seeAlsoSections":[{"title":"Data formatting","anchor":"Data-formatting","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/formatstyle"]}],"sections":[],"relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH"]},{"type":"inheritedBy","title":"Inherited By","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"]},{"type":"conformingTypes","title":"Conforming Types","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/ISO8601FormatStyle"]}],"metadata":{"platforms":[{"introducedAt":"15.0","name":"iOS","deprecated":false,"beta":false,"unavailable":false},{"introducedAt":"15.0","name":"iPadOS","deprecated":false,"beta":false,"unavailable":false},{"introducedAt":"15.0","name":"Mac Catalyst","deprecated":false,"beta":false,"unavailable":false},{"introducedAt":"12.0","name":"macOS","deprecated":false,"beta":false,"unavailable":false},{"introducedAt":"15.0","name":"tvOS","deprecated":false,"beta":false,"unavailable":false},{"introducedAt":"8.0","name":"watchOS","deprecated":false,"beta":false,"unavailable":false}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FormatStyle","kind":"identifier"}],"externalID":"s:20FoundationEssentials11FormatStyleP","title":"FormatStyle","navigatorTitle":[{"text":"FormatStyle","kind":"identifier"}],"role":"symbol","roleHeading":"Protocol","symbolKind":"protocol","modules":[{"name":"FoundationEssentials"}]},"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/http-26iub":{"url":"\/documentation\/foundationessentials\/formatstyle\/http-26iub","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"http","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdent