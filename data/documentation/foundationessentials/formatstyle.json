TTPFormatStyle","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","type":"topic","abstract":[{"text":"Converts ","type":"text"},{"code":"DateComponents","type":"codeVoice"},{"text":" into RFC 9110-compatible “HTTP date” ","type":"text"},{"code":"String","type":"codeVoice"},{"text":", and parses in the reverse direction.","type":"text"},{"text":" ","type":"text"},{"text":"This parser does not do validation on the individual values of the components. An optional date can be created from the result using ","type":"text"},{"code":"Calendar(identifier: .gregorian).date(from: ...)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"When formatting, missing or invalid fields are filled with default values: ","type":"text"},{"code":"Sun","type":"codeVoice"},{"text":", ","type":"text"},{"code":"01","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Jan","type":"codeVoice"},{"text":", ","type":"text"},{"code":"2000","type":"codeVoice"},{"text":", ","type":"text"},{"code":"00:00:00","type":"codeVoice"},{"text":", ","type":"text"},{"code":"GMT","type":"codeVoice"},{"text":". Note that missing fields may result in an invalid date or time. Other values in the ","type":"text"},{"code":"DateComponents","type":"codeVoice"},{"text":" are ignored.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPFormatStyle"}],"url":"\/documentation\/foundationessentials\/datecomponents\/httpformatstyle","navigatorTitle":[{"kind":"identifier","text":"HTTPFormatStyle"}],"kind":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/FormatOutput":{"required":true,"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatOutput"}],"url":"\/documentation\/foundationessentials\/formatstyle\/formatoutput","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput","title":"FormatOutput","type":"topic","abstract":[{"type":"text","text":"The type this format style produces as output."}]},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/http-3z94y":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-3z94y","role":"symbol","title":"http","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"http"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"DateComponents","preciseIdentifier":"s:20FoundationEssentials14DateComponentsV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"HTTPFormatStyle","preciseIdentifier":"s:20FoundationEssentials14DateComponentsV15HTTPFormatStyleV"}],"type":"topic","conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"DateComponents.HTTPFormatStyle","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"kind":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/http-3z94y","abstract":[]},"doc://FoundationEssentials/documentation/FoundationEssentials/Date/ISO8601FormatStyle":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle","role":"symbol","title":"Date.ISO8601FormatStyle","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ISO8601FormatStyle"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"ISO8601FormatStyle"}],"kind":"symbol","url":"\/documentation\/foundationessentials\/date\/iso8601formatstyle","abstract":[{"type":"text","text":"A type that converts between dates and their ISO-8601 string representations."}]},"doc://FoundationEssentials/documentation/FoundationEssentials/ParseableFormatStyle":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle","role":"symbol","title":"ParseableFormatStyle","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"ParseableFormatStyle","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"ParseableFormatStyle","kind":"identifier"}],"url":"\/documentation\/foundationessentials\/parseableformatstyle","kind":"symbol","abstract":[{"type":"text","text":"A type that can convert a given input data type into a representation in an output type."}]},"doc://FoundationEssentials/documentation/FoundationEssentials/Date/HTTPFormatStyle":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","role":"symbol","title":"Date.HTTPFormatStyle","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPFormatStyle"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"HTTPFormatStyle"}],"kind":"symbol","url":"\/documentation\/foundationessentials\/date\/httpformatstyle","abstract":[{"text":"Options for generating and parsing string representations of dates following the HTTP date format from ","type":"text"},{"identifier":"https:\/\/www.rfc-editor.org\/rfc\/rfc9110.html#http.date","isActive":true,"type":"reference"},{"text":".","type":"text"}]},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/iso8601-1jmw1":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-1jmw1","role":"symbol","title":"iso8601","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"iso8601"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"DateComponents","preciseIdentifier":"s:20FoundationEssentials14DateComponentsV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"ISO8601FormatStyle","preciseIdentifier":"s:20FoundationEssentials14DateComponentsV18ISO8601FormatStyleV"}],"type":"topic","conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"DateComponents.ISO8601FormatStyle","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"kind":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/iso8601-1jmw1","abstract":[]},"doc://FoundationEssentials/documentation/FoundationEssentials/DateComponents/ISO8601FormatStyle":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/ISO8601FormatStyle","role":"symbol","title":"DateComponents.ISO8601FormatStyle","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ISO8601FormatStyle"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"ISO8601FormatStyle"}],"kind":"symbol","url":"\/documentation\/foundationessentials\/datecomponents\/iso8601formatstyle","abstract":[{"text":"Options for generating and parsing string representations of dates following the ISO 8601 standard.","type":"text"}]},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/iso8601-2hxhp":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-2hxhp","role":"symbol","title":"iso8601","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"iso8601"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"ISO8601FormatStyle","preciseIdentifier":"s:20FoundationEssentials4DateV18ISO8601FormatStyleV"}],"type":"topic","conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Date.ISO8601FormatStyle","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"kind":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/iso8601-2hxhp","abstract":[]},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/locale(_:)":{"title":"locale(_:)","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/locale(_:)","defaultImplementations":1,"type":"topic","abstract":[{"text":"Modifies the format style to use the specified locale.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"locale"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Locale","preciseIdentifier":"s:20FoundationEssentials6LocaleV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"}],"url":"\/documentation\/foundationessentials\/formatstyle\/locale(_:)","kind":"symbol","required":true},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle":{"role":"symbol","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatStyle"}],"url":"\/documentation\/foundationessentials\/formatstyle","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","title":"FormatStyle","type":"topic","abstract":[{"text":"A type that converts a given data type into a representation in another type, such as a string.","type":"text"}],"navigatorTitle":[{"text":"FormatStyle","kind":"identifier"}]},"doc://FoundationEssentials/SE":{"title":"Swift.Encodable","type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SE"},"doc://FoundationEssentials/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SQ"}}}