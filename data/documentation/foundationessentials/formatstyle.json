nEssentials/documentation/FoundationEssentials/FormatStyle/format(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"format","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"FormatInput","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"FormatOutput","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa"}],"url":"\/documentation\/foundationessentials\/formatstyle\/format(_:)","kind":"symbol","abstract":[{"text":"Formats a value, using this style.","type":"text"}],"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)","required":true,"role":"symbol","title":"format(_:)"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/locale(_:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"locale"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials6LocaleV","text":"Locale"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"}],"title":"locale(_:)","defaultImplementations":1,"type":"topic","abstract":[{"text":"Modifies the format style to use the specified locale.","type":"text"}],"url":"\/documentation\/foundationessentials\/formatstyle\/locale(_:)","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/locale(_:)","required":true,"kind":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/iso8601-1jmw1":{"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-1jmw1","role":"symbol","conformance":{"constraints":[{"type":"code