{"metadata":{"modules":[{"name":"FoundationEssentials"}],"title":"FormatStyle","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FormatStyle","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"FormatStyle","kind":"identifier"}],"roleHeading":"Protocol","platforms":[{"beta":false,"name":"iOS","deprecated":false,"introducedAt":"15.0","unavailable":false},{"beta":false,"name":"iPadOS","deprecated":false,"introducedAt":"15.0","unavailable":false},{"beta":false,"name":"Mac Catalyst","deprecated":false,"introducedAt":"15.0","unavailable":false},{"beta":false,"name":"macOS","deprecated":false,"introducedAt":"12.0","unavailable":false},{"beta":false,"name":"tvOS","deprecated":false,"introducedAt":"15.0","unavailable":false},{"beta":false,"name":"watchOS","deprecated":false,"introducedAt":"8.0","unavailable":false}],"externalID":"s:20FoundationEssentials11FormatStyleP","symbolKind":"protocol"},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)"],"anchor":"Performing-formatting","title":"Performing formatting"},{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/locale(_:)"],"anchor":"Setting-style-locale","title":"Setting style locale"},{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput"],"anchor":"Declaring-input-and-output-types","title":"Declaring input and output types"},{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-26iub","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-3z94y","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-1jmw1","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-2hxhp"],"anchor":"Type-Properties","title":"Type Properties","generated":true}],"abstract":[{"text":"A type that converts a given data type into a representation in another type, such as a string.","type":"text"}],"relationshipsSections":[{"identifiers":["doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH"],"title":"Inherits From","type":"inheritsFrom","kind":"relationships"},{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"title":"Inherited By","type":"inheritedBy","kind":"relationships"},{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/ISO8601FormatStyle"],"title":"Conforming Types","type":"conformingTypes","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatStyle"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","kind":"typeIdentifier","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","text":"FormatInput"},{"kind":"text","text":", "},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa","kind":"typeIdentifier","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput","text":"FormatOutput"},{"kind":"text","text":"> : "},{"preciseIdentifier":"s:Se","kind":"typeIdentifier","text":"Decodable"},{"kind":"text","text":", "},{"preciseIdentifier":"s:SE","kind":"typeIdentifier","text":"Encodable"},{"kind":"text","text":", "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Types conforming to the "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":" protocol take their input type and produce formatted"},{"type":"text","text":" "},{"type":"text","text":"instances of their output type. The formatting process accounts for locale-specific conventions,"},{"type":"text","text":" "},{"type":"text","text":"like grouping and separators for numbers, and presentation of units for measurements. The format"},{"type":"text","text":" "},{"type":"text","text":"styles Foundation provides produce their output as "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or "},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":" instances. You"},{"type":"text","text":" "},{"type":"text","text":"can also create custom styles that format their output as any type, like XML or JSON "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"an image."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There are two basic approaches to using a "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Create an instance of a type that conforms to ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" and apply it to one or more","type":"text"},{"text":" ","type":"text"},{"text":"instances of the input type, by calling the style’s ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)"},{"text":" method. Use this when you","type":"text"},{"text":" ","type":"text"},{"text":"want to customize a style once and apply it repeatedly to many instances.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pass an instance of a type that conforms to ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" to the data type’s ","type":"text"},{"code":"formatted(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"method, which takes the style as a parameter. Use this for one-off formatting scenarios, or","type":"text"},{"text":" ","type":"text"},{"text":"when you want to apply different format styles to the same data value. For the simplest cases,","type":"text"},{"text":" ","type":"text"},{"text":"most types that support formatting also have a no-argument ","type":"text"},{"code":"formatted()","type":"codeVoice"},{"text":" method that applies a","type":"text"},{"text":" ","type":"text"},{"text":"locale-appropriate default format style.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Foundation provides format styles for integers ("},{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":"), floating-point numbers"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"FloatingPointFormatStyle"},{"type":"text","text":"), decimals ("},{"type":"codeVoice","code":"Decimal.FormatStyle"},{"type":"text","text":"), measurements"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Measurement.FormatStyle"},{"type":"text","text":"), arrays ("},{"type":"codeVoice","code":"ListFormatStyle"},{"type":"text","text":"), and more. The numeric format styles"},{"type":"text","text":" "},{"type":"text","text":"also provide supporting format styles to format currency and percent values, like"},{"type":"text","text":" "},{"type":"codeVoice","code":"IntegerFormatStyle.Currency"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Decimal.FormatStyle.Percent"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"text":"Modifying a format style","anchor":"Modifying-a-format-style","type":"heading"},{"inlineContent":[{"type":"text","text":"Format styles include modifier methods that return a new format style with an adjusted behavior."},{"type":"text","text":" "},{"type":"text","text":"The following example creates an "},{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":", then applies modifiers to round values"},{"type":"text","text":" "},{"type":"text","text":"down to the nearest 1,000 and applies formatting appropriate to the "},{"type":"codeVoice","code":"fr_FR"},{"type":"text","text":" locale:"}],"type":"paragraph"},{"code":["let style = IntegerFormatStyle<Int>()","    .rounded(rule: .down, increment: 1000)","    .locale(Locale(identifier: \"fr_FR\"))","let rounded = 123456789.formatted(style) \/\/ \"123 456 000\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Foundation caches identical instances of a customized format style, so you don’t need to pass"},{"type":"text","text":" "},{"type":"text","text":"format style instances around unrelated parts of your app’s source code."}],"type":"paragraph"},{"level":3,"text":"Accessing static instances","anchor":"Accessing-static-instances","type":"heading"},{"inlineContent":[{"type":"text","text":"Types that conform to "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":" typically extend the base protocol with type properties or"},{"type":"text","text":" "},{"type":"text","text":"type methods to provide convenience instances. These are available for use in a data type’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"formatted(_:)"},{"type":"text","text":" method when the format style’s input type matches the data type. For example,"},{"type":"text","text":" "},{"type":"text","text":"the various numeric format styles define "},{"type":"codeVoice","code":"number"},{"type":"text","text":" properties with generic constraints to match"},{"type":"text","text":" "},{"type":"text","text":"the different numeric types ("},{"type":"codeVoice","code":"Double"},{"type":"text","text":", "},{"type":"codeVoice","code":"Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"Float16"},{"type":"text","text":", and so on)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To see how this works, consider this example of a default formatter for an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" value. Because"},{"type":"text","text":" "},{"type":"codeVoice","code":"123456789"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"BinaryInteger"},{"type":"text","text":", its "},{"type":"codeVoice","code":"formatted(_:)"},{"type":"text","text":" method accepts an "},{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":" "},{"type":"text","text":"parameter. The following example shows the style’s default behavior in the "},{"type":"codeVoice","code":"en_US"},{"type":"text","text":" locale."}],"type":"paragraph"},{"code":["let formatted = 123456789.formatted(IntegerFormatStyle()) \/\/ \"123,456,789\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":" extends "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":" with multiple type properties called "},{"type":"codeVoice","code":"number"},{"type":"text","text":", each"},{"type":"text","text":" "},{"type":"text","text":"of which is an "},{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":" instance; these properties differ by which"},{"type":"text","text":" "},{"type":"codeVoice","code":"BinaryInteger"},{"type":"text","text":"-conforming type they take as input. Since one of these statically-defined"},{"type":"text","text":" "},{"type":"text","text":"properties takes "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" as its input, you can use this type property instead of instantiating a"},{"type":"text","text":" "},{"type":"text","text":"new format style instance. Using dot notation to access this property on the inferred"},{"type":"text","text":" "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":" makes the call point much easier to read, as seen here:"}],"type":"paragraph"},{"code":["let formatted = 123456789.formatted(.number) \/\/ \"123,456,789\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Furthermore, since you can customize these statically-accessed format style instances, you can"},{"type":"text","text":" "},{"type":"text","text":"rewrite the example from the previous section without instantiating a new "},{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"like this:"}],"type":"paragraph"},{"code":["let rounded = 123456789.formatted(.number","    .rounded(rule: .down, increment: 1000)","    .locale(Locale(identifier: \"fr_FR\"))) \/\/ \"123 456 000\""],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Parsing with a format style","anchor":"Parsing-with-a-format-style","type":"heading"},{"inlineContent":[{"type":"text","text":"To perform the opposite conversion — from formatted output type to input data type — some"},{"type":"text","text":" "},{"type":"text","text":"format styles provide a corresponding "},{"type":"codeVoice","code":"ParseStrategy"},{"type":"text","text":" type. These format styles typically expose"},{"type":"text","text":" "},{"type":"text","text":"an instance of this type as a variable, called "},{"type":"codeVoice","code":"parseStrategy"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can use a "},{"type":"codeVoice","code":"ParseStrategy"},{"type":"text","text":" one of two ways:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Initialize the data type by calling an initializer of that type that takes a formatted","type":"text"},{"text":" ","type":"text"},{"text":"instance and a parse strategy as parameters. For example, you can create a ","type":"text"},{"code":"Decimal","type":"codeVoice"},{"text":" from a","type":"text"},{"text":" ","type":"text"},{"text":"formatted string with the initializer ","type":"text"},{"code":"Decimal.init(_:format:lenient:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Create a parse strategy and call its ","type":"text"},{"code":"parse(_:)","type":"codeVoice"},{"text":" method on one or more formatted instances.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"anchor":"Data-formatting","title":"Data formatting","generated":true}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/formatstyle"]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/http-26iub":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"http","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV15HTTPFormatStyleV","text":"HTTPFormatStyle","kind":"typeIdentifier"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-26iub","role":"symbol","kind":"symbol","abstract":[],"url":"\/documentation\/foundationessentials\/formatstyle\/http-26iub","type":"topic","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Date.HTTPFormatStyle","type":"codeVoice"},{"text":".","type":"text"}]},"title":"http"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatStyle"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A type that converts a given data type into a representation in another type, such as a string."}],"url":"\/documentation\/foundationessentials\/formatstyle","title":"FormatStyle","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","navigatorTitle":[{"kind":"identifier","text":"FormatStyle"}],"type":"topic"},"doc://FoundationEssentials/documentation/FoundationEssentials/Date/HTTPFormatStyle":{"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","url":"\/documentation\/foundationessentials\/date\/httpformatstyle","kind":"symbol","title":"Date.HTTPFormatStyle","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPFormatStyle"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"HTTPFormatStyle"}],"abstract":[{"type":"text","text":"Options for generating and parsing string representations of dates following the HTTP date format from "},{"isActive":true,"type":"reference","identifier":"https:\/\/www.rfc-editor.org\/rfc\/rfc9110.html#http.date"},{"type":"text","text":"."}]},"doc://FoundationEssentials/documentation/FoundationEssentials/DateComponents/ISO8601FormatStyle":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ISO8601FormatStyle"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/ISO8601FormatStyle","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Options for generating and parsing string representations of dates following the ISO 8601 standard."}],"navigatorTitle":[{"kind":"identifier","text":"ISO8601FormatStyle"}],"url":"\/documentation\/foundationessentials\/datecomponents\/iso8601formatstyle","type":"topic","title":"DateComponents.ISO8601FormatStyle"},"doc://FoundationEssentials/documentation/FoundationEssentials/ParseableFormatStyle":{"abstract":[{"text":"A type that can convert a given input data type into a representation in an output type.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"ParseableFormatStyle"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ParseableFormatStyle"}],"url":"\/documentation\/foundationessentials\/parseableformatstyle","type":"topic","title":"ParseableFormatStyle"},"doc://FoundationEssentials/documentation/FoundationEssentials/DateComponents/HTTPFormatStyle":{"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPFormatStyle"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","type":"topic","url":"\/documentation\/foundationessentials\/datecomponents\/httpformatstyle","navigatorTitle":[{"kind":"identifier","text":"HTTPFormatStyle"}],"abstract":[{"type":"text","text":"Converts "},{"type":"codeVoice","code":"DateComponents"},{"type":"text","text":" into RFC 9110-compatible “HTTP date” "},{"type":"codeVoice","code":"String"},{"type":"text","text":", and parses in the reverse direction."},{"type":"text","text":" "},{"type":"text","text":"This parser does not do validation on the individual values of the components. An optional date can be created from the result using "},{"type":"codeVoice","code":"Calendar(identifier: .gregorian).date(from: ...)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"When formatting, missing or invalid fields are filled with default values: "},{"type":"codeVoice","code":"Sun"},{"type":"text","text":", "},{"type":"codeVoice","code":"01"},{"type":"text","text":", "},{"type":"codeVoice","code":"Jan"},{"type":"text","text":", "},{"type":"codeVoice","code":"2000"},{"type":"text","text":", "},{"type":"codeVoice","code":"00:00:00"},{"type":"text","text":", "},{"type":"codeVoice","code":"GMT"},{"type":"text","text":". Note that missing fields may result in an invalid date or time. Other values in the "},{"type":"codeVoice","code":"DateComponents"},{"type":"text","text":" are ignored."}],"title":"DateComponents.HTTPFormatStyle"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/FormatInput":{"kind":"symbol","type":"topic","required":true,"url":"\/documentation\/foundationessentials\/formatstyle\/formatinput","title":"FormatInput","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","abstract":[{"type":"text","text":"The type this format style accepts as input."}],"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatInput"}],"role":"symbol"},"doc://FoundationEssentials/Se":{"title":"Swift.Decodable","type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/Se"},"https://www.rfc-editor.org/rfc/rfc9110.html#http.date":{"title":"RFC 9110 § 5.6.7","url":"https:\/\/www.rfc-editor.org\/rfc\/rfc9110.html#http.date","type":"link","titleInlineContent":[{"text":"RFC 9110 § 5.6.7","type":"text"}],"identifier":"https:\/\/www.rfc-editor.org\/rfc\/rfc9110.html#http.date"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/iso8601-1jmw1":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"iso8601","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DateComponents","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials14DateComponentsV"},{"text":".","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials14DateComponentsV18ISO8601FormatStyleV","text":"ISO8601FormatStyle","kind":"typeIdentifier"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-1jmw1","role":"symbol","kind":"symbol","abstract":[],"url":"\/documentation\/foundationessentials\/formatstyle\/iso8601-1jmw1","type":"topic","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Self"},{"text":" is ","type":"text"},{"code":"DateComponents.ISO8601FormatStyle","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"title":"iso8601"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/iso8601-2hxhp":{"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Date.ISO8601FormatStyle"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"abstract":[],"kind":"symbol","role":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-2hxhp","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text