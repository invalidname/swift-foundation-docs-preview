{"metadata":{"role":"symbol","platforms":[{"name":"iOS","introducedAt":"15.0","unavailable":false,"beta":false,"deprecated":false},{"name":"iPadOS","introducedAt":"15.0","unavailable":false,"beta":false,"deprecated":false},{"name":"Mac Catalyst","introducedAt":"15.0","unavailable":false,"beta":false,"deprecated":false},{"name":"macOS","introducedAt":"12.0","unavailable":false,"beta":false,"deprecated":false},{"name":"tvOS","introducedAt":"15.0","unavailable":false,"beta":false,"deprecated":false},{"name":"watchOS","introducedAt":"8.0","unavailable":false,"beta":false,"deprecated":false}],"navigatorTitle":[{"kind":"identifier","text":"FormatStyle"}],"title":"FormatStyle","externalID":"s:20FoundationEssentials11FormatStyleP","roleHeading":"Protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatStyle"}],"modules":[{"name":"FoundationEssentials"}],"symbolKind":"protocol"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Performing formatting","anchor":"Performing-formatting","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)"]},{"title":"Setting style locale","anchor":"Setting-style-locale","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/locale(_:)"]},{"title":"Declaring input and output types","anchor":"Declaring-input-and-output-types","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput"]},{"title":"Type Properties","generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-26iub","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-3z94y","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-1jmw1","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-2hxhp"]}],"variants":[{"paths":["\/documentation\/foundationessentials\/formatstyle"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatStyle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","text":"FormatInput"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"FormatOutput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput"},{"kind":"text","text":"> : "},{"kind":"typeIdentifier","text":"Decodable","preciseIdentifier":"s:Se"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Encodable","preciseIdentifier":"s:SE"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Types conforming to the "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":" protocol take their input type and produce formatted"},{"type":"text","text":" "},{"type":"text","text":"instances of their output type. The formatting process accounts for locale-specific conventions,"},{"type":"text","text":" "},{"type":"text","text":"like grouping and separators for numbers, and presentation of units for measurements. The format"},{"type":"text","text":" "},{"type":"text","text":"styles Foundation provides produce their output as "},{"type":"codeVoice","code":"String"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"AttributedString"},{"text":" instances. You","type":"text"},{"text":" ","type":"text"},{"text":"can also create custom styles that format their output as any type, like XML or JSON ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"text":"an image.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are two basic approaches to using a "},{"code":"FormatStyle","type":"codeVoice"},{"type":"text","text":":"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Create an instance of a type that conforms to "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":" and apply it to one or more"},{"type":"text","text":" "},{"type":"text","text":"instances of the input type, by calling the style’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)"},{"type":"text","text":" method. Use this when you"},{"type":"text","text":" "},{"type":"text","text":"want to customize a style once and apply it repeatedly to many instances."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Pass an instance of a type that conforms to ","type":"text"},{"type":"codeVoice","code":"FormatStyle"},{"text":" to the data type’s ","type":"text"},{"type":"codeVoice","code":"formatted(_:)"},{"text":" ","type":"text"},{"text":"method, which takes the style as a parameter. Use this for one-off formatting scenarios, or","type":"text"},{"text":" ","type":"text"},{"text":"when you want to apply different format styles to the same data value. For the simplest cases,","type":"text"},{"text":" ","type":"text"},{"text":"most types that support formatting also have a no-argument ","type":"text"},{"type":"codeVoice","code":"formatted()"},{"text":" method that applies a","type":"text"},{"text":" ","type":"text"},{"text":"locale-appropriate default format style.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Foundation provides format styles for integers ("},{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":"), floating-point numbers"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"FloatingPointFormatStyle"},{"type":"text","text":"), decimals ("},{"type":"codeVoice","code":"Decimal.FormatStyle"},{"type":"text","text":"), measurements"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Measurement.FormatStyle"},{"type":"text","text":"), arrays ("},{"type":"codeVoice","code":"ListFormatStyle"},{"type":"text","text":"), and more. The numeric format styles"},{"type":"text","text":" "},{"type":"text","text":"also provide supporting format styles to format currency and percent values, like"},{"type":"text","text":" "},{"type":"codeVoice","code":"IntegerFormatStyle.Currency"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Decimal.FormatStyle.Percent"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Modifying a format style","level":3,"anchor":"Modifying-a-format-style","type":"heading"},{"inlineContent":[{"text":"Format styles include modifier methods that return a new format style with an adjusted behavior.","type":"text"},{"text":" ","type":"text"},{"text":"The following example creates an ","type":"text"},{"type":"codeVoice","code":"IntegerFormatStyle"},{"text":", then applies modifiers to round values","type":"text"},{"text":" ","type":"text"},{"text":"down to the nearest 1,000 and applies formatting appropriate to the ","type":"text"},{"code":"fr_FR","type":"codeVoice"},{"type":"text","text":" locale:"}],"type":"paragraph"},{"code":["let style = IntegerFormatStyle<Int>()","    .rounded(rule: .down, increment: 1000)","    .locale(Locale(identifier: \"fr_FR\"))","let rounded = 123456789.formatted(style) \/\/ \"123 456 000\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Foundation caches identical instances of a customized format style, so you don’t need to pass"},{"type":"text","text":" "},{"type":"text","text":"format style instances around unrelated parts of your app’s source code."}],"type":"paragraph"},{"anchor":"Accessing-static-instances","type":"heading","level":3,"text":"Accessing static instances"},{"inlineContent":[{"type":"text","text":"Types that conform to "},{"code":"FormatStyle","type":"codeVoice"},{"type":"text","text":" typically extend the base protocol with type properties or"},{"type":"text","text":" "},{"type":"text","text":"type methods to provide convenience instances. These are available for use in a data type’s"},{"type":"text","text":" "},{"code":"formatted(_:)","type":"codeVoice"},{"type":"text","text":" method when the format style’s input type matches the data type. For example,"},{"type":"text","text":" "},{"type":"text","text":"the various numeric format styles define "},{"code":"number","type":"codeVoice"},{"type":"text","text":" properties with generic constraints to match"},{"type":"text","text":" "},{"type":"text","text":"the different numeric types ("},{"code":"Double","type":"codeVoice"},{"type":"text","text":", "},{"code":"Int","type":"codeVoice"},{"type":"text","text":", "},{"code":"Float16","type":"codeVoice"},{"type":"text","text":", and so on)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To see how this works, consider this example of a default formatter for an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" value. Because"},{"type":"text","text":" "},{"type":"codeVoice","code":"123456789"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"BinaryInteger"},{"type":"text","text":", its "},{"type":"codeVoice","code":"formatted(_:)"},{"type":"text","text":" method accepts an "},{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":" "},{"type":"text","text":"parameter. The following example shows the style’s default behavior in the "},{"type":"codeVoice","code":"en_US"},{"type":"text","text":" locale."}],"type":"paragraph"},{"code":["let formatted = 123456789.formatted(IntegerFormatStyle()) \/\/ \"123,456,789\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":" extends "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":" with multiple type properties called "},{"type":"codeVoice","code":"number"},{"type":"text","text":", each"},{"type":"text","text":" "},{"type":"text","text":"of which is an "},{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":" instance; these properties differ by which"},{"type":"text","text":" "},{"type":"codeVoice","code":"BinaryInteger"},{"type":"text","text":"-conforming type they take as input. Since one of these statically-defined"},{"type":"text","text":" "},{"type":"text","text":"properties takes "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" as its input, you can use this type property instead of instantiating a"},{"type":"text","text":" "},{"type":"text","text":"new format style instance. Using dot notation to access this property on the inferred"},{"type":"text","text":" "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":" makes the call point much easier to read, as seen here:"}]},{"code":["let formatted = 123456789.formatted(.number) \/\/ \"123,456,789\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Furthermore, since you can customize these statically-accessed format style instances, you can"},{"type":"text","text":" "},{"type":"text","text":"rewrite the example from the previous section without instantiating a new "},{"code":"IntegerFormatStyle","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"like this:"}]},{"type":"codeListing","syntax":"swift","code":["let rounded = 123456789.formatted(.number","    .rounded(rule: .down, increment: 1000)","    .locale(Locale(identifier: \"fr_FR\"))) \/\/ \"123 456 000\""]},{"text":"Parsing with a format style","level":3,"type":"heading","anchor":"Parsing-with-a-format-style"},{"type":"paragraph","inlineContent":[{"text":"To perform the opposite conversion — from formatted output type to input data type — some","type":"text"},{"text":" ","type":"text"},{"text":"format styles provide a corresponding ","type":"text"},{"type":"codeVoice","code":"ParseStrategy"},{"text":" type. These format styles typically expose","type":"text"},{"text":" ","type":"text"},{"text":"an instance of this type as a variable, called ","type":"text"},{"type":"codeVoice","code":"parseStrategy"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use a "},{"type":"codeVoice","code":"ParseStrategy"},{"type":"text","text":" one of two ways:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Initialize the data type by calling an initializer of that type that takes a formatted","type":"text"},{"text":" ","type":"text"},{"text":"instance and a parse strategy as parameters. For example, you can create a ","type":"text"},{"code":"Decimal","type":"codeVoice"},{"text":" from a","type":"text"},{"text":" ","type":"text"},{"text":"formatted string with the initializer ","type":"text"},{"code":"Decimal.init(_:format:lenient:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Create a parse strategy and call its ","type":"text"},{"code":"parse(_:)","type":"codeVoice"},{"text":" method on one or more formatted instances.","type":"text"}],"type":"paragraph"}]}]}]}],"abstract":[{"type":"text","text":"A type that converts a given data type into a representation in another type, such as a string."}],"relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH"]},{"type":"inheritedBy","title":"Inherited By","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"]},{"type":"conformingTypes","title":"Conforming Types","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/ISO8601FormatStyle"]}],"seeAlsoSections":[{"title":"Data formatting","generated":true,"anchor":"Data-formatting","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"]}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle"},"sections":[],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/Date/ISO8601FormatStyle":{"type":"topic","url":"\/documentation\/foundationessentials\/date\/iso8601formatstyle","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ISO8601FormatStyle"}],"abstract":[{"type":"text","text":"A type that converts between dates and their ISO-8601 stri