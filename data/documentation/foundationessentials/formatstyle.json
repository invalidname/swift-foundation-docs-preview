{"sections":[],"relationshipsSections":[{"title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH"],"type":"inheritsFrom"},{"title":"Inherited By","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"type":"inheritedBy"},{"title":"Conforming Types","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/ISO8601FormatStyle"],"type":"conformingTypes"}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"kind":"symbol","abstract":[{"type":"text","text":"A type that converts a given data type into a representation in another type, such as a string."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"FormatStyle","kind":"identifier"},{"text":"<","kind":"text"},{"text":"FormatInput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","kind":"typeIdentifier","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput"},{"text":", ","kind":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput","text":"FormatOutput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa","kind":"typeIdentifier"},{"text":"> : ","kind":"text"},{"preciseIdentifier":"s:Se","kind":"typeIdentifier","text":"Decodable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:SE","text":"Encodable"},{"kind":"text","text":", "},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Types conforming to the ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" protocol take their input type and produce formatted","type":"text"},{"text":" ","type":"text"},{"text":"instances of their output type. The formatting process accounts for locale-specific conventions,","type":"text"},{"text":" ","type":"text"},{"text":"like grouping and separators for numbers, and presentation of units for measurements. The format","type":"text"},{"text":" ","type":"text"},{"text":"styles Foundation provides produce their output as ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":" instances. You","type":"text"},{"text":" ","type":"text"},{"text":"can also create custom styles that format their output as any type, like XML or JSON ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"text":"an image.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"There are two basic approaches to using a ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of a type that conforms to "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":" and apply it to one or more"},{"text":" ","type":"text"},{"type":"text","text":"instances of the input type, by calling the style’s "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)","isActive":true},{"type":"text","text":" method. Use this when you"},{"type":"text","text":" "},{"text":"want to customize a style once and apply it repeatedly to many instances.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Pass an instance of a type that conforms to "},{"type":"codeVoice","code":"FormatStyle"},{"text":" to the data type’s ","type":"text"},{"type":"codeVoice","code":"formatted(_:)"},{"type":"text","text":" "},{"type":"text","text":"method, which takes the style as a parameter. Use this for one-off formatting scenarios, or"},{"type":"text","text":" "},{"text":"when you want to apply different format styles to the same data value. For the simplest cases,","type":"text"},{"text":" ","type":"text"},{"text":"most types that support formatting also have a no-argument ","type":"text"},{"type":"codeVoice","code":"formatted()"},{"text":" method that applies a","type":"text"},{"text":" ","type":"text"},{"text":"locale-appropriate default format style.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Foundation provides format styles for integers (","type":"text"},{"type":"codeVoice","code":"IntegerFormatStyle"},{"text":"), floating-point numbers","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"FloatingPointFormatStyle"},{"text":"), decimals (","type":"text"},{"type":"codeVoice","code":"Decimal.FormatStyle"},{"text":"), measurements","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"Measurement.FormatStyle"},{"text":"), arrays (","type":"text"},{"type":"codeVoice","code":"ListFormatStyle"},{"type":"text","text":"), and more. The numeric format styles"},{"type":"text","text":" "},{"text":"also provide supporting format styles to format currency and percent values, like","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"IntegerFormatStyle.Currency"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Decimal.FormatStyle.Percent"},{"text":".","type":"text"}]},{"level":3,"anchor":"Modifying-a-format-style","text":"Modifying a format style","type":"heading"},{"inlineContent":[{"type":"text","text":"Format styles include modifier methods that return a new format style with an adjusted behavior."},{"text":" ","type":"text"},{"text":"The following example creates an ","type":"text"},{"type":"codeVoice","code":"IntegerFormatStyle"},{"text":", then applies modifiers to round values","type":"text"},{"text":" ","type":"text"},{"text":"down to the nearest 1,000 and applies formatting appropriate to the ","type":"text"},{"type":"codeVoice","code":"fr_FR"},{"text":" locale:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let style = IntegerFormatStyle<Int>()","    .rounded(rule: .down, increment: 1000)","    .locale(Locale(identifier: \"fr_FR\"))","let rounded = 123456789.formatted(style) \/\/ \"123 456 000\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Foundation caches identical instances of a customized format style, so you don’t need to pass"},{"type":"text","text":" "},{"type":"text","text":"format style instances around unrelated parts of your app’s source code."}]},{"level":3,"anchor":"Accessing-static-instances","text":"Accessing static instances","type":"heading"},{"inlineContent":[{"text":"Types that conform to ","type":"text"},{"type":"codeVoice","code":"FormatStyle"},{"text":" typically extend the base protocol with type properties or","type":"text"},{"text":" ","type":"text"},{"text":"type methods to provide convenience instances. These are available for use in a data type’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"formatted(_:)"},{"text":" method when the format style’s input type matches the data type. For example,","type":"text"},{"text":" ","type":"text"},{"text":"the various numeric format styles define ","type":"text"},{"type":"codeVoice","code":"number"},{"text":" properties with generic constraints to match","type":"text"},{"text":" ","type":"text"},{"text":"the different numeric types (","type":"text"},{"type":"codeVoice","code":"Double"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Float16"},{"text":", and so on).","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To see how this works, consider this example of a default formatter for an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" value. Because"},{"type":"text","text":" "},{"code":"123456789","type":"codeVoice"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"BinaryInteger"},{"type":"text","text":", its "},{"type":"codeVoice","code":"formatted(_:)"},{"type":"text","text":" method accepts an "},{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":" "},{"type":"text","text":"parameter. The following example shows the style’s default behavior in the "},{"type":"codeVoice","code":"en_US"},{"type":"text","text":" locale."}]},{"type":"codeListing","code":["let formatted = 123456789.formatted(IntegerFormatStyle()) \/\/ \"123,456,789\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":" extends "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":" with multiple type properties called "},{"type":"codeVoice","code":"number"},{"type":"text","text":", each"},{"type":"text","text":" "},{"type":"text","text":"of which is an "},{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":" instance; these properties differ by which"},{"type":"text","text":" "},{"type":"codeVoice","code":"BinaryInteger"},{"type":"text","text":"-conforming type they take as input. Since one of these statically-defined"},{"type":"text","text":" "},{"type":"text","text":"properties takes "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" as its input, you can use this type property instead of instantiating a"},{"type":"text","text":" "},{"type":"text","text":"new format style instance. Using dot notation to access this property on the inferred"},{"type":"text","text":" "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":" makes the call point much easier to read, as seen here:"}]},{"type":"codeListing","code":["let formatted = 123456789.formatted(.number) \/\/ \"123,456,789\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Furthermore, since you can customize these statically-accessed format style instances, you can"},{"type":"text","text":" "},{"type":"text","text":"rewrite the example from the previous section without instantiating a new "},{"code":"IntegerFormatStyle","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"like this:"}]},{"type":"codeListing","code":["let rounded = 123456789.formatted(.number","    .rounded(rule: .down, increment: 1000)","    .locale(Locale(identifier: \"fr_FR\"))) \/\/ \"123 456 000\""],"syntax":"swift"},{"level":3,"anchor":"Parsing-with-a-format-style","text":"Parsing with a format style","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To perform the opposite conversion — from formatted output type to input data type — some"},{"type":"text","text":" "},{"type":"text","text":"format styles provide a corresponding "},{"type":"codeVoice","code":"ParseStrategy"},{"type":"text","text":" type. These format styles typically expose"},{"type":"text","text":" "},{"type":"text","text":"an instance of this type as a variable, called "},{"type":"codeVoice","code":"parseStrategy"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use a "},{"type":"codeVoice","code":"ParseStrategy"},{"type":"text","text":" one of two ways:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialize the data type by calling an initializer of that type that takes a formatted"},{"type":"text","text":" "},{"type":"text","text":"instance and a parse strategy as parameters. For example, you can create a "},{"code":"Decimal","type":"codeVoice"},{"type":"text","text":" from a"},{"type":"text","text":" "},{"type":"text","text":"formatted string with the initializer "},{"type":"codeVoice","code":"Decimal.init(_:format:lenient:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a parse strategy and call its "},{"type":"codeVoice","code":"parse(_:)"},{"type":"text","text":" method on one or more formatted instances."}]}]}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"s:20FoundationEssentials11FormatStyleP","title":"FormatStyle","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatStyle"}],"navigatorTitle":[{"text":"FormatStyle","kind":"identifier"}],"role":"symbol","roleHeading":"Protocol","modules":[{"name":"FoundationEssentials"}],"platforms":[{"introducedAt":"15.0","unavailable":false,"beta":false,"name":"iOS","deprecated":false},{"introducedAt":"15.0","unavailable":false,"beta":false,"name":"iPadOS","deprecated":false},{"introducedAt":"15.0","unavailable":false,"beta":false,"name":"Mac Catalyst","deprecated":false},{"introducedAt":"12.0","unavailable":false,"beta":false,"name":"macOS","deprecated":false},{"introducedAt":"15.0","unavailable":false,"beta":false,"name":"tvOS","deprecated":false},{"introducedAt":"8.0","unavailable":false,"beta":false,"name":"watchOS","deprecated":false}]},"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","interfaceLanguage":"swift"},"topicSections":[{"title":"Performing formatting","anchor":"Performing-formatting","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)"]},{"title":"Setting style locale","anchor":"Setting-style-locale","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/locale(_:)"]},{"title":"Declaring input and output types","anchor":"Declaring-input-and-output-types","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput"]},{"title":"Type Properties","generated":true,"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-26iub","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-3z94y","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-1jmw1","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-2hxhp"],"anchor":"Type-Properties"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/formatstyle"]}],"seeAlsoSections":[{"title":"Data formatting","generated":true,"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"anchor":"Data-formatting"}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/DateComponents/HTTPFormatStyle":{"url":"\/documentation\/foundationessentials\/datecomponents\/httpformatstyle","type":"topic","role":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","abstract":[{"type":"text","text":"Converts "},{"type":"codeVoice","code":"DateComponents"},{"type":"text","text":" into RFC 9110-compatible “HTTP date” "},{"type":"codeVoice","code":"String"},{"type":"text","text":", and parses in the reverse direction."},{"type":"text","text":" "},{"type":"text","text":"This parser does not do validation on the individual values of the components. An optional date can be created from the result using "},{"code":"Calendar(identifier: .gregorian).date(from: ...)","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"When formatting, missing or invalid fields are filled with default values: "},{"code":"Sun","type":"codeVoice"},{"type":"text","text":", "},{"code":"01","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"Jan"},{"type":"text","text":", "},{"code":"2000","type":"codeVoice"},{"type":"text","text":", "},{"code":"00:00:00","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"GMT"},{"type":"text","text":". Note that missing fields may result in an invalid date or time. Other values in the "},{"type":"codeVoice","code":"DateComponents"},{"type":"text","text":" are ignored."}],"title":"DateComponents.HTTPFormatStyle","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPFormatStyle","kind":"identifier"}],"navigatorTitle":[{"text":"HTTPFormatStyle","kind":"identifier"}],"kind":"symbol"},"doc://FoundationEssentials/Se":{"type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/Se","title":"Swift.Decodable"},"doc://FoundationEssentials/documentation/FoundationEssentials/Date/ISO8601FormatStyle":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle","abstract":[{"text":"A type that converts between dates and their ISO-8601 string representations.","type":"text"}],"title":"Date.ISO8601FormatStyle","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ISO8601FormatStyle"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ISO8601FormatStyle"}],"role":"symbol","type":"t