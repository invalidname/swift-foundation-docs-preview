codeVoice"},{"text":". Note that missing fields may result in an invalid date or time. Other values in the ","type":"text"},{"code":"DateComponents","type":"codeVoice"},{"text":" are ignored.","type":"text"}],"title":"DateComponents.HTTPFormatStyle","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","navigatorTitle":[{"text":"HTTPFormatStyle","kind":"identifier"}],"url":"\/documentation\/foundationessentials\/datecomponents\/httpformatstyle","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPFormatStyle","kind":"identifier"}],"type":"topic","role":"symbol"},"https://www.rfc-editor.org/rfc/rfc9110.html#http.date":{"titleInlineContent":[{"type":"text","text":"RFC 9110 § 5.6.7"}],"identifier":"https:\/\/www.rfc-editor.org\/rfc\/rfc9110.html#http.date","type":"link","title":"RFC 9110 § 5.6.7","url":"https:\/\/www.rfc-editor.org\/rfc\/rfc9110.html#http.date"},"doc://FoundationEssentials/documentation/FoundationEssentials/DiscreteFormatStyle":{"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DiscreteFormatStyle"}],"url":"\/documentation\/foundationessentials\/discreteformatstyle","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DiscreteFormatStyle"}],"title":"DiscreteFormatStyle","kind":"symbol","abstract":[{"type":"text","text":"A format style that transforms a continuous input into a discrete output and provides"},{"type":"text","text":" "},{"type":"text","text":"information about its discretization boundaries."}]},"doc://FoundationEssentials/documentation/FoundationEssentials/Date/ISO8601FormatStyle":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle","url":"\/documentation\/foundationessentials\/date\/iso8601formatstyle","type":"t