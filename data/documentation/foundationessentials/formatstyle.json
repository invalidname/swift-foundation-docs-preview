{"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","abstract":[{"text":"A type that converts a given data type into a representation in another type, such as a string.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle"},"topicSections":[{"anchor":"Performing-formatting","title":"Performing formatting","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)"]},{"anchor":"Setting-style-locale","title":"Setting style locale","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/locale(_:)"]},{"anchor":"Declaring-input-and-output-types","title":"Declaring input and output types","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput"]},{"anchor":"Applying-date-and-time-styles","title":"Applying date and time styles","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-1jmw1","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/iso8601-2hxhp","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-26iub","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/http-3z94y"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"FormatStyle","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"FormatInput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"FormatOutput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput"},{"text":"> : ","kind":"text"},{"preciseIdentifier":"s:Se","text":"Decodable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:SE","text":"Encodable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Types conforming to the "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":" protocol take their input type and produce formatted"},{"type":"text","text":" "},{"type":"text","text":"instances of their output type. The formatting process accounts for locale-specific conventions,"},{"type":"text","text":" "},{"type":"text","text":"like grouping and separators for numbers, and presentation of units for measurements. The format"},{"type":"text","text":" "},{"type":"text","text":"styles Foundation provides produce their output as "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or "},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":" instances. You"},{"type":"text","text":" "},{"type":"text","text":"can also create custom styles that format their output as any type, like XML or JSON "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"an image."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are two basic approaches to using a "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":":"}]},{"items":[{"content":[{"inlineContent":[{"text":"Create an instance of a type that conforms to ","type":"text"},{"type":"codeVoice","code":"FormatStyle"},{"text":" and apply it to one or more","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"instances of the input type, by calling the style’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/format(_:)"},{"text":" method. Use this when you","type":"text"},{"type":"text","text":" "},{"text":"want to customize a style once and apply it repeatedly to many instances.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pass an instance of a type that conforms to ","type":"text"},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":" to the data type’s "},{"type":"codeVoice","code":"formatted(_:)"},{"type":"text","text":" "},{"text":"method, which takes the style as a parameter. Use this for one-off formatting scenarios, or","type":"text"},{"type":"text","text":" "},{"type":"text","text":"when you want to apply different format styles to the same data value. For the simplest cases,"},{"type":"text","text":" "},{"type":"text","text":"most types that support formatting also have a no-argument "},{"type":"codeVoice","code":"formatted()"},{"type":"text","text":" method that applies a"},{"type":"text","text":" "},{"type":"text","text":"locale-appropriate default format style."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Foundation provides format styles for integers ("},{"code":"IntegerFormatStyle","type":"codeVoice"},{"type":"text","text":"), floating-point numbers"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"FloatingPointFormatStyle","type":"codeVoice"},{"type":"text","text":"), decimals ("},{"code":"Decimal.FormatStyle","type":"codeVoice"},{"type":"text","text":"), measurements"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"Measurement.FormatStyle","type":"codeVoice"},{"type":"text","text":"), arrays ("},{"code":"ListFormatStyle","type":"codeVoice"},{"type":"text","text":"), and more. The numeric format styles"},{"type":"text","text":" "},{"type":"text","text":"also provide supporting format styles to format currency and percent values, like"},{"type":"text","text":" "},{"code":"IntegerFormatStyle.Currency","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Decimal.FormatStyle.Percent","type":"codeVoice"},{"type":"text","text":"."}]},{"anchor":"Modifying-a-format-style","type":"heading","text":"Modifying a format style","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Format styles include modifier methods that return a new format style with an adjusted behavior."},{"type":"text","text":" "},{"type":"text","text":"The following example creates an "},{"type":"codeVoice","code":"IntegerFormatStyle"},{"type":"text","text":", then applies modifiers to round values"},{"type":"text","text":" "},{"type":"text","text":"down to the nearest 1,000 and applies formatting appropriate to the "},{"code":"fr_FR","type":"codeVoice"},{"type":"text","text":" locale:"}]},{"syntax":"swift","type":"codeListing","code":["let style = IntegerFormatStyle<Int>()","    .rounded(rule: .down, increment: 1000)","    .locale(Locale(identifier: \"fr_FR\"))","let rounded = 123456789.formatted(style) \/\/ \"123 456 000\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Foundation caches identical instances of a customized format style, so you don’t need to pass"},{"type":"text","text":" "},{"type":"text","text":"format style instances around unrelated parts of your app’s source code."}]},{"anchor":"Accessing-static-instances","type":"heading","text":"Accessing static instances","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Types that conform to "},{"code":"FormatStyle","type":"codeVoice"},{"type":"text","text":" typically extend the base protocol with type properties or"},{"type":"text","text":" "},{"type":"text","text":"type methods to provide convenience instances. These are available for use in a data type’s"},{"type":"text","text":" "},{"code":"formatted(_:)","type":"codeVoice"},{"type":"text","text":" method when the format style’s input type matches the data type. For example,"},{"type":"text","text":" "},{"type":"text","text":"the various numeric format styles define "},{"code":"number","type":"codeVoice"},{"type":"text","text":" properties with generic constraints to match"},{"type":"text","text":" "},{"type":"text","text":"the different numeric types ("},{"code":"Double","type":"codeVoice"},{"type":"text","text":", "},{"code":"Int","type":"codeVoice"},{"type":"text","text":", "},{"code":"Float16","type":"codeVoice"},{"type":"text","text":", and so on)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To see how this works, consider this example of a default formatter for an "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" value. Because"},{"type":"text","text":" "},{"code":"123456789","type":"codeVoice"},{"type":"text","text":" is a "},{"code":"BinaryInteger","type":"codeVoice"},{"type":"text","text":", its "},{"code":"formatted(_:)","type":"codeVoice"},{"type":"text","text":" method accepts an "},{"code":"IntegerFormatStyle","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"parameter. The following example shows the style’s default behavior in the "},{"code":"en_US","type":"codeVoice"},{"type":"text","text":" locale."}]},{"syntax":"swift","type":"codeListing","code":["let formatted = 123456789.formatted(IntegerFormatStyle()) \/\/ \"123,456,789\""]},{"type":"paragraph","inlineContent":[{"code":"IntegerFormatStyle","type":"codeVoice"},{"type":"text","text":" extends "},{"code":"FormatStyle","type":"codeVoice"},{"type":"text","text":" with multiple type properties called "},{"code":"number","type":"codeVoice"},{"type":"text","text":", each"},{"type":"text","text":" "},{"type":"text","text":"of which is an "},{"code":"IntegerFormatStyle","type":"codeVoice"},{"type":"text","text":" instance; these properties differ by which"},{"type":"text","text":" "},{"code":"BinaryInteger","type":"codeVoice"},{"type":"text","text":"-conforming type they take as input. Since one of these statically-defined"},{"type":"text","text":" "},{"type":"text","text":"properties takes "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" as its input, you can use this type property instead of instantiating a"},{"type":"text","text":" "},{"type":"text","text":"new format style instance. Using dot notation to access this property on the inferred"},{"type":"text","text":" "},{"code":"FormatStyle","type":"codeVoice"},{"type":"text","text":" makes the call point much easier to read, as seen here:"}]},{"syntax":"swift","type":"codeListing","code":["let formatted = 123456789.formatted(.number) \/\/ \"123,456,789\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Furthermore, since you can customize these statically-accessed format style instances, you can"},{"type":"text","text":" "},{"type":"text","text":"rewrite the example from the previous section without instantiating a new "},{"code":"IntegerFormatStyle","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"like this:"}]},{"syntax":"swift","type":"codeListing","code":["let rounded = 123456789.formatted(.number","    .rounded(rule: .down, increment: 1000)","    .locale(Locale(identifier: \"fr_FR\"))) \/\/ \"123 456 000\""]},{"anchor":"Parsing-with-a-format-style","type":"heading","text":"Parsing with a format style","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"To perform the opposite conversion — from formatted output type to input data type — some"},{"type":"text","text":" "},{"type":"text","text":"format styles provide a corresponding "},{"code":"ParseStrategy","type":"codeVoice"},{"type":"text","text":" type. These format styles typically expose"},{"type":"text","text":" "},{"type":"text","text":"an instance of this type as a variable, called "},{"code":"parseStrategy","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use a "},{"code":"ParseStrategy","type":"codeVoice"},{"type":"text","text":" one of two ways:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Initialize the data type by calling an initializer of that type that takes a formatted","type":"text"},{"text":" ","type":"text"},{"text":"instance and a parse strategy as parameters. For example, you can create a ","type":"text"},{"type":"codeVoice","code":"Decimal"},{"text":" from a","type":"text"},{"text":" ","type":"text"},{"text":"formatted string with the initializer ","type":"text"},{"type":"codeVoice","code":"Decimal.init(_:format:lenient:)"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Create a parse strategy and call its ","type":"text"},{"type":"codeVoice","code":"parse(_:)"},{"text":" method on one or more formatted instances.","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/formatstyle"]}],"metadata":{"navigatorTitle":[{"text":"FormatStyle","kind":"identifier"}],"symbolKind":"protocol","title":"FormatStyle","role":"symbol","roleHeading":"Protocol","modules":[{"name":"FoundationEssentials"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"FormatStyle"}],"externalID":"s:20FoundationEssentials11FormatStyleP","platforms":[{"deprecated":false,"introducedAt":"15.0","unavailable":false,"name":"iOS","beta":false},{"deprecated":false,"name":"iPadOS","unavailable":false,"beta":false,"introducedAt":"15.0"},{"deprecated":false,"name":"Mac Catalyst","unavailable":false,"beta":false,"introducedAt":"15.0"},{"deprecated":false,"introducedAt":"12.0","unavailable":false,"name":"macOS","beta":false},{"deprecated":false,"introducedAt":"15.0","unavailable":false,"name":"tvOS","beta":false},{"deprecated":false,"introducedAt":"8.0","unavailable":false,"name":"watchOS","beta":false}]},"seeAlsoSections":[{"anchor":"Data-formatting","title":"Data formatting","generated":true,"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"]}],"relationshipsSections":[{"title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH"],"type":"inheritsFrom"},{"title":"Inherited By","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"type":"inheritedBy"},{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/ISO8601FormatStyle"],"title":"Conforming Types","type":"conformingTypes","kind":"relationships"}],"references":{"doc://FoundationEssentials/SH":{"type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SH","title":"Swift.Hashable"},"https://www.rfc-editor.org/rfc/rfc9110.html#http.date":{"url":"https:\/\/www.rfc-editor.org\/rfc\/rfc9110.html#http.date","type":"link","identifier":"https:\/\/www.rfc-editor.org\/rfc\/rfc9110.html#http.date","titleInlineContent":[{"text":"RFC 9110 § 5.6.7","type":"text"}],"title":"RFC 9110 § 5.6.7"},"doc://FoundationEssentials/documentation/FoundationEssenti