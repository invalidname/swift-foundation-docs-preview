{"variants":[{"paths":["\/documentation\/foundationessentials\/attributedstring\/writingdirection"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"The writing direction of a piece of text."}],"topicSections":[{"anchor":"Working-with-writing-directions","title":"Working with writing directions","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/leftToRight","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/rightToLeft"]},{"anchor":"Encoding-and-decoding","title":"Encoding and decoding","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/init(from:)"]},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/Equatable-Implementations"],"generated":true}],"kind":"symbol","sections":[],"metadata":{"title":"AttributedString.WritingDirection","platforms":[{"unavailable":false,"name":"iOS","deprecated":false,"beta":false,"introducedAt":"26.0"},{"unavailable":false,"name":"iPadOS","deprecated":false,"beta":false,"introducedAt":"26.0"},{"unavailable":false,"name":"Mac Catalyst","deprecated":false,"beta":false,"introducedAt":"26.0"},{"unavailable":false,"name":"macOS","deprecated":false,"beta":false,"introducedAt":"26.0"},{"unavailable":false,"name":"tvOS","deprecated":false,"beta":false,"introducedAt":"26.0"},{"unavailable":false,"name":"visionOS","deprecated":false,"beta":false,"introducedAt":"26.0"},{"unavailable":false,"name":"watchOS","deprecated":false,"beta":false,"introducedAt":"26.0"}],"externalID":"s:20FoundationEssentials16AttributedStringV16WritingDirectionO","modules":[{"name":"FoundationEssentials"}],"extendedModule":"FoundationEssentials","navigatorTitle":[{"kind":"identifier","text":"WritingDirection"}],"roleHeading":"Enumeration","symbolKind":"enum","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"WritingDirection"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/s15BitwiseCopyableP","doc:\/\/FoundationEssentials\/s12CaseIterableP","doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH","doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"],"type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString"]]},"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Supporting-types","title":"Supporting types","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/AttributeInvalidationCondition","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/UTF16View","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/UTF8View","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/AttributeRunBoundaries"],"generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WritingDirection","kind":"identifier"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Writing direction defines the base direction in which bidirectional text","type":"text"},{"text":" ","type":"text"},{"text":"lays out its directional runs. A directional run is a contiguous sequence","type":"text"},{"text":" ","type":"text"},{"text":"of characters that all have the same effective directionality, which can","type":"text"},{"text":" ","type":"text"},{"text":"be determined using the Unicode BiDi algorithm. The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/leftToRight"},{"text":" ","type":"text"},{"text":"writing direction puts the directional run that is placed first in the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"storage leftmost, and places subsequent directional runs towards the"},{"type":"text","text":" "},{"type":"text","text":"right. The "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/rightToLeft","isActive":true},{"type":"text","text":" writing direction puts the directional run"},{"type":"text","text":" "},{"type":"text","text":"that is placed first in the storage rightmost, and places subsequent"},{"type":"text","text":" "},{"type":"text","text":"directional runs towards the left."}]},{"inlineContent":[{"type":"text","text":"Note that writing direction is a property separate from a text’s"},{"type":"text","text":" "},{"type":"text","text":"alignment, its line layout direction, or its character direction."},{"type":"text","text":" "},{"type":"text","text":"However, it is often used to determine the default alignment of a"},{"type":"text","text":" "},{"type":"text","text":"paragraph. E.g. English (a language with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/leftToRight"},{"type":"text","text":" for its"},{"type":"text","text":" "},{"code":"characterDirection","type":"codeVoice"},{"type":"text","text":", as defined by the FoundationInternationization module) is usually aligned"},{"type":"text","text":" "},{"type":"text","text":"to the left, but may be centered or aligned to the right for special"},{"type":"text","text":" "},{"type":"text","text":"effect, or to be visually more appealing in a user interface."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For bidirectional text to be perceived as laid out correctly, make sure"},{"type":"text","text":" "},{"type":"text","text":"that the writing direction is set to the value equivalent to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"characterDirection"},{"type":"text","text":"of the primary"},{"type":"text","text":" "},{"type":"text","text":"language in the text. E.g. an English sentence that contains some"},{"type":"text","text":" "},{"type":"text","text":"Arabic (a language with"},{"type":"text","text":" "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/rightToLeft","type":"reference","isActive":true},{"type":"text","text":" value for"},{"type":"text","text":" "},{"code":"characterDirection","type":"codeVoice"},{"type":"text","text":") words, should use"},{"type":"text","text":" "},{"type":"text","text":"a "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/leftToRight","type":"reference","isActive":true},{"type":"text","text":" writing direction. An Arabic sentence that contains"},{"type":"text","text":" "},{"type":"text","text":"some English words, should use a "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/rightToLeft","type":"reference","isActive":true},{"type":"text","text":" writing direction."}],"type":"paragraph"},{"inlineContent":[{"text":"Writing direction is always orthogonoal to the line layout direction","type":"text"},{"text":" ","type":"text"},{"text":"chosen to display a certain text. The line layout direction is the","type":"text"},{"text":" ","type":"text"},{"text":"direction in which a sequence of lines is placed in. E.g. English text","type":"text"},{"text":" ","type":"text"},{"text":"is usually displayed with a line layout direction of","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/topToBottom","isActive":true,"type":"reference"},{"text":". While languages do","type":"text"},{"text":" ","type":"text"},{"text":"have an associated line language direction (see","type":"text"},{"text":" ","type":"text"},{"code":"lineLayoutDirection","type":"codeVoice"},{"text":" in FoundationInternationlization), not all displays","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"of text follow the line layout direction of the text’s primary language."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Horizontal script is script with a line layout direction of either"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/topToBottom"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/bottomToTop"},{"type":"text","text":". Vertical script"},{"type":"text","text":" "},{"type":"text","text":"has a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/leftToRight"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/rightToLeft"},{"type":"text","text":" line layout"},{"type":"text","text":" "},{"type":"text","text":"direction. In vertical scripts, a writing direction of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/leftToRight"},{"type":"text","text":" "},{"type":"text","text":"is interpreted as top-to-bottom and a writing direction of"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/rightToLeft"},{"type":"text","text":" is interpreted as bottom-to-top."}],"type":"paragraph"}]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/AttributedString/AttributeInvalidationCondition":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"AttributeInvalidationCondition"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/AttributeInvalidationCondition","kind":"symbol","title":"AttributedString.AttributeInvalidationCondition","url":"\/documentation\/foundationessentials\/attributedstring\/attributeinvalidationcondition","navigatorTitle":[{"kind":"identifier","text":"AttributeInvalidationCondition"}],"abstract":[],"role":"symbol"},"doc://FoundationEssentials/Se":{"title":"Swift.Decodable","type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/Se"},"doc://FoundationEssentials/documentation/FoundationEssentials/AttributedString/WritingDirection/leftToRight":{"role":"symbol","abstract":[{"text":"A left-to-right writing direction in horizontal script.","type":"text"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/leftToRight","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"leftToRight"}],"u