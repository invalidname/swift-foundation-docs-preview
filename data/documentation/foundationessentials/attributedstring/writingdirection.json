{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WritingDirection","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Writing direction defines the base direction in which bidirectional text","type":"text"},{"text":" ","type":"text"},{"text":"lays out its directional runs. A directional run is a contiguous sequence","type":"text"},{"text":" ","type":"text"},{"text":"of characters that all have the same effective directionality, which can","type":"text"},{"text":" ","type":"text"},{"text":"be determined using the Unicode BiDi algorithm. The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/leftToRight"},{"text":" ","type":"text"},{"text":"writing direction puts the directional run that is placed first in the","type":"text"},{"text":" ","type":"text"},{"text":"storage leftmost, and places subsequent directional runs towards the","type":"text"},{"text":" ","type":"text"},{"text":"right. The ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/rightToLeft","type":"reference","isActive":true},{"text":" writing direction puts the directional run","type":"text"},{"text":" ","type":"text"},{"text":"that is placed first in the storage rightmost, and places subsequent","type":"text"},{"text":" ","type":"text"},{"text":"directional runs towards the left.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note that writing direction is a property separate from a text’s","type":"text"},{"text":" ","type":"text"},{"text":"alignment, its line layout direction, or its character direction.","type":"text"},{"text":" ","type":"text"},{"text":"However, it is often used to determine the default alignment of a","type":"text"},{"text":" ","type":"text"},{"text":"paragraph. E.g. English (a language with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/leftToRight","type":"reference","isActive":true},{"text":" ","type":"text"},{"code":"Locale\/Language-swift.struct\/characterDirection","type":"codeVoice"},{"text":") is usually aligned","type":"text"},{"text":" ","type":"text"},{"text":"to the left, but may be centered or aligned to the right for special","type":"text"},{"text":" ","type":"text"},{"text":"effect, or to be visually more appealing in a user interface.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For bidirectional text to be perceived as laid out correctly, make sure","type":"text"},{"type":"text","text":" "},{"text":"that the writing direction is set to the value equivalent to the","type":"text"},{"type":"text","text":" "},{"code":"Locale\/Language-swift.struct\/characterDirection","type":"codeVoice"},{"type":"text","text":" of the primary"},{"type":"text","text":" "},{"text":"language in the text. E.g. an English sentence that contains some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Arabic (a language with"},{"text":" ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/rightToLeft","isActive":true,"type":"reference"},{"type":"text","text":" "},{"code":"Locale\/Language-swift.struct\/characterDirection","type":"codeVoice"},{"type":"text","text":") words, should use"},{"type":"text","text":" "},{"text":"a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/leftToRight"},{"type":"text","text":" writing direction. An Arabic sentence that contains"},{"type":"text","text":" "},{"text":"some English words, should use a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/rightToLeft"},{"type":"text","text":" writing direction."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Writing direction is always orthogonoal to the line layout direction"},{"type":"text","text":" "},{"type":"text","text":"chosen to display a certain text. The line layout direction is the"},{"type":"text","text":" "},{"type":"text","text":"direction in which a sequence of lines is placed in. E.g. English text"},{"type":"text","text":" "},{"type":"text","text":"is usually displayed with a line layout direction of"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/topToBottom"},{"text":". While languages do","type":"text"},{"text":" ","type":"text"},{"text":"have an associated line language direction (see","type":"text"},{"text":" ","type":"text"},{"code":"Locale\/Language-swift.struct\/lineLayoutDirection","type":"codeVoice"},{"text":"), not all displays","type":"text"},{"text":" ","type":"text"},{"text":"of text follow the line layout direction of the text’s primary language.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Horizontal script is script with a line layout direction of either","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/topToBottom"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/bottomToTop"},{"text":". Vertical script","type":"text"},{"text":" ","type":"text"},{"text":"has a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/leftToRight"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/rightToLeft"},{"text":" line layout","type":"text"},{"text":" ","type":"text"},{"text":"direction. In vertical scripts, a writing direction of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/leftToRight"},{"text":" ","type":"text"},{"text":"is interpreted as top-to-bottom and a writing direction of","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/rightToLeft"},{"text":" is interpreted as bottom-to-top.","type":"text"}]}],"kind":"content"}],"seeAlsoSections":[{"generated":true,"anchor":"Supporting-types","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/AttributeInvalidationCondition","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/UTF16View","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/UTF8View","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/AttributeRunBoundaries"],"title":"Supporting types"}],"variants":[{"paths":["\/documentation\/foundationessentials\/attributedstring\/writingdirection"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[],"hie