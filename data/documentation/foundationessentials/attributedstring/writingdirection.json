{"abstract":[{"type":"text","text":"The writing direction of a piece of text."}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/s15BitwiseCopyableP","doc:\/\/FoundationEssentials\/s12CaseIterableP","doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH","doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"WritingDirection"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Writing direction defines the base direction in which bidirectional text"},{"type":"text","text":" "},{"type":"text","text":"lays out its directional runs. A directional run is a contiguous sequence"},{"type":"text","text":" "},{"type":"text","text":"of characters that all have the same effective directionality, which can"},{"type":"text","text":" "},{"type":"text","text":"be determined using the Unicode BiDi algorithm. The "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/leftToRight","isActive":true},{"type":"text","text":" "},{"type":"text","text":"writing direction puts the directional run that is placed first in the"},{"type":"text","text":" "},{"type":"text","text":"storage leftmost, and places subsequent directional runs towards the"},{"type":"text","text":" "},{"type":"text","text":"right. The "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/rightToLeft","isActive":true},{"type":"text","text":" writing direction puts the directional run"},{"type":"text","text":" "},{"type":"text","text":"that is placed first in the storage rightmost, and places subsequent"},{"type":"text","text":" "},{"type":"text","text":"directional runs towards the left."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that writing direction is a property separate from a text’s"},{"type":"text","text":" "},{"type":"text","text":"alignment, its line layout direction, or its character direction."},{"type":"text","text":" "},{"type":"text","text":"However, it is often used to determine the default alignment of a"},{"type":"text","text":" "},{"type":"text","text":"paragraph. E.g. English (a language with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/leftToRight","isActive":true},{"type":"text","text":" for its"},{"type":"text","text":" "},{"type":"codeVoice","code":"characterDirection"},{"type":"text","text":", as defined by the FoundationInternationalization module) is usually aligned"},{"type":"text","text":" "},{"type":"text","text":"to the left, but may be centered or aligned to the right for special"},{"type":"text","text":" "},{"type":"text","text":"effect, or to be visually more appealing in a user interface."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For bidirectional text to be perceived as laid out correctly, make sure"},{"type":"text","text":" "},{"type":"text","text":"that the writing direction is set to the value equivalent to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"characterDirection"},{"type":"text","text":"of the primary"},{"type":"text","text":" "},{"type":"text","text":"language in the text. E.g. an English sentence that contains some"},{"type":"text","text":" "},{"type":"text","text":"Arabic (a language with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/rightToLeft","isActive":true},{"type":"text","text":" value for"},{"type":"text","text":" "},{"type":"codeVoice","code":"characterDirection"},{"type":"text","text":") words, should use"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/leftToRight","isActive":true},{"type":"text","text":" writing direction. An Arabic sentence that contains"},{"type":"text","text":" "},{"type":"text","text":"some English words, should use a "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/rightToLeft","isActive":true},{"type":"text","text":" writing direction."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Writing direction is always orthogonoal to the line layout direction"},{"type":"text","text":" "},{"type":"text","text":"chosen to display a certain text. The line layout direction is the"},{"type":"text","text":" "},{"type":"text","text":"direction in which a sequence of lines is placed in. E.g. English text"},{"type":"text","text":" "},{"type":"text","text":"is usually displayed with a line layout direction of"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/topToBottom","isActive":true},{"type":"text","text":". While languages do"},{"type":"text","text":" "},{"type":"text","text":"have an associated line language direction (see"},{"type":"text","text":" "},{"type":"codeVoice","code":"lineLayoutDirection"},{"type":"text","text":" in FoundationInternationalization), not all displays"},{"type":"text","text":" "},{"type":"text","text":"of text follow the line layout direction of the text’s primary language."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Horizontal script is script with a line layout direction of either"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/topToBottom","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/bottomToTop","isActive":true},{"type":"text","text":". Vertical script"},{"type":"text","text":" "},{"type":"text","text":"has a "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/leftToRight","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/rightToLeft","isActive":true},{"type":"text","text":" line layout"},{"type":"text","text":" "},{"type":"text","text":"direction. In vertical scripts, a writing direction of "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/leftToRight","isActive":true},{"type":"text","text":" "},{"type":"text","text":"is interpreted as top-to-bottom and a writing direction of"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/rightToLeft","isActive":true},{"type":"text","text":" is interpreted as bottom-to-top."}]}]}],"metadata":{"navigatorTitle":[{"text":"WritingDirection","kind":"identifier"}],"extendedModule":"FoundationEssentials","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WritingDirection","kind":"identifier"}],"roleHeading":"Enumeration","symbolKind"