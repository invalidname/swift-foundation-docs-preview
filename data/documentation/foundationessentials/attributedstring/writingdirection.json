{"kind":"symbol","seeAlsoSections":[{"title":"Supporting types","generated":true,"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/AttributeInvalidationCondition","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/UTF16View","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/UTF8View","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/AttributeRunBoundaries"],"anchor":"Supporting-types"}],"metadata":{"externalID":"s:20FoundationEssentials16AttributedStringV16WritingDirectionO","extendedModule":"FoundationEssentials","modules":[{"name":"FoundationEssentials"}],"platforms":[{"name":"iOS","introducedAt":"26.0","unavailable":false,"deprecated":false,"beta":false},{"name":"iPadOS","introducedAt":"26.0","unavailable":false,"deprecated":false,"beta":false},{"name":"Mac Catalyst","introducedAt":"26.0","unavailable":false,"deprecated":false,"beta":false},{"unavailable":false,"beta":false,"introducedAt":"26.0","deprecated":false,"name":"macOS"},{"unavailable":false,"beta":false,"introducedAt":"26.0","deprecated":false,"name":"tvOS"},{"unavailable":false,"beta":false,"introducedAt":"26.0","deprecated":false,"name":"visionOS"},{"unavailable":false,"beta":false,"introducedAt":"26.0","deprecated":false,"name":"watchOS"}],"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"WritingDirection","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"WritingDirection"}],"symbolKind":"enum","roleHeading":"Enumeration","title":"AttributedString.WritingDirection","role":"symbol"},"sections":[],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString"]]},"topicSections":[{"title":"Working with writing directions","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/leftToRight","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/rightToLeft"],"anchor":"Working-with-writing-directions"},{"title":"Encoding and decoding","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/init(from:)"],"anchor":"Encoding-and-decoding"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"The writing direction of a piece of text.","type":"text"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/FoundationEssentials\/s15BitwiseCopyableP","doc:\/\/FoundationEssentials\/s12CaseIterableP","doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH","doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"]}],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/attributedstring\/writingdirection"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WritingDirection","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Writing direction defines the base direction in which bidirectional text","type":"text"},{"text":" ","type":"text"},{"text":"lays out its directional runs. A directional run is a contiguous sequence","type":"text"},{"text":" ","type":"text"},{"text":"of characters that all have the same effective directionality, which can","type":"text"},{"text":" ","type":"text"},{"text":"be determined using the Unicode BiDi algorithm. The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/leftToRight"},{"text":" ","type":"text"},{"text":"writing direction puts the directional run that is placed first in the","type":"text"},{"text":" ","type":"text"},{"text":"storage leftmost, and places subsequent directional runs towards the","type":"text"},{"text":" ","type":"text"},{"text":"right. The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/rightToLeft"},{"text":" writing direction puts the directional run","type":"text"},{"text":" ","type":"text"},{"text":"that is placed first in the storage rightmost, and places subsequent","type":"text"},{"text":" ","type":"text"},{"text":"directional runs towards the left.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Note that writing direction is a property separate from a text’s","type":"text"},{"text":" ","type":"text"},{"text":"alignment, its line layout direction, or its character direction.","type":"text"},{"text":" ","type":"text"},{"text":"However, it is often used to determine the default alignment of a","type":"text"},{"text":" ","type":"text"},{"text":"paragraph. E.g. English (a language with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/leftToRight"},{"text":" for its","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"characterDirection"},{"text":", as defined by the FoundationInternationalization module) is usually aligned","type":"text"},{"text":" ","type":"text"},{"text":"to the left, but may be centered or aligned to the right for special","type":"text"},{"text":" ","type":"text"},{"text":"effect, or to be visually more appealing in a user interface.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For bidirectional text to be perceived as laid out correctly, make sure","type":"text"},{"text":" ","type":"text"},{"text":"that the writing direction is set to the value equivalent to the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"characterDirection"},{"text":"of the primary","type":"text"},{"text":" ","type":"text"},{"text":"language in the text. E.g. an English sentence that contains some","type":"text"},{"text":" ","type":"text"},{"text":"Arabic (a language with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/rightToLeft"},{"text":" value for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"characterDirection"},{"text":") words, should use","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/leftToRight"},{"text":" writing direction. An Arabic sentence that contains","type":"text"},{"text":" ","type":"text"},{"text":"some English words, should use a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/rightToLeft"},{"text":" writing direction.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Writing direction is always orthogonoal to the line layout direction","type":"text"},{"text":" ","type":"text"},{"text":"chosen to display a certain text. The line layout direction is the","type":"text"},{"text":" ","type":"text"},{"text":"direction in which a sequence of lines is placed in. E.g. English text","type":"text"},{"text":" ","type":"text"},{"text":"is usually displayed with a line layout direction of","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/topToBottom"},{"text":". While languages do","type":"text"},{"text":" ","type":"text"},{"text":"have an associated line language direction (see","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"lineLayoutDirection"},{"text":" in FoundationInternationalization), not all displays","type":"text"},{"text":" ","type":"text"},{"text":"of text follow the line layout direction of the text’s primary language.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Horizontal script is script with a line layout direction of either","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/topToBottom"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/bottomToTop"},{"text":". Vertical script","type":"text"},{"text":" ","type":"text"},{"text":"has a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/leftToRight"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/rightToLeft"},{"text":" line layout","type":"text"},{"text":" ","type":"text"},{"text":"direction. In vertical scripts, a writing direction of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/leftToRight"},{"text":" ","type":"text"},{"text":"is interpreted as top-to-bottom and a writing direction of","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/WritingDirection\/rightToLeft"},{"text":" is interpreted as bottom-to-top.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/AttributedString/UTF8View":{"role":"symbol","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString\/UTF8View","abstract":[{"type":"text","text":"A view of an attributed string’s contents as a collection of UTF-8 code units."}],"kind":"symbol","url":"\/documentation\/foundationessentials\/attributedstring\/utf8view","title":"AttributedString.UTF8View","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"UTF8View"}],"navigatorTitle":[{"kind":"identifier","text":"UTF8View"}]},"doc://FoundationEssentials/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/FoundationEssentials\/s16SendableMetatypeP"},"doc://FoundationEssentials/documentation/FoundationEssentials/Locale/LanguageDirection/topToBottom":{"role":"symbol","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/LanguageDirection\/topToBottom","abstract":[{"type":"text","text":"The language direction is from top to bottom."}],"kind":"symbol","url":"\/documentation\/foundationessentials\/locale\/languagedirection\/toptobottom","title":"Loca