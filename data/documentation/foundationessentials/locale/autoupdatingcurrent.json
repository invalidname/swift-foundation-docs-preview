xt":"A locale which tracks the user’s current preferences."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"autoupdatingCurrent","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale","text":"Locale","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials6LocaleV"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"This value represents the locale currently used by the app, based on the following:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The current system locale."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Any app-specific locale choice made in the Settings app."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The availability of the preferred locale in the app. For example, if the person using an app has set their device to use a Spanish-language locale, but the app only supports English, this value returns an English locale."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Use this property when you want a locale that always reflects the latest configuration settings. When the person using the app changes settings, reading properties from a locale instance obtained from this property provides the latest values. If you need to rely on a locale that does not change, use the locale given by the ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/current","type":"reference","isActive":true},{"text":" property instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Although the locale obtained here automatically follows the latest language and region settings, it provides no indication when the settings change. To receive notification of locale changes in Swift, add an observer for ","type":"text"},{"type":"codeVoice","code":"Locale\/CurrentLocaleDidChangeMessage"},{"text":". In Objective-C, you can add your object as an observer of ","type":"text"},{"type":"codeVoice","code":"NSCurrentLocaleDidChangeNotification"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If mutated, this ","type":"text"},{"type":"codeVoice","code":"Locale"},{"text":" no longer tracks the user’s preferences.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"The autoupdating "},{"code":"Locale","type":"codeVoice"},{"type":"text","text":" only compares as equal to another autoupdating "},{"code":"Locale","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Note","style":"note"}],"kind":"content"}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/Locale":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale","role":"symbol","title":"Locale","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Locale"}],"type":"topic","navigatorTitle":[{"text":"Locale","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/foundationessentials\/locale","abstract":[{"type":"text","text":"Information about linguistic, cultural, and technological conventions for use in formatting data for presentation."}]},"doc://FoundationEssentials/documentation/FoundationEssentials":{"title":"FoundationEssentials","type":"topic","role":"collection","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","abstract":[{"type":"text","text