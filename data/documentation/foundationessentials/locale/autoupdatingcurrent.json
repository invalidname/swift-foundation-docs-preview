:"Although the locale obtained here automatically follows the latest language and region settings, it provides no indication when the settings change."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If mutated, this "},{"code":"Locale","type":"codeVoice"},{"type":"text","text":" no longer tracks the user’s preferences."}]},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"The autoupdating "},{"type":"codeVoice","code":"Locale"},{"type":"text","text":" only compares as equal to another autoupdating "},{"type":"codeVoice","code":"Locale"},{"type":"text","text":"."}],"type":"paragraph"}]}]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/Locale/current":{"kind":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"current","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials6LocaleV","text":"Locale","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"A locale representing the user’s region settings at the time the property is read."}],"title":"current","url":"\/documentation\/foundationessentials\/locale\/current","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/current","role":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials":{"role":"collection","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","abstract":[{"type":"text","text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app."}],"kind":"symbol","url":"\/documentation\/foundationessentials","title":"FoundationEssentials"},"doc://FoundationEssentials/documentation/FoundationEssentials/Locale/autoupdatingCurrent":{"title":"autoupdatingCurrent","identifier":"doc:\/\/FoundationEssen