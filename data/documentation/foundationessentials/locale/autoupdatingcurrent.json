,"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"autoupdatingCurrent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale","preciseIdentifier":"s:20FoundationEssentials6LocaleV","text":"Locale"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"This value represents the locale currently used by the app, based on the following:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The current system locale.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Any app-specific locale choice made in the Settings app."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The availability of the preferred locale in the app. For example, if the person using an app has set their device to use a Spanish-language locale, but the app only supports English, this value returns an English locale."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Use this property when you want a locale that always reflects the latest configuration settings. When the person using the app changes settings, reading properties from a locale instance obtained from this property provides the latest values. If you need to rely on a locale that does not change, use the locale given by the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/current","type":"reference"},{"text":" property instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Although the locale obtained here automatically follows the latest language and region settings, it provides no indication when the settings change.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If mutated, this ","type":"text"},{"code":"Locale","type":"codeVoice"},{"text":" no longer tracks the user’s preferences.","type":"text"}]},{"content":[{"inlineContent":[{"text":"The autoupdating ","type":"text"},{"code":"Locale","type":"codeVoice"},{"text":" only compares as equal to another autoupdating ","type":"text"},{"code":"Locale","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"}]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/Locale/autoupdatingCurrent":{"type":"topic","url":"\/documentation\/foundationessentials\/locale\/autoupdatingcurrent","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/autoupdatingCurrent","title":"autoupdatingCurrent","role":"symbol","abstract":[{"text":"A locale which tracks the user’s current preferences.","type":"text"}],"kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"autoupdatingCurrent","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Locale","preciseIdentifier":"s:20FoundationEssentials6LocaleV","kind":"typeIdentifier"}]},"doc://FoundationEssentials/documentation/FoundationEssentials":{"title":"FoundationEssentials","url":"\/documentation\/foundationessentials","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","abstract":[{"text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app.","type":"text"}],"kind":"symbol","role":"collection","type":"topic"},"doc://FoundationEssentials/documentation/FoundationEssentials/Locale/current":{"type":"topic","url":"\/documentation\/foundatio