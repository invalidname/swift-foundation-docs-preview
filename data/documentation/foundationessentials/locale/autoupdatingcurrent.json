tent":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"text":"This value represents the locale currently used by the app, based on the following:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The current system locale.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Any app-specific locale choice made in the Settings app."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The availability of the preferred locale in the app. For example, if the person using an app has set their device to use a Spanish-language locale, but the app only supports English, this value returns an English locale.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this property when you want a locale that always reflects the latest configuration settings. When the person using the app changes settings, reading properties from a locale instance obtained from this property provides the latest values. If you need to rely on a locale that does not change, use the locale given by the "},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale\/current","type":"reference"},{"type":"text","text":" property instead."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Although the locale obtained here automatically follows the latest language and region settings, it provides no indication when the settings change."}]},{"type":"paragraph","inlineContent":[{"text":"If mutated, this ","type":"text"},{"code":"Locale","type":"codeVoice"},{"text":" no longer tracks the user’s preferences.","type":"text"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"The autoupdating "},{"code":"Locale","type":"codeVoice"},{"type":"text","text":" only compares as equal to another autoupdating "},{"code":"Locale","