{"topicSections":[{"anchor":"Declaring-subject-type","title":"Declaring subject type","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage\/Subject"]}],"seeAlsoSections":[{"generated":true,"anchor":"Declaring-a-notification-message","title":"Declaring a notification message","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/notificationcenter\/mainactormessage"]}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorMessage"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s16SendableMetatypeP","kind":"typeIdentifier","text":"SendableMetatype"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"You post types conforming to  "},{"code":"MainActorMessage","type":"codeVoice"},{"type":"text","text":" to a notification center using "},{"code":"post(_:subject:)","type":"codeVoice"},{"type":"text","text":" and observe them with "},{"code":"addObserver(of:for:using:)","type":"codeVoice"},{"type":"text","text":". The notification center delivers "},{"code":"MainActorMessage","type":"codeVoice"},{"type":"text","text":" types synchronously when posted."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For types that post on an arbitrary isolation, use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each "},{"code":"MainActorMessage","type":"codeVoice"},{"type":"text","text":" is associated with a specific "},{"code":"Subject","type":"codeVoice"},{"type":"text","text":" type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, a "},{"code":"MainActorMessage","type":"codeVoice"},{"type":"text","text":" associated with the type "},{"code":"Event","type":"codeVoice"},{"type":"text","text":" could use the following declaration:"}],"type":"paragraph"},{"syntax":"swift","code":["struct EventDidStart: NotificationCenter.MainActorMessage {","    typealias Subject = Event","}"],"type":"codeListing"},{"inlineContent":[{"code":"MainActorMessage","type":"codeVoice"},{"type":"text","text":" can use an optional "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MessageIdentifier"},{"type":"text","text":" type for context-aware observer registration:"}],"type":"paragraph"},{"syntax":"swift","code":["extension NotificationCenter.MessageIdentifier where Self == NotificationCenter.BaseMessageIdentifier<EventDidStart> {","    static var didStart: Self { .init() }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"With this identifier, observers can receive information about a specific instance by registering for this message with a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let observerToken = NotificationCenter.default.addObserver(of: importantEvent, for: .didStart)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or an observer can receive information about any instance with:"}],"type":"paragraph"},{"syntax":"swift","code":["let observerToken = NotificationCenter.default.addObserver(of: Event.self, for: .didStart)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The notification center ties observation the lifetime of the returned "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/ObservationToken"},{"type":"text","text":" and automatically de-registers the observer if the token"},{"type":"text","text":" "},{"type":"text","text":"goes out of scope. You can also remove observation explicitly:"}],"type":"paragraph"},{"syntax":"swift","code":["NotificationCenter.default.removeObserver(observerToken)"],"type":"codeListing"},{"anchor":"Notification-Interoperability","level":3,"type":"heading","text":"Notification Interoperability"},{"inlineContent":[{"code":"MainActorMessage","type":"codeVoice"},{"type":"text","text":" includes optional interoperability with "},{"code":"Notification","type":"codeVoice"},{"type":"text","text":", enabling posters and observers of both types"},{"type":"text","text":" "},{"type":"text","text":"to pass information."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It does this by offering a "},{"code":"makeMessage(_:)","type":"codeVoice"},{"type":"text","text":" method that collects values from a "},{"code":"Notification","type":"codeVoice"},{"type":"text","text":"‘s "},{"code":"Notification\/userInfo","type":"codeVoice"},{"type":"text","text":" and populates properties on a new message."},{"type":"text","text":" "},{"type":"text","text":"In the other direction, a "},{"code":"makeNotification(_:)","type":"codeVoice"},{"type":"text","text":" method collects the message’s defined properties and loads them into a new notification’s "},{"code":"Notification\/userInfo","type":"codeVoice"},{"type":"text","text":" dictionary."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, if there exists a "},{"code":"Notification","type":"codeVoice"},{"type":"text","text":" posted on "},{"code":"MainActor","type":"codeVoice"},{"type":"text","text":" identified by the "},{"code":"Notification\/Name","type":"codeVoice"},{"type":"text","text":" "},{"code":"\"eventDidFinish\"","type":"codeVoice"},{"type":"text","text":" with a "},{"code":"Notification\/userInfo","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"dictionary containing the key "},{"code":"\"duration\"","type":"codeVoice"},{"type":"text","text":" as an "},{"code":"NSNumber","type":"codeVoice"},{"type":"text","text":", an app could post and observe the notification with the following "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["struct EventDidFinish: NotificationCenter.MainActorMessage {","    typealias Subject = Event","    static var name: Notification.Name { Notification.Name(\"eventDidFinish\") }","","    var duration: Int","","    static func makeNotification(_ message: Self) -> Notification {","        return Notification(name: Self.name, userInfo: [\"duration\": NSNumber(message.duration)])","    }","","    static func makeMessage(_ notification: Notification) -> Self? {","        guard let userInfo = notification.userInfo,","              let duration = userInfo[\"duration\"] as? Int","        else {","            return nil","        }","","        return Self(duration: duration)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"With this definition, an observer for this "},{"code":"MainActorMessage","type":"codeVoice"},{"type":"text","text":" type receives information even if the poster used the "},{"code":"Notification","type":"codeVoice"},{"type":"text","text":" equivalent, and vice versa."}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/FoundationEssentials\/s16SendableMetatypeP"]}],"metadata":{"externalID":"s:20FoundationEssentials18NotificationCenterC16MainActorMessageP","extendedModule":"FoundationEssentials","role":"symbol","modules":[{"name":"FoundationEssentials"}],"title":"NotificationCenter.MainActorMessage","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorMessage"}],"navigatorTitle":[{"kind":"identifier","text":"MainActorMessage"}],"roleHeading":"Protocol","platforms":[{"unavailable":false,"beta":false,"introducedAt":"26.0","deprecated":false,"name":"iOS"},{"unavailable":false,"beta":false,"introducedAt":"26.0","deprecated":false,"name":"iPadOS"},{"unavailable":false,"beta":false,"introducedAt":"26.0","deprecated":false,"name":"Mac Catalyst"},{"unavailable":false,"beta":false,"introducedAt":"26.0","deprecated":false,"name":"macOS"},{"unavailable":false,"beta":false,"introducedAt":"26.0","deprecated":false,"name":"tvOS"},{"unavailable":false,"beta":false,"introducedAt":"26.0","deprecated":false,"name":"visionOS"},{"unavailable":false,"beta":false,"introducedAt":"26.0","deprecated":false,"name":"watchOS"}]},"kind":"symbol","abstract":[{"text":"A protocol for creating types that you can post to a notification center and bind to the main actor.","type":"text"}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/NotificationCenter/MessageIdentifier":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MessageIdentifier","role":"symbol","title":"NotificationCenter.MessageIdentifier","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MessageIdentifier","kind":"identifier"}],"type":"topic","