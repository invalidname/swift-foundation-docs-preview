{"topicSections":[{"title":"Declaring subject type","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage\/Subject"],"anchor":"Declaring-subject-type"}],"metadata":{"navigatorTitle":[{"text":"MainActorMessage","kind":"identifier"}],"modules":[{"name":"FoundationEssentials"}],"platforms":[{"beta":false,"deprecated":false,"name":"iOS","introducedAt":"26.0","unavailable":false},{"beta":false,"deprecated":false,"name":"iPadOS","introducedAt":"26.0","unavailable":false},{"deprecated":false,"unavailable":false,"beta":false,"name":"Mac Catalyst","introducedAt":"26.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"macOS","introducedAt":"26.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"tvOS","introducedAt":"26.0"},{"beta":false,"deprecated":false,"name":"visionOS","introducedAt":"26.0","unavailable":false},{"deprecated":false,"unavailable":false,"beta":false,"name":"watchOS","introducedAt":"26.0"}],"roleHeading":"Protocol","extendedModule":"FoundationEssentials","externalID":"s:20FoundationEssentials18NotificationCenterC16MainActorMessageP","title":"NotificationCenter.MainActorMessage","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"MainActorMessage","kind":"identifier"}],"symbolKind":"protocol"},"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/FoundationEssentials\/s16SendableMetatypeP"],"type":"inheritsFrom","kind":"relationships"}],"kind":"symbol","abstract":[{"text":"A protocol for creating types that you can post to a notification center and bind to the main actor.","type":"text"}],"seeAlsoSections":[{"title":"Declaring a notification message","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage"],"anchor":"Declaring-a-notification-message","generated":true}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MainActorMessage"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s16SendableMetatypeP","kind":"typeIdentifier","text":"SendableMetatype"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"You post types conforming to  ","type":"text"},{"code":"MainActorMessage","type":"codeVoice"},{"text":" to a notification center using ","type":"text"},{"code":"post(_:subject:)","type":"codeVoice"},{"text":" and observe them with ","type":"text"},{"code":"addObserver(of:for:using:)","type":"codeVoice"},{"type":"text","text":". The notification center delivers "},{"code":"MainActorMessage","type":"codeVoice"},{"text":" types synchronously when posted.","type":"text"}]},{"inlineContent":[{"type":"text","text":"For types that post on an arbitrary isolation, use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each "},{"code":"MainActorMessage","type":"codeVoice"},{"type":"text","text":" is associated with a specific "},{"code":"Subject","type":"codeVoice"},{"type":"text","text":" type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, a "},{"code":"MainActorMessage","type":"codeVoice"},{"type":"text","text":" associated with the type "},{"code":"Event","type":"codeVoice"},{"type":"text","text":" could use the following declaration:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct EventDidStart: NotificationCenter.MainActorMessage {","    typealias Subject = Event","}"]},{"inlineContent":[{"code":"MainActorMessage","type":"codeVoice"},{"type":"text","text":" can use an optional "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MessageIdentifier"},{"type":"text","text":" type for context-aware observer registration:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension NotificationCenter.MessageIdentifier where Self == NotificationCenter.BaseMessageIdentifier<EventDidStart> {","    static var didStart: Self { .init() }","}"]},{"inlineContent":[{"type":"text","text":"With this identifier, observers can receive information about a specific instance by registering for this message with a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let observerToken = NotificationCenter.default.addObserver(of: importantEvent, for: .didStart)"]},{"inlineContent":[{"text":"Or an observer can receive information about any instance with:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let observerToken = NotificationCenter.default.addObserver(of: Event.self, for: .didStart)"]},{"inlineContent":[{"text":"The notification center ties observation the lifetime of the returned ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/ObservationToken","isActive":true,"type":"reference"},{"text":" and automatically de-registers the observer if the token","type":"text"},{"text":" ","type":"text"},{"text":"goes out of scope. You can also remove observation explicitly:","type":"text"}],"type":"paragraph"},{"code":["NotificationCenter.default.removeObserver(observerToken)"],"type":"codeListing","syntax":"swift"},{"text":"Notification Interoperability","anchor":"Notification-Interoperability","level":3,"type":"heading"},{"inlineContent":[{"code":"MainActorMessage","type":"codeVoice"},{"text":" includes optional interoperability with ","type":"text"},{"code":"Notification","type":"codeVoice"},{"text":", enabling posters and observers of both types","type":"text"},{"text":" ","type":"text"},{"text":"to pass information.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It does this by offering a ","type":"text"},{"code":"makeMessage(_:)","type":"codeVoice"},{"text":" method that collects values from a ","type":"text"},{"code":"Notification","type":"codeVoice"},{"text":"‘s ","type":"text"},{"code":"Notification\/userInfo","type":"codeVoice"},{"text":" and populates properties on a new message.","type":"text"},{"text":" ","type":"text"},{"text":"In the other direction, a ","type":"text"},{"code":"makeNotification(_:)","type":"codeVoice"},{"text":" method collects the message’s defined properties and loads them into a new notification’s ","type":"text"},{"code":"Notification\/userInfo","type":"codeVoice"},{"text":" dictionary.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, if there exists a ","type":"text"},{"code":"Notification","type":"codeVoice"},{"text":" posted on ","type":"text"},{"code":"MainActor","type":"codeVoice"},{"text":" identified by the ","type":"text"},{"type":"codeVoice","code":"Notification\/Name"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\"eventDidFinish\""},{"text":" with a ","type":"text"},{"type":"codeVoice","code":"Notification\/userInfo"},{"text":" ","type":"text"},{"text":"dictionary containing the key ","type":"text"},{"type":"codeVoice","code":"\"duration\""},{"text":" as an ","type":"text"},{"type":"codeVoice","code":"NSNumber"},{"text":", an app could post and observe the notification with the following ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage","type":"reference","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"code":["struct EventDidFinish: NotificationCenter.MainActorMessage {","    typealias Subject = Event","    static var name: Notification.Name { Notification.Name(\"eventDidFinish\") }","","    var duration: Int","","    static func makeNotification(_ message: Self) -> Notification {","        return Notification(name: Self.name, userInfo: [\"duration\": NSNumber(message.duration)])","    }","","    static func makeMessage(_ notification: Notification) -> Self? {","        guard let userInfo = notification.userInfo,","              let duration = userInfo[\"duration\"] as? Int","        else {","            return nil","        }","","        return Self(duration: duration)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"With this definition, an observer for this ","type":"text"},{"code":"MainActorMessage","type":"codeVoice"},{"text":" type receives information even if the poster used the ","type":"text"},{"code":"Notification","type":"codeVoice"},{"text":" equivalent, and vice versa.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter"]]},"sections":[],"variants":[{"paths":["\/documentation\/foundationessentials\/notificationcenter\/mainactormessage"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/NotificationCenter/MessageIdentifier":{"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MessageIdentifier","url":"\/documentation\/foundationessentials\/notificationcenter\/messageidentifier","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":