{"abstract":[{"text":"A protocol for creating types that you can post to a notification center and bind to the main actor.","type":"text"}],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter"]]},"relationshipsSections":[{"kind":"relationships","title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/FoundationEssentials\/s16SendableMetatypeP"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorMessage","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s16SendableMetatypeP","text":"SendableMetatype","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"text":"You post types conforming to  ","type":"text"},{"code":"MainActorMessage","type":"codeVoice"},{"text":" to a notification center using ","type":"text"},{"code":"post(_:subject:)","type":"codeVoice"},{"text":" and observe them with ","type":"text"},{"code":"addObserver(of:for:using:)","type":"codeVoice"},{"text":". The notification center delivers ","type":"text"},{"code":"MainActorMessage","type":"codeVoice"},{"text":" types synchronously when posted.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For types that post on an arbitrary isolation, use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each "},{"code":"MainActorMessage","type":"codeVoice"},{"type":"text","text":" is associated with a specific "},{"code":"Subject","type":"codeVoice"},{"type":"text","text":" type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, a "},{"type":"codeVoice","code":"MainActorMessage"},{"type":"text","text":" associated with the type "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" could use the following declaration:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct EventDidStart: NotificationCenter.MainActorMessage {","    typealias Subject = Event","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MainActorMessage"},{"type":"text","text":" can use an optional "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MessageIdentifier"},{"type":"text","text":" type for context-aware observer registration:"}]},{"type":"codeListing","syntax":"swift","code":["extension NotificationCenter.MessageIdentifier where Self == NotificationCenter.BaseMessageIdentifier<EventDidStart> {","    static var didStart: Self { .init() }","}"]},{"type":"paragraph","inlineContent":[{"text":"With this identifier, observers can receive information about a specific instance by registering for this message with a ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter","type":"reference","isActive":true},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let observerToken = NotificationCenter.default.addObserver(of: importantEvent, for: .didStart)"]},{"type":"paragraph","inlineContent":[{"text":"Or an observer can receive information about any instance with:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let observerToken = NotificationCenter.default.addObserver(of: Event.self, for: .didStart)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The notification center ties observation the lifetime of the returned "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/ObservationToken","type":"reference","isActive":true},{"text":" and automatically de-registers the observer if the token","type":"text"},{"text":" ","type":"text"},{"text":"goes out of scope. You can also remove observation explicitly:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["NotificationCenter.default.removeObserver(observerToken)"]},{"type":"heading","level":3,"text":"Notification Interoperability","anchor":"Notification-Interoperability"},{"type":"paragraph","inlineContent":[{"code":"MainActorMessage","type":"codeVoice"},{"text":" includes optional interoperability with ","type":"text"},{"type":"codeVoice","code":"Notification"},{"text":", enabling posters and observers of both types","type":"text"},{"text":" ","type":"text"},{"text":"to pass information.","type":"text"}]},{"inlineContent":[{"type":"text","text":"It does this by offering a "},{"type":"codeVoice","code":"makeMessage(_:)"},{"text":" method that collects values from a ","type":"text"},{"type":"codeVoice","code":"Notification"},{"text":"‘s ","type":"text"},{"type":"codeVoice","code":"Notification\/userInfo"},{"text":" and populates properties on a new message.","type":"text"},{"text":" ","type":"text"},{"text":"In the other direction, a ","type":"text"},{"type":"codeVoice","code":"makeNotification(_:)"},{"type":"text","text":" method collects the message’s defined properties and loads them into a new notification’s "},{"type":"codeVoice","code":"Notification\/userInfo"},{"type":"text","text":" dictionary."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, if there exists a "},{"type":"codeVoice","code":"Notification"},{"type":"text","text":" posted on "},{"type":"codeVoice","code":"MainActor"},{"text":" identified by the ","type":"text"},{"type":"codeVoice","code":"Notification\/Name"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\"eventDidFinish\""},{"text":" with a ","type":"text"},{"code":"Notification\/userInfo","type":"codeVoice"},{"type":"text","text":" "},{"text":"dictionary containing the key ","type":"text"},{"code":"\"duration\"","type":"codeVoice"},{"type":"text","text":" as an "},{"code":"NSNumber","type":"codeVoice"},{"text":", an app could post and observe the notification with the following ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage","isActive":true,"type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["struct EventDidFinish: NotificationCenter.MainActorMessage {","    typealias Subject = Event","    static var name: Notification.Name { Notification.Name(\"eventDidFinish\") }","","    var duration: Int","","    static func makeNotification(_ message: Self) -> Notification {","        return Notification(name: Self.name, userInfo: [\"duration\": NSNumber(message.duration)])","    }","","    static func makeMessage(_ notification: Notification) -> Self? {","        guard let userInfo = notification.userInfo,","              let duration = userInfo[\"duration\"] as? Int","        else {","            return nil","        }","","        return Self(duration: duration)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"With this definition, an observer for this "},{"type":"codeVoice","code":"MainActorMessage"},{"type":"text","text":" type receives information even if the poster used the "},{"type":"codeVoice","code":"Notification"},{"text":" equivalent, and vice versa.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","topicSections":[{"anchor":"Declaring-subject-type","title":"Declaring subject type","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage\/Subject"]}],"variants":[{"paths":["\/documenta