vationToken","isActive":true},{"text":" and automatically de-registers the observer if the token","type":"text"},{"text":" ","type":"text"},{"text":"goes out of scope. You can also remove observation explicitly:","type":"text"}]},{"code":["NotificationCenter.default.removeObserver(observerToken)"],"type":"codeListing","syntax":"swift"},{"text":"Notification Interoperability","type":"heading","anchor":"Notification-Interoperability","level":3},{"type":"paragraph","inlineContent":[{"code":"MainActorMessage","type":"codeVoice"},{"text":" includes optional interoperability with ","type":"text"},{"type":"codeVoice","code":"Notification"},{"type":"text","text":", enabling posters and observers of both types"},{"type":"text","text":" "},{"type":"text","text":"to pass information."}]},{"type":"paragraph","inlineContent":[{"text":"It does this by offering a ","type":"text"},{"code":"makeMessage(_:)","type":"codeVoice"},{"text":" method that collects values from a ","type":"text"},{"code":"Notification","type":"codeVoice"},{"text":"‘s ","type":"text"},{"code":"Notification\/userInfo","type":"codeVoice"},{"text":" and populates properties on a new message.","type":"text"},{"text":" ","type":"text"},{"text":"In the other direction, a ","type":"text"},{"code":"makeNotification(_:)","type":"codeVoice"},{"text":" method collects the message’s defined properties and loads them into a new notification’s ","type":"text"},{"code":"Notification\/userInfo","type":"codeVoice"},{"text":" dictionary.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, if there exists a ","type":"text"},{"code":"Notification","type":"codeVoice"},{"text":" posted on ","type":"text"},{"code":"MainActor","type":"codeVoice"},{"text":" identified by the ","type":"text"},{"code":"Notification\/Name","type":"codeVoice"},{"text":" ","type":"text"},{"code":"\"eventDidFinish\"","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"Notification\/userInfo","type":"codeVoice"},{"text":" ","type":"text"},{"text":"dictionary containing the key ","type":"text"},{"code":"\"duration\"","type":"codeVoice"},{"text":" as an ","type":"text"},{"code":"NSNumber","type":"codeVoice"},{"text":", an app could post and observe the notification with the following ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage"},{"text":":","type":"text"}]},{"code":["struct EventDidFinish: NotificationCenter.MainActorMessage {","    typealias Subject = Event","    static var name: Notification.Name { Notification.Name(\"eventDidFinish\") }","","    var duration: Int","","    static func makeNotification(_ message: Self) -> Notification {","        return Notification(name: Self.name, userInfo: [\"duration\": NSNumber(message.duration)])","    }","","    static func makeMessage(_ notification: Notification) -> Self? {","        guard let userInfo = notification.userInfo,","              let duration = userInfo[\"duration\"] as? Int","        else {","            return nil","        }","","        return Self(duration: duration)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"With this definition, an observer for this ","type":"text"},{"code":"MainActorMessage","type":"codeVoice"},{"text":" type receives information even if the poster used the ","type":"text"},{"code":"Notification","type":"codeVoice"},{"text":" equivalent, and vice versa.","type":"text"}]}],"kind":"content"}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/NotificationCenter/MainActorMessage/Subject":{"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage\/Subject","abstract":[{"type":"text","text":"A type which you can optionally post and observe along with this "},{"type":"codeVoice","code":"MainActorMessage"},{"type":"text","text":"."}