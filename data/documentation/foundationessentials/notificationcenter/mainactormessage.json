{"kind":"symbol","topicSections":[{"title":"Declaring subject type","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage\/Subject"],"anchor":"Declaring-subject-type"}],"seeAlsoSections":[{"generated":true,"title":"Declaring a notification message","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage"],"anchor":"Declaring-a-notification-message"}],"metadata":{"modules":[{"name":"FoundationEssentials"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MainActorMessage"}],"symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorMessage"}],"platforms":[{"introducedAt":"26.0","beta":false,"unavailable":false,"deprecated":false,"name":"iOS"},{"introducedAt":"26.0","beta":false,"unavailable":false,"deprecated":false,"name":"iPadOS"},{"introducedAt":"26.0","beta":false,"unavailable":false,"deprecated":false,"name":"Mac Catalyst"},{"introducedAt":"26.0","beta":false,"unavailable":false,"deprecated":false,"name":"macOS"},{"introducedAt":"26.0","beta":false,"unavailable":false,"deprecated":false,"name":"tvOS"},{"introducedAt":"26.0","beta":false,"unavailable":false,"deprecated":false,"name":"visionOS"},{"introducedAt":"26.0","beta":false,"unavailable":false,"deprecated":false,"name":"watchOS"}],"externalID":"s:20FoundationEssentials18NotificationCenterC16MainActorMessageP","roleHeading":"Protocol","extendedModule":"FoundationEssentials","title":"NotificationCenter.MainActorMessage"},"abstract":[{"type":"text","text":"A protocol for creating types that you can post to a notification center and bind to the main actor."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorMessage","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"SendableMetatype","preciseIdentifier":"s:s16SendableMetatypeP","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"You post types conforming to  ","type":"text"},{"type":"codeVoice","code":"MainActorMessage"},{"text":" to a notification center using ","type":"text"},{"type":"codeVoice","code":"post(_:subject:)"},{"text":" and observe them with ","type":"text"},{"type":"codeVoice","code":"addObserver(of:for:using:)"},{"text":". The notification center delivers ","type":"text"},{"type":"codeVoice","code":"MainActorMessage"},{"text":" types synchronously when posted.","type":"text"}]},{"inlineContent":[{"type":"text","text":"For types that post on an arbitrary isolation, use "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"type":"codeVoice","code":"MainActorMessage"},{"text":" is associated with a specific ","type":"text"},{"type":"codeVoice","code":"Subject"},{"text":" type.","type":"text"}]},{"inlineContent":[{"type":"text","text":"For example, a "},{"code":"MainActorMessage","type":"codeVoice"},{"type":"text","text":" associated with the type "},{"code":"Event","type":"codeVoice"},{"type":"text","text":" could use the following declaration:"}],"type":"paragraph"},{"code":["struct EventDidStart: NotificationCenter.MainActorMessage {","    typealias Subject = Event","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MainActorMessage"},{"text":" can use an optional ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MessageIdentifier","isActive":true,"type":"reference"},{"text":" type for context-aware observer registration:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["extension NotificationCenter.MessageIdentifier where Self == NotificationCenter.BaseMessageIdentifier<EventDidStart> {","    static var didStart: Self { .init() }","}"]},{"inlineContent":[{"type":"text","text":"With this identifier, observers can receive information about a specific instance by registering for this message with a "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter","isActive":true,"type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let observerToken = NotificationCenter.default.addObserver(of: importantEvent, for: .didStart)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Or an observer can receive information about any instance with:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let observerToken = NotificationCenter.default.addObserver(of: Event.self, for: .didStart)"]},{"inlineContent":[{"type":"text","text":"The notification center ties observation the lifetime of the returned "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/ObservationToken","isActive":true,"type":"reference"},{"type":"text","text":" and automatically de-registers the observer if the token"},{"type":"text","text":" "},{"type":"text","text":"goes out of scope. You can also remove observation explicitly:"}],"type":"paragraph"},{"code":["NotificationCenter.default.removeObserver(observerToken)"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"Notification-Interoperability","text":"Notification Interoperability"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MainActorMessage"},{"text":" includes optional interoperability with ","type":"text"},{"type":"codeVoice","code":"Notification"},{"text":", enabling posters and observers of both types","type":"text"},{"text":" ","type":"text"},{"text":"to pass information.","type":"text"}]},{"inlineContent":[{"type":"text","text":"It does this by offering a "},{"code":"makeMessage(_:)","type":"codeVoice"},{"type":"text","text":" method that collects values from a "},{"code":"Notification","type":"codeVoice"},{"type":"text","text":"‘s "},{"code":"Notification\/userInfo","type":"codeVoice"},{"type":"text","text":" and populates properties on a new message."},{"type":"text","text":" "},{"type":"text","text":"In the other direction, a "},{"code":"makeNotification(_:)","type":"codeVoice"},{"type":"text","text":" method collects the message’s defined properties and loads them into a new notification’s "},{"code":"Notification\/userInfo","type":"codeVoice"},{"type":"text","text":" dictionary."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"For example, if there exists a ","type":"text"},{"type":"codeVoice","code":"Notification"},{"text":" posted on ","type":"text"},{"type":"codeVoice","code":"MainActor"},{"text":" identified by the ","type":"text"},{"type":"codeVoice","code":"Notification\/Name"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\"eventDidFinish\""},{"text":" with a ","type":"text"},{"type":"codeVoice","code":"Notification\/userInfo"},{"text":" ","type":"text"},{"text":"dictionary containing the key ","type":"text"},{"type":"codeVoice","code":"\"duration\""},{"text":" as an ","type":"text"},{"type":"codeVoice","code":"NSNumber"},{"text":", an app could post and observe the notification with the following ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct EventDidFinish: NotificationCenter.MainActorMessage {","    typealias Subject = Event","    static var name: Notification.Name { Notification.Name(\"eventDidFinish\") }","","    var duration: Int","","    static func makeNotification(_ message: Self) -> Notification {","        return Notification(name: Self.name, userInfo: [\"duration\": NSNumber(message.duration)])","    }","","    static func makeMessage(_ notification: Notification) -> Self? {","        guard let userInfo = notification.userInfo,","              let duration = userInfo[\"duration\"] as? Int","        else {","            return nil","        }","","        return Self(duration: duration)","    }","}"]},{"inlineContent":[{"type":"text","text":"With this definition, an observer for this "},{"code":"MainActorMessage","type":"codeVoice"},{"type":"text","text":" type receives information even if the poster used the "},{"code":"Notification","type":"codeVoice"},{"type":"text","text":" equivalent, and vice versa."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/notificationcenter\/mainactormessage"]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter"]]},"relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/FoundationEssentials\/s16SendableMetatypeP"],"kind":"relationships"}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/NotificationCenter/MainActorMessage":{"url":"\/documentation\/foundationessentials\/notificationcenter\/mainactormessage","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorMessage","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/