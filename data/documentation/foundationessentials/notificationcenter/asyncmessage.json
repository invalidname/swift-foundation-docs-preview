y post and observe along with this ","type":"text"},{"type":"codeVoice","code":"AsyncMessage"},{"text":".","type":"text"}],"role":"symbol"},"doc://FoundationEssentials/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/FoundationEssentials\/s8SendableP"},"doc://FoundationEssentials/documentation/FoundationEssentials/NotificationCenter/MainActorMessage":{"navigatorTitle":[{"text":"MainActorMessage","kind":"identifier"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage","abstract":[{"text":"A protocol for creating types that you can post to a notification center and bind to the main actor.","type":"text"}],"kind":"symbol","url":"\/documentation\/foundationessentials\/notificationcenter\/mainactormessage","title":"NotificationCenter.MainActorMessage","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorMessage","kind":"identifier"}],"role":"symbol","type":"topic"},"doc://FoundationEssentials/documentation/FoundationEssentials/NotificationCenter/ObservationToken":{"role":"symbol","title":"NotificationCenter.ObservationToken","abstract":[{"type":"text","text":"A unique token representing a single observer registration in a notification center."}],"type":"topic","url":"\/documentation\/foundationessentials\/notificationcenter\/observationtoken","navigatorTitle":[{"kind":"identifier","text":"ObservationToken"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/ObservationToken","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ObservationToken"}]},"doc://FoundationEssentials/documentation/FoundationEssentials":{"role":"collection","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","abstract":[{"type":"text","text":"Access essential data types, collections, and operating-system service