{"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage"],"title":"Declaring a notification message","anchor":"Declaring-a-notification-message"}],"sections":[],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage","interfaceLanguage":"swift"},"abstract":[{"text":"A protocol for creating types that you can post to a notification center, which posts them to an arbitrary isolation.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage\/Subject"],"title":"Declaring subject type","anchor":"Declaring-subject-type"}],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"],"title":"Inherits From"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"externalID":"s:20FoundationEssentials18NotificationCenterC12AsyncMessageP","roleHeading":"Protocol","symbolKind":"protocol","platforms":[{"name":"iOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"26.0"},{"name":"iPadOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"26.0"},{"name":"Mac Catalyst","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"26.0"},{"name":"macOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"26.0"},{"name":"tvOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"26.0"},{"name":"visionOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"26.0"},{"name":"watchOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"26.0"}],"navigatorTitle":[{"text":"AsyncMessage","kind":"identifier"}],"extendedModule":"FoundationEssentials","modules":[{"name":"FoundationEssentials"}],"title":"NotificationCenter.AsyncMessage","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncMessage","kind":"identifier"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncMessage"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"You post types conforming to "},{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" to a notification center using "},{"type":"codeVoice","code":"post(_:subject:)"},{"type":"text","text":" and observe them with "},{"type":"codeVoice","code":"addObserver(of:for:using:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The notification center delivers "},{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" types asynchronously when posted. Asynchronous delivery isn’t suitable"},{"type":"text","text":" "},{"type":"text","text":"for messages with time-critical deliveries, such as a message that must have its observers called before a certain"},{"type":"text","text":" "},{"type":"text","text":"action takes place."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For types that post on the main actor, use "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" is associated with a specific "},{"type":"codeVoice","code":"Subject"},{"type":"text","text":" type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, an "},{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" associated with the type "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" could use the following declaration:"}],"type":"paragraph"},{"code":["struct EventDidStart: NotificationCenter.AsyncMessage {","    typealias Subject = Event","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" can use an optional "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MessageIdentifier","isActive":true},{"type":"text","text":" type for context-aware observer registration:"}],"type":"paragraph"},{"code":["extension NotificationCenter.MessageIdentifier where Self == NotificationCenter.BaseMessageIdentifier<EventDidStart> {","    static var didStart: Self { .init() }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"With this identifier, observers can receive information about a specific instance by registering for this message with a "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let observerToken = NotificationCenter.default.addObserver(of: importantEvent, for: .didStart)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or an observer can receive information about any instance with:"}],"type":"paragraph"},{"code":["let observerToken = NotificationCenter.default.addObserver(of: Event.self, for: .didStart)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The notification center ties observation the lifetime of the returned "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/ObservationToken","isActive":true},{"type":"text","text":" and automatically de-registers the observer if the token"},{"type":"text","text":" "},{"type":"text","text":"goes out of scope. You can also remove observation explicitly:"}],"type":"paragraph"},{"code":["NotificationCenter.default.removeObserver(observerToken)"],"syntax":"swift","type":"codeListing"},{"text":"Notification Interoperability","level":3,"type":"heading","anchor":"Notification-Interoperability"},{"inlineContent":[{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" includes optional interoperability with "},{"type":"codeVoice","code":"Notification"},{"type":"text","text":", enabling posters and observers of both types"},{"type":"text","text":" "},{"type":"text","text":"to pass information."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It does this by offering a "},{"type":"codeVoice","code":"makeMessage(_:)"},{"type":"text","text":" method that collects values from a "},{"type":"codeVoice","code":"Notification"},{"type":"text","text":"‘s "},{"type":"codeVoice","code":"Notification\/userInfo"},{"type":"text","text":" and populates properties on a new message."},{"type":"text","text":" "},{"type":"text","text":"In the other direction, a "},{"type":"codeVoice","code":"makeNotification(_:)"},{"type":"text","text":" method collects the message’s defined properties and loads them into a new notification’s "},{"type":"codeVoice","code":"Notification\/userInfo"},{"type":"text","text":" dictionary."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, if there exists a "},{"type":"codeVoice","code":"Notification"},{"type":"text","text":" posted on an arbitrary isolation identified by the "},{"type":"codeVoice","code":"Notification\/Name"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"eventDidFinish\""},{"type":"text","text":" with a "},{"type":"codeVoice","code":"Notification\/userInfo"},{"type":"text","text":" "},{"type":"text","text":"dictionary containing the key "},{"type":"codeVoice","code":"\"duration\""},{"type":"text","text":" as an "},{"type":"codeVoice","code":"NSNumber"},{"type":"text","text":", an app could post and observe the notification with the following "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["struct EventDidFinish: NotificationCenter.AsyncMessage {","    typealias Subject = Event","    static var name: Notification.Name { Notification.Name(\"eventDidFinish\") }","","    var duration: Int","","    static func makeNotification(_ message: Self) -> Notification {","        return Notification(name: Self.name, userInfo: [\"duration\": NSNumber(message.duration)])","    }","","    static func makeMessage(_ notification: Notification) -> Self? {","        guard let userInfo = notification.userInfo,","              let duration = userInfo[\"duration\"] as? Int","        else {","            return nil","        }","","        return Self(duration: duration)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"With this definition, an observer for this "},{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" type receives information even if the poster used the "},{"type":"codeVoice","code":"Notification"},{"type":"text","text":" equivalent, and vice versa."}],"type":"paragraph"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter"]]},"variants":[{"paths":["\/documentation\/foundationessentials\/notificationcenter\/asyncmessage"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://FoundationEssentials/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/s16SendableMetatypeP","title":"Swift.Senda