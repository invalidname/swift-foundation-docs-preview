{"topicSections":[{"title":"Declaring subject type","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage\/Subject"],"anchor":"Declaring-subject-type"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"extendedModule":"FoundationEssentials","roleHeading":"Protocol","role":"symbol","platforms":[{"name":"iOS","beta":false,"unavailable":false,"introducedAt":"26.0","deprecated":false},{"name":"iPadOS","beta":false,"unavailable":false,"introducedAt":"26.0","deprecated":false},{"name":"Mac Catalyst","beta":false,"unavailable":false,"introducedAt":"26.0","deprecated":false},{"name":"macOS","beta":false,"unavailable":false,"introducedAt":"26.0","deprecated":false},{"name":"tvOS","beta":false,"unavailable":false,"introducedAt":"26.0","deprecated":false},{"name":"visionOS","beta":false,"unavailable":false,"introducedAt":"26.0","deprecated":false},{"name":"watchOS","beta":false,"unavailable":false,"introducedAt":"26.0","deprecated":false}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncMessage","kind":"identifier"}],"modules":[{"name":"FoundationEssentials"}],"navigatorTitle":[{"text":"AsyncMessage","kind":"identifier"}],"title":"NotificationCenter.AsyncMessage","symbolKind":"protocol","externalID":"s:20FoundationEssentials18NotificationCenterC12AsyncMessageP"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/notificationcenter\/asyncmessage"]}],"relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"],"type":"inheritsFrom"}],"sections":[],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"text":"A protocol for creating types that you can post to a notification center, which posts them to an arbitrary isolation.","type":"text"}],"seeAlsoSections":[{"generated":true,"title":"Declaring a notification message","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage"],"anchor":"Declaring-a-notification-message"}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncMessage","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You post types conforming to "},{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" to a notification center using "},{"code":"post(_:subject:)","type":"codeVoice"},{"type":"text","text":" and observe them with "},{"code":"addObserver(of:for:using:)","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The notification center delivers "},{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" types asynchronously when posted. Asynchronous delivery isn’t suitable"},{"type":"text","text":" "},{"type":"text","text":"for messages with time-critical deliveries, such as a message that must have its observers called before a certain"},{"type":"text","text":" "},{"type":"text","text":"action takes place."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For types that post on the main actor, use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" is associated with a specific "},{"code":"Subject","type":"codeVoice"},{"type":"text","text":" type."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, an "},{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" associated with the type "},{"code":"Event","type":"codeVoice"},{"type":"text","text":" could use the following declaration:"}]},{"syntax":"swift","type":"codeListing","code":["struct EventDidStart: NotificationCenter.AsyncMessage {","    typealias Subject = Event","}"]},{"type":"paragraph","inlineContent":[{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" can use an optional "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MessageIdentifier"},{"type":"text","text":" type for context-aware observer registration:"}]},{"syntax":"swift","type":"codeListing","code":["extension NotificationCenter.MessageIdentifier where Self == NotificationCenter.BaseMessageIdentifier<EventDidStart> {","    static var didStart: Self { .init() }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With this identifier, observers can receive information about a specific instance by registering for this message with a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["let observerToken = NotificationCenter.default.addObserver(of: importantEvent, for: .didStart)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or an observer can receive information about any instance with:"}]},{"syntax":"swift","type":"codeListing","code":["let observerToken = NotificationCenter.default.addObserver(of: Event.self, for: .didStart)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The notification center ties observation the lifetime of the returned "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/ObservationToken"},{"type":"text","text":" and automatically de-registers the observer if the token"},{"type":"text","text":" "},{"type":"text","text":"goes out of scope. You can also remove observation explicitly:"}]},{"type":"codeListing","syntax":"swift","code":["NotificationCenter.default.removeObserver(observerToken)"]}],"kind":"content"}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials":{"role":"collection","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","abstract":[{"type":"text","text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app."}],"kind":"symbol","url":"\/documentation\/foundationessentials","title":"FoundationEssentials"},"doc://FoundationEssentials/documentation/FoundationEssentials/NotificationCenter/MainActorMessage":{"type":"topic","url":"\/documentation\/foundationessentials\/notificationcenter\/mainactormessage","role":"symbol","abstract":[{"type":"text","text":"A protocol for creating types that you can post to a notification center and bind to the main actor."}],"navigatorTitle":[{"text":"MainActorMessage","kind":"identifier"}],"kind":"symbol","title":"NotificationCenter.MainActorMessage","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorMessage","kind":"identifier"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage"},"doc://FoundationEssentials/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/FoundationEssentials\/