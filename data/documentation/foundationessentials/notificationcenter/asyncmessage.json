/FoundationEssentials/documentation/FoundationEssentials/NotificationCenter/ObservationToken":{"title":"NotificationCenter.ObservationToken","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/ObservationToken","type":"topic","abstract":[{"type":"text","text":"A unique token representing a single observer registration in a notification center."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ObservationToken","kind":"identifier"}],"url":"\/documentation\/foundationessentials\/notificationcenter\/observationtoken","navigatorTitle":[{"text":"ObservationToken","kind":"identifier"}],"kind":"symbol"}}}