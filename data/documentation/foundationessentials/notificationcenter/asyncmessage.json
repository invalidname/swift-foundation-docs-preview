{"seeAlsoSections":[{"anchor":"Declaring-a-notification-message","generated":true,"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage"],"title":"Declaring a notification message"}],"metadata":{"role":"symbol","symbolKind":"protocol","modules":[{"name":"FoundationEssentials"}],"externalID":"s:20FoundationEssentials18NotificationCenterC12AsyncMessageP","extendedModule":"FoundationEssentials","roleHeading":"Protocol","title":"NotificationCenter.AsyncMessage","platforms":[{"name":"iOS","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"26.0"},{"name":"iPadOS","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"26.0"},{"name":"Mac Catalyst","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"26.0"},{"name":"macOS","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"26.0"},{"name":"tvOS","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"26.0"},{"name":"visionOS","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"26.0"},{"name":"watchOS","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"26.0"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncMessage","kind":"identifier"}],"navigatorTitle":[{"text":"AsyncMessage","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter"]]},"sections":[],"kind":"symbol","abstract":[{"text":"A protocol for creating types that you can post to a notification center, which posts them to an arbitrary isolation.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncMessage","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"You post types conforming to ","type":"text"},{"code":"AsyncMessage","type":"codeVoice"},{"text":" to a notification center using ","type":"text"},{"code":"post(_:subject:)","type":"codeVoice"},{"text":" and observe them with ","type":"text"},{"code":"addObserver(of:for:using:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The notification center delivers ","type":"text"},{"code":"AsyncMessage","type":"codeVoice"},{"text":" types asynchronously when posted. Asynchronous delivery isn’t suitable","type":"text"},{"text":" ","type":"text"},{"text":"for messages with time-critical deliveries, such as a message that must have its observers called before a certain","type":"text"},{"text":" ","type":"text"},{"text":"action takes place.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For types that post on the main actor, use ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"code":"AsyncMessage","type":"codeVoice"},{"text":" is associated with a specific ","type":"text"},{"code":"Subject","type":"codeVoice"},{"text":" type.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, an ","type":"text"},{"code":"AsyncMessage","type":"codeVoice"},{"text":" associated with the type ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" could use the following declaration:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct EventDidStart: NotificationCenter.AsyncMessage {","    typealias Subject = Event","}"]},{"type":"paragraph","inlineContent":[{"code":"AsyncMessage","type":"codeVoice"},{"text":" can use an optional ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MessageIdentifier","type":"reference","isActive":true},{"text":" type for context-aware observer registration:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["extension NotificationCenter.MessageIdentifier where Self == NotificationCenter.BaseMessageIdentifier<EventDidStart> {","    static var didStart: Self { .init() }","}"]},{"type":"paragraph","inlineContent":[{"text":"With this identifier, observers can receive information about a specific instance by registering for this message with a ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter","type":"reference","isActive":true},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let observerToken = NotificationCenter.default.addObserver(of: importantEvent, for: .didStart)"]},{"type":"paragraph","inlineContent":[{"text":"Or an observer can receive information about any instance with:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let observerToken = NotificationCenter.default.addObserver(of: Event.self, for: .didStart)"]},{"type":"paragraph","inlineContent":[{"text":"The notification center ties observation the lifetime of the returned ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/ObservationToken","type":"reference","isActive":true},{"text":" and automatically de-registers the observer if the token","type":"text"},{"text":" ","type":"text"},{"text":"goes out of scope. You can also remove observation explicitly:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["NotificationCenter.default.removeObserver(observerToken)"]},{"level":3,"text":"Notification Interoperability","anchor":"Notification-Interoperability","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"AsyncMessage","type":"codeVoice"},{"text":" includes optional interoperability with ","type":"text"},{"code":"Notification","type":"codeVoice"},{"text":", enabling posters and observers of both types","type":"text"},{"text":" ","type":"text"},{"text":"to pass information.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It does this by offering a ","type":"text"},{"code":"makeMessage(_:)","type":"codeVoice"},{"text":" method that collects values from a ","type":"text"},{"code":"Notification","type":"codeVoice"},{"text":"‘s ","type":"text"},{"code":"Notification\/userInfo","type":"codeVoice"},{"text":" and populates properties on a new message.","type":"text"},{"text":" ","type":"text"},{"text":"In the other direction, a ","type":"text"},{"code":"makeNotification(_:)","type":"codeVoice"},{"text":" method collects the message’s defined properties and loads them into a new notification’s ","type":"text"},{"code":"Notification\/userInfo","type":"codeVoice"},{"text":" dictionary.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, if there exists a ","type":"text"},{"code":"Notification","type":"codeVoice"},{"text":" posted on an arbitrary isolation identified by the ","type":"text"},{"code":"Notification\/Name","type":"codeVoice"},{"text":" ","type":"text"},{"code":"\"eventDidFinish\"","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"Notification\/userInfo","type":"codeVoice"},{"text":" ","type":"text"},{"text":"dictionary containing the key ","type":"text"},{"code":"\"duration\"","type":"codeVoice"},{"text":" as an ","type":"text"},{"code":"NSNumber","type":"codeVoice"},{"text":", an app could post and observe the notification with the following ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage","type":"reference","isActive":true},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct EventDidFinish: NotificationCenter.AsyncMessage {","    typealias Subject = Event","    static var name: Notification.Name { Notification.Name(\"eventDidFinish\") }","","    var duration: Int","","    static func makeNotification(_ message: Self) -> Notification {","        return Notification(name: Self.name, userInfo: [\"duration\": NSNumber(message.duration)])","    }","","    static func makeMessage(_ notification: Notification) -> Self? {","        guard let userInfo = notification.userInfo,","              let duration = userInfo[\"duration\"] as? Int","        else {","            return nil","        }","","        return Self(duration: duration)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"With this definition, an observer for this ","type":"text"},{"code":"AsyncMessage","type":"codeVoice"},{"text":" type receives information even if the poster used the ","type":"text"},{"code":"Notification","type":"codeVoice"},{"text":" equivalent, and vice versa.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/notificationcenter\/asyncmessage"]}],"topicSections":[{"anchor":"Declaring-subject-type","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage\/Subject"],"title":"Declaring subject type"}],"relationshipsSections":[{"type":"inheritsFrom","identifiers":["doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"],"title":"Inherits From","kind":"relationships"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage","interfaceLanguage":"swift"},"references":{"doc://FoundationEssentials/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/s16SendableMetatypeP","title":"Swift.Senda