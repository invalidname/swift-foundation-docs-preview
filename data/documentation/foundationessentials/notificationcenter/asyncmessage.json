dationEssentials\/NotificationCenter\/MainActorMessage"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"code":"AsyncMessage","type":"codeVoice"},{"text":" is associated with a specific ","type":"text"},{"code":"Subject","type":"codeVoice"},{"text":" type.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, an ","type":"text"},{"code":"AsyncMessage","type":"codeVoice"},{"text":" associated with the type ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" could use the following declaration:","type":"text"}]},{"type":"codeListing","code":["struct EventDidStart: NotificationCenter.AsyncMessage {","    typealias Subject = Event","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"AsyncMessage","type":"codeVoice"},{"text":" can use an optional ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MessageIdentifier"},{"text":" type for context-aware observer registration:","type":"text"}]},{"type":"codeListing","code":["extension NotificationCenter.MessageIdentifier where Self == NotificationCenter.BaseMessageIdentifier<EventDidStart> {","    static var didStart: Self { .init() }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"With this identifier, observers can receive information about a specific instance by registering for this message with a "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let observerToken = NotificationCenter.default.addObserver(of: importantEvent, for: .didStart)"],"type":"codeListing"},{"inlineContent":[{"text":"Or an observer can receive information about any instance with:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let observerToken = NotificationCenter.default.addObserver(of: Event.self, for: .didStart)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The notification center ties observation the lifetime of the returned ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/ObservationToken","type":"reference"},{"text":" and automatically de-registers the observer if the token","type":"text"},{"text":" ","type":"text"},{"text":"goes out of scope. You can also remove observation explicitly:","type":"text"}]},{"type":"codeListing","code":["NotificationCenter.default.removeObserver(observerToken)"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"Notification-Interoperability","text":"Notification Interoperability"},{"type":"paragraph","inlineContent":[{"code":"AsyncMessage","type":"codeVoice"},{"text":" includes optional interoperability with ","type":"text"},{"code":"Notification","type":"codeVoice"},{"text":", enabling posters and observers of both types","type":"text"},{"type":"text","text":" "},{"text":"to pass information.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It does this by offering a "},{"code":"makeMessage(_:)","type":"codeVoice"},{"type":"text","text":" method that collects values from a "},{"type":"codeVoice","code":"Notification"},{"type":"text","text":"‘s "},{"type":"codeVoice","code":"Notification\/userInfo"},{"text":" and populates properties on a new message.","type":"text"},{"type":"text","text":" "},{"text":"In the other direction, a ","type":"text"},{"code":"makeNotification(_:)","type":"codeVoice"},{"text":" method collects the message’s defined properties and loads them into a new notification’s ","type":"text"},{"code":"Notification\/userInfo","type":"codeVoice"},{"text":" dictionary.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, if there exists a ","type":"text"},{"code":"Notification","type":"codeVoice"},{"text":" posted on an arbitrary isolation identified by the ","type":"text"},{"code":"Notification\/Name","type":"codeVoice"},{"text":" ","type":"text"},{"code":"\"eventDidFinish\"","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"Notification\/userInfo","type":"codeVoice"},{"text":" ","type":"text"},{"text":"dictionary containing the key ","type":"text"},{"code":"\"duration\"","type":"codeVoice"},{"text":" as an ","type":"text"},{"code":"NSNumber","type":"codeVoice"},{"text":", an app could post and observe the notification with the following ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage","type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","code":["struct EventDidFinish: NotificationCenter.AsyncMessage {","    typealias Subject = Event","    static var name: Notification.Name { Notification.Name(\"eventDidFinish\") }","","    var duration: Int","","    static func makeNotification(_ message: Self) -> Notification {","        return Notification(name: Self.name, userInfo: [\"duration\": NSNumber(message.duration)])","    }","","    static func makeMessage(_ notification: Notification) -> Self? {","        guard let userInfo = notification.userInfo,","              let duration = userInfo[\"duration\"] as? Int","        else {","            return nil","        }","","        return Self(duration: duration)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With this definition, an observer for this "},{"code":"AsyncMessage","type":"codeVoice"},{"text":" type receives information even if the poster used the ","type":"text"},{"code":"Notification","type":"codeVoice"},{"text":" equivalent, and vice versa.","type":"text"}]}]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/NotificationCenter/MessageIdentifier":{"kind":"symbol","navigatorTitle":[{"text":"MessageIdentif