{"topicSections":[{"anchor":"Declaring-subject-type","title":"Declaring subject type","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage\/Subject"]}],"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncMessage"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"You post types conforming to "},{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" to a notification center using "},{"code":"post(_:subject:)","type":"codeVoice"},{"type":"text","text":" and observe them with "},{"code":"addObserver(of:for:using:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The notification center delivers "},{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" types asynchronously when posted. Asynchronous delivery isn’t suitable"},{"type":"text","text":" "},{"type":"text","text":"for messages with time-critical deliveries, such as a message that must have its observers called before a certain"},{"type":"text","text":" "},{"type":"text","text":"action takes place."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For types that post on the main actor, use "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each "},{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" is associated with a specific "},{"code":"Subject","type":"codeVoice"},{"type":"text","text":" type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, an "},{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" associated with the type "},{"code":"Event","type":"codeVoice"},{"type":"text","text":" could use the following declaration:"}],"type":"paragraph"},{"syntax":"swift","code":["struct EventDidStart: NotificationCenter.AsyncMessage {","    typealias Subject = Event","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" can use an optional "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MessageIdentifier"},{"text":" type for context-aware observer registration:","type":"text"}],"type":"paragraph"},{"code":["extension NotificationCenter.MessageIdentifier where Self == NotificationCenter.BaseMessageIdentifier<EventDidStart> {","    static var didStart: Self { .init() }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"With this identifier, observers can receive information about a specific instance by registering for this message with a "},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter","type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let observerToken = NotificationCenter.default.addObserver(of: importantEvent, for: .didStart)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Or an observer can receive information about any instance with:"}],"type":"paragraph"},{"code":["let observerToken = NotificationCenter.default.addObserver(of: Event.self, for: .didStart)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The notification center ties observation the lifetime of the returned "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/ObservationToken"},{"text":" and automatically de-registers the observer if the token","type":"text"},{"type":"text","text":" "},{"text":"goes out of scope. You can also remove observation explicitly:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["NotificationCenter.default.removeObserver(observerToken)"],"syntax":"swift"}],"kind":"content"}],"abstract":[{"text":"A protocol for creating types that you can post to a notification center, which posts them to an arbitrary isolation.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","metadata":{"roleHeading":"Protocol","role":"symbol","symbolKind":"protocol","platforms":[{"introducedAt":"26.0","name":"iOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"26.0","name":"iPadOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"26.0","name":"Mac Catalyst","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"26.0","name":"macOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"26.0","name":"tvOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"26.0","name":"visionOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"26.0","name":"watchOS","unavailable":false,"beta":false,"deprecated":false}],"extendedModule":"FoundationEssentials","title":"NotificationCenter.AsyncMessage","externalID":"s:20FoundationEssentials18NotificationCenterC12AsyncMessageP","modules":[{"name":"FoundationEssentials"}],"navigatorTitle":[{"text":"AsyncMessage","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncMessage","kind":"identifier"}]},"variants":[{"paths":["\/documentation\/foundati