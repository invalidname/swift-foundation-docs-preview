{"abstract":[{"text":"A protocol for creating types that you can post to a notification center, which posts them to an arbitrary isolation.","type":"text"}],"metadata":{"modules":[{"name":"FoundationEssentials"}],"navigatorTitle":[{"text":"AsyncMessage","kind":"identifier"}],"platforms":[{"deprecated":false,"unavailable":false,"name":"iOS","introducedAt":"26.0","beta":false},{"deprecated":false,"unavailable":false,"name":"iPadOS","introducedAt":"26.0","beta":false},{"deprecated":false,"unavailable":false,"name":"Mac Catalyst","introducedAt":"26.0","beta":false},{"deprecated":false,"unavailable":false,"name":"macOS","introducedAt":"26.0","beta":false},{"deprecated":false,"unavailable":false,"name":"tvOS","introducedAt":"26.0","beta":false},{"deprecated":false,"unavailable":false,"name":"visionOS","introducedAt":"26.0","beta":false},{"deprecated":false,"unavailable":false,"name":"watchOS","introducedAt":"26.0","beta":false}],"role":"symbol","symbolKind":"protocol","extendedModule":"FoundationEssentials","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncMessage","kind":"identifier"}],"externalID":"s:20FoundationEssentials18NotificationCenterC12AsyncMessageP","title":"NotificationCenter.AsyncMessage","roleHeading":"Protocol"},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncMessage","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"You post types conforming to "},{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" to a notification center using "},{"code":"post(_:subject:)","type":"codeVoice"},{"type":"text","text":" and observe them with "},{"code":"addObserver(of:for:using:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The notification center delivers "},{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" types asynchronously when posted. Asynchronous delivery isn’t suitable"},{"type":"text","text":" "},{"type":"text","text":"for messages with time-critical deliveries, such as a message that must have its observers called before a certain"},{"type":"text","text":" "},{"type":"text","text":"action takes place."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For types that post on the main actor, use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each "},{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" is associated with a specific "},{"code":"Subject","type":"codeVoice"},{"type":"text","text":" type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, an "},{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" associated with the type "},{"code":"Event","type":"codeVoice"},{"type":"text","text":" could use the following declaration:"}],"type":"paragraph"},{"syntax":"swift","code":["struct EventDidStart: NotificationCenter.AsyncMessage {","    typealias Subject = Event","}"],"type":"codeListing"},{"inlineContent":[{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" can use an optional "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MessageIdentifier"},{"type":"text","text":" type for context-aware observer registration:"}],"type":"paragraph"},{"syntax":"swift","code":["extension NotificationCenter.MessageIdentifier where Self == NotificationCenter.BaseMessageIdentifier<EventDidStart> {","    static var didStart: Self { .init() }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"With this identifier, observers can receive information about a specific instance by registering for this message with a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let observerToken = NotificationCenter.default.addObserver(of: importantEvent, for: .didStart)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or an observer can receive information about any instance with:"}],"type":"paragraph"},{"syntax":"swift","code":["let observerToken = NotificationCenter.default.addObserver(of: Event.self, for: .didStart)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The notification center ties observation the lifetime of the returned "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/ObservationToken"},{"type":"text","text":" and automatically de-registers the observer if the token"},{"type":"text","text":" "},{"type":"text","text":"goes out of scope. You can also remove observation explicitly:"}],"type":"paragraph"},{"syntax":"swift","code":["NotificationCenter.default.removeObserver(observerToken)"],"type":"codeListing"},{"anchor":"Notification-Interoperability","type":"heading","level":3,"text":"Notification Interoperability"},{"inlineContent":[{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" includes optional interoperability with "},{"code":"Notification","type":"codeVoice"},{"type":"text","text":", enabling posters and observers of both types"},{"type":"text","text":" "},{"type":"text","text":"to pass information."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It does this by offering a "},{"code":"makeMessage(_:)","type":"codeVoice"},{"type":"text","text":" method that collects values from a "},{"code":"Notification","type":"codeVoice"},{"type":"text","text":"‘s "},{"code":"Notification\/userInfo","type":"codeVoice"},{"type":"text","text":" and populates properties on a new message."},{"type":"text","text":" "},{"type":"text","text":"In the other direction, a "},{"code":"makeNotification(_:)","type":"codeVoice"},{"type":"text","text":" method collects the message’s defined properties and loads them into a new notification’s "},{"code":"Notification\/userInfo","type":"codeVoice"},{"type":"text","text":" dictionary."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, if there exists a "},{"code":"Notification","type":"codeVoice"},{"type":"text","text":" posted on an arbitrary isolation identified by the "},{"code":"Notification\/Name","type":"codeVoice"},{"type":"text","text":" "},{"code":"\"eventDidFinish\"","type":"codeVoice"},{"type":"text","text":" with a "},{"code":"Notification\/userInfo","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"dictionary containing the key "},{"code":"\"duration\"","type":"codeVoice"},{"type":"text","text":" as an "},{"code":"NSNumber","type":"codeVoice"},{"type":"text","text":", an app could post and observe the notification with the following "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["struct EventDidFinish: NotificationCenter.AsyncMessage {","    typealias Subject = Event","    static var name: Notification.Name { Notification.Name(\"eventDidFinish\") }","","    var duration: Int","","    static func makeNotification(_ message: Self) -> Notification {","        return Notification(name: Self.name, userInfo: [\"duration\": NSNumber(message.duration)])","    }","","    static func makeMessage(_ notification: Notification) -> Self? {","        guard let userInfo = notification.userInfo,","              let duration = userInfo[\"duration\"] as? Int","        else {","            return nil","        }","","        return Self(duration: duration)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"With this definition, an observer for this "},{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" type receives information even if the poster used the "},{"code":"Notification","type":"codeVoice"},{"type":"text","text":" equivalent, and vice versa."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/foundationessentials\/notificationcenter\/asyncmessage"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Declaring-subject-type","title":"Declaring subject type","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage\/Subject"]}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter"]]},"relationshipsSections":[{"identifiers":["doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"],"type":"inheritsFrom","title":"Inherits From","kind":"relationships"}],"seeAlsoSections":[{"title":"Declaring a notification message","anchor":"Declaring-a-notification-message","generated":true,"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage"]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials":{"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssential