{"sections":[],"topicSections":[{"anchor":"Declaring-subject-type","title":"Declaring subject type","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage\/Subject"]}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage"},"relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"],"kind":"relationships"}],"abstract":[{"type":"text","text":"A protocol for creating types that you can post to a notification center, which posts them to an arbitrary isolation."}],"seeAlsoSections":[{"anchor":"Declaring-a-notification-message","title":"Declaring a notification message","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage"],"generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncMessage","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You post types conforming to "},{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" to a notification center using "},{"type":"codeVoice","code":"post(_:subject:)"},{"type":"text","text":" and observe them with "},{"type":"codeVoice","code":"addObserver(of:for:using:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The notification center delivers "},{"code":"AsyncMessage","type":"codeVoice"},{"type":"text","text":" types asynchronously when posted. Asynchronous delivery isn’t suitable"},{"type":"text","text":" "},{"type":"text","text":"for messages with time-critical deliveries, such as a message that must have its observers called before a certain"},{"type":"text","text":" "},{"type":"text","text":"action takes place."}]},{"type":"paragraph","inlineContent":[{"text":"For types that post on the main actor, use ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"code":"AsyncMessage","type":"codeVoice"},{"text":" is associated with a specific ","type":"text"},{"code":"Subject","type":"codeVoice"},{"text":" type.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, an "},{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" associated with the type "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" could use the following declaration:"}]},{"type":"codeListing","syntax":"swift","code":["struct EventDidStart: NotificationCenter.AsyncMessage {","    typealias Subject = Event","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" can use an optional "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MessageIdentifier"},{"text":" type for context-aware observer registration:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["extension NotificationCenter.MessageIdentifier where Self == NotificationCenter.BaseMessageIdentifier<EventDidStart> {","    static var didStart: Self { .init() }","}"]},{"type":"paragraph","inlineContent":[{"text":"With this identifier, observers can receive information about a specific instance by registering for this message with a ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let observerToken = NotificationCenter.default.addObserver(of: importantEvent, for: .didStart)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or an observer can receive information about any instance with:"}]},{"syntax":"swift","type":"codeListing","code":["let observerToken = NotificationCenter.default.addObserver(of: Event.self, for: .didStart)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The notification center ties observation the lifetime of the returned "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/ObservationToken"},{"type":"text","text":" and automatically de-registers the observer if the token"},{"type":"text","text":" "},{"type":"text","text":"goes out of scope. You can also remove observation explicitly:"}]},{"syntax":"swift","type":"codeListing","code":["NotificationCenter.default.removeObserver(observerToken)"]},{"text":"Notification Interoperability","level":3,"type":"heading","anchor":"Notification-Interoperability"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" includes optional interoperability with "},{"type":"codeVoice","code":"Notification"},{"type":"text","text":", enabling posters and observers of both types"},{"type":"text","text":" "},{"type":"text","text":"to pass information."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It does this by offering a "},{"type":"codeVoice","code":"makeMessage(_:)"},{"type":"text","text":" method that collects values from a "},{"type":"codeVoice","code":"Notification"},{"type":"text","text":"‘s "},{"type":"codeVoice","code":"Notification\/userInfo"},{"type":"text","text":" and populates properties on a new message."},{"type":"text","text":" "},{"type":"text","text":"In the other direction, a "},{"type":"codeVoice","code":"makeNotification(_:)"},{"type":"text","text":" method collects the message’s defined properties and loads them into a new notification’s "},{"type":"codeVoice","code":"Notification\/userInfo"},{"type":"text","text":" dictionary."}]},{"inlineContent":[{"type":"text","text":"For example, if there exists a "},{"type":"codeVoice","code":"Notification"},{"type":"text","text":" posted on an arbitrary isolation identified by the "},{"type":"codeVoice","code":"Notification\/Name"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"eventDidFinish\""},{"type":"text","text":" with a "},{"type":"codeVoice","code":"Notification\/userInfo"},{"type":"text","text":" "},{"type":"text","text":"dictionary containing the key "},{"type":"codeVoice","code":"\"duration\""},{"type":"text","text":" as an "},{"type":"codeVoice","code":"NSNumber"},{"type":"text","text":", an app could post and observe the notification with the following "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct EventDidFinish: NotificationCenter.AsyncMessage {","    typealias Subject = Event","    static var name: Notification.Name { Notification.Name(\"eventDidFinish\") }","","    var duration: Int","","    static func makeNotification(_ message: Self) -> Notification {","        return Notification(name: Self.name, userInfo: [\"duration\": NSNumber(message.duration)])","    }","","    static func makeMessage(_ notification: Notification) -> Self? {","        guard let userInfo = notification.userInfo,","              let duration = userInfo[\"duration\"] as? Int","        else {","            return nil","        }","","        return Self(duration: duration)","    }","}"]},{"inlineContent":[{"text":"With this definition, an observer for this ","type":"text"},{"code":"AsyncMessage","type":"codeVoice"},{"text":" type receives information even if the poster used the ","type":"text"},{"code":"Notification","type":"codeVoice"},{"text":" equivalent, and vice versa.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter"]]},"variants":[{"paths":["\/documentation\/foundationessentials\/notificationcenter\/asyncmessage"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"AsyncMessage"}],"symbolKind":"protocol","roleHeading":"Protocol","title":"NotificationCenter.AsyncMessage","platforms":[{"deprecated":false,"introducedAt":"26.0","name":"iOS","unavailable":false,"beta":false},{"deprecated":false,"introducedAt":"26.0","name":"iPadOS","unavailable":false,"beta":false},{"deprecated":false,"introducedAt":"26.0","name":"Mac Catalyst","unavailable":false,"beta":false},{"deprecated":false,"introducedAt":"26.0","name":"macOS","unavailable":false,"beta":false},{"deprecated":false,"introducedAt":"26.0","name":"tvOS","unavailable":false,"beta":false},{"deprecated":false,"introducedAt":"26.0","name":"visionOS","unavailable":false,"beta":false},{"deprecated":false,"introducedAt":"26.0","name":"watchOS","unavailable":false,"beta":false}],"role":"symbol","modules":[{"name":"FoundationEssentials"}],"externalID":"s:20FoundationEssentials18NotificationCenterC12AsyncMessageP","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncMessage"}],"extendedModule":"FoundationEssentials"},"references":{"doc://FoundationEssentials/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/FoundationEssentials\/s16Sendab