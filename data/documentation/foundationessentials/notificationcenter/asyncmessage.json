{"abstract":[{"type":"text","text":"A protocol for creating types that you can post to a notification center, which posts them to an arbitrary isolation."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/notificationcenter\/asyncmessage"]}],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage\/Subject"],"anchor":"Declaring-subject-type","title":"Declaring subject type"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage"},"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter"]]},"relationshipsSections":[{"identifiers":["doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"],"kind":"relationships","title":"Inherits From","type":"inheritsFrom"}],"seeAlsoSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage"],"generated":true,"anchor":"Declaring-a-notification-message","title":"Declaring a notification message"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncMessage","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You post types conforming to "},{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" to a notification center using "},{"type":"codeVoice","code":"post(_:subject:)"},{"type":"text","text":" and observe them with "},{"type":"codeVoice","code":"addObserver(of:for:using:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The notification center delivers "},{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" types asynchronously when posted. Asynchronous delivery isn’t suitable"},{"type":"text","text":" "},{"type":"text","text":"for messages with time-critical deliveries, such as a message that must have its observers called before a certain"},{"type":"text","text":" "},{"type":"text","text":"action takes place."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For types that post on the main actor, use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MainActorMessage"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" is associated with a specific "},{"type":"codeVoice","code":"Subject"},{"type":"text","text":" type."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, an "},{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" associated with the type "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" could use the following declaration:"}]},{"type":"codeListing","syntax":"swift","code":["struct EventDidStart: NotificationCenter.AsyncMessage {","    typealias Subject = Event","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" can use an optional "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/MessageIdentifier"},{"type":"text","text":" type for context-aware observer registration:"}]},{"type":"codeListing","syntax":"swift","code":["extension NotificationCenter.MessageIdentifier where Self == NotificationCenter.BaseMessageIdentifier<EventDidStart> {","    static var didStart: Self { .init() }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With this identifier, observers can receive information about a specific instance by registering for this message with a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["let observerToken = NotificationCenter.default.addObserver(of: importantEvent, for: .didStart)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or an observer can receive information about any instance with:"}]},{"type":"codeListing","syntax":"swift","code":["let observerToken = NotificationCenter.default.addObserver(of: Event.self, for: .didStart)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The notification center ties observation the lifetime of the returned "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/ObservationToken"},{"type":"text","text":" and automatically de-registers the observer if the token"},{"type":"text","text":" "},{"type":"text","text":"goes out of scope. You can also remove observation explicitly:"}]},{"type":"codeListing","syntax":"swift","code":["NotificationCenter.default.removeObserver(observerToken)"]},{"type":"heading","anchor":"Notification-Interoperability","level":3,"text":"Notification Interoperability"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" includes optional interoperability with "},{"type":"codeVoice","code":"Notification"},{"type":"text","text":", enabling posters and observers of both types"},{"type":"text","text":" "},{"type":"text","text":"to pass information."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It does this by offering a "},{"type":"codeVoice","code":"makeMessage(_:)"},{"type":"text","text":" method that collects values from a "},{"type":"codeVoice","code":"Notification"},{"type":"text","text":"‘s "},{"type":"codeVoice","code":"Notification\/userInfo"},{"type":"text","text":" and populates properties on a new message."},{"type":"text","text":" "},{"type":"text","text":"In the other direction, a "},{"type":"codeVoice","code":"makeNotification(_:)"},{"type":"text","text":" method collects the message’s defined properties and loads them into a new notification’s "},{"type":"codeVoice","code":"Notification\/userInfo"},{"type":"text","text":" dictionary."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, if there exists a "},{"type":"codeVoice","code":"Notification"},{"type":"text","text":" posted on an arbitrary isolation identified by the "},{"type":"codeVoice","code":"Notification\/Name"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"eventDidFinish\""},{"type":"text","text":" with a "},{"type":"codeVoice","code":"Notification\/userInfo"},{"type":"text","text":" "},{"type":"text","text":"dictionary containing the key "},{"type":"codeVoice","code":"\"duration\""},{"type":"text","text":" as an "},{"type":"codeVoice","code":"NSNumber"},{"type":"text","text":", an app could post and observe the notification with the following "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NotificationCenter\/AsyncMessage"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["struct EventDidFinish: NotificationCenter.AsyncMessage {","    typealias Subject = Event","    static var name: Notification.Name { Notification.Name(\"eventDidFinish\") }","","    var duration: Int","","    static func makeNotification(_ message: Self) -> Notification {","        return Notification(name: Self.name, userInfo: [\"duration\": NSNumber(message.duration)])","    }","","    static func makeMessage(_ notification: Notification) -> Self? {","        guard let userInfo = notification.userInfo,","              let duration = userInfo[\"duration\"] as? Int","        else {","            return nil","        }","","        return Self(duration: duration)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With this definition, an observer for this "},{"type":"codeVoice","code":"AsyncMessage"},{"type":"text","text":" type receives information even if the poster used the "},{"type":"codeVoice","code":"Notification"},{"type":"text","text":" equivalent, and vice versa."}]}]}],"metadata":{"platforms":[{"deprecated":false,"beta":false,"name":"iOS","introducedAt":"26.0","unavailable":false},{"name":"iPadOS","introducedAt":"26.0","deprecated":false,"unavailable":false,"beta":false},{"name":"Mac Catalyst","introducedAt":"26.0","deprecated":false,"unavailable":false,"beta":false},{"name":"macOS","introducedAt":"26.0","deprecated":false,"unavailable":false,"beta":false},{"deprecated":false,"beta":false,"name":"tvOS","introducedAt":"26.0","unavailable":false},{"name":"visionOS","introducedAt":"26.0","deprecated":false,"unavailable":false,"beta":false},{"name":"watchOS","introducedAt":"26.0","deprecated":false,"unavailable":false,"beta":false}],"role":"symbol","title":"NotificationCenter.AsyncMessage","extendedModule":"FoundationEssentials","modules":[{"name":"FoundationEssentials"}],"symbolKind":"protocol","roleHeading":"Protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncMessage"}],"externalID":"s:20FoundationEssentials18NotificationCenterC12AsyncMessageP","navigatorTitle":[{"kind":"identifier","text":"AsyncMessage"}]},"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/NotificationCenter/AsyncMessage/Subject":{"abstract":[{"type":"text","text":"A type which you ca