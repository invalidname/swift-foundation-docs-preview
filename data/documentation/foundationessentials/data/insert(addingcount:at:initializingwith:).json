{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Data"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/data\/insert(addingcount:at:initializingwith:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@export(implementation)"},{"kind":"text","text":" "},{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":">("},{"kind":"externalParam","text":"addingCount"},{"kind":"text","text":" "},{"kind":"internalParam","text":"newBytesCount"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"at"},{"kind":"text","text":" "},{"kind":"internalParam","text":"index"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"initializingWith"},{"kind":"text","text":" "},{"kind":"internalParam","text":"initializer"},{"kind":"text","text":": @_lifetime(0: copy 0) ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:s13OutputRawSpanV","kind":"typeIdentifier","text":"OutputRawSpan"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier","text":"Error"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The maximum number of bytes to insert into the data.","type":"text"}]}],"name":"newBytesCount"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The position at which to insert the new items. ","type":"text"},{"code":"index","type":"codeVoice"},{"text":" must be a valid index in the data, or equal to the data’s ","type":"text"},{"code":"endIndex","type":"codeVoice"},{"text":" (in which case the new bytes are appended to the end of the data).","type":"text"}]}],"name":"index"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A callback that gets called exactly once to directly populate newly reserved storage within the data. The callback is always called with an empty output span. The callback is allowed to initialize fewer than ","type":"text"},{"code":"newBytesCount","type":"codeVoice"},{"text":" bytes. The data is extended by however many bytes the callback appends to the output raw span before it returns (or throws an error).","type":"text"}]}],"name":"initializer"}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Existing bytes in the data’s storage are moved towards the back as needed to make room for the new bytes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the capacity of the data isn’t sufficient to perform the insertion, then this reallocates the data’s storage to extend its capacity."}],"type":"paragraph"},{"syntax":null,"code":["var prefix: RawSpan = \/* a raw span containing the bytes 11, 99 *\/","var buffer = Data(capacity: 20, copying: prefix)","var i: UInt8 = 0","buffer.insert(addingCount: 3, at: 1) { target in","  while !target.isFull {","    target.append(i)","    i += 1","  }","}","\/\/ `buffer` now contains the bytes 11, 0, 1, 2, and 99"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If the callback fails to fully populate its output raw span or if it throws an error, then the data keeps all items that were successfully initialized before the callback terminated the insertion."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Partial insertions create a gap in data storage that needs to be closed by moving already inserted bytes to their correct positions given"},{"type":"text","text":" "},{"type":"text","text":"the adjusted count. This adds some overhead compared to adding exactly as many items as promised."}],"type":"paragraph"}]}],"metadata":{"modules":[{"name":"FoundationEssentials"}],"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"addingCount","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"at","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"initializingWith","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:s13OutputRawSpanV","text":"OutputRawSpan","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"te