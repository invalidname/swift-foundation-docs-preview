panV","kind":"typeIdentifier","text":"OutputRawSpan"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier","text":"Error"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"name":"subrange","content":[{"inlineContent":[{"type":"text","text":"The subrange of the data to replace. The bounds of the range must be valid indices in the data."}],"type":"paragraph"}]},{"name":"newBytesCount","content":[{"inlineContent":[{"text":"The maximum number of new bytes to insert in place of the old subrange.","type":"text"}],"type":"paragraph"}]},{"name":"initializer","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A callback that gets called exactly once to directly populate newly reserved storage within the data. The callback is always called with an empty output span. The callback is allowed to initialize fewer than "},{"code":"newBytesCount","type":"codeVoice"},{"type":"text","text":" bytes. The data is extended by however many bytes the callback appends to the output raw span before it returns (or throws an error)."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The number of new bytes need not match the number of bytes being removed."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method has the same overall effect as calling"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["try data.removeSubrange(subrange)","try data.insert(","  addingCount: newBytesCount,","  at: subrange.lowerBound,","  initializingWith: initializer)"]},{"inlineContent":[{"type":"text","text":"However, it performs faster (by a constant factor) by avoiding moving some bytes in the data twice."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the capacity of the data isn’t sufficient to perform the replacement, then this reallocates the data’s storage to extend its capacity."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If the callback fails to fully populate its output raw span or if it throws an error, then the data keeps all bytes that were successfully initialized before the callback terminated the replacement.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Partial replacements create a gap in data storage that needs to be closed by moving subsequent bytes to their correct positions given the adjusted count. This adds some overhead compared to adding exactly as many bytes as promised.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/data\/replacesubrange(_:addingcount:initializingwith:)"]}],"kind":"symbol","references":{"doc://FoundationEssentials/documentation/FoundationEssentials/Data/replaceSubrange(_:addingCount:initializingWith:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"replaceSubrange","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Range","kind":"typeIdentifier","preciseIdentifier":"s:Sn"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">, ","kind":"text"},{"text":"addingCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"initializingWith","kind":"ex