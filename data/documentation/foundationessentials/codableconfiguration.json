ecodingE0Qa","text":"DecodingConfiguration"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"ConfigurationProvider"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DecodingConfigurationProviding\/DecodingConfiguration-swift.associatedtype","preciseIdentifier":"s:20FoundationEssentials30DecodingConfigurationProvidingP0cD0Qa","text":"DecodingConfiguration"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/EncodableWithConfiguration\/EncodingConfiguration","preciseIdentifier":"s:20FoundationEssentials26EncodableWithConfigurationP08EncodingE0Qa","text":"EncodingConfiguration"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"ConfigurationProvider"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/EncodingConfigurationProviding\/EncodingConfiguration-swift.associatedtype","preciseIdentifier":"s:20FoundationEssentials30EncodingConfigurationProvidingP0cD0Qa","text":"EncodingConfiguration"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration","isActive":true},{"type":"text","text":" allows you to create "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/codable"},{"type":"text","text":" types whose members don’t all conform to "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/codable"},{"type":"text","text":". For types that can’t support encoding and decoding by themselves but could become encodable and decodable with some statically-defined information, use the "},{"type":"codeVoice","code":"@CodableConfiguration"},{"type":"text","text":" wrapper. This lets you assign a configuration provider — a type that conforms to both "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/EncodingConfigurationProviding","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DecodingConfigurationProviding","isActive":true},{"type":"text","text":" — to supply this data."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Limiting the "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration","isActive":true},{"type":"text","text":" to statically-defined information protects clients from loading unexpected data, similar to the protection provided by "},{"type":"codeVoice","code":"NSSecureCoding"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In the following example, the "},{"type":"codeVoice","code":"Message"},{"type":"text","text":" type uses "},{"type":"codeVoice","code":"@CodableConfiguration"},{"type":"text","text":" for an "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString","isActive":true},{"type":"text","text":" property called "},{"type":"codeVoice","code":"content"},{"type":"text","text":". While "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString","isActive":true},{"type":"text","text":" does conform to "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/codable"},{"type":"text","text":", it can only encode its known attributes — those declared by the platform SDK — as part of this conformance. By adding a "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentia