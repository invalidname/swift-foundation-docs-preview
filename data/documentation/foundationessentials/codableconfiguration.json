ode(to:configuration:)","isActive":true},{"text":" when encoding ","type":"text"},{"code":"content","type":"codeVoice"},{"text":", which preserves the custom attributes.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct Message: Codable {","let date: Date","let sender: Person","@CodableConfiguration(from: MyAttributes.self) var content = AttributedString()","}"],"type":"codeListing"}],"kind":"content"}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH","doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/CodableConfiguration/Equatable-Implementations":{"url":"\/documentation\/foundationessentials\/codableconfiguration\/equatable-implementations","kind":"article","role":"collectionGroup","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration\/Equatable-Implementations","abstract":[],"title":"Equatable Implementations"},"doc://FoundationEssentials/SH":{"identifier":"doc:\/\/FoundationEssentials\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://FoundationEssentials/documentation/FoundationEssentials/CodableConfiguration":{"url":"\/documentation\/foundationessentials\/codableconfiguration","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CodableConfiguration"}],"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration","abstract":[{"text":"A property wrapper that makes a type codable, by supplying a configuration that provides additional information for serialization.","type":"text"}],"title":"CodableConfiguration","navig