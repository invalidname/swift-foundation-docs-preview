pe":"reference"},{"type":"text","text":" when encoding "},{"type":"codeVoice","code":"content"},{"type":"text","text":", which preserves the custom attributes."}]},{"type":"codeListing","syntax":"swift","code":["struct Message: Codable {","let date: Date","let sender: Person","@CodableConfiguration(from: MyAttributes.self) var content = AttributedString()","}"]}],"kind":"content"}],"topicSections":[{"title":"Creating a codable configuration","anchor":"Creating-a-codable-configuration","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration\/init(wrappedValue:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration\/init(wrappedValue:from:)-6a8g3","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration\/init(wrappedValue:from:)-157qf"]},{"title":"Accessing the wrapped value","anchor":"Accessing-the-wrapped-value","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration\/wrappedValue"]},{"title":"Encoding and decoding","anchor":"Encoding-and-decoding","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration\/init(from:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration\/encode(to:)"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration\/Equatable-Implementations"]}],"metadata":{"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"CodableConfiguration"}],"title":"CodableConfiguration","platforms":[{"deprecated":false,"beta":false,"name":"iOS","introducedAt":"15.0","unavailable":false},{"introducedAt":"15.0","beta":false,"unavailable":false,"deprecated":false,"name":"iPadOS"},{"deprecated":false,"beta":false,"name":"Mac Catalyst","introducedAt":"15.0","unavailable":fal