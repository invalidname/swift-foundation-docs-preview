/documentation\/FoundationEssentials\/CodableConfiguration"},{"type":"text","text":" allows you to create "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" types whose members don’t all conform to "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":". For types that can’t support encoding and decoding by themselves but could become encodable and decodable with some statically-defined information, use the "},{"code":"@CodableConfiguration","type":"codeVoice"},{"type":"text","text":" wrapper. This lets you assign a configuration provider — a type that conforms to both "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/EncodingConfigurationProviding"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DecodingConfigurationProviding"},{"type":"text","text":" — to supply this data."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Limiting the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration"},{"type":"text","text":" to statically-defined information protects clients from loading unexpected data."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the following example, the "},{"code":"Message","type":"codeVoice"},{"type":"text","text":" type uses "},{"code":"@CodableConfiguration","type":"codeVoice"},{"type":"text","text":" for an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString"},{"type":"text","text":" property called "},{"code":"content","type":"codeVoice"},{"type":"text","text":". While "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/AttributedString"},{"type":"text","text":" does conform to "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":", it can only encode its known attributes — those declared by the platform SDK — as part of this conformance. By adding a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration"},{"type":"text","text":" for the custom "},{"code":"MyAttributes","type":"codeVoice"},{"type":"text","text":" type, "},{"code":"Message","type":"codeVoice"},{"type":"text","text":" uses "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/EncodableWithConfiguration\/encode(to:configuration:)"},{"type":"text","text":" when encoding "},{"code":"content","type":"codeVoice"},{"type":"text","text":", which preserves the custom attributes."}]},{"type":"codeListing","syntax":"swift","code":["struct Message: Codable {","let date: Date","let sender: Person","@CodableConfiguration(from: MyAttributes.self) var content = AttributedString()","}"]}]}],"topicSections":[{"title":"Creating a codable configuration","anchor":"Creating-a-codable-configuration","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration\/init(wrappedValue:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration\/init(wrappedValue:from:)-6a8g3","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration\/init(wrappedValue:from:)-157qf"]},{"title":"Accessing the wrapped value","anchor":"Accessing-the-wrapped-value","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration\/wrappedValue"]},{"title":"Encoding and decoding","anchor":"Encoding-and-decoding","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration\/init(from:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration\/encode(to:)"]},{"ti