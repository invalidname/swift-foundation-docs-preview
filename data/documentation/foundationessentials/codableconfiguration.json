ntials30DecodingConfigurationProvidingP0cD0Qa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":"."},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/EncodableWithConfiguration\/EncodingConfiguration","kind":"typeIdentifier","text":"EncodingConfiguration","preciseIdentifier":"s:20FoundationEssentials26EncodableWithConfigurationP08EncodingE0Qa"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"ConfigurationProvider"},{"kind":"text","text":"."},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/EncodingConfigurationProviding\/EncodingConfiguration-swift.associatedtype","kind":"typeIdentifier","text":"EncodingConfiguration","preciseIdentifier":"s:20FoundationEssentials30EncodingConfigurationProvidingP0cD0Qa"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/CodableConfiguration","isActive":true,"type":"reference"},{"type":"text","text":" allows you to create "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/codable"},{"type":"text","text":" types whose members don’t all conform to "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/codable"},{"type":"text","text":". For types that can’t support encoding and decoding by themselves but could become encodable and decodable with some statically-defined information, use the "},{"type":"codeVoice","code":"@CodableConfiguration"},{"type":"text","text":" wrapper. This lets you assign a configuration provider — a type that conforms to both "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/EncodingConfigurationProviding","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/FoundationEssentia