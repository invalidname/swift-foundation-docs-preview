inlineContent":[{"text":"This method prioritizes ordering by start date. If the start dates are equal, then it will order by duration.","type":"text"},{"text":" ","type":"text"},{"text":"e.g. Given intervals a and b","type":"text"}],"type":"paragraph"},{"code":["a.   |-----|","b.      |-----|"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"code":"a.compare(b)","type":"codeVoice"},{"text":" would return ","type":"text"},{"code":".orderedAscending","type":"codeVoice"},{"text":" because a’s start date is earlier in time than b’s start date.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In the event that the start dates are equal, the compare method will attempt to order by duration.","type":"text"},{"text":" ","type":"text"},{"text":"e.g. Given intervals c and d","type":"text"}],"type":"paragraph"},{"code":["c.  |-----|","d.  |---|"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"code":"c.compare(d)","type":"codeVoice"},{"text":" would result in ","type":"text"},{"code":".orderedDescending","type":"codeVoice"},{"text":" because c is longer than d.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If both the start dates and the durations are equal, then the intervals are considered equal and ","type":"text"},{"code":".orderedSame","type":"codeVoice"},{"text":" is returned as the result.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"roleHeading":"Instance Method","platforms":[{"name":"iOS","beta":false,"unavailable":false,"introducedAt":"10.0","deprecated":false},{"name":"iPadOS","beta":false,"unavailable":false,"introducedAt":"10.0","deprecated":false},{"name":"Mac Catalyst","beta":false,"unavailable":false,"introducedAt":"10.0","deprecated":false},{"name":"macOS","beta":false,"unavailable":false,"introducedAt":"10.12","deprecated":false},{"name":"tvOS","beta":false,"unavailable":false,"introducedAt":"10.0","deprecated":false},{"name":"watchOS","beta":false,"unavailable":false,"introducedAt":"3.