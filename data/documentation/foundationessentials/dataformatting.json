ingsAndText":{"title":"Strings and text","abstract":[],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/StringsAndText","type":"topic","role":"collectionGroup","url":"\/documentation\/foundationessentials\/stringsandtext","kind":"article"},"doc://FoundationEssentials/documentation/FoundationEssentials/Decimal":{"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Decimal","url":"\/documentation\/foundationessentials\/decimal","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Decimal"}],"abstract":[{"type":"text","text":"A structure representing a base-10 number."}],"title":"Decimal","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Decimal"}],"type":"topic"},"doc://FoundationEssentials/documentation/FoundationEssentials/NumbersDataAndBasicValues":{"kind":"article","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NumbersDataAndBasicValues","url":"\/documentation\/foundationessentials\/numbersdataandbasicvalues","abstract":[{"type":"text","text":"Work with primitive values and other fundamental types."}],"title":"Numbers, data, and basic values","role":"collectionGroup","type":"topic"}}}