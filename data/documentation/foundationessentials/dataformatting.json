{"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","abstract":[{"type":"text","text":"Convert numbers, dates, measurements, and other values to and from locale-aware string representations."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DataFormatting"},"topicSections":[{"title":"Data formatting","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"anchor":"Data-formatting"},{"title":"Data parsing","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy"],"anchor":"Data-parsing"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"FoundationEssentials defines the "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","isActive":true},{"type":"text","text":" protocol to establish conventions for formatting a given type as some kind of output type, typically a "},{"type":"codeVoice","code":"String"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Similarly, the "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy","isActive":true},{"type":"text","text":" protocol provides an API for converting a representation back to the represented type, such as converting a numeric string to an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Decimal","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"While FoundationEssentials defines the core protocols, most implementations of "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy","isActive":true},{"type":"text","text":" exist in the "},{"type":"codeVoice","code":"FoundationInternationalization"},{"type":"text","text":" module."},{"type":"text","text":" "},{"type":"codeVoice","code":"FoundationInternationalization"},{"type":"text","text":" also extends types in both "},{"type":"codeVoice","code":"FoundationEssentials"},{"type":"text","text":" and the Swift Standard Library to add formatting and parsing support."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you import "},{"type":"codeVoice","code":"FoundationInternationalization"},{"type":"text","text":", you have two general approaches to perform formatting of supported types:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Call ","type":"text"},{"code":"formatted()","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"formatted(_:)","type":"codeVoice"},{"text":" on an instance of the type, optionally passing in a customized ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" appropriate to the type. These methods, defined by extensions in ","type":"text"},{"code":"FoundationInternationalization","type":"codeVoice"},{"text":", are useful for performing one-off formatting with default styles or slightly-customized styles. For example, ","type":"text"},{"code":"var string123 = Double(1.23).formatted()","type":"codeVoice"},{"text":" creates the string ","type":"text"},{"code":"1.23","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":"format(_:)","type":"codeVoice"},{"text":" on an instance of the ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":", passing in the type you want to format. This method, defined by the ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" itself, makes sense when you customize a style and want to format many instances with it. For example, ","type":"text"},{"code":"var string456 = FloatingPointFormatStyle<Double>().format(4.56)","type":"codeVoice"},{"text":" creates the string ","type":"text"},{"code":"4.56","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The arrangement is similar with parsing:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"init(strategy:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"init(_:format:lenient:)"},{"type":"text","text":" to create instance of a type from its formatted representation. For example, to create a "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" from the string "},{"code":"1.23","type":"codeVoice"},{"text":", you could use ","type":"text"},{"code":"var oneTwoThree = try Double(\"1.23\", format: FloatingPointFormatStyle<Double>())","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":"parse(_:)","type":"codeVoice"},{"text":" on an instance of the ","type":"text"},{"code":"ParseStrategy","type":"codeVoice"},{"text":" to initialize an instance of the output type. For example, ","type":"text"},{"code":"var fourFiveSix = try FloatingPointFormatStyle<Double>().parseStrategy.parse(\"4.56\")","type":"codeVoice"},{"text":" creates a ","type":"text"},{"type":"codeVoice","code":"Double"},{"type":"text","text":" equal to "},{"code":"4.56","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"unorderedList"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/dataformatting"]}],"metadata":{"role":"collectionGroup","title":"Data formatting","modules":[{"name":"FoundationEssentials"}],"roleHeading":"API Collection"},"seeAlsoSections":[{"title":"Fundamentals","generated":true,"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NumbersDataAndBasicValues","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/StringsAndText","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Collections","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DatesAndTimes","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FiltersAndSorting"],"anchor":"Fundamentals"}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/DatesAndTimes":{"abstract":[],"title":"Dates and times","url":"\/documentation\/foundationessentials\/datesandtimes","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DatesAndTimes","type":"topic","kind":"article","role":"collectionGroup"},"doc://FoundationEssentials/documentation/FoundationEssentials":{"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","title":"FoundationEssentials","type":"topic","role":"collection","abstract":[{"type":"text","text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app."}],"url":"\/documentation\/foundationessentials"},"doc://FoundationEssentials/documentation/FoundationEssentials/FiltersAndSorting":{"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FiltersAndSorting","url":"\/documentation\/foundationessentials\/filtersandsorting","abstract