{"abstract":[{"type":"text","text":"Convert numbers, dates, measurements, and other values to and from locale-aware string representations."}],"topicSections":[{"anchor":"Data-formatting","title":"Data formatting","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"]},{"anchor":"Data-parsing","title":"Data parsing","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy"]},{"anchor":"Internationalization","title":"Internationalization","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale"]}],"seeAlsoSections":[{"generated":true,"anchor":"Fundamentals","title":"Fundamentals","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NumbersDataAndBasicValues","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/StringsAndText","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Collections","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DatesAndTimes","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FiltersAndSorting"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"FoundationEssentials defines the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle"},{"text":" protocol to establish conventions for formatting a given type as some kind of output type, typically a ","type":"text"},{"type":"codeVoice","code":"String"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Similarly, the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy"},{"text":" protocol provides an API for converting a representation back to the represented type, such as converting a numeric string to an ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" or ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Decimal"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"While FoundationEssentials defines the core protocols, most implementations of ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy","type":"reference","isActive":true},{"text":" exist in the ","type":"text"},{"code":"FoundationInternationalization","type":"codeVoice"},{"text":" module.","type":"text"},{"text":" ","type":"text"},{"code":"FoundationInternationalization","type":"codeVoice"},{"text":" also extends types in both ","type":"text"},{"code":"FoundationEssentials","type":"codeVoice"},{"text":" and the Swift Standard Library to add formatting and parsing support.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When you import ","type":"text"},{"type":"codeVoice","code":"FoundationInternationalization"},{"text":", you have two general approaches to perform formatting of supported types:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"formatted()"},{"type":"text","text":" or "},{"type":"codeVoice","code":"formatted(_:)"},{"type":"text","text":" on an instance of the type, optionally passing in a customized "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":" appropriate to the type. These methods, defined by extensions in "},{"type":"codeVoice","code":"FoundationInternationalization"},{"type":"text","text":", are useful for performing one-off formatting with default styles or slightly-customized styles. For example, "},{"type":"codeVoice","code":"var string123 = Double(1.23).formatted()"},{"type":"text","text":" creates the string "},{"type":"codeVoice","code":"1.23"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":"format(_:)","type":"codeVoice"},{"text":" on an instance of the ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":", passing in the type you want to format. This method, defined by the ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" itself, makes sense when you customize a style and want to format many instances with it. For example, ","type":"text"},{"code":"var string456 = FloatingPointFormatStyle<Double>().format(4.56)","type":"codeVoice"},{"text":" creates the string ","type":"text"},{"code":"4.56","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The arrangement is similar with parsing:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":"init(strategy:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"init(_:format:lenient:)","type":"codeVoice"},{"text":" to create instance of a type from its formatted representation. For example, to create a ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" from the string ","type":"text"},{"code":"1.23","type":"codeVoice"},{"text":", you could use ","type":"text"},{"code":"var oneTwoThree = try Double(\"1.23\", format: FloatingPointFormatStyle<Double>())","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"parse(_:)"},{"type":"text","text":" on an instance of the "},{"type":"codeVoice","code":"ParseStrategy"},{"type":"text","text":" to initialize an instance of the output type. For example, "},{"type":"codeVoice","code":"var fourFiveSix = try FloatingPointFormatStyle<Double>().parseStrategy.parse(\"4.56\")"},{"type":"text","text":" creates a "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" equal to "},{"type":"codeVoice","code":"4.56"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DataFormatting"},"kind":"article","variants":[{"paths":["\/documentation\/foundationessentials\/dataformatting"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"FoundationEssentials"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Data formatting"},"sections":[],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/Decimal":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Decimal","kind":"identifier"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Decimal","kind":"symbol","navigatorTitle":[{"text":"Decimal","kind":"identifier"}],"type":"topic","url":"\/documentation\/foundationessentials\/decimal","role":"symbol","title":"Decimal","abstract":[{"type":"text","text":"A structure representing a base-10 number."}]},"doc://FoundationEssentials/documentation/FoundationEssentials/DatesAndTimes":{"kind":"article","abstract":[{"type":"text","text":"Compare dates and times, and perform calendar and time zone calculations."}],"url":"\/documentation\/foundationessentials\/datesandtimes","title":"Dates and times","role":"collectionGroup","type":"topic","identifier":"doc