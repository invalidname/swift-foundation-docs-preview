{"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"abstract":[{"text":"Convert numbers, dates, measurements, and other values to and from locale-aware string representations.","type":"text"}],"topicSections":[{"anchor":"Data-formatting","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"title":"Data formatting"},{"anchor":"Data-parsing","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy"],"title":"Data parsing"},{"anchor":"Internationalization","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale"],"title":"Internationalization"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"FoundationEssentials defines the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle"},{"text":" protocol to establish conventions for formatting a given type as some kind of output type, typically a ","type":"text"},{"code":"String","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Similarly, the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy"},{"text":" protocol provides an API for converting a representation back to the represented type, such as converting a numeric string to an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" or ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Decimal"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"While FoundationEssentials defines the core protocols, most implementations of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle"},{"text":" and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy"},{"text":" exist in the ","type":"text"},{"code":"FoundationInternationalization","type":"codeVoice"},{"text":" module.","type":"text"},{"text":" ","type":"text"},{"code":"FoundationInternationalization","type":"codeVoice"},{"text":" also extends types in both ","type":"text"},{"code":"FoundationEssentials","type":"codeVoice"},{"text":" and the Swift Standard Library to add formatting and parsing support.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When you import ","type":"text"},{"code":"FoundationInternationalization","type":"codeVoice"},{"text":", you have two general approaches to perform formatting of supported types:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":"formatted()","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"formatted(_:)","type":"codeVoice"},{"text":" on an instance of the type, optionally passing in a customized ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" appropriate to the type. These methods, defined by extensions in ","type":"text"},{"code":"FoundationInternationalization","type":"codeVoice"},{"text":", are useful for performing one-off formatting with default styles or slightly-customized styles. For example, ","type":"text"},{"code":"var string123 = Double(1.23).formatted()","type":"codeVoice"},{"text":" creates the string ","type":"text"},{"code":"1.23","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"format(_:)"},{"type":"text","text":" on an instance of the "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":", passing in the type you want to format. This method, defined by the "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":" itself, makes sense when you customize a style and want to format many instances with it. For example, "},{"type":"codeVoice","code":"var string456 = FloatingPointFormatStyle<Double>().format(4.56)"},{"type":"text","text":" creates the string "},{"type":"codeVoice","code":"4.56"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The arrangement is similar with parsing:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"init(strategy:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"init(_:format:lenient:)"},{"type":"text","text":" to create instance of a type from its formatted representation. For example, to create a "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" from the string "},{"type":"codeVoice","code":"1.23"},{"type":"text","text":", you could use "},{"type":"codeVoice","code":"var oneTwoThree = try Double(\"1.23\", format: FloatingPointFormatStyle<Double>())"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"parse(_:)"},{"type":"text","text":" on an instance of the "},{"type":"codeVoice","code":"ParseStrategy"},{"type":"text","text":" to initialize an instance of the output type. For example, "},{"type":"codeVoice","code":"var fourFiveSix = try FloatingPointFormatStyle<Double>().parseStrategy.parse(\"4.56\")"},{"type":"text","text":" creates a "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" equal to "},{"type":"codeVoice","code":"4.56"},{"type":"text","text":"."}]}]}],"type":"unorderedList"}]}],"kind":"article","metadata":{"title":"Data formatting","modules":[{"name":"FoundationEssentials"}],"roleHeading":"API Collection","role":"collectionGroup"},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DataFormatting"},"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Fundamentals","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NumbersDataAndBasicValues","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/StringsAndText","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Collections","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DatesAndTimes","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FiltersAndSorting"],"title":"Fundamentals"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/dataformatting"]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/Locale":{"title":"Locale","navigatorTitle":[{"kind":"identifier","text":"Locale"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Locale","url":"\/documentation\/foundationessentials\/locale","role":"symbol","abstract":[{"text":"Information about linguistic, cultural, and technological conventions for use in formatting data for presentation.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Locale"}],"type":"topic","kind":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/ParseableFormatStyle":{"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ParseableFormatStyle"}],"identifier":"doc:\/\/FoundationEssentials\/documentat