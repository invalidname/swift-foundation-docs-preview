:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"formatted()"},{"type":"text","text":" or "},{"type":"codeVoice","code":"formatted(_:)"},{"text":" on an instance of the type, optionally passing in a customized ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" appropriate to the type. These methods, defined by extensions in ","type":"text"},{"type":"codeVoice","code":"FoundationInternationalization"},{"text":", are useful for performing one-off formatting with default styles or slightly-customized styles. For example, ","type":"text"},{"type":"codeVoice","code":"var string123 = Double(1.23).formatted()"},{"type":"text","text":" creates the string "},{"type":"codeVoice","code":"1.23"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"format(_:)"},{"type":"text","text":" on an instance of the "},{"type":"codeVoice","code":"FormatStyle"},{"type":"text","text":", passing in the type you want to format. This method, defined by the "},{"code":"FormatStyle","type":"codeVoice"},{"type":"text","text":" itself, makes sense when you customize a style and want to format many instances with it. For example, "},{"type":"codeVoice","code":"var string456 = FloatingPointFormatStyle<Double>().format(4.56)"},{"type":"text","text":" creates the string "},{"type":"codeVoice","code":"4.56"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The arrangement is similar with parsing:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Call ","type":"text"},{"type":"codeVoice","code":"init(strategy:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"init(_:format:lenient:)"},{"type":"text","text":" to create instance of a type from its formatted representation. For example, to create a "},{"type":"codeVoice","code":"Double"},{"text":" from the string ","type":"text"},{"type":"codeVoice","code":"1.23"},{"type":"text","text":", you could use "},{"type":"codeVoice","code":"var oneTwoThree = try Double(\"1.23\", format: FloatingPointFormatStyle<Double>())"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"parse(_:)"},{"text":" on an instance of the ","type":"text"},{"type":"codeVoice","code":"ParseStrategy"},{"text":" to initialize an instance of the output type. For example, ","type":"text"},{"type":"codeVoice","code":"var fourFiveSix = try FloatingPointFormatStyle<Double>().parseStrategy.parse(\"4.56\")"},{"text":" creates a ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":" equal to ","type":"text"},{"type":"codeVoice","code":"4.56"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"sections":[],"abstract":[{"text":"Convert numbers, dates, measurements, and other values to and from locale-aware string representations.","type":"text"}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/ParseableFormatStyle":{"kind":"symbol","url":"\/documentation\/foundationessentials\/parseableformatstyle","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle","title":"ParseableFormatStyle","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ParseableFormatStyle","kind":"identifier"}],"navigatorTitle":[{"text":"ParseableFormatStyle","kind":"identifier"}],"abstract":[{"text":"A type that can convert a given input data type into a representation in an output type.","type":"text"}]},"doc://FoundationEssentials/documentation/FoundationEssentials":{"role":"collection","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","abstract":[{"type":"text","text":"Access essential data typ