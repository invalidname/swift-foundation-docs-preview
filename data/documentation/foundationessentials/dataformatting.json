{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/dataformatting"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/NumbersDataAndBasicValues","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/StringsAndText","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Collections","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DatesAndTimes","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FiltersAndSorting"],"anchor":"Fundamentals","generated":true,"title":"Fundamentals"}],"kind":"article","sections":[],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DataFormatting","interfaceLanguage":"swift"},"metadata":{"role":"collectionGroup","modules":[{"name":"FoundationEssentials"}],"roleHeading":"API Collection","title":"Data formatting"},"primaryContentSections":[{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"FoundationEssentials defines the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","type":"reference"},{"text":" protocol to establish conventions for formatting a given type as some kind of output type, typically a ","type":"text"},{"type":"codeVoice","code":"String"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Similarly, the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy","type":"reference"},{"text":" protocol provides an API for converting a representation back to the represented type, such as converting a numeric string to an ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Decimal","type":"reference"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"While FoundationEssentials defines the core protocols, most implementations of ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy","isActive":true,"type":"reference"},{"text":" exist in the ","type":"text"},{"code":"FoundationInternationalization","type":"codeVoice"},{"text":" module.","type":"text"},{"text":" ","type":"text"},{"code":"FoundationInternationalization","type":"codeVoice"},{"text":" also extends types in both ","type":"text"},{"code":"FoundationEssentials","type":"codeVoice"},{"text":" and the Swift Standard Library to add formatting and parsing support.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When you import "},{"type":"codeVoice","code":"FoundationInternationalization"},{"type":"text","text":", you have two general approaches to perform formatting of supported types:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"type":"codeVoice","code":"formatted()"},{"text":" or ","type":"text"},{"code":"formatted(_:)","type":"codeVoice"},{"text":" on an instance of the type, optionally passing in a customized ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":" appropriate to the type. These methods, defined by extensions in ","type":"text"},{"type":"codeVoice","code":"FoundationInternationalization"},{"text":", are useful for performing one-off formatting with default styles or slightly-customized styles. For example, ","type":"text"},{"type":"codeVoice","code":"var string123 = Double(1.23).formatted()"},{"text":" creates the string ","type":"text"},{"type":"codeVoice","code":"1.23"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Call ","type":"text"},{"code":"format(_:)","type":"codeVoice"},{"text":" on an instance of the ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"type":"text","text":", passing in the type you want to format. This method, defined by the "},{"code":"FormatStyle","type":"codeVoice"},{"type":"text","text":" itself, makes sense when you customize a style and want to format many instances with it. For example, "},{"type":"codeVoice","code":"var string456 = FloatingPointFormatStyle<Double>().format(4.56)"},{"type":"text","text":" creates the string "},{"type":"codeVoice","code":"4.56"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The arrangement is similar with parsing:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Call ","type":"text"},{"type":"codeVoice","code":"init(strategy:)"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"init(_:format:lenient:)"},{"text":" to create instance of a type from its formatted representation. For example, to create a ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":" from the string ","type":"text"},{"type":"codeVoice","code":"1.23"},{"text":", you could use ","type":"text"},{"type":"codeVoice","code":"var oneTwoThree = try Double(\"1.23\", format: FloatingPointFormatStyle<Double>())"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"parse(_:)"},{"text":" on an instance of the ","type":"text"},{"type":"codeVoice","code":"ParseStrategy"},{"text":" to initialize an instance of the output type. For example, ","type":"text"},{"type":"codeVoice","code":"var fourFiveSix = try FloatingPointFormatStyle<Double>().parseStrategy.parse(\"4.56\")"},{"text":" creates a ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" equal to ","type":"text"},{"code":"4.56","type":"codeVoice"},{"text":".","type":"text"}]}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"topicSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"title":"Data formatting","anchor":"Data-formatting"},{"anchor":"Data-parsing","title":"Data parsing","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy"]}],"abstract":[{"type":"text","text":"Convert numbers, dates, measurements, and other values to and from locale-aware string representations."}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/StringsAndText":{"role":"collectionGroup","kind":"article","url":"\/documentation\/foundationessentials\/stringsandtext","title":"Strings and text","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/StringsAndText","type":"topic","abstract":[]},"doc://FoundationEssentials/documentation/FoundationEssentials":{"title":"FoundationEssentials","type":"topic","role":"collection","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","abstract":[{"type":"text","text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app."}],"url":"\/documentation\/foundationessentials","kind":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/DiscreteFormatStyle":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","role":"symbol","title":"DiscreteFormatStyle","fragments":[{"text":"protocol","ki