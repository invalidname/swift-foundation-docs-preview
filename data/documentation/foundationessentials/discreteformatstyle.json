{"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle"},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"DiscreteFormatStyle"}],"platforms":[{"deprecated":false,"unavailable":false,"beta":false,"name":"iOS","introducedAt":"18.0"},{"introducedAt":"18.0","deprecated":false,"unavailable":false,"name":"iPadOS","beta":false},{"introducedAt":"18.0","deprecated":false,"unavailable":false,"name":"Mac Catalyst","beta":false},{"deprecated":false,"unavailable":false,"beta":false,"name":"macOS","introducedAt":"15.0"},{"introducedAt":"18.0","deprecated":false,"unavailable":false,"name":"tvOS","beta":false},{"deprecated":false,"unavailable":false,"beta":false,"name":"watchOS","introducedAt":"11.0"}],"modules":[{"name":"FoundationEssentials"}],"symbolKind":"protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscreteFormatStyle","kind":"identifier"}],"role":"symbol","externalID":"s:20FoundationEssentials19DiscreteFormatStyleP","roleHeading":"Protocol","title":"DiscreteFormatStyle"},"topicSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)"],"anchor":"Accessing-boundaries","title":"Accessing boundaries"},{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(before:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(after:)"],"anchor":"Accessing-values","title":"Accessing values"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/foundationessentials\/discreteformatstyle"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH"],"title":"Inherits From"}],"abstract":[{"text":"A format style that transforms a continuous input into a discrete output and provides","type":"text"},{"text":" ","type":"text"},{"text":"information about its discretization boundaries.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"title":"Data formatting","anchor":"Data-formatting","generated":true}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"DiscreteFormatStyle","kind":"identifier"},{"text":"<","kind":"text"},{"text":"FormatInput","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa"},{"text":", ","kind":"text"},{"text":"FormatOutput","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa"},{"text":"> : ","kind":"text"},{"text":"FormatStyle","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP"}]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Use this protocol to keep displays up to date if input changes continuously, or to iterate","type":"text"},{"text":" ","type":"text"},{"text":"over all possible outputs of a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle"},{"text":" by obtaining the next discrete input in either direction","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)"},{"type":"text","text":" or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)"},{"type":"text","text":"."}]},{"level":2,"text":"Ordering of Inputs","type":"heading","anchor":"Ordering-of-Inputs"},{"inlineContent":[{"type":"text","text":"The ordering over "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","isActive":true},{"type":"text","text":" "},{"type":"text","text":"defined by "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","isActive":true},{"type":"text","text":" \/ "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true},{"type":"text","text":" must be"},{"type":"text","text":" "},{"type":"text","text":"consistent between the two functions. If "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput"},{"type":"text","text":" conforms to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":" protocol, the format style’s ordering "},{"inlineContent":[{"text":"should","type":"text"}],"type":"emphasis"},{"type":"text","text":" be consistent with the canonical ordering"},{"type":"text","text":" "},{"text":"defined via the ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":" conformance, i.e. it should hold that","type":"text"},{"type":"text","text":" "},{"code":"discreteInput(before: x)! < x < discreteInput(after: x)!","type":"codeVoice"},{"type":"text","text":" where discrete inputs"},{"type":"text","text":" "},{"type":"text","text":"are not nil."}],"type":"paragraph"},{"text":"Stepping through Discrete Input\/Output Pairs","level":2,"type":"heading","anchor":"Stepping-through-Discrete-InputOutput-Pairs"},{"inlineContent":[{"text":"One use case of this protocol is enumerating all discrete inputs of a format style and their respective","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"outputs."}],"type":"paragraph"},{"inlineContent":[{"text":"While the ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"text":"functions are the right tool for that, they do not give a guarantee that their respective return values","type":"text"},{"type":"text","text":" "},{"type":"text","text":"actually produce an output that is different from the output produced by formatting the "},{"code":"input","type":"codeVoice"},{"type":"text","text":" value"},{"text":" ","type":"text"},{"text":"used when calling ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","isActive":true,"type":"reference"},{"text":" \/ ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true,"type":"reference"},{"text":", they only","type":"text"},{"text":" ","type":"text"},{"text":"provide a value that produces a different output for ","type":"text"},{"inlineContent":[{"text":"most","type":"text"}],"type":"emphasis"},{"text":" inputs. E.g. when formatting a floating point","type":"text"},{"text":" ","type":"text"},{"text":"value as an integer, we can get the next discrete input after ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" by calculating ","type":"text"},{"code":"floor(x + 1)","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"However, when rounding toward zero, the whole interval (-1;1) formats as zero. It would be ok for a"},{"type":"text","text":" "},{"type":"text","text":"discrete format style to ignore that edge case and return "},{"code":"0","type":"codeVoice"},{"type":"text","text":" for the "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"negative value greater than "},{"code":"-1","type":"codeVoice"},{"type":"text","text":". Therefore, to enumerate all discrete input\/output pairs, adjacent"},{"type":"text","text":" "},{"type":"text","text":"outputs must be deduplicated in order to guarantee no adjacent outputs are the same."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example produces all discrete input\/output pairs for inputs in a given "},{"code":"range","type":"codeVoice"},{"type":"text","text":" making"},{"type":"text","text":" "},{"text":"sure adjacent outputs are unequal:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension DiscreteFormatStyle","    where FormatInput : Comparable, FormatOutput : Equatable","{","        func enumerated(","        in range: ClosedRange<FormatInput>","    ) -> [(input: FormatInput, output: FormatOutput)] {","        var input = range.lowerBound","        var output = format(input)","","        var pairs = [(input: FormatInput, output: FormatOutput)]()","        pairs.append((input, output))","","        \/\/ get the next discretization bound","        while let nextInput = discreteInput(after: input),","              \/\/ check that it is still in the requested `range`","              nextInput <= range.upperBound {","            \/\/ get the respective formatted output","            let nextOutput = format(nextInput)","            \/\/ deduplicate based on the formatted output","            if nextOutput != output {","                pairs.append((nextInput, nextOutput))","            }","                input = nextInput","            output = nextOutput","        }","","        return pairs","    }","}"]},{"level":2,"text":"Imperfect Discretization Boundaries","type":"heading","anchor":"Imperfect-Discretization-Boundaries"},{"type":"paragraph","inlineContent":[{"text":"In some scenarios, a format style cannot provide precise discretization boundaries in","type":"text"},{"text":" ","type":"text"},{"text":"a performant manner. In those cases it must override ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(before:)","type":"reference","isActive":true},{"text":" and","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(after:)","isActive":true},{"text":" to reflect that. For any discretization boundary ","type":"text"},{"type":"codeVoice","code":"x"},{"text":" returned by either","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference","isActive":true},{"type":"text","text":" based on the"},{"type":"text","text":" "},{"type":"text","text":"original input "},{"type":"codeVoice","code":"y"},{"text":", all values representable in the ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","isActive":true},{"type":"text","text":"strictly  between"},{"type":"text","text":" "},{"type":"codeVoice","code":"x"},{"type":"text","text":" and the return value of "},{"type":"codeVoice","code":"input(after: x)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"input(before: x)"},{"type":"text","text":", respectively, are not"},{"type":"text","text":" "},{"type":"text","text":"guaranteed to produce the same formatted output as "},{"code":"y","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following schematic shows an overview of the guarantees given by the protocol:"}]},{"syntax":null,"type":"codeListing","code":["xB = discreteInput(before: y)       y      xA = discreteInput(after: y)","      |                             |                             |","<-----+---+-------------------------+-------------------------+---+--->","          |                                                   |"," zB = input(after: xB)                          zA = input(before: xA)"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the formatted output for everything in "},{"code":"zB...zA","type":"codeVoice"},{"type":"text","text":" (including bounds) is "},{"type":"strong","inlineContent":[{"type":"text","text":"guaranteed"}]},{"type":"text","text":" to be equal"},{"type":"text","text":" "},{"type":"text","text":"to "},{"code":"format(y)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the formatted output for "},{"code":"xB","type":"codeVoice"},{"type":"text","text":" and lower is "},{"type":"strong","inlineContent":[{"type":"text","text":"most likely"}]},{"type":"text","text":" different from "},{"code":"format(y)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the formatted output for "},{"code":"xA","type":"codeVoice"},{"type":"text","text":" and higher is "},{"type":"strong","inlineContent":[{"type":"text","text":"most likely"}]},{"type":"text","text":" different from "},{"code":"format(y)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the  formatted output between "},{"type":"codeVoice","code":"xB"},{"type":"text","text":" and "},{"type":"codeVoice","code":"zB"},{"type":"text","text":", as well as "},{"code":"zA","type":"codeVoice"},{"type":"text","text":" and "},{"code":"xA","type":"codeVoice"},{"type":"text","text":" (excluding bounds) cannot"},{"type":"text","text":" "},{"type":"text","text":"be predicted"}]}]}]}],"kind":"content"}],"references":{"doc://FoundationEssentials/SQ":{"type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SQ","title":"Swift.Equatable"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle":{"url":"\/documentation\/foundationessentials\/formatstyle","type":"topic","role":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","abstract":[{"type":"text","text":"A type that converts a given data type into a representation in another type, such as a string."}],"title":"FormatStyle","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatStyle"}],"navigatorTitle":[{"kind":"identifier","text":"FormatStyle"}],"kind":"symbol"},"doc://FoundationEssentials/SE":{"type":"unresolvable","ident