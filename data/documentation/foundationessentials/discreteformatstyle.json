rate"},{"type":"text","text":" "},{"type":"text","text":"over all possible outputs of a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle"},{"type":"text","text":" by obtaining the next discrete input in either direction"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)"},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Ordering of Inputs","anchor":"Ordering-of-Inputs","level":2},{"inlineContent":[{"text":"The ordering over ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"defined by "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)"},{"type":"text","text":" \/ "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true,"type":"reference"},{"text":" must be","type":"text"},{"text":" ","type":"text"},{"text":"consistent between the two functions. If ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","isActive":true,"type":"reference"},{"text":" conforms to the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":" protocol, the format style’s ordering ","type":"text"},{"inlineContent":[{"text":"should","type":"text"}],"type":"emphasis"},{"type":"text","text":" be consistent with the canonical ordering"},{"type":"text","text":" "},{"type":"text","text":"defined via the "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":" conformance, i.e. it should hold that"},{"type":"text","text":" "},{"type":"codeVoice","code":"discreteInput(before: x)! < x < discreteInput(after: x)!"},{"type":"text","text":" where discrete inputs"},{"type":"text","text":" "},{"type":"text","text":"are not nil."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Stepping through Discrete Input\/Output Pairs","anchor":"Stepping-through-Discrete-InputOutput-Pairs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"One use case of this protocol is enumerating all discrete inputs of a format style and their respective"},{"type":"text","text":" "},{"text":"outputs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"While the "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"functions are the right tool for that, they do not give a guarantee that their respective return values"},{"type":"text","text":" "},{"type":"text","text":"actually produce an output that is different from the output produced by formatting the "},{"type":"codeVoice","code":"input"},{"type":"text","text":" value"},{"type":"text","text":" "},{"type":"text","text":"used when calling "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","isActive":true},{"type":"text","text":" \/ "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true},{"type":"text","text":", they only"},{"type":"text","text":" "},{"type":"text","text":"provide a value that produces a different output for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"most"}]},{"type":"text","text":" inputs. E.g. when formatting a floating point"},{"type":"text","text":" "},{"type":"text","text":"value as an integer, we can get the next discrete input after "},{"type":"codeVoice","code":"x"},{"type":"text","text":" by calculating "},{"type":"codeVoice","code":"floor(x + 1)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"However, when rounding toward zero, the whole interval (-1;1) formats as zero. It would be ok for a"},{"type":"text","text":" "},{"type":"text","text":"discrete format style to ignore that edge case and return "},{"type":"codeVoice","code":"0"},{"type":"text","text":" for the "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"negative value greater than "},{"type":"codeVoice","code":"-1"},{"type":"text","text":". Therefore, to enumerate all discrete input\/output pairs, adjacent"},{"type":"text","text":" "},{"type":"text","text":"outputs must be deduplicated in order to guarantee no adjacent outputs are the same."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example produces all discrete input\/output pairs for inputs in a given "},{"type":"codeVoice","code":"range"},{"type":"text","text":" making"},{"type":"text","text":" "},{"type":"text","text":"sure adjacent outputs are unequal:"}]},{"type":"codeListing","code":["extension DiscreteFormatStyle","    where FormatInput : Comparable, FormatOutput : Equatable","{","        func enumerated(","        in range: ClosedRange<FormatInput>","    ) -> [(input: FormatInput, output: FormatOutput)] {","        var input = range.lowerBound","        var output = format(input)","","        var pairs = [(input: FormatInput, output: FormatOutput)]()","        pairs.append((input, output))","","        \/\/ get the next discretization bound","        while let nextInput = discreteInput(after: input),","              \/\/ check that it is still in the requested `range`","              nextInput <= range.upperBound {","            \/\/ get the respective formatted output","            let nextOutput = format(nextInput)","            \/\/ deduplicate based on the formatted output","            if nextOutput != output {","                pairs.append((nextInput, nextOutput))","            }","                input = nextInput","            output = nextOutput","        }","","        return pairs","    }","}"],"syntax":"swift"},{"level":2,"type":"heading","text":"Imperfect Discretization Boundaries","anchor":"Imperfect-Discretization-Boundaries"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In some scenarios, a format style cannot provide precise discretization boundaries in"},{"type":"text","text":" "},{"type":"text","text":"a performant manner. In those cases it must override "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(before:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(after:)","isActive":true},{"type":"text","text":" to reflect that. For any discretization boundary "},{"type":"codeVoice","code":"x"},{"type":"text","text":" returned by either"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true},{"type":"text","text":" based on the"},{"type":"text","text":" "},{"type":"text","text":"original input "},{"type":"codeVoice","code":"y"},{"type":"text","text":", all values representable in the "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","isActive":true},{"type":"text","text":"strictly  between"},{"type":"text","text":" "},{"type":"codeVoice","code":"x"},{"type":"text","text":" and the return value of "},{"type":"codeVoice","code":"input(after: x)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"input(before: x)"},{"type":"text","text":", respectively, are not"},{"type":"text","text":" "},{"type":"text","text":"guaranteed to produce the same formatted output as "},{"type":"codeVoice","code":"y"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following schematic shows an overview of the guarantees given by the protocol:"}]},{"type":"codeListing","code":["xB = discreteInput(before: y)       y      xA = discreteInput(after: y)","      |                             |                             |","<-----+---+-------------------------+-------------------------+---+--->","          |                                                   |"," zB = input(after: xB)                          zA = input(before: xA)"],"syntax":null},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"the formatted output for everything in "},{"type":"codeVoice","code":"zB...zA"},{"type":"text","text":" (including bounds) is "},{"type":"strong","inlineContent":[{"text":"guaranteed","type":"text"}]},{"type":"text","text":" to be equal"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"format(y)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the formatted output for "},{"type":"codeVoice","code":"xB"},{"type":"text","text":" and lower is "},{"type":"strong","inlineContent":[{"text":"most likely","type":"text"}]},{"type":"text","text":" different from "},{"type":"codeVoice","code":"format(y)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the formatted output for "},{"type":"codeVoice","code":"xA"},{"type":"text","text":" and higher is "},{"type":"strong","inlineContent":[{"text":"most likely","type":"text"}]},{"type":"text","text":" different from "},{"type":"codeVoice","code":"format(y)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the  formatted output between "},{"type":"codeVoice","code":"xB"},{"type":"text","text":" and "},{"type":"codeVoice","code":"zB"},{"type":"text","text":", as well as "},{"type":"codeVoice","code":"zA"},{"type":"text","text":" and "},{"type":"codeVoice","code":"xA"},{"type":"text","text":" (excluding bounds) cannot"},{"type":"text","text":" "},{"type":"text","text":"be predicted"}],"type":"paragraph"}]}]}]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/DiscreteFormatStyle/discreteInput(after:)":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"discreteInput","kind":"identifier"},{"text":"(","kind":"text"},{"text":"after","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"FormatInput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"FormatInput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"The next discretization boundary after the given input."}],"identifier":