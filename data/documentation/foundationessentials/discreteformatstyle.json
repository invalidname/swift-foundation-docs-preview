{"sections":[],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(after:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(before:)"],"generated":true}],"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH"],"kind":"relationships"}],"variants":[{"paths":["\/documentation\/foundationessentials\/discreteformatstyle"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","metadata":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscreteFormatStyle","kind":"identifier"}],"symbolKind":"protocol","platforms":[{"name":"iOS","unavailable":false,"beta":false,"introducedAt":"18.0","deprecated":false},{"name":"iPadOS","unavailable":false,"beta":false,"introducedAt":"18.0","deprecated":false},{"name":"Mac Catalyst","unavailable":false,"beta":false,"introducedAt":"18.0","deprecated":false},{"name":"macOS","unavailable":false,"beta":false,"introducedAt":"15.0","deprecated":false},{"name":"tvOS","unavailable":false,"beta":false,"introducedAt":"18.0","deprecated":false},{"name":"watchOS","unavailable":false,"beta":false,"introducedAt":"11.0","deprecated":false}],"roleHeading":"Protocol","title"