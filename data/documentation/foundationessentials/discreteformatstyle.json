sentials\/DiscreteFormatStyle\/discreteInput(after:)","title":"discreteInput(after:)"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","navigatorTitle":[{"text":"FormatStyle","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"FormatStyle","kind":"identifier"}],"title":"FormatStyle","url":"\/documentation\/foundationessentials\/formatstyle","type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A type that converts a given data type into a representation in another type, such as a string."}]},"doc://FoundationEssentials/documentation/FoundationEssentials":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","title":"FoundationEssentials","url":"\/documentation\/foundationessentials","type":"topic","role":"collection","abstract":[{"type":"text","text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app."}],"kind":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/FormatInput":{"abstract":[{"text":"The type this format style accepts as input.","type":"text"}],"kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FormatInput","kind":"identifier"}],"role":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/formatinput","required":true,"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","title":"FormatInput"},"doc://FoundationEssentials/SH":{"type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SH","title":"Swift.Hashable"}}}