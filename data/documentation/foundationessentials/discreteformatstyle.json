{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"kind":"symbol","topicSections":[{"title":"Accessing boundaries","anchor":"Accessing-boundaries","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)"]},{"title":"Accessing values","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(before:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(after:)"],"anchor":"Accessing-values"}],"metadata":{"externalID":"s:20FoundationEssentials19DiscreteFormatStyleP","title":"DiscreteFormatStyle","platforms":[{"name":"iOS","beta":false,"deprecated":false,"introducedAt":"18.0","unavailable":false},{"name":"iPadOS","beta":false,"deprecated":false,"introducedAt":"18.0","unavailable":false},{"name":"Mac Catalyst","beta":false,"deprecated":false,"introducedAt":"18.0","unavailable":false},{"introducedAt":"15.0","deprecated":false,"unavailable":false,"name":"macOS","beta":false},{"introducedAt":"18.0","deprecated":false,"unavailable":false,"name":"tvOS","beta":false},{"introducedAt":"11.0","deprecated":false,"unavailable":false,"name":"watchOS","beta":false}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DiscreteFormatStyle"}],"symbolKind":"protocol","role":"symbol","roleHeading":"Protocol","navigatorTitle":[{"kind":"identifier","text":"DiscreteFormatStyle"}],"modules":[{"name":"FoundationEssentials"}]},"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A format style that transforms a continuous input into a discrete output and provides"},{"type":"text","text":" "},{"type":"text","text":"information about its discretization boundaries."}],"sections":[],"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH"],"kind":"relationships","type":"inheritsFrom"}],"seeAlsoSections":[{"generated":true,"title":"Data formatting","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"anchor":"Data-formatting"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DiscreteFormatStyle"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","kind":"typeIdentifier","text":"FormatInput","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput"},{"kind":"text","text":", "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa","kind":"typeIdentifier","text":"FormatOutput"},{"kind":"text","text":"> : "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP","kind":"typeIdentifier","text":"FormatStyle"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Use this protocol to keep displays up to date if input changes continuously, or to iterate"},{"type":"text","text":" "},{"type":"text","text":"over all possible outputs of a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle"},{"text":" by obtaining the next discrete input in either direction","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Ordering-of-Inputs","level":2,"type":"heading","text":"Ordering of Inputs"},{"inlineContent":[{"text":"The ordering over ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","isActive":true},{"text":" ","type":"text"},{"text":"defined by ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","isActive":true},{"text":" \/ ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true},{"text":" must be","type":"text"},{"text":" ","type":"text"},{"text":"consistent between the two functions. If ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput"},{"text":" conforms to the","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"Comparable"},{"text":" protocol, the format style’s ordering ","type":"text"},{"inlineContent":[{"text":"should","type":"text"}],"type":"emphasis"},{"text":" be consistent with the canonical ordering","type":"text"},{"text":" ","type":"text"},{"text":"defined via the ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":" conformance, i.e. it should hold that","type":"text"},{"text":" ","type":"text"},{"code":"discreteInput(before: x)! < x < discreteInput(after: x)!","type":"codeVoice"},{"text":" where discrete inputs","type":"text"},{"text":" ","type":"text"},{"text":"are not nil.","type":"text"}],"type":"paragraph"},{"anchor":"Stepping-through-Discrete-InputOutput-Pairs","level":2,"type":"heading","text":"Stepping through Discrete Input\/Output Pairs"},{"inlineContent":[{"text":"One use case of this protocol is enumerating all discrete inputs of a format style and their respective","type":"text"},{"text":" ","type":"text"},{"text":"outputs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"While the ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"functions are the right tool for that, they do not give a guarantee that their respective return values"},{"type":"text","text":" "},{"type":"text","text":"actually produce an output that is different from the output produced by formatting the "},{"code":"input","type":"codeVoice"},{"type":"text","text":" value"},{"type":"text","text":" "},{"type":"text","text":"used when calling "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)"},{"text":" \/ ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)"},{"text":", they only","type":"text"},{"type":"text","text":" "},{"text":"provide a value that produces a different output for ","type":"text"},{"inlineContent":[{"text":"most","type":"text"}],"type":"emphasis"},{"type":"text","text":" inputs. E.g. when formatting a floating point"},{"type":"text","text":" "},{"type":"text","text":"value as an integer, we can get the next discrete input after "},{"type":"codeVoice","code":"x"},{"type":"text","text":" by calculating "},{"type":"codeVoice","code":"floor(x + 1)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"However, when rounding toward zero, the whole interval (-1;1) formats as zero. It would be ok for a"},{"type":"text","text":" "},{"type":"text","text":"discrete format style to ignore that edge case and return "},{"type":"codeVoice","code":"0"},{"text":" for the ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"negative value greater than "},{"type":"codeVoice","code":"-1"},{"type":"text","text":". Therefore, to enumerate all discrete input\/output pairs, adjacent"},{"type":"text","text":" "},{"type":"text","text":"outputs must be deduplicated in order to guarantee no adjacent outputs are the same."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example produces all discrete input\/output pairs for inputs in a given "},{"type":"codeVoice","code":"range"},{"text":" making","type":"text"},{"text":" ","type":"text"},{"text":"sure adjacent outputs are unequal:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["extension DiscreteFormatStyle","    where FormatInput : Comparable, FormatOutput : Equatable","{","        func enumerated(","        in range: ClosedRange<FormatInput>","    ) -> [(input: FormatInput, output: FormatOutput)] {","        var input = range.lowerBound","        var output = format(input)","","        var pairs = [(input: FormatInput, output: FormatOutput)]()","        pairs.append((input, output))","","        \/\/ get the next discretization bound","        while let nextInput = discreteInput(after: input),","              \/\/ check that it is still in the requested `range`","              nextInput <= range.upperBound {","            \/\/ get the respective formatted output","            let nextOutput = format(nextInput)","            \/\/ deduplicate based on the formatted output","            if nextOutput != output {","                pairs.append((nextInput, nextOutput))","            }","                input = nextInput","            output = nextOutput","        }","","        return pairs","    }","}"],"type":"codeListing"},{"text":"Imperfect Discretization Boundaries","level":2,"type":"heading","anchor":"Imperfect-Discretization-Boundaries"},{"inlineContent":[{"text":"In some scenarios, a format style cannot provide precise discretization boundaries in","type":"text"},{"text":" ","type":"text"},{"text":"a performant manner. In those cases it must override ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(before:)","isActive":true},{"text":" and","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(after:)","isActive":true},{"text":" to reflect that. For any discretization boundary ","type":"text"},{"type":"codeVoice","code":"x"},{"text":" returned by either","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","isActive":true},{"text":" or ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true},{"type":"text","text":" based on the"},{"type":"text","text":" "},{"type":"text","text":"original input "},{"type":"codeVoice","code":"y"},{"type":"text","text":", all values representable in the "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","isActive":true,"type":"reference"},{"type":"text","text":"strictly  between"},{"type":"text","text":" "},{"code":"x","type":"codeVoice"},{"type":"text","text":" and the return value of "},{"code":"input(after: x)","type":"codeVoice"},{"type":"text","text":" or "},{"code":"input(before: x)","type":"codeVoice"},{"type":"text","text":", respectively, are not"},{"type":"text","text":" "},{"text":"guaranteed to produce the same formatted output as ","type":"text"},{"type":"codeVoice","code":"y"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following schematic shows an overview of the guarantees given by the protocol:"}],"type":"paragraph"},{"code":["xB = discreteInput(before: y)       y      xA = discreteInput(after: y)","      |                             |                             |","<-----+---+-------------------------+-------------------------+---+--->","          |                                                   |"," zB = input(after: xB)                          zA = input(before: xA)"],"type":"codeListing","syntax":null},{"items":[{"content":[{"inlineContent":[{"text":"the formatted output for everything in ","type":"text"},{"code":"zB...zA","type":"codeVoice"},{"type":"text","text":" (including bounds) is "},{"inlineContent":[{"type":"text","text":"guaranteed"}],"type":"strong"},{"type":"text","text":" to be equal"},{"type":"text","text":" "},{"type":"text","text":"to "},{"code":"format(y)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the formatted output for "},{"code":"xB","type":"codeVoice"},{"type":"text","text":" and lower is "},{"inlineContent":[{"type":"text","text":"most likely"}],"type":"strong"},{"type":"text","text":" different from "},{"type":"codeVoice","code":"format(y)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the formatted output for ","type":"text"},{"code":"xA","type":"codeVoice"},{"text":" and higher is ","type":"text"},{"inlineContent":[{"text":"most likely","type":"text"}],"type":"strong"},{"type":"text","text":" different from "},{"code":"format(y)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the  formatted output between "},{"code":"xB","type":"codeVoice"},{"type":"text","text":" and "},{"code":"zB","type":"codeVoice"},{"type":"text","text":", as well as "},{"code":"zA","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"xA","type":"codeVoice"},{"text":" (excluding bounds) cannot","type":"text"},{"text":" ","type":"text"},{"text":"be predicted","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/discreteformatstyle"]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/DiscreteFormatStyle":{"title":"DiscreteFormatStyle","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DiscreteFormatStyle"}],"navigatorTitle":[{"kind":"identifier","text":"DiscreteFormatStyle"}],"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","type":"topic","abstract":[{"type":"text","text":"A format style that transforms a continuous input into a discrete output and provides"},{"type":"text","text":" "},{"type":"text","text":"information about its discretization boundaries."}],"url":"\/documentation\/foundationessentials\/discreteformatstyle","role":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/FormatOutput":{"type":"topic","abstract":[{"type":"text","text":"The type this format style produces as output."}],"kind":"symbol","url":"\/documentation\/foundationessentials\/formatstyle\/formatoutput","fragments":[{"text":"associatedtype","kind":"keyword"},{"kind":"text","text":" "},{"text":"FormatOutput","kind":"identifier"}],"role":"symbol","title":"FormatOutput","required":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput"},"doc://FoundationEssentials/SQ":{"identifier":"doc:\/\/FoundationEssentials\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://FoundationEssentials/SE":{"identifier":"doc:\/\/FoundationEssentials\/SE","title":"Swift.Encodable","type":"unresolvable"},"doc://FoundationEssentials/SH":{"identifier":"doc:\/\/FoundationEssentials\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle/FormatInput":{"url":"\/documentation\/foundationessentials\/formatstyle\/formatinput","role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"text":" ","kind":"text"},{"kind":"identifier","text":"FormatInput"}],"required":true,"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The type this format style accepts as input."}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","title":"FormatInput"},"doc://FoundationEssentials/documentation/FoundationEssentials/DiscreteFormatStyle/input(before:)":{"title":"input(before:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"input"},{"kind":"text","text":"("},{"kind":"externalParam","text":"before"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"FormatInput","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa"},{"text":") -