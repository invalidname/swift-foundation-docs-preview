{"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"title":"Data formatting","anchor":"Data-formatting","generated":true}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DiscreteFormatStyle"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","kind":"typeIdentifier","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","text":"FormatInput"},{"kind":"text","text":", "},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa","kind":"typeIdentifier","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput","text":"FormatOutput"},{"kind":"text","text":"> : "},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP","kind":"typeIdentifier","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","text":"FormatStyle"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use this protocol to keep displays up to date if input changes continuously, or to iterate"},{"type":"text","text":" "},{"type":"text","text":"over all possible outputs of a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle"},{"type":"text","text":" by obtaining the next discrete input in either direction"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Ordering of Inputs","anchor":"Ordering-of-Inputs","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The ordering over "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput"},{"type":"text","text":" "},{"type":"text","text":"defined by "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)"},{"type":"text","text":" \/ "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)"},{"type":"text","text":" must be"},{"type":"text","text":" "},{"type":"text","text":"consistent between the two functions. If "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput"},{"type":"text","text":" conforms to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":" protocol, the format style’s ordering "},{"type":"emphasis","inlineContent":[{"text":"should","type":"text"}]},{"type":"text","text":" be consistent with the canonical ordering"},{"type":"text","text":" "},{"type":"text","text":"defined via the "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":" conformance, i.e. it should hold that"},{"type":"text","text":" "},{"type":"codeVoice","code":"discreteInput(before: x)! < x < discreteInput(after: x)!"},{"type":"text","text":" where discrete inputs"},{"type":"text","text":" "},{"type":"text","text":"are not nil."}],"type":"paragraph"},{"text":"Stepping through Discrete Input\/Output Pairs","anchor":"Stepping-through-Discrete-InputOutput-Pairs","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"One use case of this protocol is enumerating all discrete inputs of a format style and their respective"},{"type":"text","text":" "},{"type":"text","text":"outputs."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"While the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)"},{"type":"text","text":" "},{"type":"text","text":"functions are the right tool for that, they do not give a guarantee that their respective return values"},{"type":"text","text":" "},{"type":"text","text":"actually produce an output that is different from the output produced by formatting the "},{"type":"codeVoice","code":"input"},{"type":"text","text":" value"},{"type":"text","text":" "},{"type":"text","text":"used when calling "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)"},{"text":" \/ ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)"},{"text":", they only","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"provide a value that produces a different output for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"most"}]},{"type":"text","text":" inputs. E.g. when formatting a floating point"},{"type":"text","text":" "},{"type":"text","text":"value as an integer, we can get the next discrete input after "},{"type":"codeVoice","code":"x"},{"type":"text","text":" by calculating "},{"type":"codeVoice","code":"floor(x + 1)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"However, when rounding toward zero, the whole interval (-1;1) formats as zero. It would be ok for a"},{"type":"text","text":" "},{"type":"text","text":"discrete format style to ignore that edge case and return "},{"type":"codeVoice","code":"0"},{"type":"text","text":" for the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)"},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"negative value greater than ","type":"text"},{"type":"codeVoice","code":"-1"},{"text":". Therefore, to enumerate all discrete input\/output pairs, adjacent","type":"text"},{"text":" ","type":"text"},{"text":"outputs must be deduplicated in order to guarantee no adjacent outputs are the same.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example produces all discrete input\/output pairs for inputs in a given ","type":"text"},{"code":"range","type":"codeVoice"},{"text":" making","type":"text"},{"text":" ","type":"text"},{"text":"sure adjacent outputs are unequal:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["extension DiscreteFormatStyle","    where FormatInput : Comparable, FormatOutput : Equatable","{","        func enumerated(","        in range: ClosedRange<FormatInput>","    ) -> [(input: FormatInput, output: FormatOutput)] {","        var input = range.lowerBound","        var output = format(input)","","        var pairs = [(input: FormatInput, output: FormatOutput)]()","        pairs.append((input, output))","","        \/\/ get the next discretization bound","        while let nextInput = discreteInput(after: input),","              \/\/ check that it is still in the requested `range`","              nextInput <= range.upperBound {","            \/\/ get the respective formatted output","            let nextOutput = format(nextInput)","            \/\/ deduplicate based on the formatted output","            if nextOutput != output {","                pairs.append((nextInput, nextOutput))","            }","                input = nextInput","            output = nextOutput","        }","","        return pairs","    }","}"],"syntax":"swift"},{"text":"Imperfect Discretization Boundaries","level":2,"anchor":"Imperfect-Discretization-Boundaries","type":"heading"},{"inlineContent":[{"type":"text","text":"In some scenarios, a format style cannot provide precise discretization boundaries in"},{"text":" ","type":"text"},{"type":"text","text":"a performant manner. In those cases it must override "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(before:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(after:)"},{"type":"text","text":" to reflect that. For any discretization boundary "},{"type":"codeVoice","code":"x"},{"type":"text","text":" returned by either"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)"},{"text":" or ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)"},{"text":" based on the","type":"text"},{"text":" ","type":"text"},{"text":"original input ","type":"text"},{"code":"y","type":"codeVoice"},{"text":", all values representable in the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput"},{"text":"strictly  between","type":"text"},{"text":" ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" and the return value of ","type":"text"},{"code":"input(after: x)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"input(before: x)","type":"codeVoice"},{"text":", respectively, are not","type":"text"},{"text":" ","type":"text"},{"text":"guaranteed to produce the same formatted output as ","type":"text"},{"code":"y","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following schematic shows an overview of the guarantees given by the protocol:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["xB = discreteInput(before: y)       y      xA = discreteInput(after: y)","      |                             |                             |","<-----+---+-------------------------+-------------------------+---+--->","          |                                                   |"," zB = input(after: xB)                          zA = input(before: xA)"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"the formatted output for everything in "},{"type":"codeVoice","code":"zB...zA"},{"type":"text","text":" (including bounds) is "},{"type":"strong","inlineContent":[{"type":"text","text":"guaranteed"}]},{"type":"text","text":" to be equal"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"format(y)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the formatted output for "},{"type":"codeVoice","code":"xB"},{"type":"text","text":" and lower is "},{"type":"strong","inlineContent":[{"type":"text","text":"most likely"}]},{"type":"text","text":" different from "},{"type":"codeVoice","code":"format(y)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the formatted output for "},{"type":"codeVoice","code":"xA"},{"type":"text","text":" and higher is "},{"type":"strong","inlineContent":[{"type":"text","text":"most likely"}]},{"type":"text","text":" different from "},{"type":"codeVoice","code":"format(y)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the  formatted output between "},{"type":"codeVoice","code":"xB"},{"type":"text","text":" and "},{"type":"codeVoice","code":"zB"},{"type":"text","text":", as well as "},{"type":"codeVoice","code":"zA"},{"type":"text","text":" and "},{"type":"codeVoice","code":"xA"},{"type":"text","text":" (excluding bounds) cannot"},{"type":"text","text":" "},{"type":"text","text":"be predicted"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/discreteformatstyle"]}],"kind":"symbol","metadata":{"title":"DiscreteFormatStyle","navigatorTitle":[{"kind":"identifier","text":"DiscreteFormatStyle"}],"modules":[{"name":"FoundationEssentials"}],"platforms":[{"name":"iOS","deprecated":false,"introducedAt":"18.0","unavailable":false,"beta":false},{"name":"iPadOS","deprecated":false,"introducedAt":"18.0","unavailable":false,"beta":false},{"name":"Mac Catalyst","deprecated":false,"introducedAt":"18.0","unavailable":false,"beta":false},{"name":"macOS","deprecated":false,"introducedAt":"15.0","unavailable":false,"beta":false},{"name":"tvOS","deprecated":false,"introducedAt":"18.0","unavailable":false,"beta":false},{"name":"watchOS","deprecated":false,"introducedAt":"11.0","unavailable":false,"beta":false}],"roleHeading":"Protocol","externalID":"s:20FoundationEssentials19DiscreteFormatStyleP","role":"symbol","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DiscreteFormatStyle"}]},"