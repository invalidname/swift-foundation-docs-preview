xt":"from ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Ordering of Inputs","anchor":"Ordering-of-Inputs","type":"heading","level":2},{"inlineContent":[{"text":"The ordering over ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"defined by ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","type":"reference","isActive":true},{"text":" \/ ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference","isActive":true},{"text":" must be","type":"text"},{"text":" ","type":"text"},{"text":"consistent between the two functions. If ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","type":"reference","isActive":true},{"text":" conforms to the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":" protocol, the format style’s ordering ","type":"text"},{"inlineContent":[{"text":"should","type":"text"}],"type":"emphasis"},{"text":" be consistent with the canonical ordering","type":"text"},{"text":" ","type":"text"},{"text":"defined via the ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":" conformance, i.e. it should hold that","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"discreteInput(before: x)! < x < discreteInput(after: x)!"},{"text":" where discrete inputs","type":"text"},{"text":" ","type":"text"},{"text":"are not nil.","type":"text"}],"type":"paragraph"},{"text":"Stepping through Discrete Input\/Output Pairs","anchor":"Stepping-through-Discrete-InputOutput-Pairs","type":"heading","level":2},{"inlineContent":[{"text":"One use case of this protocol is enumerating all discrete inputs of a format style and their respective","type":"text"},{"text":" ","type":"text"},{"text":"outputs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"While the ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"functions are the right tool for that, they do not give a guarantee that their respective return values","type":"text"},{"text":" ","type":"text"},{"text":"actually produce an output that is different from the output produced by formatting the ","type":"text"},{"type":"codeVoice","code":"input"},{"text":" value","type":"text"},{"text":" ","type":"text"},{"text":"used when calling ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","type":"reference","isActive":true},{"text":" \/ ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference","isActive":true},{"text":", they only","type":"text"},{"text":" ","type":"text"},{"text":"provide a value that produces a different output for ","type":"text"},{"inlineContent":[{"text":"most","type":"text"}],"type":"emphasis"},{"text":" inputs. E.g. when formatting a floating point","type":"text"},{"text":" ","type":"text"},{"text":"value as an integer, we can get the next discrete input after ","type":"text"},{"type":"codeVoice","code":"x"},{"text":" by calculating ","type":"text"},{"type":"codeVoice","code":"floor(x + 1)"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"However, when rounding toward zero, the whole interval (-1;1) formats as zero. It would be ok for a","type":"text"},{"text":" ","type":"text"},{"text":"discrete format style to ignore that edge case and return ","type":"text"},{"type":"codeVoice","code":"0"},{"text":" for the ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference","isActive":true},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"negative value greater than ","type":"text"},{"type":"codeVoice","code":"-1"},{"text":". Therefore, to enumerate all discrete input\/output pairs, adjacent","type":"text"},{"text":" ","type":"text"},{"text":"outputs must be deduplicated in order to guarantee no adjacent outputs are the same.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example produces all discrete input\/output pairs for inputs in a given ","type":"text"},{"type":"codeVoice","code":"range"},{"text":" making","type":"text"},{"text":" ","type":"text"},{"text":"sure adjacent outputs are unequal:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension DiscreteFormatStyle","    where FormatInput : Comparable, FormatOutput : Equatable","{","        func enumerated(","        in range: ClosedRange<FormatInput>","    ) -> [(input: FormatInput, output: FormatOutput)] {","        var input = range.lowerBound","        var output = format(input)","","        var pairs = [(input: FormatInput, output: FormatOutput)]()","        pairs.append((input, output))","","        \/\/ get the next discretization bound","        while let nextInput = discreteInput(after: input),","              \/\/ check that it is still in the requested `range`","              nextInput <= range.upperBound {","            \/\/ get the respective formatted output","            let nextOutput = format(nextInput)","            \/\/ deduplicate based on the formatted output","            if nextOutput != output {","                pairs.append((nextInput, nextOutput))","            }","                input = nextInput","            output = nextOutput","        }","","        return pairs","    }","}"]},{"text":"Imperfect Discretization Boundaries","anchor":"Imperfect-Discretization-Boundaries","type":"heading","level":2},{"inlineContent":[{"text":"In some scenarios, a format style cannot provide precise discretization boundaries in","type":"text"},{"text":" ","type":"text"},{"text":"a performant manner. In those cases it must override ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(before:)","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(after:)","type":"reference","isActive":true},{"text":" to reflect that. For any discretization boundary ","type":"text"},{"type":"codeVoice","code":"x"},{"text":" returned by either","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference","isActive":true},{"text":" based on the","type":"text"},{"text":" ","type":"text"},{"text":"original input ","type":"text"},{"type":"codeVoice","code":"y"},{"text":", all values representable in the ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","type":"reference","isActive":true},{"text":"strictly  between","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"x"},{"text":" and the return value of ","type":"text"},{"type":"codeVoice","code":"input(after: x)"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"input(before: x)"},{"text":", respectively, are not","type":"text"},{"text":" ","type":"text"},{"text":"guaranteed to produce the same formatted output as ","type":"text"},{"type":"codeVoice","code":"y"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following schematic shows an overview of the guarantees given by the protocol:","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["xB = discreteInput(before: y)       y      xA = discreteInput(after: y)","      |                             |                             |","<-----+---+-------------------------+-------------------------+---+--->","          |                                                   |"," zB = input(after: xB)                          zA = input(before: xA)"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the formatted output for everything in ","type":"text"},{"code":"zB...zA","type":"codeVoice"},{"text":" (including bounds) is ","type":"text"},{"inlineContent":[{"text":"guaranteed","type":"text"}],"type":"strong"},{"text":" to be equal","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"format(y)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the formatted output for ","type":"text"},{"code":"xB","type":"codeVoice"},{"text":" and lower is ","type":"text"},{"inlineContent":[{"text":"most likely","type":"text"}],"type":"strong"},{"text":" different from ","type":"text"},{"code":"format(y)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the formatted output for ","type":"text"},{"code":"xA","type":"codeVoice"},{"text":" and higher is ","type":"text"},{"inlineContent":[{"text":"most likely","type":"text"}],"type":"strong"},{"text":" different from ","type":"text"},{"code":"format(y)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the  formatted output between ","type":"text"},{"code":"xB","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"zB","type":"codeVoice"},{"text":", as well as ","type":"text"},{"code":"zA","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"xA","type":"codeVoice"},{"text":" (excluding bounds) cannot","type":"text"},{"text":" ","type":"text"},{"text":"be predicted","type":"text"}]}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"abstract":[{"text":"A format style that transforms a continuous input into a discrete output and provides","type":"text"},{"text":" ","type":"text"},{"text":"information about its discretization boundaries.","type":"text"}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/DiscreteFormatStyle/discreteInput(after:)":{"type":"topic","url":"\/documentation\/foundationessentials\/discreteformatstyle\/discreteinput(after:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"discreteInput","kind":"identifier"},{"text":"(","kind":"text"},{"text":"after","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","text":"FormatInput","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"kind":"text","text":"."},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","text":"FormatInput","kind":"typeIdentifier"},{"kind":"text","text":"?"}],"identifier":"doc: