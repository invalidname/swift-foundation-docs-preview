{"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"kind":"symbol","abstract":[{"type":"text","text":"A format style that transforms a continuous input into a discrete output and provides"},{"type":"text","text":" "},{"type":"text","text":"information about its discretization boundaries."}],"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH"],"type":"inheritsFrom","kind":"relationships"}],"topicSections":[{"anchor":"Accessing-boundaries","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)"],"title":"Accessing boundaries"},{"anchor":"Accessing-values","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(before:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(after:)"],"title":"Accessing values"}],"seeAlsoSections":[{"anchor":"Data-formatting","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"generated":true,"title":"Data formatting"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/discreteformatstyle"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscreteFormatStyle","kind":"identifier"},{"text":"<","kind":"text"},{"text":"FormatInput","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"FormatOutput","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa","kind":"typeIdentifier"},{"text":"> : ","kind":"text"},{"text":"FormatStyle","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this protocol to keep displays up to date if input changes continuously, or to iterate"},{"type":"text","text":" "},{"type":"text","text":"over all possible outputs of a "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","isActive":true,"type":"reference"},{"type":"text","text":" by obtaining the next discrete input in either direction"},{"type":"text","text":" "},{"type":"text","text":"from "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Ordering of Inputs","anchor":"Ordering-of-Inputs"},{"type":"paragraph","inlineContent":[{"text":"The ordering over ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","isActive":true},{"text":" ","type":"text"},{"text":"defined by ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","isActive":true},{"text":" \/ ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true},{"text":" must be","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"consistent between the two functions. If "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","isActive":true},{"type":"text","text":" conforms to the"},{"type":"text","text":" "},{"code":"Comparable","type":"codeVoice"},{"type":"text","text":" protocol, the format style’s ordering "},{"type":"emphasis","inlineContent":[{"type":"text","text":"should"}]},{"type":"text","text":" be consistent with the canonical ordering"},{"type":"text","text":" "},{"type":"text","text":"defined via the "},{"code":"Comparable","type":"codeVoice"},{"type":"text","text":" conformance, i.e. it should hold that"},{"type":"text","text":" "},{"code":"discreteInput(before: x)! < x < discreteInput(after: x)!","type":"codeVoice"},{"type":"text","text":" where discrete inputs"},{"type":"text","text":" "},{"type":"text","text":"are not nil."}]},{"text":"Stepping through Discrete Input\/Output Pairs","anchor":"Stepping-through-Discrete-InputOutput-Pairs","type":"heading","level":2},{"inlineContent":[{"text":"One use case of this protocol is enumerating all discrete inputs of a format style and their respective","type":"text"},{"text":" ","type":"text"},{"text":"outputs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"While the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)"},{"type":"text","text":" "},{"type":"text","text":"functions are the right tool for that, they do not give a guarantee that their respective return values"},{"type":"text","text":" "},{"type":"text","text":"actually produce an output that is different from the output produced by formatting the "},{"code":"input","type":"codeVoice"},{"type":"text","text":" value"},{"text":" ","type":"text"},{"text":"used when calling ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","type":"reference"},{"text":" \/ ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference"},{"text":", they only","type":"text"},{"text":" ","type":"text"},{"text":"provide a value that produces a different output for ","type":"text"},{"inlineContent":[{"text":"most","type":"text"}],"type":"emphasis"},{"text":" inputs. E.g. when formatting a floating point","type":"text"},{"text":" ","type":"text"},{"text":"value as an integer, we can get the next discrete input after ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" by calculating ","type":"text"},{"code":"floor(x + 1)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"However, when rounding toward zero, the whole interval (-1;1) formats as zero. It would be ok for a","type":"text"},{"text":" ","type":"text"},{"text":"discrete format style to ignore that edge case and return ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" for the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference"},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"negative value greater than ","type":"text"},{"code":"-1","type":"codeVoice"},{"text":". Therefore, to enumerate all discrete input\/output pairs, adjacent","type":"text"},{"text":" ","type":"text"},{"text":"outputs must be deduplicated in order to guarantee no adjacent outputs are the same.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example produces all discrete input\/output pairs for inputs in a given "},{"type":"codeVoice","code":"range"},{"type":"text","text":" making"},{"type":"text","text":" "},{"type":"text","text":"sure adjacent outputs are unequal:"}],"type":"paragraph"},{"syntax":"swift","code":["extension DiscreteFormatStyle","    where FormatInput : Comparable, FormatOutput : Equatable","{","        func enumerated(","        in range: ClosedRange<FormatInput>","    ) -> [(input: FormatInput, output: FormatOutput)] {","        var input = range.lowerBound","        var output = format(input)","","        var pairs = [(input: FormatInput, output: FormatOutput)]()","        pairs.append((input, output))","","        \/\/ get the next discretization bound","        while let nextInput = discreteInput(after: input),","              \/\/ check that it is still in the requested `range`","              nextInput <= range.upperBound {","            \/\/ get the respective formatted output","            let nextOutput = format(nextInput)","            \/\/ deduplicate based on the formatted output","            if nextOutput != output {","                pairs.append((nextInput, nextOutput))","            }","                input = nextInput","            output = nextOutput","        }","","        return pairs","    }","}"],"type":"codeListing"},{"level":2,"text":"Imperfect Discretization Boundaries","type":"heading","anchor":"Imperfect-Discretization-Boundaries"},{"inlineContent":[{"text":"In some scenarios, a format style cannot provide precise discretization boundaries in","type":"text"},{"text":" ","type":"text"},{"text":"a performant manner. In those cases it must override ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(before:)","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(after:)","isActive":true,"type":"reference"},{"text":" to reflect that. For any discretization boundary ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" returned by either","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true,"type":"reference"},{"text":" based on the","type":"text"},{"text":" ","type":"text"},{"text":"original input ","type":"text"},{"code":"y","type":"codeVoice"},{"text":", all values representable in the ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","isActive":true,"type":"reference"},{"text":"strictly  between","type":"text"},{"text":" ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" and the return value of ","type":"text"},{"code":"input(after: x)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"input(before: x)","type":"codeVoice"},{"text":", respectively, are not","type":"text"},{"text":" ","type":"text"},{"text":"guaranteed to produce the same formatted output as ","type":"text"},{"code":"y","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following schematic shows an overview of the guarantees given by the protocol:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["xB = discreteInput(before: y)       y      xA = discreteInput(after: y)","      |                             |                             |","<-----+---+-------------------------+-------------------------+---+--->","          |                                                   |"," zB = input(after: xB)                          zA = input(before: xA)"],"syntax":null},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the formatted output for everything in "},{"type":"codeVoice","code":"zB...zA"},{"type":"text","text":" (including bounds) is "},{"inlineContent":[{"text":"guaranteed","type":"text"}],"type":"strong"},{"type":"text","text":" to be equal"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"format(y)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the formatted output for ","type":"text"},{"type":"codeVoice","code":"xB"},{"text":" and lower is ","type":"text"},{"inlineContent":[{"type":"text","text":"most likely"}],"type":"strong"},{"text":" different from ","type":"text"},{"type":"codeVoice","code":"format(y)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the formatted output for "},{"type":"codeVoice","code":"xA"},{"type":"text","text":" and higher is "},{"type":"strong","inlineContent":[{"text":"most likely","type":"text"}]},{"type":"text","text":" different from "},{"type":"codeVoice","code":"format(y)"}]}]},{"content":[{"inlineContent":[{"text":"the  formatted output between ","type":"text"},{"code":"xB","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"zB"},{"type":"text","text":", as well as "},{"type":"codeVoice","code":"zA"},{"type":"text","text":" and "},{"type":"codeVoice","code":"xA"},{"type":"text","text":" (excluding bounds) cannot"},{"type":"text","text":" "},{"type":"text","text":"be predicted"}],"type":"paragraph"}]}]}],"kind":"content"}],"s