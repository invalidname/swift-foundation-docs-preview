{"seeAlsoSections":[{"anchor":"Data-formatting","generated":true,"title":"Data formatting","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"]}],"abstract":[{"type":"text","text":"A format style that transforms a continuous input into a discrete output and provides"},{"type":"text","text":" "},{"type":"text","text":"information about its discretization boundaries."}],"variants":[{"paths":["\/documentation\/foundationessentials\/discreteformatstyle"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscreteFormatStyle","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","text":"FormatInput","kind":"typeIdentifier","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa","text":"FormatOutput","kind":"typeIdentifier","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput"},{"text":"> : ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP","text":"FormatStyle","kind":"typeIdentifier","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle"}],"platforms":["macOS"]}]},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use this protocol to keep displays up to date if input changes continuously, or to iterate","type":"text"},{"text":" ","type":"text"},{"text":"over all possible outputs of a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","type":"reference"},{"text":" by obtaining the next discrete input in either direction","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference"},{"text":".","type":"text"}]},{"text":"Ordering of Inputs","anchor":"Ordering-of-Inputs","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The ordering over "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","isActive":true},{"type":"text","text":" "},{"type":"text","text":"defined by "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","isActive":true},{"type":"text","text":" \/ "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","isActive":true},{"type":"text","text":" must be"},{"type":"text","text":" "},{"type":"text","text":"consistent between the two functions. If "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","isActive":true},{"type":"text","text":" conforms to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":" protocol, the format style’s ordering "},{"type":"emphasis","inlineContent":[{"type":"text","text":"should"}]},{"type":"text","text":" be consistent with the canonical ordering"},{"type":"text","text":" "},{"type":"text","text":"defined via the "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":" conformance, i.e. it should hold that"},{"type":"text","text":" "},{"type":"codeVoice","code":"discreteInput(before: x)! < x < discreteInput(after: x)!"},{"type":"text","text":" where discrete inputs"},{"type":"text","text":" "},{"type":"text","text":"are not nil."}],"type":"paragraph"},{"type":"heading","anchor":"Stepping-through-Discrete-InputOutput-Pairs","level":2,"text":"Stepping through Discrete Input\/Output Pairs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"One use case of this protocol is enumerating all discrete inputs of a format style and their respective"},{"type":"text","text":" "},{"type":"text","text":"outputs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"While the "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"functions are the right tool for that, they do not give a guarantee that their respective return values"},{"type":"text","text":" "},{"type":"text","text":"actually produce an output that is different from the output produced by formatting the "},{"type":"codeVoice","code":"input"},{"type":"text","text":" value"},{"type":"text","text":" "},{"type":"text","text":"used when calling "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","type":"reference","isActive":true},{"type":"text","text":" \/ "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference","isActive":true},{"type":"text","text":", they only"},{"type":"text","text":" "},{"type":"text","text":"provide a value that produces a different output for "},{"inlineContent":[{"text":"most","type":"text"}],"type":"emphasis"},{"text":" inputs. E.g. when formatting a floating point","type":"text"},{"text":" ","type":"text"},{"text":"value as an integer, we can get the next discrete input after ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" by calculating ","type":"text"},{"code":"floor(x + 1)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"However, when rounding toward zero, the whole interval (-1;1) formats as zero. It would be ok for a","type":"text"},{"text":" ","type":"text"},{"text":"discrete format style to ignore that edge case and return ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" for the ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference","isActive":true},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"negative value greater than ","type":"text"},{"code":"-1","type":"codeVoice"},{"text":". Therefore, to enumerate all discrete input\/output pairs, adjacent","type":"text"},{"text":" ","type":"text"},{"text":"outputs must be deduplicated in order to guarantee no adjacent outputs are the same.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The following example produces all discrete input\/output pairs for inputs in a given "},{"type":"codeVoice","code":"range"},{"type":"text","text":" making"},{"type":"text","text":" "},{"type":"text","text":"sure adjacent outputs are unequal:"}],"type":"paragraph"},{"type":"codeListing","code":["extension DiscreteFormatStyle","    where FormatInput : Comparable, FormatOutput : Equatable","{","        func enumerated(","        in range: ClosedRange<FormatInput>","    ) -> [(input: FormatInput, output: FormatOutput)] {","        var input = range.lowerBound","        var output = format(input)","","        var pairs = [(input: FormatInput, output: FormatOutput)]()","        pairs.append((input, output))","","        \/\/ get the next discretization bound","        while let nextInput = discreteInput(after: input),","              \/\/ check that it is still in the requested `range`","              nextInput <= range.upperBound {","            \/\/ get the respective formatted output","            let nextOutput = format(nextInput)","            \/\/ deduplicate based on the formatted output","            if nextOutput != output {","                pairs.append((nextInput, nextOutput))","            }","                input = nextInput","            output = nextOutput","        }","","        return pairs","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"Imperfect-Discretization-Boundaries","level":2,"text":"Imperfect Discretization Boundaries"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In some scenarios, a format style cannot provide precise discretization boundaries in"},{"type":"text","text":" "},{"type":"text","text":"a performant manner. In those cases it must override "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(before:)","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(after:)"},{"type":"text","text":" to reflect that. For any discretization boundary "},{"type":"codeVoice","code":"x"},{"type":"text","text":" returned by either"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)"},{"type":"text","text":" or "},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference"},{"text":" based on the","type":"text"},{"text":" ","type":"text"},{"text":"original input ","type":"text"},{"type":"codeVoice","code":"y"},{"text":", all values representable in the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","type":"reference"},{"type":"text","text":"strictly  between"},{"text":" ","type":"text"},{"type":"codeVoice","code":"x"},{"text":" and the return value of ","type":"text"},{"type":"codeVoice","code":"input(after: x)"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"input(before: x)"},{"text":", respectively, are not","type":"text"},{"text":" ","type":"text"},{"text":"guaranteed to produce the same formatted output as ","type":"text"},{"type":"codeVoice","code":"y"},{"text":".","type":"text"}]},{"inlineContent":[{"type":"text","text":"The following schematic shows an overview of the guarantees given by the protocol:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["xB = discreteInput(before: y)       y      xA = discreteInput(after: y)","      |                             |                             |","<-----+---+-------------------------+-------------------------+---+--->","          |                                                   |"," zB = input(after: xB)                          zA = input(before: xA)"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the formatted output for everything in "},{"code":"zB...zA","type":"codeVoice"},{"text":" (including bounds) is ","type":"text"},{"type":"strong","inlineContent":[{"text":"guaranteed","type":"text"}]},{"type":"text","text":" to be equal"},{"text":" ","type":"text"},{"type":"text","text":"to "},{"code":"format(y)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the formatted output for ","type":"text"},{"code":"xB","type":"codeVoice"},{"text":" and lower is ","type":"text"},{"inlineContent":[{"text":"most likely","type":"text"}],"type":"strong"},{"text":" different from ","type":"text"},{"code":"format(y)","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"the formatted output for ","type":"text"},{"code":"xA","type":"codeVoice"},{"text":" and higher is ","type":"text"},{"inlineContent":[{"type":"text","text":"most likely"}],"type":"strong"},{"text":" different from ","type":"text"},{"code":"format(y)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"the  formatted output between ","type":"text"},{"code":"xB","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"zB","type":"codeVoice"},{"text":", as well as ","type":"text"},{"code":"zA","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"xA","type":"codeVoice"},{"text":" (excluding bounds) cannot","type":"text"},{"text":" ","type":"text"},{"text":"be predicted","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle"},"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"metadata":{"roleHeading":"Protocol","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DiscreteFormatStyle"}],"modules":[{"name":"FoundationEssentials"}],"role":"symbol","externalID":"s:20FoundationEssentials19DiscreteFormatStyleP","navigatorTitle":[{"kind":"identifier","text":"DiscreteFormatStyle"}],"platforms":[{"beta":false,"name":"iOS","unavailable":false,"introducedAt":"18.0","deprecated":false},{"beta":false,"name":"iPadOS","unavailable":false,"introducedAt":"18.0","deprecated":false},{"beta":false,"name":"Mac Catalyst","unavailable":false,"introducedAt":"18.0","deprecated":false},{"beta":false,"name":"macOS","unavailable":false,"introducedAt":"15.0","deprecated":false},{"beta":false,"name":"tvOS","unavailable":false,"introd