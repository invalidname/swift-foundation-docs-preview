{"topicSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)"],"title":"Accessing boundaries","anchor":"Accessing-boundaries"},{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(before:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(after:)"],"title":"Accessing values","anchor":"Accessing-values"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DiscreteFormatStyle"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","text":"FormatInput"},{"kind":"text","text":", "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatOutput","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa","text":"FormatOutput"},{"kind":"text","text":"> : "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP","text":"FormatStyle"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Use this protocol to keep displays up to date if input changes continuously, or to iterate","type":"text"},{"text":" ","type":"text"},{"text":"over all possible outputs of a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","type":"reference"},{"text":" by obtaining the next discrete input in either direction","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Ordering of Inputs","anchor":"Ordering-of-Inputs"},{"inlineContent":[{"text":"The ordering over ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","type":"reference"},{"text":" ","type":"text"},{"text":"defined by ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","type":"reference"},{"text":" \/ ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference"},{"text":" must be","type":"text"},{"type":"text","text":" "},{"text":"consistent between the two functions. If ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","type":"reference"},{"text":" conforms to the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":" protocol, the format style’s ordering ","type":"text"},{"inlineContent":[{"type":"text","text":"should"}],"type":"emphasis"},{"type":"text","text":" be consistent with the canonical ordering"},{"type":"text","text":" "},{"type":"text","text":"defined via the "},{"type":"codeVoice","code":"Comparable"},{"text":" conformance, i.e. it should hold that","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"discreteInput(before: x)! < x < discreteInput(after: x)!"},{"type":"text","text":" where discrete inputs"},{"type":"text","text":" "},{"type":"text","text":"are not nil."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Stepping through Discrete Input\/Output Pairs","anchor":"Stepping-through-Discrete-InputOutput-Pairs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"One use case of this protocol is enumerating all discrete inputs of a format style and their respective"},{"type":"text","text":" "},{"type":"text","text":"outputs."}]},{"inlineContent":[{"type":"text","text":"While the "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"type":"text","text":"functions are the right tool for that, they do not give a guarantee that their respective return values"},{"text":" ","type":"text"},{"text":"actually produce an output that is different from the output produced by formatting the ","type":"text"},{"code":"input","type":"codeVoice"},{"text":" value","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"used when calling "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","type":"reference","isActive":true},{"text":" \/ ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference","isActive":true},{"type":"text","text":", they only"},{"type":"text","text":" "},{"type":"text","text":"provide a value that produces a different output for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"most"}]},{"type":"text","text":" inputs. E.g. when formatting a floating point"},{"type":"text","text":" "},{"type":"text","text":"value as an integer, we can get the next discrete input after "},{"code":"x","type":"codeVoice"},{"text":" by calculating ","type":"text"},{"type":"codeVoice","code":"floor(x + 1)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"However, when rounding toward zero, the whole interval (-1;1) formats as zero. It would be ok for a"},{"type":"text","text":" "},{"type":"text","text":"discrete format style to ignore that edge case and return "},{"code":"0","type":"codeVoice"},{"type":"text","text":" for the "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference","isActive":true},{"text":" a","type":"text"},{"type":"text","text":" "},{"text":"negative value greater than ","type":"text"},{"code":"-1","type":"codeVoice"},{"text":". Therefore, to enumerate all discrete input\/output pairs, adjacent","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"outputs must be deduplicated in order to guarantee no adjacent outputs are the same."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The following example produces all discrete input\/output pairs for inputs in a given ","type":"text"},{"type":"codeVoice","code":"range"},{"text":" making","type":"text"},{"type":"text","text":" "},{"text":"sure adjacent outputs are unequal:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["extension DiscreteFormatStyle","    where FormatInput : Comparable, FormatOutput : Equatable","{","        func enumerated(","        in range: ClosedRange<FormatInput>","    ) -> [(input: FormatInput, output: FormatOutput)] {","        var input = range.lowerBound","        var output = format(input)","","        var pairs = [(input: FormatInput, output: FormatOutput)]()","        pairs.append((input, output))","","        \/\/ get the next discretization bound","        while let nextInput = discreteInput(after: input),","              \/\/ check that it is still in the requested `range`","              nextInput <= range.upperBound {","            \/\/ get the respective formatted output","            let nextOutput = format(nextInput)","            \/\/ deduplicate based on the formatted output","            if nextOutput != output {","                pairs.append((nextInput, nextOutput))","            }","                input = nextInput","            output = nextOutput","        }","","        return pairs","    }","}"]},{"text":"Imperfect Discretization Boundaries","anchor":"Imperfect-Discretization-Boundaries","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In some scenarios, a format style cannot provide precise discretization boundaries in"},{"type":"text","text":" "},{"type":"text","text":"a performant manner. In those cases it must override "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(before:)","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(after:)","type":"reference","isActive":true},{"text":" to reflect that. For any discretization boundary ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" returned by either","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(before:)","type":"reference","isActive":true},{"type":"text","text":" or "},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/discreteInput(after:)","type":"reference"},{"type":"text","text":" based on the"},{"text":" ","type":"text"},{"text":"original input ","type":"text"},{"code":"y","type":"codeVoice"},{"text":", all values representable in the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle\/FormatInput","type":"reference"},{"type":"text","text":"strictly  between"},{"type":"text","text":" "},{"type":"codeVoice","code":"x"},{"text":" and the return value of ","type":"text"},{"code":"input(after: x)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"input(before: x)","type":"codeVoice"},{"text":", respectively, are not","type":"text"},{"text":" ","type":"text"},{"text":"guaranteed to produce the same formatted output as ","type":"text"},{"code":"y","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following schematic shows an overview of the guarantees given by the protocol:","type":"text"}]},{"syntax":null,"type":"codeListing","code":["xB = discreteInput(before: y)       y      xA = discreteInput(after: y)","      |                             |                             |","<-----+---+-------------------------+-------------------------+---+--->","          |                                                   |"," zB = input(after: xB)                          zA = input(before: xA)"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the formatted output for everything in ","type":"text"},{"code":"zB...zA","type":"codeVoice"},{"text":" (including bounds) is ","type":"text"},{"inlineContent":[{"type":"text","text":"guaranteed"}],"type":"strong"},{"text":" to be equal","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"format(y)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the formatted output for ","type":"text"},{"code":"xB","type":"codeVoice"},{"type":"text","text":" and lower is "},{"inlineContent":[{"text":"most likely","type":"text"}],"type":"strong"},{"type":"text","text":" different from "},{"code":"format(y)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the formatted output for ","type":"text"},{"type":"codeVoice","code":"xA"},{"text":" and higher is ","type":"text"},{"inlineContent":[{"text":"most likely","type":"text"}],"type":"strong"},{"text":" different from ","type":"text"},{"type":"codeVoice","code":"format(y)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the  formatted output between "},{"code":"xB","type":"codeVoice"},{"type":"text","text":" and "},{"code":"zB","type":"codeVoice"},{"type":"text","text":", as well as "},{"code":"zA","type":"codeVoice"},{"type":"text","text":" and "},{"code":"xA","type":"codeVoice"},{"type":"text","text":" (excluding bounds) cannot"},{"type":"text","text":" "},{"type":"text","text":"be predicted"}]}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/discreteformatstyle"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"title":"Data formatting","generated":true,"anchor":"Data-formatting"}],"abstract":[{"text":"A format style that transforms a continuous input into a discrete output and provides","type":"text"},{"text":" ","type":"text"},{"text":"information about its discretization boundaries.","type":"text"}],"relationshipsSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH"],"title":"Inherits From","type":"inheritsFrom","kind":"relationships"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentia