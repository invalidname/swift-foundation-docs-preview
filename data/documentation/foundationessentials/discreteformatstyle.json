":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SE","title":"Swift.Encodable"},"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle":{"role":"symbol","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatStyle"}],"url":"\/documentation\/foundationessentials\/formatstyle","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","title":"FormatStyle","type":"topic","abstract":[{"text":"A type that converts a given data type into a representation in another type, such as a string.","type":"text"}],"navigatorTitle":[{"text":"FormatStyle","kind":"identifier"}]},"doc://FoundationEssentials/documentation/FoundationEssentials/DiscreteFormatStyle/input(after:)":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DiscreteFormatStyle\/input(after:)","role":"symbol","defaultImplementations":4,"title":"input(after:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"input"},{"kind":"text","text":"("},{"kind":"externalParam","text":"after"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","text":"FormatInput"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","text":"FormatInput"},{"kind":"text","text":"?"}],"type":"topic","required":true,"kind":"symbol","url":"\/documentation\/foundationessentials\/discreteformatstyle\/input(after:)","abstract":[{"type":"text","text":"The next input value after the given input."}]}}}