","parameters":[{"name":"parentSummary","content":[{"inlineContent":[{"text":"The current summary value of the parent progress manager.","type":"text"}],"type":"paragraph"}]},{"name":"selfSummary","content":[{"inlineContent":[{"text":"The final summary value from the progress manager being deinitialized.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"The updated summary that replaces the parent’s current summary.","type":"text"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"This method is used when a progress manager in the hierarchy is being","type":"text"},{"text":" ","type":"text"},{"text":"deinitialized and its accumulated summary needs to be processed in relation to","type":"text"},{"text":" ","type":"text"},{"text":"its parent’s summary. The behavior can vary depending on the property type:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"For additive properties (like file counts, byte counts): The self summary","type":"text"},{"text":" ","type":"text"},{"text":"is typically added to the parent summary to preserve the accumulated progress.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For max-based properties (like estimated time remaining): The parent summary","type":"text"},{"text":" ","type":"text"},{"text":"is typically preserved as it represents an existing estimate.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For collection-based properties (like file URLs): The self summary may be","type":"text"},{"text":" ","type":"text"},{"text":"discarded to avoid accumulating stale references.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/f