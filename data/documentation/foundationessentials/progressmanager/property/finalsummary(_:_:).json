ry"}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"The updated summary that replaces the parent’s current summary."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This method is used when a progress manager in the hierarchy is being"},{"type":"text","text":" "},{"type":"text","text":"deinitialized and its accumulated summary needs to be processed in relation to"},{"type":"text","text":" "},{"type":"text","text":"its parent’s summary. The behavior can vary depending on the property type:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For additive properties (like file counts, byte counts): The self summary"},{"type":"text","text":" "},{"type":"text","text":"is typically added to the parent summary to preserve the accumulated progress."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For max-based properties (like estimated time remaining): The parent summary"},{"type":"text","text":" "},{"type":"text","text":"is typically preserved as it represents an existing estimate."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For collection-based properties (like file URLs): The self summary may be"},{"type":"text","text":" "},{"type":"text","text":"discarded to avoid accumulating stale references."}]}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager\/Property"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["