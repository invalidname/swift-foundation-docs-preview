:"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials15ProgressManagerC8PropertyP7SummaryQa"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"parentSummary","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The current summary value of the parent progress manager."}]}]},{"name":"selfSummary","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The final summary value from the progress manager being deinitialized."}]}]}]},{"kind":"content","content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"The updated summary that replaces the parent’s current summary.","type":"text"}],"type":"paragraph"}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"This method is used when a progress manager in the hierarchy is being"},{"type":"text","text":" "},{"type":"text","text":"deinitialized and its accumulated summary needs to be processed in relation to"},{"type":"text","text":" "},{"type":"text","text":"its parent’s summary. The behavior can vary depending on the property type:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"For additive properties (like file counts, byte counts): The self summary","type":"text"},{"text":" ","type":"text"},{"text":"is typically added to the parent summary to preserve the accumulated progress.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For max-based properties (like estimated time remaining): The parent summary","type":"text"},{"text":" ","type":"text"},{"text":"is typically preserved as it represents an existing estimate.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For collection-based properties (like file URLs): The self summary may be","type":"text"},{"text":" ","type":"text"},{"text":"discarded to avoid accumulating stale references.","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/ProgressManager/Property":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager\/Property","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Property"}],"navigatorTitle":[{"text":"Property","kind":"identifier"}],"title":"ProgressManager.Property","url":"\/documentation\/foundationessentials\/progressmanager\/property","abstract":[{"text":"A type that conveys additional task-specific information on progress.","type":"text"}]},"doc://FoundationEssentials/documentation/FoundationEssentials/ProgressManager":{"abstract":[{"type":"text","text":"An object that conveys ongoing progress to the user for a specified task."}],"title":"ProgressManager","url":"\/documentation\/foundationessentials\/progressmanager","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager","type":"topic","kind":"symbol","navigatorTitle":[{"text":"ProgressManager","kind":"identifier"}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProgressManager","kind":"identifier"}]},"doc://FoundationEssentials/documentation/FoundationEssentials/ProgressManager/Property/Summary":{"role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Summary","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Equatable","preciseIdentifier":"s:SQ","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"type":"text","text":"The type used for aggregated summaries of this property."}],"url":"\/documentation\/foundationessentials\/progressmanager\/property\/summary","ti