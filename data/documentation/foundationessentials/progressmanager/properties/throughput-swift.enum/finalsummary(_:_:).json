xt"},{"text":" ","type":"text"},{"text":"deinitialized and its accumulated summary needs to be processed in relation to","type":"text"},{"text":" ","type":"text"},{"text":"its parent’s summary. The behavior can vary depending on the property type:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"For additive properties (like file counts, byte counts): The self summary","type":"text"},{"text":" ","type":"text"},{"text":"is typically added to the parent summary to preserve the accumulated progress.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"For max-based properties (like estimated time remaining): The parent summary"},{"type":"text","text":" "},{"type":"text","text":"is typically preserved as it represents an existing estimate."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For collection-based properties (like file URLs): The self summary may be","type":"text"},{"text":" ","type":"text"},{"text":"discarded to avoid accumulating stale references.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager\/Properties\/Throughput-swift.enum\/finalSummary(_:_:)"},"sections":[],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager\/Properties","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager\/Properties\/Throughput-swift.enum"]]},"metadata":{"roleHeading":"Type Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finalSummary"},{"kind":"text"