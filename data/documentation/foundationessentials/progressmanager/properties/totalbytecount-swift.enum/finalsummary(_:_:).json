{"abstract":[{"text":"Determines how to handle summary data when a progress manager is deinitialized.","type":"text"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager\/Properties\/TotalByteCount-swift.enum\/finalSummary(_:_:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finalSummary"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"parentSummary"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V","text":"UInt64"},{"kind":"text","text":", "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"selfSummary"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V","text":"UInt64"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V","text":"UInt64"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"parentSummary","content":[{"inlineContent":[{"text":"The current summary value of the parent progress manager.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The final summary value from the progress manager being deinitialized."}],"type":"paragraph"}],"name":"selfSummary"}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"text":"The updated summary that replaces the parent’s current summary.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"This method is used when a progress manager in the hierarchy is being","type":"text"},{"text":" ","type":"text"},{"text":"deinitialized and its accumulated summary needs to be processed in relation to","type":"text"},{"text":" ","type":"text"},{"text":"its parent’s summary. The behavior can vary depending on the property type:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For additive properties (like file counts, byte counts): The self summary"},{"text":" ","type":"text"},{"type":"text","text":"is typically added to the parent summary to preserve the accumulated progress."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For max-based properties (like estimated time remaining): The parent summary"},{"type":"text","text":" "},{"type":"text","text":"is typically preserved as it represents an existing estimate."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For collection-based properties (like file URLs): The self summary may be"},{"type":"text","text":" "},{"text":"discarded to avoid accumulating stale references.","type":"text"}]}]}]}]}],"variants":[{"paths":["\/documentation\/foundationessentials\/progressmanager\/properties\/totalbytecount-swift.enum\/finalsummary(_:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager\/Properties","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager\/Properties\/TotalByteCount-swift.enum"]]},"kind":"symbol","metadata":{"role":"symbol","roleHeading":"Type Method","symbolKind":"method","platforms":[{"beta":false,"name":"iOS","deprecated":false,"introducedAt":"26.0","unavailable":false},{"beta":false,"name":"iPadOS","