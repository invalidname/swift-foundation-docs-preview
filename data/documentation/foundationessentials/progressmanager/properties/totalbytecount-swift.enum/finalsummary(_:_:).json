ype":"text","text":"This method is used when a progress manager in the hierarchy is being"},{"type":"text","text":" "},{"text":"deinitialized and its accumulated summary needs to be processed in relation to","type":"text"},{"text":" ","type":"text"},{"text":"its parent’s summary. The behavior can vary depending on the property type:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"For additive properties (like file counts, byte counts): The self summary"},{"type":"text","text":" "},{"type":"text","text":"is typically added to the parent summary to preserve the accumulated progress."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For max-based properties (like estimated time remaining): The parent summary","type":"text"},{"text":" ","type":"text"},{"text":"is typically preserved as it represents an existing estimate.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For collection-based properties (like file URLs): The self summary may be","type":"text"},{"text":" ","type":"text"},{"text":"discarded to avoid accumulating stale references.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/ProgressManager/Properties/TotalByteCount-swift.enum":{"abstract":[],"type":"topic","navigatorTitle":[{"text":"TotalByteCount","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/foundationessentials\/progressmanager\/properties\/totalbytecount-swift.enum","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager\/Properties\/TotalByteCount-swift.enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TotalByteCount","kind":"identifier"}],"title":"ProgressManager.Properties.TotalByteCount"},"doc://FoundationEssentials/documentation/FoundationEssentials/ProgressManager/Properties/TotalByteCount-swift.enu