"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"This method is used when a progress manager in the hierarchy is being","type":"text"},{"text":" ","type":"text"},{"text":"deinitialized and its accumulated summary needs to be processed in relation to","type":"text"},{"text":" ","type":"text"},{"text":"its parent’s summary. The behavior can vary depending on the property type:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"For additive properties (like file counts, byte counts): The self summary"},{"type":"text","text":" "},{"type":"text","text":"is typically added to the parent summary to preserve the accumulated progress."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"For max-based properties (like estimated time remaining): The parent summary"},{"type":"text","text":" "},{"type":"text","text":"is typically preserved as it represents an existing estimate."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For collection-based properties (like file URLs): The self summary may be","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"discarded to avoid accumulating stale references."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager\/Properties\/TotalFileCount-swift.enum\/finalSummary(_:_:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"method","externalID":"s:20FoundationEssentials15ProgressManagerC10PropertiesO14TotalFileCountO12finalSummaryyS2i_SitFZ","role":"symbol","title":"finalSummary(_:_:)","modules":[{"name":"FoundationEssentials"}],"roleHeading":"Type Method","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","tex