hor":"return-value","type":"heading","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The updated summary that replaces the parent’s current summary."}]}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"text":"This method is used when a progress manager in the hierarchy is being","type":"text"},{"text":" ","type":"text"},{"text":"deinitialized and its accumulated summary needs to be processed in relation to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"its parent’s summary. The behavior can vary depending on the property type:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"For additive properties (like file counts, byte counts): The self summary","type":"text"},{"text":" ","type":"text"},{"text":"is typically added to the parent summary to preserve the accumulated progress.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For max-based properties (like estimated time remaining): The parent summary","type":"text"},{"text":" ","type":"text"},{"text":"is typically preserved as it represents an existing estimate.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"For collection-based properties (like file URLs): The self summary may be"},{"type":"text","text":" "},{"type":"text","text":"discarded to avoid accumulating stale references."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/progressmanager\/properties\/completedbytecount-swift.enum\/finalsummary(_:_:)"]}],"metadata":{"externalID":"s:20FoundationEssentials15ProgressManagerC10PropertiesO18CompletedByteCountO12finalSummaryys6UInt64VAJ_AJtFZ","roleHeading":"Type Method","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","tex