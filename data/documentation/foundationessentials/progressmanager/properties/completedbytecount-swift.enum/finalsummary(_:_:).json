{"abstract":[{"text":"Determines how to handle summary data when a progress manager is deinitialized.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finalSummary"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"parentSummary"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UInt64","preciseIdentifier":"s:s6UInt64V"},{"kind":"text","text":", "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"selfSummary"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UInt64","preciseIdentifier":"s:s6UInt64V"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"UInt64","preciseIdentifier":"s:s6UInt64V"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The current summary value of the parent progress manager.","type":"text"}]}],"name":"parentSummary"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The final summary value from the progress manager being deinitialized.","type":"text"}]}],"name":"selfSummary"}]},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The updated summary that replaces the parent’s current summary."}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"This method is used when a progress manager in the hierarchy is being"},{"type":"text","text":" "},{"type":"text","text":"deinitialized and its accumulated summary needs to be processed in relation to"},{"type":"text","text":" "},{"type":"text","text":"its parent’s summary. The behavior can vary depending on the property type:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"For additive properties (like file counts, byte counts): The self summary","type":"text"},{"text":" ","type":"text"},{"text":"is typically added to the parent summary to preserve the accumulated progress.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For max-based properties (like estimated time remaining): The parent summary","type":"text"},{"text":" ","type":"text"},{"text":"is typically preserved as it represents an existing estimate.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For collection-based properties (like file URLs): The self summary may be","type":"text"},{"text":" ","type":"text"},{"text":"discarded to avoid accumulating stale references.","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/progressmanager\/properties\/completedbytecount-swift.enum\/finalsummary(_:_:)"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager\/Properties","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager\/Properties\/CompletedByteCount-swift.enum"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ProgressManager\/Properties\/CompletedByteCount-swift.enum\/finalSummary(_:_:)"},"metadata":{"roleHeading":"Type Method","modules":[{"name":"FoundationEssentials"}],"externalID":"s:20FoundationEssentials15ProgressManagerC10PropertiesO18CompletedByteCountO12finalSummaryys6UInt64VA