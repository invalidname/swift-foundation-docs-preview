]},{"content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The updated summary that replaces the parent’s current summary."}]}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method is used when a progress manager in the hierarchy is being"},{"type":"text","text":" "},{"type":"text","text":"deinitialized and its accumulated summary needs to be processed in relation to"},{"type":"text","text":" "},{"type":"text","text":"its parent’s summary. The behavior can vary depending on the property type:"}]},{"items":[{"content":[{"inlineContent":[{"text":"For additive properties (like file counts, byte counts): The self summary","type":"text"},{"text":" ","type":"text"},{"text":"is typically added to the parent summary to preserve the accumulated progress.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For max-based properties (like estimated time remaining): The parent summary","type":"text"},{"text":" ","type":"text"},{"text":"is typically preserved as it represents an existing estimate.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For collection-based properties (like file URLs): The self summary may be","type":"text"},{"text":" ","type":"text"},{"text":"discarded to avoid accumulating stale references.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"sections":[],"metadata":{"platforms":[{"unavailable":false,"introducedAt":"26.0","beta":false,"name":"iOS","deprecated":false},{"unavailable":false,"introducedAt":"26.0","beta":false,"name":"iPadOS","deprecated":false},{"unavailable":false,"introducedAt":"26.0","beta":false,"name":"Mac Catalyst","deprecated":false},{"unavailable":false,"introducedAt":"26.0","beta":false,"name":"macOS","deprecated":false},{"unavailable":fa