" "},{"type":"text","text":"to IDs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cocoa does not provide any API to change the time zone of the computer, or of other applications."}]}],"kind":"content"}],"topicSections":[{"title":"Operators","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/TimeZone\/==(_:_:)"],"anchor":"Operators"},{"title":"Initializers","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/TimeZone\/init(abbreviation:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/TimeZone\/init(identifier:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/TimeZone\/init(secondsFromGMT:)"],"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/TimeZone\/identifier","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/TimeZone\/nextDaylightSavingTimeTransition"],"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/TimeZone\/abbreviation(for:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/TimeZone\/daylightSavingTimeOffset(for:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/TimeZone\/hash(into:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/TimeZone\/isDaylightSavingTime(for:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/TimeZone\/localizedName(for:locale:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/TimeZone\/nextDaylightSavingTimeTransition(after:)","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/TimeZone\/secondsFromGMT(for:)"],"anchor":"Instance-Methods"},{"title":"Type Properties","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/TimeZone\/abbreviationDictionary","doc:\/\/FoundationEsse