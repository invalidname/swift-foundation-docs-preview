l such as "},{"type":"codeVoice","code":"for"},{"type":"text","text":" loops,"},{"type":"text","text":" "},{"type":"text","text":"or modify variables from its enclosing scope. However, it can refer to constants that are in"},{"type":"text","text":" "},{"type":"text","text":"scope."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To express more complex queries, you can nest expressions in the predicate:"}]},{"syntax":"swift","type":"codeListing","code":["let messagePredicate = #Predicate<Message> { message in","    message.recipients.contains {","        $0.firstName == message.sender.firstName","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can safely encode and decode predicates, pass predicates across concurrency boundaries, and load a predicate from a file."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can transform a predicate into another representation — for example, to express a predicate in another query language, or to create a modified predicate — using the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Predicate\/expression"},{"type":"text","text":" property."}]}],"kind":"content"}],"kind":"symbol","metadata":{"navigatorTitle":[{"kind":"identifier","text":"Predicate"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Predicate"}],"roleHeading":"Structure","symbolKind":"struct","modules":[{"name":"FoundationEssentials"}],"externalID":"s:20FoundationEssentials9PredicateV","platforms":[{"name":"iOS","unavailable":false,"beta":false,"introducedAt":"17.0","deprecated":false},{"name":"iPadOS","unavailable":false,"beta":false,"introducedAt":"17.0","deprecated":false},{"name":"Mac Catalyst","unavailable":false,"beta":false,"introducedAt":"17.0","deprecated":false},{"name":"macOS","unavailable":false,"beta":false,"introducedAt":"14.0","deprecated":false},