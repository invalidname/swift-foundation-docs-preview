},{"type":"codeVoice","code":"for"},{"type":"text","text":" loops,"},{"type":"text","text":" "},{"type":"text","text":"or modify variables from its enclosing scope. However, it can refer to constants that are in"},{"type":"text","text":" "},{"type":"text","text":"scope."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To express more complex queries, you can nest expressions in the predicate:"}],"type":"paragraph"},{"syntax":"swift","code":["let messagePredicate = #Predicate<Message> { message in","    message.recipients.contains {","        $0.firstName == message.sender.firstName","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can safely encode and decode predicates, pass predicates across concurrency boundaries, and load a predicate from a file. To define a list of types and key paths that are allowed when reading an archived predicate, use "},{"type":"codeVoice","code":"PredicateCodableConfiguration"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can transform a predicate into another representation — for example, to express a predicate in another query language, or to create a modified predicate — using the "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Predicate\/expression","isActive":true},{"type":"text","text":" property."}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/FoundationEssentials\/s8CopyableP","doc:\/\/FoundationEssentials\/s28CustomDebugStringConvertibleP","doc:\/\/FoundationEssentials\/s23CustomStringConvertibleP","doc:\/\/FoundationEssentials\/s9EscapableP","doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"kind":"symbol","metadata":{"externalID":"s:20FoundationEssentials9PredicateV","role":"symbol","modules":[{"name":"FoundationEssential