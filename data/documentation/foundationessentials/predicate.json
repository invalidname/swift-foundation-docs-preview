 can safely encode and decode predicates, pass predicates across concurrency boundaries, and load a predicate from a file."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can transform a predicate into another representation — for example, to express a predicate in another query language, or to create a modified predicate — using the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Predicate\/expression"},{"type":"text","text":" property."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"A logical condition used to test a set of input values for searching or filtering."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","metadata":{"navigatorTitle":[{"kind":"identifier","text":"Predicate"}],"externalID":"s:20FoundationEssentials9PredicateV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Predicate"}],"symbolKind":"struct","platforms":[{"introducedAt":"17.0","name":"iOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"17.0","name":"iPadOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"17.0","name":"Mac Catalyst","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"14.0","name":"macOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"17.0","name":"tvOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"10.0","name":"watchOS","unavailable":false,"beta":false,"deprecated":false}],"roleHeading":"Structure","title":"Predicate","role":"symbol","modules":[{"name":"FoundationEssentials"}]},"variants":[{"paths":["\/documentation\/foundationessentials\/predicate"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Predicate"},"seeAlsoSections":[{"identifiers":["doc:\/\