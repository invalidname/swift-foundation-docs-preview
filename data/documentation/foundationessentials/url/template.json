{"kind":"symbol","abstract":[{"text":"A template for constructing a URL from variable expansions.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template"},"metadata":{"navigatorTitle":[{"text":"Template","kind":"identifier"}],"platforms":[{"introducedAt":"26.0","unavailable":false,"beta":false,"deprecated":false,"name":"iOS"},{"introducedAt":"26.0","unavailable":false,"beta":false,"deprecated":false,"name":"iPadOS"},{"introducedAt":"26.0","unavailable":false,"beta":false,"deprecated":false,"name":"Mac Catalyst"},{"beta":false,"unavailable":false,"name":"macOS","deprecated":false,"introducedAt":"26.0"},{"introducedAt":"26.0","unavailable":false,"beta":false,"deprecated":false,"name":"tvOS"},{"beta":false,"unavailable":false,"name":"visionOS","deprecated":false,"introducedAt":"26.0"},{"beta":false,"unavailable":false,"name":"watchOS","deprecated":false,"introducedAt":"26.0"}],"modules":[{"name":"FoundationEssentials"}],"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Template","kind":"identifier"}],"title":"URL.Template","role":"symbol","roleHeading":"Structure","extendedModule":"FoundationEssentials","externalID":"s:20FoundationEssentials3URLV8TemplateV"},"relationshipsSections":[{"identifiers":["doc:\/\/FoundationEssentials\/s8CopyableP","doc:\/\/FoundationEssentials\/s23CustomStringConvertibleP","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/s9EscapableP","doc:\/\/FoundationEssentials\/SH","doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/init(template:variables:)"],"title":"Creating a URL from a template","anchor":"Creating-a-URL-from-a-template"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Template"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is an template that can be expanded into"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL"},{"type":"text","text":" by calling "},{"type":"codeVoice","code":"URL(template:variables:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Templating has a rich set of options for substituting various parts of URLs. See"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc6570"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"details."}]},{"level":3,"text":"Example 1","anchor":"Example-1","type":"heading"},{"type":"codeListing","syntax":"swift","code":["let template = URL.Template(\"http:\/\/www.example.com\/foo{?query,number}\")!","let url = URL(","    template: template,","    variables: [","        .query: \"bar baz\",","        .number: \"234\",","    ]",")","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The resulting URL will be"}]},{"type":"codeListing","code":["http:\/\/www.example.com\/foo?query=bar%20baz&number=234"],"syntax":"text"},{"type":"heading","anchor":"Usage","level":3,"text":"Usage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Templates provide a description of a URL space and define how URLs can"},{"type":"text","text":" "},{"type":"text","text":"be constructed given specific variable values. Their intended use is,"},{"type":"text","text":" "},{"type":"text","text":"for example, to allow a server to communicate to a client how to"},{"type":"text","text":" "},{"type":"text","text":"construct URLs for particular resources."}]},{"inlineContent":[{"type":"text","text":"For each specific resource, an API contract is required to clearly"},{"type":"text","text":" "},{"type":"text","text":"define the variables applicable to that resource and its associated"},{"type":"text","text":" "},{"type":"text","text":"template. For example, such an API contract might specify that the"},{"type":"text","text":" "},{"type":"text","text":"variable "},{"type":"codeVoice","code":"query"},{"type":"text","text":" is mandatory and must be an alphanumeric string"},{"type":"text","text":" "},{"type":"text","text":"while the variable "},{"type":"codeVoice","code":"number"},{"type":"text","text":" is optional and must be a positive integer"},{"type":"text","text":" "},{"text":"if provided. The server could then provide the client with a template","type":"text"},{"text":" ","type":"text"},{"text":"such as ","type":"text"},{"code":"http:\/\/www.example.com\/foo{?query,number}","type":"codeVoice"},{"text":", which the client","type":"text"},{"text":" ","type":"text"},{"text":"can subsequently use to substitute variables accordingly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An API contract is necessary to define which substitutions are valid","type":"text"},{"text":" ","type":"text"},{"text":"within a given URL space. There is no guarantee that every possible","type":"text"},{"text":" ","type":"text"},{"text":"expansion of variable expressions corresponds to an existing resource","type":"text"},{"text":" ","type":"text"},{"text":"URL; indeed, some expansions may not even produce a valid URL. Only","type":"text"},{"text":" ","type":"text"},{"text":"the API specification itself can determine which expansions are","type":"text"},{"text":" ","type":"text"},{"text":"expected to yield valid URLs corresponding to existing resources.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Example-2","text":"Example 2","level":3},{"inlineContent":[{"text":"Here’s an example, that illustrates how to define a specific set of variables:","type":"text"}],"type":"paragraph"},{"code":["struct MyQueryTemplate: Sendable, Hashable {","    var template: URL.Template","","    init?(_ template: String) {","        guard let t = URL.Template(template) else { return nil }","        self.template = t","    }","}","","struct MyQuery: Sendable, Hashable {","    var query: String","    var number: Int?","","    var variables: [URL.Template.VariableName: URL.Template.Value] {","        var result: [URL.Template.VariableName: URL.Template.Value] = [","            .query: .text(query)","        ]","        if let number {","            result[.number] = .text(\"\\(number)\")","        }","        return result","    }","}","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}","","extension URL {","    init?(","        template: MyQueryTemplate,","        query: MyQuery","    ) {","        self.init(","            template: template.template,","            variables: query.variables","        )","    }","}"],"syntax":"swift","type":"codeListing"}]}],"sections":[],"topicSections":[{"anchor":"Creating-a-template","title":"Creating a template","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/init(_:)"]},{"anchor":"Supporting-types","title":"Supporting types","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/Value","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/VariableName"]},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/CustomStringConvertible-Implementations","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/url\/template"]}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL"]]},"references":{"doc://FoundationEssentials/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SQ"},"doc://FoundationEssentials/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/s8SendableP"},"doc://FoundationEssentials/documentation/FoundationEssentials/URL/Template/init(_:)":{"kind":"symbol","abstract":[{"type":"text","text":"Creates a new template from its text form."}],"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/init(_:)","url":"\/documentation\/foundationessentials\/url\/template\/init(_:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":")"}],"title":"init(_:)","role":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/URL/Template/CustomStringConvertible-Implementations":{"kind":"article","abstract":[],"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/CustomStringConvertible-Implementations","url":"\/documentation\/foundationessentials\/url\/template\/customstringconvertible-implementations","title":"CustomStringConvertible Implementations","role":"collectionGroup"},"doc://FoundationEssentials/s23CustomStringConvertibleP":{"title":"Swift.CustomStringConvertible","type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/s23CustomStringConvertibleP"},"doc://FoundationEssentials/documentation/FoundationEssentials/URL/Template/VariableName":{"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/VariableName","title":"URL.Template.VariableName","abstract":[{"type":"text","text":"The name of a variable used for expanding a template."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VariableName"}],"navigatorTitle":[{"kind":"identifier","text":"VariableName"}],"role":"symbol","url":"\/documentation\/foundationessentials\/url\/template\/variablename","type":"topic"},"doc://FoundationEssentials/documentation/FoundationEssentials":{"kind":"symbol","title":"FoundationEssentials","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","role":"collection","type":"topic","abstract":[{"text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app.","type":"text"}],"url":"\/documentation\/foundationessentials"},"doc://FoundationEssentials/s9EscapableP":{"title":"Swift.Escapable","type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/s9EscapableP"},"doc://FoundationEssentials/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/FoundationEssentials\/SH"},"doc://FoundationEssentials/documentation/FoundationEssentials/URL/Template":{"title":"URL.Template","kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Template","kind":"identifier"}],"navigatorTitle":[{"text":"Template","kind":"identifier"}],"type":"topic","abstract":[{"text":"A template for constructing a URL from variable expansions.","type":"text"}],"url":"\/documentation\/foundationessentials\/url\/template"},"doc://FoundationEssentials/documentation/FoundationEssentials/URL/init(template:variables:)":{"kind":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"URL"},{"type":"text","text":" by expanding the RFC 6570 template and variables."}],"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/init(template:variables:)","url":"\/documentation\/foundationessentials\/url\/init(template:variables:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"template"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials3URLV","text":"URL"},{"kind":"text","text":"."},{"preciseIdentifier":"s:20FoundationEssentials3URLV8TemplateV","text":"Template","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"variables","kind":"externalParam"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:20FoundationEssentials3URLV","text":"URL","kind":"typeIdentifier"},{"text":".","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials3URLV8TemplateV","text":"Template"},{"text":".","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials3URLV8TemplateV12VariableNameV","text":"VariableName","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials3URLV","text":"URL","kind":"typeIdentifier"},{"text":".","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials3URLV8TemplateV","text":"Template"},{"kind":"text","text":"."},{"preciseIdentifier":"s:20FoundationEssentials3URLV8TemplateV5ValueV","text":"Value","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"title":"init(template:variables:)","role":"symbol"},"https://datatracker.ietf.org/doc/html/rfc6570":{"type":"link