{"variants":[{"paths":["\/documentation\/foundationessentials\/url\/template"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"A template for constructing a URL from variable expansions.","type":"text"}],"topicSections":[{"anchor":"Creating-a-template","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/init(_:)"],"title":"Creating a template"},{"anchor":"Supporting-types","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/Value","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/VariableName"],"title":"Supporting types"},{"anchor":"Default-Implementations","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/CustomStringConvertible-Implementations","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/Equatable-Implementations"],"title":"Default Implementations","generated":true}],"seeAlsoSections":[{"anchor":"Creating-a-URL-from-a-template","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/init(template:variables:)"],"title":"Creating a URL from a template","generated":true}],"metadata":{"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Template","kind":"identifier"}],"navigatorTitle":[{"text":"Template","kind":"identifier"}],"externalID":"s:20FoundationEssentials3URLV8TemplateV","symbolKind":"struct","title":"URL.Template","modules":[{"name":"FoundationEssentials"}],"role":"symbol","extendedModule":"FoundationEssentials","platforms":[{"introducedAt":"26.0","unavailable":false,"beta":false,"name":"iOS","deprecated":false},{"introducedAt":"26.0","unavailable":false,"beta":false,"name":"iPadOS","deprecated":false},{"introducedAt":"26.0","unavailable":false,"beta":false,"name":"Mac Catalyst","deprecated":false},{"introducedAt":"26.0","unavailable":false,"beta":false,"name":"macOS","deprecated":false},{"introducedAt":"26.0","unavailable":false,"beta":false,"name":"tvOS","deprecated":false},{"introducedAt":"26.0","unavailable":false,"beta":false,"name":"visionOS","deprecated":false},{"introducedAt":"26.0","unavailable":false,"beta":false,"name":"watchOS","deprecated":false}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Template"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is an template that can be expanded into"},{"type":"text","text":" "},{"type":"text","text":"a "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL","type":"reference","isActive":true},{"type":"text","text":" by calling "},{"type":"codeVoice","code":"URL(template:variables:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Templating has a rich set of options for substituting various parts of URLs. See"},{"type":"text","text":" "},{"identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc6570","type":"reference","isActive":true},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"details."}]},{"level":3,"anchor":"Example-1","type":"heading","text":"Example 1"},{"syntax":"swift","type":"codeListing","code":["let template = URL.Template(\"http:\/\/www.example.com\/foo{?query,number}\")!","let url = URL(","    template: template,","    variables: [","        .query: \"bar baz\",","        .number: \"234\",","    ]",")","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}"]},{"type":"paragraph","inlineContent":[{"text":"The resulting URL will be","type":"text"}]},{"syntax":"text","type":"codeListing","code":["http:\/\/www.example.com\/foo?query=bar%20baz&number=234"]},{"level":3,"anchor":"Usage","type":"heading","text":"Usage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Templates provide a description of a URL space and define how URLs can"},{"type":"text","text":" "},{"type":"text","text":"be constructed given specific variable values. Their intended use is,"},{"type":"text","text":" "},{"type":"text","text":"for example, to allow a server to communicate to a client how to"},{"type":"text","text":" "},{"type":"text","text":"construct URLs for particular resources."}]},{"inlineContent":[{"text":"For each specific resource, an API contract is required to clearly","type":"text"},{"text":" ","type":"text"},{"text":"define the variables applicable to that resource and its associated","type":"text"},{"text":" ","type":"text"},{"text":"template. For example, such an API contract might specify that the","type":"text"},{"text":" ","type":"text"},{"text":"variable ","type":"text"},{"code":"query","type":"codeVoice"},{"text":" is mandatory and must be an alphanumeric string","type":"text"},{"text":" ","type":"text"},{"text":"while the variable ","type":"text"},{"code":"number","type":"codeVoice"},{"text":" is optional and must be a positive integer","type":"text"},{"text":" ","type":"text"},{"text":"if provided. The server could then provide the client with a template","type":"text"},{"text":" ","type":"text"},{"text":"such as ","type":"text"},{"code":"http:\/\/www.example.com\/foo{?query,number}","type":"codeVoice"},{"text":", which the client","type":"text"},{"text":" ","type":"text"},{"text":"can subsequently use to substitute variables accordingly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An API contract is necessary to define which substitutions are valid","type":"text"},{"text":" ","type":"text"},{"text":"within a given URL space. There is no guarantee that every possible","type":"text"},{"text":" ","type":"text"},{"text":"expansion of variable expressions corresponds to an existing resource","type":"text"},{"text":" ","type":"text"},{"text":"URL; indeed, some expansions may not even produce a valid URL. Only","type":"text"},{"text":" ","type":"text"},{"text":"the API specification itself can determine which expansions are","type":"text"},{"type":"text","text":" "},{"type":"text","text":"expected to yield valid URLs corresponding to existing resources."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Example-2","text":"Example 2"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s an example, that illustrates how to define a specific set of variables:"}]},{"type":"codeListing","syntax":"swift","code":["struct MyQueryTemplate: Sendable, Hashable {","    var template: URL.Template","","    init?(_ template: String) {","        guard let t = URL.Template(template) else { return nil }","        self.template = t","    }","}","","struct MyQuery: Sendable, Hashable {","    var query: String","    var number: Int?","","    var variables: [URL.Template.VariableName: URL.Template.Value] {","        var result: [URL.Template.VariableName: URL.Template.Value] = [","            .query: .text(query)","        ]","        if let number {","            result[.number] = .text(\"\\(number)\")","        }","        return result","    }","}","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}","","extension URL {","    init?(","        template: MyQueryTemplate,","        query: MyQuery","    ) {","        self.init(","            template: template.template,","            variables: query.variables","        )","    }","}"]}],"kind":"content"}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/FoundationEssentials\/s8CopyableP","doc:\/\/FoundationEssentials\/s23CustomStringConvertibleP","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/s9EscapableP","doc:\/\/FoundationEssentials\/SH","doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/URL":{"kind":"symbol","navigatorTitle":[{"text":"URL","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A value that identifies the location of a resource, such as an item on a remote server or the path to a local file."}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL","url":"\/documentation\/foundationessentials\/url","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"URL","kind":"identifier"}],"title":"URL","type":"topic"},"https://datatracker.ietf.org/doc/html/rfc6570":{"type":"link","title":"RFC 6570","identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc6570","titleInlineContent":[{"text":"RFC 6570","type":"text"}],"url":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc6570"},"doc://FoundationEssentials/documentation/FoundationEssentials/URL/Template/Equatable-Implementations":{"url":"\/documentation\/foundationessentials\/url\/template\/equatable-implementations","role":"collectionGroup","kind":"article","title":"Equatable Implementations","abstract":[],"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/Equatable-Implementations"},"doc://FoundationEssentials/s23CustomStringConvertibleP":