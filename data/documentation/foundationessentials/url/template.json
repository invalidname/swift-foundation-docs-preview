{"topicSections":[{"title":"Creating a template","anchor":"Creating-a-template","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/init(_:)"]},{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/Value","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/VariableName"],"anchor":"Supporting-types","title":"Supporting types"},{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/CustomStringConvertible-Implementations","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/Equatable-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"externalID":"s:20FoundationEssentials3URLV8TemplateV","title":"URL.Template","modules":[{"name":"FoundationEssentials"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Template","kind":"identifier"}],"symbolKind":"struct","role":"symbol","extendedModule":"FoundationEssentials","navigatorTitle":[{"text":"Template","kind":"identifier"}],"platforms":[{"unavailable":false,"introducedAt":"26.0","beta":false,"deprecated":false,"name":"iOS"},{"unavailable":false,"introducedAt":"26.0","beta":false,"deprecated":false,"name":"iPadOS"},{"unavailable":false,"introducedAt":"26.0","beta":false,"deprecated":false,"name":"Mac Catalyst"},{"unavailable":false,"introducedAt":"26.0","beta":false,"deprecated":false,"name":"macOS"},{"unavailable":false,"introducedAt":"26.0","beta":false,"deprecated":false,"name":"tvOS"},{"unavailable":false,"introducedAt":"26.0","beta":false,"deprecated":false,"name":"visionOS"},{"unavailable":false,"introducedAt":"26.0","beta":false,"deprecated":false,"name":"watchOS"}]},"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL"]]},"sections":[],"kind":"symbol","abstract":[{"text":"A template for constructing a URL from variable expansions.","type":"text"}],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Creating a URL from a template","generated":true,"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/init(template:variables:)"],"anchor":"Creating-a-URL-from-a-template"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Template","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"This is an template that can be expanded into"},{"type":"text","text":" "},{"type":"text","text":"a "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL","type":"reference","isActive":true},{"type":"text","text":" by calling "},{"type":"codeVoice","code":"URL(template:variables:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Templating has a rich set of options for substituting various parts of URLs. See"},{"type":"text","text":" "},{"identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc6570","type":"reference","isActive":true},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"details."}],"type":"paragraph"},{"text":"Example 1","level":3,"anchor":"Example-1","type":"heading"},{"syntax":"swift","code":["let template = URL.Template(\"http:\/\/www.example.com\/foo{?query,number}\")!","let url = URL(","    template: template,","    variables: [","        .query: \"bar baz\",","        .number: \"234\",","    ]",")","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The resulting URL will be"}],"type":"paragraph"},{"syntax":"text","code":["http:\/\/www.example.com\/foo?query=bar%20baz&number=234"],"type":"codeListing"},{"text":"Usage","level":3,"anchor":"Usage","type":"heading"},{"inlineContent":[{"type":"text","text":"Templates provide a description of a URL space and define how URLs can"},{"type":"text","text":" "},{"type":"text","text":"be constructed given specific variable values. Their intended use is,"},{"type":"text","text":" "},{"type":"text","text":"for example, to allow a server to communicate to a client how to"},{"type":"text","text":" "},{"type":"text","text":"construct URLs for particular resources."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For each specific resource, an API contract is required to clearly"},{"type":"text","text":" "},{"type":"text","text":"define the variables applicable to that resource and its associated"},{"type":"text","text":" "},{"type":"text","text":"template. For example, such an API contract might specify that the"},{"type":"text","text":" "},{"type":"text","text":"variable "},{"type":"codeVoice","code":"query"},{"type":"text","text":" is mandatory and must be an alphanumeric string"},{"type":"text","text":" "},{"type":"text","text":"while the variable "},{"type":"codeVoice","code":"number"},{"type":"text","text":" is optional and must be a positive integer"},{"type":"text","text":" "},{"type":"text","text":"if provided. The server could then provide the client with a template"},{"type":"text","text":" "},{"type":"text","text":"such as "},{"type":"codeVoice","code":"http:\/\/www.example.com\/foo{?query,number}"},{"type":"text","text":", which the client"},{"type":"text","text":" "},{"type":"text","text":"can subsequently use to substitute variables accordingly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An API contract is necessary to define which substitutions are valid"},{"type":"text","text":" "},{"type":"text","text":"within a given URL space. There is no guarantee that every possible"},{"type":"text","text":" "},{"type":"text","text":"expansion of variable expressions corresponds to an existing resource"},{"type":"text","text":" "},{"type":"text","text":"URL; indeed, some expansions may not even produce a valid URL. Only"},{"type":"text","text":" "},{"type":"text","text":"the API specification itself can determine which expansions are"},{"type":"text","text":" "},{"type":"text","text":"expected to yield valid URLs corresponding to existing resources."}],"type":"paragraph"},{"text":"Example 2","level":3,"anchor":"Example-2","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s an example, that illustrates how to define a specific set of variables:"}]},{"syntax":"swift","code":["struct MyQueryTemplate: Sendable, Hashable {","    var template: URL.Template","","    init?(_ template: String) {","        guard let t = URL.Template(template) else { return nil }","        self.template = t","    }","}","","struct MyQuery: Sendable, Hashable {","    var query: String","    var number: Int?","","    var variables: [URL.Template.VariableName: URL.Template.Value] {","        var result: [URL.Template.VariableName: URL.Template.Value] = [","            .query: .text(query)","        ]","        if let number {","            result[.number] = .text(\"\\(number)\")","        }","        return result","    }","}","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}","","extension URL {","    init?(","        template: MyQueryTemplate,","        query: MyQuery","    ) {","        self.init(","            template: template.template,","            variables: query.variables","        )","    }","}"],"type":"codeListing"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/url\/template"]}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/FoundationEssentials\/s8CopyableP","doc:\/\/FoundationEssentials\/s23CustomStringConvertibleP","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/s9EscapableP","doc:\/\/FoundationEssentials\/SH","doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"references":{"doc://FoundationEssentials/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/FoundationEssentials\/s8SendableP","type":"unresolvable"},"doc://FoundationEssentials/documentation/FoundationEssentials/URL":{"role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"URL","kind":"identifier"}],"url":"\/documentation\/foundationessentials\/url","title":"URL","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL","type":"topic","abstract":[{"type":"text","text":"A value that identifies the location of a resource, such as an item on a remote server or the path to a local file."}],"navigatorTitle":[{"text":"URL","kind":"identifier"}]},"doc://FoundationEssentials/documentation/FoundationEssentials/URL/Template":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template","role":"symbol","title":"URL.Template","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"Template","kind":"identifier"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Template"}],"url":"\/documentation\/foundationessentials\/url\/template","kind":"symbol","abstract":[{"type":"text","text":"A template for constructing a URL from variable expansions."}]},"doc://FoundationEs