{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template"},"abstract":[{"text":"A template for constructing a URL from variable expansions.","type":"text"}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/FoundationEssentials\/s8CopyableP","doc:\/\/FoundationEssentials\/s23CustomStringConvertibleP","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/s9EscapableP","doc:\/\/FoundationEssentials\/SH","doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"],"kind":"relationships"}],"seeAlsoSections":[{"generated":true,"anchor":"Creating-a-URL-from-a-template","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/init(template:variables:)"],"title":"Creating a URL from a template"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"Template","kind":"identifier"}],"platforms":["macOS"]}]},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is an template that can be expanded into"},{"text":" ","type":"text"},{"type":"text","text":"a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL"},{"text":" by calling ","type":"text"},{"type":"codeVoice","code":"URL(template:variables:)"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Templating has a rich set of options for substituting various parts of URLs. See"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc6570"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"details."}]},{"level":3,"anchor":"Example-1","type":"heading","text":"Example 1"},{"syntax":"swift","type":"codeListing","code":["let template = URL.Template(\"http:\/\/www.example.com\/foo{?query,number}\")!","let url = URL(","    template: template,","    variables: [","        .query: \"bar baz\",","        .number: \"234\",","    ]",")","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The resulting URL will be"}]},{"type":"codeListing","code":["http:\/\/www.example.com\/foo?query=bar%20baz&number=234"],"syntax":"text"},{"text":"Usage","type":"heading","level":3,"anchor":"Usage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Templates provide a description of a URL space and define how URLs can"},{"type":"text","text":" "},{"type":"text","text":"be constructed given specific variable values. Their intended use is,"},{"type":"text","text":" "},{"type":"text","text":"for example, to allow a server to communicate to a client how to"},{"type":"text","text":" "},{"type":"text","text":"construct URLs for particular resources."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For each specific resource, an API contract is required to clearly"},{"type":"text","text":" "},{"type":"text","text":"define the variables applicable to that resource and its associated"},{"type":"text","text":" "},{"type":"text","text":"template. For example, such an API contract might specify that the"},{"type":"text","text":" "},{"type":"text","text":"variable "},{"type":"codeVoice","code":"query"},{"type":"text","text":" is mandatory and must be an alphanumeric string"},{"type":"text","text":" "},{"type":"text","text":"while the variable "},{"type":"codeVoice","code":"number"},{"type":"text","text":" is optional and must be a positive integer"},{"type":"text","text":" "},{"type":"text","text":"if provided. The server could then provide the client with a template"},{"type":"text","text":" "},{"type":"text","text":"such as "},{"type":"codeVoice","code":"http:\/\/www.example.com\/foo{?query,number}"},{"type":"text","text":", which the client"},{"type":"text","text":" "},{"type":"text","text":"can subsequently use to substitute variables accordingly."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An API contract is necessary to define which substitutions are valid"},{"type":"text","text":" "},{"type":"text","text":"within a given URL space. There is no guarantee that every possible"},{"type":"text","text":" "},{"type":"text","text":"expansion of variable expressions corresponds to an existing resource"},{"type":"text","text":" "},{"type":"text","text":"URL; indeed, some expansions may not even produce a valid URL. Only"},{"type":"text","text":" "},{"type":"text","text":"the API specification itself can determine which expansions are"},{"type":"text","text":" "},{"type":"text","text":"expected to yield valid URLs corresponding to existing resources."}]},{"text":"Example 2","type":"heading","level":3,"anchor":"Example-2"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s an example, that illustrates how to define a specific set of variables:"}]},{"type":"codeListing","syntax":"swift","code":["struct MyQueryTemplate: Sendable, Hashable {","    var template: URL.Template","","    init?(_ template: String) {","        guard let t = URL.Template(template) else { return nil }","        self.template = t","    }","}","","struct MyQuery: Sendable, Hashable {","    var query: String","    var number: Int?","","    var variables: [URL.Template.VariableName: URL.Template.Value] {","        var result: [URL.Template.VariableName: URL.Template.Value] = [","            .query: .text(query)","        ]","        if let number {","            result[.number] = .text(\"\\(number)\")","        }","        return result","    }","}","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}","","extension URL {","    init?(","        template: MyQueryTemplate,","        query: MyQuery","    ) {","        self.init(","            template: template.template,","            variables: query.variables","        )","    }","}"]}],"kind":"content"}],"metadata":{"modules":[{"name":"FoundationEssentials"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Template"}],"navigatorTitle":[{"kind":"identifier","text":"Template"}],"roleHeading":"Structure","extendedModule":"FoundationEssentials","symbolKind":"struct","externalID":"s:20FoundationEssentials3URLV8TemplateV","title":"URL.Template","platforms":[{"unavailable":false,"name":"iOS","beta":false,"introducedAt":"26.0","deprecated":false},{"unavailable":false,"name":"iPadOS","beta":false,"introducedAt":"26.0","deprecated":false},{"unavailable":false,"name":"Mac Catalyst","beta":false,"introducedAt":"26.0","deprecated":false},{"unavailable":false,"name":"macOS","beta":false,"introducedAt":"26.0","deprecated":false},{"unavailable":false,"name":"tvOS","beta":false,"introducedAt":"26.0","deprecated":false},{"unavailable":false,"name":"visionOS","beta":false,"introducedAt":"26.0","deprecated":false},{"unavailable":false,"name":"watchOS","beta":false,"introducedAt":"26.0","deprecated":false}],"role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/url\/template"]}],"sections":[],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/init(_:)"],"title"