{"metadata":{"symbolKind":"struct","modules":[{"name":"FoundationEssentials"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Template","kind":"identifier"}],"extendedModule":"FoundationEssentials","navigatorTitle":[{"kind":"identifier","text":"Template"}],"title":"URL.Template","roleHeading":"Structure","externalID":"s:20FoundationEssentials3URLV8TemplateV","platforms":[{"introducedAt":"26.0","name":"iOS","deprecated":false,"beta":false,"unavailable":false},{"deprecated":false,"name":"iPadOS","introducedAt":"26.0","beta":false,"unavailable":false},{"deprecated":false,"name":"Mac Catalyst","introducedAt":"26.0","beta":false,"unavailable":false},{"deprecated":false,"name":"macOS","introducedAt":"26.0","beta":false,"unavailable":false},{"deprecated":false,"name":"tvOS","introducedAt":"26.0","beta":false,"unavailable":false},{"name":"visionOS","unavailable":false,"beta":false,"introducedAt":"26.0","deprecated":false},{"deprecated":false,"name":"watchOS","introducedAt":"26.0","beta":false,"unavailable":false}],"role":"symbol"},"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/FoundationEssentials\/s8CopyableP","doc:\/\/FoundationEssentials\/s23CustomStringConvertibleP","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/s9EscapableP","doc:\/\/FoundationEssentials\/SH","doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To"}],"seeAlsoSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/init(template:variables:)"],"generated":true,"anchor":"Creating-a-URL-from-a-template","title":"Creating a URL from a template"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"Template","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"text":"This is an template that can be expanded into","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL","isActive":true,"type":"reference"},{"text":" by calling ","type":"text"},{"code":"URL(template:variables:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Templating has a rich set of options for substituting various parts of URLs. See","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc6570","isActive":true,"type":"reference"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"details.","type":"text"}],"type":"paragraph"},{"anchor":"Example-1","level":3,"text":"Example 1","type":"heading"},{"syntax":"swift","code":["let template = URL.Template(\"http:\/\/www.example.com\/foo{?query,number}\")!","let url = URL(","    template: template,","    variables: [","        .query: \"bar baz\",","        .number: \"234\",","    ]",")","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The resulting URL will be","type":"text"}],"type":"paragraph"},{"syntax":"text","code":["http:\/\/www.example.com\/foo?query=bar%20baz&number=234"],"type":"codeListing"},{"anchor":"Usage","level":3,"text":"Usage","type":"heading"},{"inlineContent":[{"text":"Templates provide a description of a URL space and define how URLs can","type":"text"},{"text":" ","type":"text"},{"text":"be constructed given specific variable values. Their intended use is,","type":"text"},{"text":" ","type":"text"},{"text":"for example, to allow a server to communicate to a client how to","type":"text"},{"text":" ","type":"text"},{"text":"construct URLs for particular resources.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For each specific resource, an API contract is required to clearly","type":"text"},{"text":" ","type":"text"},{"text":"define the variables applicable to that resource and its associated","type":"text"},{"text":" ","type":"text"},{"text":"template. For example, such an API contract might specify that the","type":"text"},{"text":" ","type":"text"},{"text":"variable ","type":"text"},{"code":"query","type":"codeVoice"},{"text":" is mandatory and must be an alphanumeric string","type":"text"},{"text":" ","type":"text"},{"text":"while the variable ","type":"text"},{"code":"number","type":"codeVoice"},{"text":" is optional and must be a positive integer","type":"text"},{"text":" ","type":"text"},{"text":"if provided. The server could then provide the client with a template","type":"text"},{"text":" ","type":"text"},{"text":"such as ","type":"text"},{"code":"http:\/\/www.example.com\/foo{?query,number}","type":"codeVoice"},{"text":", which the client","type":"text"},{"text":" ","type":"text"},{"text":"can subsequently use to substitute variables accordingly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An API contract is necessary to define which substitutions are valid","type":"text"},{"text":" ","type":"text"},{"text":"within a given URL space. There is no guarantee that every possible","type":"text"},{"text":" ","type":"text"},{"text":"expansion of variable expressions corresponds to an existing resource","type":"text"},{"text":" ","type":"text"},{"text":"URL; indeed, some expansions may not even produce a valid URL. Only","type":"text"},{"text":" ","type":"text"},{"text":"the API specification itself can determine which expansions are","type":"text"},{"text":" ","type":"text"},{"text":"expected to yield valid URLs corresponding to existing resources.","type":"text"}],"type":"paragraph"},{"anchor":"Example-2","level":3,"text":"Example 2","type":"heading"},{"inlineContent":[{"text":"Here’s an example, that illustrates how to define a specific set of variables:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyQueryTemplate: Sendable, Hashable {","    var template: URL.Template","","    init?(_ template: String) {","        guard let t = URL.Template(template) else { return nil }","        self.template = t","    }","}","","struct MyQuery: Sendable, Hashable {","    var query: String","    var number: Int?","","    var variables: [URL.Template.VariableName: URL.Template.Value] {","        var result: [URL.Template.VariableName: URL.Template.Value] = [","            .query: .text(query)","        ]","        if let number {","            result[.number] = .text(\"\\(number)\")","        }","        return result","    }","}","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}","","extension URL {","    init?(","        template: MyQueryTemplate,","        query: MyQuery","    ) {","        self.init(","            template: template.template,","            variables: query.variables","        )","    }","}"],"type":"codeListing"}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"anchor":"Creating-a-template","title":"Creating a template","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/init(_:)"]},{"anchor":"Supporting-types","title":"Supporting types","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/Value","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/VariableName"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/CustomStringConvertible-Implementations","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/Equatable-Implementations"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/url\/template"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"A template for constructing a URL from variable expansions."}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL"]]},"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/URL/Template/CustomStringConvertible-Implementations":{"title":"CustomStringConvertible Implementations","type":"topic","kind":"article","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/CustomStringConvertible-Implementations","url":"\/documentation\/foundationessentials\/url\/template\/customstringconvertible-implementations","abstract":[],"role":"collectionGroup"},"doc://FoundationEssentials/s8SendableP":{"identifier":"doc:\/\/FoundationEssentials\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://FoundationEssentials/documentation/FoundationEssentials/URL":{"url":"\/documentation\/foundationessentials\/url","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"URL"}],"abstract":[{"text":"A value that identifies the location of a resource, such as an item on a remote server or the path to a local file.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL","title":"URL","type":"topic","navigatorTitle":[{"kind":"identifier","text":"URL"}],"role":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/URL/Template/VariableName":{"navigatorTitle":[{"text":"V