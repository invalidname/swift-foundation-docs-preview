{"metadata":{"extendedModule":"FoundationEssentials","platforms":[{"name":"iOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"26.0"},{"name":"iPadOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"26.0"},{"name":"Mac Catalyst","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"26.0"},{"name":"macOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"26.0"},{"name":"tvOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"26.0"},{"name":"visionOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"26.0"},{"name":"watchOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"26.0"}],"modules":[{"name":"FoundationEssentials"}],"roleHeading":"Structure","externalID":"s:20FoundationEssentials3URLV8TemplateV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Template"}],"title":"URL.Template","navigatorTitle":[{"kind":"identifier","text":"Template"}],"symbolKind":"struct","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL"]]},"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Creating a URL from a template","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/init(template:variables:)"],"anchor":"Creating-a-URL-from-a-template","generated":true}],"topicSections":[{"title":"Creating a template","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/init(_:)"],"anchor":"Creating-a-template"},{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/Value","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/VariableName"],"anchor":"Supporting-types","title":"Supporting types"},{"title":"Default Implementations","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/CustomStringConvertible-Implementations","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Template"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"This is an template that can be expanded into","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL","type":"reference","isActive":true},{"text":" by calling ","type":"text"},{"type":"codeVoice","code":"URL(template:variables:)"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Templating has a rich set of options for substituting various parts of URLs. See"},{"type":"text","text":" "},{"identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc6570","type":"reference","isActive":true},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"details."}],"type":"paragraph"},{"level":3,"text":"Example 1","anchor":"Example-1","type":"heading"},{"type":"codeListing","syntax":"swift","code":["let template = URL.Template(\"http:\/\/www.example.com\/foo{?query,number}\")!","let url = URL(","    template: template,","    variables: [","        .query: \"bar baz\",","        .number: \"234\",","    ]",")","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}"]},{"inlineContent":[{"type":"text","text":"The resulting URL will be"}],"type":"paragraph"},{"syntax":"text","code":["http:\/\/www.example.com\/foo?query=bar%20baz&number=234"],"type":"codeListing"},{"level":3,"type":"heading","text":"Usage","anchor":"Usage"},{"inlineContent":[{"type":"text","text":"Templates provide a description of a URL space and define how URLs can"},{"type":"text","text":" "},{"type":"text","text":"be constructed given specific variable values. Their intended use is,"},{"text":" ","type":"text"},{"text":"for example, to allow a server to communicate to a client how to","type":"text"},{"text":" ","type":"text"},{"text":"construct URLs for particular resources.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For each specific resource, an API contract is required to clearly"},{"text":" ","type":"text"},{"text":"define the variables applicable to that resource and its associated","type":"text"},{"text":" ","type":"text"},{"text":"template. For example, such an API contract might specify that the","type":"text"},{"text":" ","type":"text"},{"text":"variable ","type":"text"},{"code":"query","type":"codeVoice"},{"text":" is mandatory and must be an alphanumeric string","type":"text"},{"text":" ","type":"text"},{"text":"while the variable ","type":"text"},{"type":"codeVoice","code":"number"},{"text":" is optional and must be a positive integer","type":"text"},{"text":" ","type":"text"},{"text":"if provided. The server could then provide the client with a template","type":"text"},{"text":" ","type":"text"},{"text":"such as ","type":"text"},{"type":"codeVoice","code":"http:\/\/www.example.com\/foo{?query,number}"},{"text":", which the client","type":"text"},{"text":" ","type":"text"},{"text":"can subsequently use to substitute variables accordingly.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An API contract is necessary to define which substitutions are valid"},{"type":"text","text":" "},{"type":"text","text":"within a given URL space. There is no guarantee that every possible"},{"type":"text","text":" "},{"type":"text","text":"expansion of variable expressions corresponds to an existing resource"},{"type":"text","text":" "},{"type":"text","text":"URL; indeed, some expansions may not even produce a valid URL. Only"},{"type":"text","text":" "},{"type":"text","text":"the API specification itself can determine which expansions are"},{"type":"text","text":" "},{"type":"text","text":"expected to yield valid URLs corresponding to existing resources."}]},{"level":3,"text":"Example 2","anchor":"Example-2","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s an example, that illustrates how to define a specific set of variables:"}]},{"code":["struct MyQueryTemplate: Sendable, Hashable {","    var template: URL.Template","","    init?(_ template: String) {","        guard let t = URL.Template(template) else { return nil }","        self.template = t","    }","}","","struct MyQuery: Sendable, Hashable {","    var query: String","    var number: Int?","","    var variables: [URL.Template.VariableName: URL.Template.Value] {","        var result: [URL.Template.VariableName: URL.Template.Value] = [","            .query: .text(query)","        ]","        if let number {","            result[.number] = .text(\"\\(number)\")","        }","        return result","    }","}","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}","","extension URL {","    init?(","        template: MyQueryTemplate,","        query: MyQuery","    ) {","        self.init(","            template: template.template,","            variables: query.variables","        )","    }","}"],"syntax":"swift","type":"codeListing"}]}],"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLang