{"seeAlsoSections":[{"generated":true,"anchor":"Creating-a-URL-from-a-template","title":"Creating a URL from a template","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/init(template:variables:)"]}],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Creating-a-template","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/init(_:)"],"title":"Creating a template"},{"anchor":"Supporting-types","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/Value","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/VariableName"],"title":"Supporting types"},{"title":"Default Implementations","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/CustomStringConvertible-Implementations","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL"]]},"metadata":{"modules":[{"name":"FoundationEssentials"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Template"}],"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Template"}],"platforms":[{"introducedAt":"26.0","beta":false,"unavailable":false,"deprecated":false,"name":"iOS"},{"name":"iPadOS","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"26.0"},{"beta":false,"name":"Mac Catalyst","deprecated":false,"introducedAt":"26.0","unavailable":false},{"beta":false,"name":"macOS","deprecated":false,"introducedAt":"26.0","unavailable":false},{"beta":false,"name":"tvOS","deprecated":false,"introducedAt":"26.0","unavailable":false},{"beta":false,"name":"visionOS","deprecated":false,"introducedAt":"26.0","unavailable":false},{"beta":false,"name":"watchOS","deprecated":false,"introducedAt":"26.0","unavailable":false}],"externalID":"s:20FoundationEssentials3URLV8TemplateV","roleHeading":"Structure","title":"URL.Template","extendedModule":"FoundationEssentials"},"abstract":[{"text":"A template for constructing a URL from variable expansions.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Template","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"This is an template that can be expanded into"},{"type":"text","text":" "},{"type":"text","text":"a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL"},{"type":"text","text":" by calling "},{"code":"URL(template:variables:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Templating has a rich set of options for substituting various parts of URLs. See"},{"type":"text","text":" "},{"identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc6570","type":"reference","isActive":true},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"details."}],"type":"paragraph"},{"anchor":"Example-1","level":3,"type":"heading","text":"Example 1"},{"code":["let template = URL.Template(\"http:\/\/www.example.com\/foo{?query,number}\")!","let url = URL(","    template: template,","    variables: [","        .query: \"bar baz\",","        .number: \"234\",","    ]",")","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The resulting URL will be","type":"text"}],"type":"paragraph"},{"code":["http:\/\/www.example.com\/foo?query=bar%20baz&number=234"],"syntax":"text","type":"codeListing"},{"text":"Usage","level":3,"anchor":"Usage","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Templates provide a description of a URL space and define how URLs can"},{"type":"text","text":" "},{"type":"text","text":"be constructed given specific variable values. Their intended use is,"},{"type":"text","text":" "},{"type":"text","text":"for example, to allow a server to communicate to a client how to"},{"type":"text","text":" "},{"type":"text","text":"construct URLs for particular resources."}]},{"inlineContent":[{"text":"For each specific resource, an API contract is required to clearly","type":"text"},{"text":" ","type":"text"},{"text":"define the variables applicable to that resource and its associated","type":"text"},{"text":" ","type":"text"},{"text":"template. For example, such an API contract might specify that the","type":"text"},{"text":" ","type":"text"},{"text":"variable ","type":"text"},{"code":"query","type":"codeVoice"},{"text":" is mandatory and must be an alphanumeric string","type":"text"},{"text":" ","type":"text"},{"text":"while the variable ","type":"text"},{"code":"number","type":"codeVoice"},{"text":" is optional and must be a positive integer","type":"text"},{"text":" ","type":"text"},{"text":"if provided. The server could then provide the client with a template","type":"text"},{"text":" ","type":"text"},{"text":"such as ","type":"text"},{"code":"http:\/\/www.example.com\/foo{?query,number}","type":"codeVoice"},{"text":", which the client","type":"text"},{"text":" ","type":"text"},{"text":"can subsequently use to substitute variables accordingly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An API contract is necessary to define which substitutions are valid"},{"type":"text","text":" "},{"type":"text","text":"within a given URL space. There is no guarantee that every possible"},{"type":"text","text":" "},{"type":"text","text":"expansion of variable expressions corresponds to an existing resource"},{"type":"text","text":" "},{"type":"text","text":"URL; indeed, some expansions may not even produce a valid URL. Only"},{"type":"text","text":" "},{"type":"text","text":"the API specification itself can determine which expansions are"},{"type":"text","text":" "},{"type":"text","text":"expected to yield valid URLs corresponding to existing resources."}],"type":"paragraph"},{"anchor":"Example-2","type":"heading","text":"Example 2","level":3},{"inlineContent":[{"type":"text","text":"Here’s an example, that illustrates how to define a specific set of variables:"}],"type":"paragraph"},{"code":["struct MyQueryTemplate: Sendable, Hashable {","    var template: URL.Template","","    init?(_ template: String) {","        guard let t = URL.Template(template) else { return nil }","        self.template = t","    }","}","","struct MyQuery: Sendable, Hashable {","    var query: String","    var number: Int?","","    var variables: [URL.Template.VariableName: URL.Template.Value] {","        var result: [URL.Template.VariableName: URL.Template.Value] = [","            .query: .text(query)","        ]","        if let number {","            result[.number] = .text(\"\\(number)\")","        }","        return result","    }","}","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}","","extension URL {","    init?(","        template: MyQueryTemplate,","        query: MyQuery","    ) {","        self.init(","            template: template.template,","            variables: query.variables","        )","    }","}"],"type":"codeListing","syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/url\/template"]}],"sections":[],"kind":"symbol","relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/FoundationEssentials\/s8CopyableP","doc:\/\/FoundationEssentials\/s23CustomStringConvertibleP","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/s9EscapableP","doc:\/\/FoundationEssentials\/SH","doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://FoundationEssentials/SH":{"identifier":"doc:\/\/FoundationEssentials\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://FoundationEssentials/documentation/FoundationEssentials/URL/Template/CustomStringConvertible-Implementations":{"type":"topic","role":"collectionGroup","url":"\/documentation\/foundationessentials\/url\/template\/customstringconvertible-implementations","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/CustomStringConvertible-Implementations","kind":"article","abstract":[],"title":"CustomStringConvertible Implementations"},"doc://FoundationEssentials/s23CustomStringConvertibleP":{"identifier":"doc:\/\/FoundationEssentials\/s23CustomStringConvertibleP","title":"Swift.CustomStringConvertible","type":"unresolvable"},"doc://FoundationEssentials/documentation/FoundationEssentials/URL/Template":{"kind":"symbol","abstract":[{"text":"A template for constructing a URL from variable expansions.","type":"text"}],"url":"\/documentation\/foundationessentials\/url\/template","navigatorTitle":[{"text":"Template","kind":"identifier"}],"title":"URL.Template","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Template","kind":"identifier"}],"identifier":"doc:\/\/FoundationEssentials\/docu