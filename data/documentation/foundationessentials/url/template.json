{"abstract":[{"type":"text","text":"A template for constructing a URL from variable expansions."}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/s8CopyableP","doc:\/\/FoundationEssentials\/s23CustomStringConvertibleP","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/s9EscapableP","doc:\/\/FoundationEssentials\/SH","doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Template"}]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"text":"This is an template that can be expanded into","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL"},{"text":" by calling ","type":"text"},{"code":"URL(template:variables:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Templating has a rich set of options for substituting various parts of URLs. See","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc6570"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"details.","type":"text"}],"type":"paragraph"},{"text":"Example 1","level":3,"type":"heading","anchor":"Example-1"},{"syntax":"swift","code":["let template = URL.Template(\"http:\/\/www.example.com\/foo{?query,number}\")!","let url = URL(","    template: template,","    variables: [","        .query: \"bar baz\",","        .number: \"234\",","    ]",")","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The resulting URL will be","type":"text"}],"type":"paragraph"},{"syntax":"text","code":["http:\/\/www.example.com\/foo?query=bar%20baz&number=234"],"type":"codeListing"},{"text":"Usage","level":3,"type":"heading","anchor":"Usage"},{"inlineContent":[{"text":"Templates provide a description of a URL space and define how URLs can","type":"text"},{"text":" ","type":"text"},{"text":"be constructed given specific variable values. Their intended use is,","type":"text"},{"text":" ","type":"text"},{"text":"for example, to allow a server to communicate to a client how to","type":"text"},{"text":" ","type":"text"},{"text":"construct URLs for particular resources.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For each specific resource, an API contract is required to clearly","type":"text"},{"text":" ","type":"text"},{"text":"define the variables applicable to that resource and its associated","type":"text"},{"text":" ","type":"text"},{"text":"template. For example, such an API contract might specify that the","type":"text"},{"text":" ","type":"text"},{"text":"variable ","type":"text"},{"code":"query","type":"codeVoice"},{"text":" is mandatory and must be an alphanumeric string","type":"text"},{"text":" ","type":"text"},{"text":"while the variable ","type":"text"},{"code":"number","type":"codeVoice"},{"text":" is optional and must be a positive integer","type":"text"},{"text":" ","type":"text"},{"text":"if provided. The server could then provide the client with a template","type":"text"},{"text":" ","type":"text"},{"text":"such as ","type":"text"},{"code":"http:\/\/www.example.com\/foo{?query,number}","type":"codeVoice"},{"text":", which the client","type":"text"},{"text":" ","type":"text"},{"text":"can subsequently use to substitute variables accordingly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An API contract is necessary to define which substitutions are valid","type":"text"},{"text":" ","type":"text"},{"text":"within a given URL space. There is no guarantee that every possible","type":"text"},{"text":" ","type":"text"},{"text":"expansion of variable expressions corresponds to an existing resource","type":"text"},{"text":" ","type":"text"},{"text":"URL; indeed, some expansions may not even produce a valid URL. Only","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the API specification itself can determine which expansions are"},{"type":"text","text":" "},{"type":"text","text":"expected to yield valid URLs corresponding to existing resources."}],"type":"paragraph"},{"level":3,"anchor":"Example-2","type":"heading","text":"Example 2"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s an example, that illustrates how to define a specific set of variables:"}]},{"syntax":"swift","type":"codeListing","code":["struct MyQueryTemplate: Sendable, Hashable {","    var template: URL.Template","","    init?(_ template: String) {","        guard let t = URL.Template(template) else { return nil }","        self.template = t","    }","}","","struct MyQuery: Sendable, Hashable {","    var query: String","    var number: Int?","","    var variables: [URL.Template.VariableName: URL.Template.Value] {","        var result: [URL.Template.VariableName: URL.Template.Value] = [","            .query: .text(query)","        ]","        if let number {","            result[.number] = .text(\"\\(number)\")","        }","        return result","    }","}","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}","","extension URL {","    init?(","        template: MyQueryTemplate,","        query: MyQuery","    ) {","        self.init(","            template: template.template,","            variables: query.variables","        )","    }","}"]}]}],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template","interfaceLanguage":"swift"},"metadata":{"extendedModule":"FoundationEssentials","externalID":"s:20FoundationEssentials3URLV8TemplateV","title":"URL.Template","role":"symbol","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Template"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"Template"}],"platforms":[{"name":"iOS","deprecated":false,"introducedAt":"26.0","unavailable":false,"beta":false},{"unavailable":false,"beta":false,"name":"iPadOS","introducedAt":"26.0","deprecated":false},{"name":"Mac Catalyst","deprecated":false,"introducedAt":"26.0","unavailable":false,"beta":false},{"name":"macOS","deprecated":false,"introducedAt":"26.0","unavailable":false,"beta":false},{"name":"tvOS","deprecated":false,"introducedAt":"26.0","unavailable":false,"beta":false},{"name":"visionOS","deprecated":false,"introducedAt":"26.0","unavailable":false,"beta":false},{"name":"watchOS","deprecated":false,"introducedAt":"26.0","unavailable":false,"beta":false}],"modules":[{"name":"FoundationEssentials"}]},"kind":"symbol","variants":[{"paths":["\/documentation\/foundationessentials\/url\/template"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Creating a URL from a template","anchor":"Creating-a-URL-from-a-template","generated":true,"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/init(template:variables:)"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"title":"Creating a template","anchor":"Creating-a-template","identifiers":["doc:\/\/FoundationEssentials\/documenta