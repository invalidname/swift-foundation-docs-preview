{"topicSections":[{"anchor":"Creating-a-template","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/init(_:)"],"title":"Creating a template"},{"anchor":"Supporting-types","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/Value","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/VariableName"],"title":"Supporting types"},{"anchor":"Default-Implementations","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/CustomStringConvertible-Implementations","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/Equatable-Implementations"],"generated":true,"title":"Default Implementations"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"extendedModule":"FoundationEssentials","roleHeading":"Structure","role":"symbol","platforms":[{"name":"iOS","introducedAt":"26.0","unavailable":false,"deprecated":false,"beta":false},{"name":"iPadOS","introducedAt":"26.0","unavailable":false,"deprecated":false,"beta":false},{"name":"Mac Catalyst","introducedAt":"26.0","unavailable":false,"deprecated":false,"beta":false},{"name":"macOS","introducedAt":"26.0","unavailable":false,"deprecated":false,"beta":false},{"name":"tvOS","introducedAt":"26.0","unavailable":false,"deprecated":false,"beta":false},{"name":"visionOS","introducedAt":"26.0","unavailable":false,"deprecated":false,"beta":false},{"name":"watchOS","introducedAt":"26.0","unavailable":false,"deprecated":false,"beta":false}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Template"}],"modules":[{"name":"FoundationEssentials"}],"navigatorTitle":[{"kind":"identifier","text":"Template"}],"title":"URL.Template","symbolKind":"struct","externalID":"s:20FoundationEssentials3URLV8TemplateV"},"variants":[{"paths":["\/documentation\/foundationessentials\/url\/template"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/FoundationEssentials\/s8CopyableP","doc:\/\/FoundationEssentials\/s23CustomStringConvertibleP","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/s9EscapableP","doc:\/\/FoundationEssentials\/SH","doc:\/\/FoundationEssentials\/s8SendableP","doc:\/\/FoundationEssentials\/s16SendableMetatypeP"],"kind":"relationships"}],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"A template for constructing a URL from variable expansions."}],"seeAlsoSections":[{"anchor":"Creating-a-URL-from-a-template","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/init(template:variables:)"],"generated":true,"title":"Creating a URL from a template"}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Template"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"This is an template that can be expanded into","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL"},{"text":" by calling ","type":"text"},{"code":"URL(template:variables:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Templating has a rich set of options for substituting various parts of URLs. See","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc6570"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"details.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Example 1","anchor":"Example-1"},{"code":["let template = URL.Template(\"http:\/\/www.example.com\/foo{?query,number}\")!","let url = URL(","    template: template,","    variables: [","        .query: \"bar baz\",","        .number: \"234\",","    ]",")","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The resulting URL will be","type":"text"}],"type":"paragraph"},{"code":["http:\/\/www.example.com\/foo?query=bar%20baz&number=234"],"type":"codeListing","syntax":"text"},{"level":3,"type":"heading","text":"Usage","anchor":"Usage"},{"inlineContent":[{"text":"Templates provide a description of a URL space and define how URLs can","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"be constructed given specific variable values. Their intended use is,"},{"type":"text","text":" "},{"text":"for example, to allow a server to communicate to a client how to","type":"text"},{"text":" ","type":"text"},{"text":"construct URLs for particular resources.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For each specific resource, an API contract is required to clearly"},{"type":"text","text":" "},{"type":"text","text":"define the variables applicable to that resource and its associated"},{"type":"text","text":" "},{"type":"text","text":"template. For example, such an API contract might specify that the"},{"type":"text","text":" "},{"type":"text","text":"variable "},{"type":"codeVoice","code":"query"},{"type":"text","text":" is mandatory and must be an alphanumeric string"},{"type":"text","text":" "},{"type":"text","text":"while the variable "},{"type":"codeVoice","code":"number"},{"type":"text","text":" is optional and must be a positive integer"},{"text":" ","type":"text"},{"type":"text","text":"if provided. The server could then provide the client with a template"},{"type":"text","text":" "},{"type":"text","text":"such as "},{"code":"http:\/\/www.example.com\/foo{?query,number}","type":"codeVoice"},{"text":", which the client","type":"text"},{"text":" ","type":"text"},{"text":"can subsequently use to substitute variables accordingly.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An API contract is necessary to define which substitutions are valid"},{"type":"text","text":" "},{"type":"text","text":"within a given URL space. There is no guarantee that every possible"},{"type":"text","text":" "},{"text":"expansion of variable expressions corresponds to an existing resource","type":"text"},{"text":" ","type":"text"},{"text":"URL; indeed, some expansions may not even produce a valid URL. Only","type":"text"},{"text":" ","type":"text"},{"text":"the API specification itself can determine which expansions are","type":"text"},{"text":" ","type":"text"},{"text":"expected to yield valid URLs corresponding to existing resources.","type":"text"}]},{"level":3,"text":"Example 2","type":"heading","anchor":"Example-2"},{"type":"paragraph","inlineContent":[{"text":"Here’s an example, that illustrates how to define a specific set of variables:","type":"text"}]},{"code":["struct MyQueryTemplate: Sendable, Hashable {","    var template: URL.Template","","    init?(_ template: String) {","        guard let t = URL.Template(template) else { return nil }","        self.template = t","    }","}","","struct MyQuery: Sendable, Hashable {","    var query: String","    var number: Int?","","    var variables: [URL.Template.VariableName: URL.Template.Value] {","        var result: [URL.Template.VariableName: URL.Template.Value] = [","            .query: .text(query)","        ]","        if let number {","            result[.number] = .text(\"\\(number)\")","        }","        return result","    }","}","","extension URL.Template.VariableName {","    static var query: URL.Template.VariableName { .init(\"query\") }","    static var number: URL.Template.VariableName { .init(\"number\") }","}","","extension URL {","    init?(","        template: MyQueryTemplate,","        query: MyQuery","    ) {","        self.init(","            template: template.template,","            variables: query.variables","        )","    }","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"references":{"doc://FoundationEssentials/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/FoundationEssentials\/s16SendableMetatypeP"},"doc://FoundationEssentials/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/FoundationEssentials\/s8SendableP"},"doc://FoundationEssentials/documentation/FoundationEssentials/URL/Template/init(_:)":{"role":"symbol","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/init(_:)","abstract":[{"text":"Creates a new template from its text form.","type":"text"}],"kind":"symbol","url":"\/documentation\/foundationessentials\/url\/template\/init(_:)","title":"init(_:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":")"}]},"doc://FoundationEssentials/documentation/FoundationEssentials/URL/Template/CustomStringConvertible-Implementations":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URL\/Template\/CustomStringConvertible-Implementations","type":"topic","title":"CustomStringConvertible Implementations","abstract":[],"url":"\/documentation\/foundationessentials\/url\/template\/customstringconvertible-impleme