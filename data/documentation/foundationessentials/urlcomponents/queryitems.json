,{"inlineContent":[{"type":"text","text":"The setter combines an array containing any number of "},{"code":"URLQueryItem","type":"codeVoice"},{"type":"text","text":"s, each of which represents a single key-value pair, into a query string and sets the "},{"code":"URLComponents","type":"codeVoice"},{"type":"text","text":" query property. Passing an empty array sets the query component of the "},{"code":"URLComponents","type":"codeVoice"},{"type":"text","text":" to an empty string. Passing nil removes the query component of the "},{"code":"URLComponents","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"If a name-value pair in a query is empty (i.e. the query string starts with ‘&’, ends with ‘&’, or has “&&” within it), you get a ","type":"text"},{"type":"codeVoice","code":"URLQueryItem"},{"text":" with a zero-length name and a nil value. If a query’s name-value pair has nothing before the equals sign, you get a zero-length name. If a query’s name-value pair has nothing after the equals sign, you get a zero-length value. If a query’s name-value pair has no equals sign, the query name-value pair string is the name and you get a nil value.","type":"text"}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"}]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/URLComponents/query":{"role":"symbol","title":"query","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"query","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"abstract":[{"text":"The query subcomponent.","type":"text"}],"type":"topic","url":"\/documentation\/foundationessentials\/urlcomponents\/query","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URLComponents\/query","kind":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/URLCompone