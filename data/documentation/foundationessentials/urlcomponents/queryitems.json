"kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"URLQueryItem"},{"type":"text","text":" represents a single key-value pair,"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Note that a name may appear more than once in a single query string, so the name values are not guaranteed to be unique. If the "},{"type":"codeVoice","code":"URLComponents"},{"text":" has an empty query component, returns an empty array. If the ","type":"text"},{"type":"codeVoice","code":"URLComponents"},{"text":" has no query component, returns nil.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The setter combines an array containing any number of ","type":"text"},{"type":"codeVoice","code":"URLQueryItem"},{"type":"text","text":"s, each of which represents a single key-value pair, into a query string and sets the "},{"code":"URLComponents","type":"codeVoice"},{"text":" query property. Passing an empty array sets the query component of the ","type":"text"},{"code":"URLComponents","type":"codeVoice"},{"text":" to an empty string. Passing nil removes the query component of the ","type":"text"},{"code":"URLComponents","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"inlineContent":[{"text":"If a name-value pair in a query is empty (i.e. the query string starts with ‘&’, ends with ‘&’, or has “&&” within it), you get a ","type":"text"},{"type":"codeVoice","code":"URLQueryItem"},{"text":" with a zero-length name and a nil value. If a query’s name-value pair has nothing before the equals sign, you get a zero-length name. If a query’s name-value pair has nothing after the equals sign, you get a zero-length value. If a query’s name-value pair has no equals sign, the query name-value pair string is the name and you get a nil value.","type":"text"}],"type":"paragraph"}],"type":"aside"}]}],"metadata":{"platforms":[{"beta":false,"name":"iOS","deprecated":false,"introducedAt":"8.0","unavailable":false},{"beta":false,"name":"iPadOS","deprecated":false,"introducedAt":"8.0","unavailable":false},{"beta":false,"name":"Mac Catalyst","deprecated":false,"introducedAt":"8.0","unavailable":false},{"beta":false,"name":"macOS","deprecated":false,"introducedAt":"10.10","unavailable":false},{"beta":false,"name":"tvOS","deprecated":false,"introducedAt":"9.0","unavailable":false},{"beta":false,"deprecated":false,"unavailable":false,"name":"watchOS","introducedAt":"2.0"}],"title":"queryItems","roleHeading":"Instance Property","externalID":"s:20FoundationEssentials13URLComponentsV10queryItemsSayAA12URLQueryItemVGSgvp","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"queryItems","kind":"identifier"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials12URLQueryItemV","text":"URLQueryItem"},{"text":"]?","kind":"text"}],"modules":[{"name":"FoundationEssentials"}],"symbolKind":"property","role":"symbol"},"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/URLQueryItem":{"navigatorTitle":[{"text":"URLQueryItem","kind":"identifier"}],"title":"URLQueryItem","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"URLQueryItem","kind":"identifier"}],"url":"\/documentation\/foundationessentials\/urlqueryitem","abstract":[{"type":"text","text":"A single name-value pair from the query portion of a URL."}],"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URLQueryItem","type":"topic","role":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/URLComponents/port":{"url":"\/documentation