:[{"type":"text","text":"The setter combines an array containing any number of "},{"type":"codeVoice","code":"URLQueryItem"},{"type":"text","text":"s, each of which represents a single key-value pair, into a query string and sets the "},{"type":"codeVoice","code":"URLComponents"},{"type":"text","text":" query property. Passing an empty array sets the query component of the "},{"type":"codeVoice","code":"URLComponents"},{"type":"text","text":" to an empty string. Passing nil removes the query component of the "},{"type":"codeVoice","code":"URLComponents"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"If a name-value pair in a query is empty (i.e. the query string starts with ‘&’, ends with ‘&’, or has “&&” within it), you get a ","type":"text"},{"code":"URLQueryItem","type":"codeVoice"},{"text":" with a zero-length name and a nil value. If a query’s name-value pair has nothing before the equals sign, you get a zero-length name. If a query’s name-value pair has nothing after the equals sign, you get a zero-length value. If a query’s name-value pair has no equals sign, the query name-value pair string is the name and you get a nil value.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/URLComponents/user":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URLComponents\/user","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"user"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"title":"user","url":"\/documentation\/foundationessentials\/urlcomponents\/user","abstract":[{"text":"The user subcomponent.","type":"text"}]},"doc://FoundationEssentials/documentation/FoundationEssentials/URLComponents/po