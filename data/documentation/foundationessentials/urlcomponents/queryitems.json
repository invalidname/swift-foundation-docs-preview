,{"type":"paragraph","inlineContent":[{"type":"text","text":"The setter combines an array containing any number of "},{"type":"codeVoice","code":"URLQueryItem"},{"type":"text","text":"s, each of which represents a single key-value pair, into a query string and sets the "},{"type":"codeVoice","code":"URLComponents"},{"type":"text","text":" query property. Passing an empty array sets the query component of the "},{"type":"codeVoice","code":"URLComponents"},{"type":"text","text":" to an empty string. Passing nil removes the query component of the "},{"type":"codeVoice","code":"URLComponents"},{"type":"text","text":"."}]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"If a name-value pair in a query is empty (i.e. the query string starts with ‘&’, ends with ‘&’, or has “&&” within it), you get a ","type":"text"},{"type":"codeVoice","code":"URLQueryItem"},{"type":"text","text":" with a zero-length name and a nil value. If a query’s name-value pair has nothing before the equals sign, you get a zero-length name. If a query’s name-value pair has nothing after the equals sign, you get a zero-length value. If a query’s name-value pair has no equals sign, the query name-value pair string is the name and you get a nil value."}]}],"name":"Note"}]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/URLComponents/path":{"fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"path"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URLComponents\/path","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The path subcomponent."}],"type":"topic","url":"\/documentation\/foundationessentials\/urlcomponents\/path","title":"path"},"doc://FoundationEssentials/documentation/FoundationEssentials/URLComponents/queryItems":{"url":"\/documen