{"abstract":[{"type":"text","text":"The query subcomponent as an array of URLQueryItems."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"queryItems","kind":"identifier"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/URLQueryItem","text":"URLQueryItem","preciseIdentifier":"s:20FoundationEssentials12URLQueryItemV","kind":"typeIdentifier"},{"text":"]? { ","kind":"text"},{"text":"get","kind":"keyword"},{"kind":"text","text":" "},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"URLQueryItem"},{"type":"text","text":" represents a single key-value pair,"}]},{"inlineContent":[{"type":"text","text":"Note that a name may appear more than once in a single query string, so the name values are not guaranteed to be unique. If the "},{"type":"codeVoice","code":"URLComponents"},{"type":"text","text":" has an empty query component, returns an empty array. If the "},{"type":"codeVoice","code":"URLComponents"},{"text":" has no query component, returns nil.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The setter combines an array containing any number of ","type":"text"},{"type":"codeVoice","code":"URLQueryItem"},{"type":"text","text":"s, each of which represents a single key-value pair, into a query string and sets the "},{"type":"codeVoice","code":"URLComponents"},{"text":" query property. Passing an empty array sets the query component of the ","type":"text"},{"type":"codeVoice","code":"URLComponents"},{"type":"text","text":" to an empty string. Passing nil removes the query component of the "},{"type":"codeVoice","code":"URLComponents"},{"type":"text","text":"."}]},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"text":"If a name-value pair in a query is empty (i.e. the query string starts with ‘&’, ends with ‘&’, or has “&&” within it), you get a ","type":"text"},{"code":"URLQueryItem","type":"codeVoice"},{"text":" with a zero-length name and a nil value. If a query’s name-value pair has nothing before the equals sign, you get a zero-length name. If a query’s name-value pair has nothing after the equals sign, you get a zero-length value. If a query’s name-value pair has no equals sign, the query name-value pair string is the name and you get a nil value.","type":"text"}],"type":"paragraph"}]}]}],"metadata":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"queryItems","kind":"identifier"},{"text":": [","kind":"text"},{"text":"URLQueryItem","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials12URLQueryItemV"},{"kind":"text","text":"]?"}],"roleHeading":"Instance Property","role":"symbol","modules":[{"name":"FoundationEssentials"}],"title":"queryItems","externalID":"s:20FoundationEssentials13URLComponentsV10queryItemsSayAA12URLQueryItemVGSgvp","symbolKind":"property","platforms":[{"unavailable":false,"deprecated":false,"introducedAt":"8.0","beta":false,"name":"iOS"},{"unavailable":false,"deprecated":false,"introducedAt":"8.0","beta":false,"name":"iPadOS"},{"unavailable":false,"introducedAt":"8.0","beta":false,"name":"Mac Catalyst","deprecated":false},{"introducedAt":"10.10","beta":false,"deprecated":false,"name":"macOS","unavailable":false},{"introducedAt":"9.0","beta":false,"deprecated":false,"name":"tvOS","unavailable":false},{"introducedAt":"2.0","beta":false,"deprecated":false,"name":"watchOS","unavailable":false}]},"kind":"symbol","sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/docume