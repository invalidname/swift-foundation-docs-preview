nent to the one given (there’s a table of this mapping at the top of this document).  So for the “set to Thursday” example, find the Thursday in the Week in which the given date resides (which could be a forwards or backwards move, and not necessarily the nearest Thursday). For more control over the exact behavior, use "},{"type":"codeVoice","code":"nextDate(after:matching:matchingPolicy:behavior:direction:)"},{"type":"text","text":"."}]}]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/date(byAdding:to:wrappingComponents:)":{"url":"\/documentation\/foundationessentials\/calendar\/date(byadding:to:wrappingcomponents:)","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/date(byAdding:to:wrappingComponents:)","type":"topic","abstract":[{"type":"text","text":"Returns a new Date representing the date calculated by adding components to a given date."}],"role":"symbol","kind":"symbol","title":"date(byAdding:to:wrappingComponents:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"date"},{"kind":"text","text":"("},{"kind":"externalParam","text":"byAdding"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials14DateComponentsV","text":"DateComponents"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":", "},{"kind":"externalParam","text":"wrappingComponents"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":"?"}]},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/Component":{"type":"topic","kind":"symbol","fragments":[{"kind":"keyword