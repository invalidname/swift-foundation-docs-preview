{"sections":[],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule"]]},"abstract":[{"type":"text","text":"What to do when a recurrence is not a valid date"}],"seeAlsoSections":[{"generated":true,"title":"Working with recurrence rule properties","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/calendar","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/frequency-swift.property","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/interval","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/end-swift.property","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/repeatedTimePolicy","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/setPositions"],"anchor":"Working-with-recurrence-rule-properties"}],"variants":[{"paths":["\/documentation\/foundationessentials\/calendar\/recurrencerule\/matchingpolicy"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"platforms":[{"beta":false,"introducedAt":"18.0","deprecated":false,"unavailable":false,"name":"iOS"},{"beta":false,"introducedAt":"18.0","deprecated":false,"unavailable":false,"name":"iPadOS"},{"beta":false,"introducedAt":"18.0","deprecated":false,"unavailable":false,"name":"Mac Catalyst"},{"beta":false,"introducedAt":"15.0","deprecated":false,"unavailable":false,"name":"macOS"},{"beta":false,"introducedAt":"18.0","deprecated":false,"unavailable":false,"name":"tvOS"},{"name":"watchOS","deprecated":false,"beta":false,"introducedAt":"11.0","unavailable":false}],"title":"matchingPolicy","roleHeading":"Instance Property","externalID":"s:20FoundationEssentials8CalendarV14RecurrenceRuleV14matchingPolicyAC08MatchingG0Ovp","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"matchingPolicy"},{"text":": ","kind":"text"},{"text":"Calendar","preciseIdentifier":"s:20FoundationEssentials8CalendarV","kind":"typeIdentifier"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials8CalendarV14MatchingPolicyO","text":"MatchingPolicy"}],"modules":[{"name":"FoundationEssentials"}],"symbolKind":"property","role":"symbol"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"matchingPolicy","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Calendar","kind":"typeIdentifier","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar","preciseIdentifier":"s:20FoundationEssentials8CalendarV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"MatchingPolicy","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy","preciseIdentifier":"s:20FoundationEssentials8CalendarV14MatchingPolicyO"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"An occurrence may not be a valid date if it falls on a leap day or a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"leap hour when there is not one. When that happens, we can choose to"},{"type":"text","text":" "},{"type":"text","text":"ignore the occurrence ("},{"code":".strict","type":"codeVoice"},{"type":"text","text":"), choose a later time which has the"},{"text":" ","type":"text"},{"text":"same components (","type":"text"},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"},{"text":"), or find an","type":"text"},{"text":" ","type":"text"},{"text":"earlier time (","type":"text"},{"code":".previousTimePreservingSmallerComponents","type":"codeVoice"},{"type":"text","text":")."}]},{"inlineContent":[{"text":"For example, consider an event happening every year, starting on the","type":"text"},{"text":" ","type":"text"},{"text":"29th of February 2020. When the matching policy is set to ","type":"text"},{"type":"codeVoice","code":".strict"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"it yields the following recurrences:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"2020-02-29","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-02-29","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2028-02-29","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"…"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"matchingPolicy"},{"type":"text","text":" of "},{"type":"codeVoice","code":".previousTimePreservingSmallerComponents"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"we get a result for each year:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"2020-02-29","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2021-02-28","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2022-02-28","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2023-02-28"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-02-29"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Lastly, a "},{"code":"matchingPolicy","type":"codeVoice"},{"type":"text","text":" of "},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"moves invalid occurrences to the day after February 29:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"2020-02-29","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"2021-03-01"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2022-03-01","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2023-03-01","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-02-29"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The same logic applies for missing leap hours during daylight saving","type":"text"},{"text":" ","type":"text"},{"text":"time switches. For example, consider an event repeating daily, which","type":"text"},{"type":"text","text":" "},{"type":"text","text":"starts at March 9 2024, 01:30 PST. With a "},{"type":"codeVoice","code":".strict"},{"type":"text","text":" matching policy,"},{"type":"text","text":" "},{"type":"text","text":"the event repeats on the following dates, and skips a day:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"},{"text":" ","type":"text"},{"text":"(on 2024-03-10, there is a missing hour between 1am and 2am)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-11 01:30 PDT (08:30 UTC)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2024-03-12 01:30 PDT (08:30 UTC)","type":"text"},{"text":" ","type":"text"},{"text":"With ","type":"text"},{"code":"matchingPolicy","type":"codeVoice"},{"type":"text","text":" of "},{"code":".previousTimePreservingSmallerComponents","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"we get a result for each day:","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-10 02:30 PST (10:30 UTC)"},{"text":" ","type":"text"},{"text":"(on 2024-03-10, there is a missing hour between 1am and 2am)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2024-03-11 01:30 PDT (08:30 UTC)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2024-03-12 01:30 PDT (08:30 UTC)","type":"text"},{"text":" ","type":"text"},{"text":"Lastly, a ","type":"text"},{"code":"matchingPolicy","type":"codeVoice"},{"text":" of ","type":"text"},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"},{"text":" ","type":"text"},{"text":"moves invalid occurrences an hour forward:","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-10 00:30 PST (08:30 UTC)"},{"type":"text","text":" "},{"text":"(on 2024-03-10, there is a missing hour between 1am and 2am)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-11 01:30 PDT (08:30 UTC)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-12 01:30 PDT (08:30 UTC)"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Default value is "},{"type":"codeVoice","code":".nextTimePreservingSmallerComponents"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/matchingPolicy","interfaceLanguage":"swift"},"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/RecurrenceRule/interval":{"title":"interval","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"interval"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifi