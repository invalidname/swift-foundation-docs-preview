{"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"anchor":"Working-with-recurrence-rule-properties","title":"Working with recurrence rule properties","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/calendar","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/frequency-swift.property","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/interval","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/end-swift.property","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/repeatedTimePolicy","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/setPositions"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule"]]},"kind":"symbol","metadata":{"roleHeading":"Instance Property","externalID":"s:20FoundationEssentials8CalendarV14RecurrenceRuleV14matchingPolicyAC08MatchingG0Ovp","platforms":[{"name":"iOS","beta":false,"deprecated":false,"introducedAt":"18.0","unavailable":false},{"name":"iPadOS","beta":false,"deprecated":false,"introducedAt":"18.0","unavailable":false},{"name":"Mac Catalyst","beta":false,"deprecated":false,"introducedAt":"18.0","unavailable":false},{"name":"macOS","beta":false,"deprecated":false,"introducedAt":"15.0","unavailable":false},{"name":"tvOS","beta":false,"deprecated":false,"introducedAt":"18.0","unavailable":false},{"name":"watchOS","beta":false,"deprecated":false,"introducedAt":"11.0","unavailable":false}],"modules":[{"name":"FoundationEssentials"}],"role":"symbol","title":"matchingPolicy","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"matchingPolicy","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Calendar","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials8CalendarV"},{"text":".","kind":"text"},{"text":"MatchingPolicy","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials8CalendarV14MatchingPolicyO"}],"symbolKind":"property"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/calendar\/recurrencerule\/matchingpolicy"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"matchingPolicy"},{"kind":"text","text":": "},{"preciseIdentifier":"s:20FoundationEssentials8CalendarV","kind":"typeIdentifier","text":"Calendar","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar"},{"kind":"text","text":"."},{"preciseIdentifier":"s:20FoundationEssentials8CalendarV14MatchingPolicyO","kind":"typeIdentifier","text":"MatchingPolicy","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy"}]}]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"An occurrence may not be a valid date if it falls on a leap day or a"},{"type":"text","text":" "},{"type":"text","text":"leap hour when there is not one. When that happens, we can choose to"},{"type":"text","text":" "},{"type":"text","text":"ignore the occurrence ("},{"type":"codeVoice","code":".strict"},{"type":"text","text":"), choose a later time which has the"},{"type":"text","text":" "},{"type":"text","text":"same components ("},{"type":"codeVoice","code":".nextTimePreservingSmallerComponents"},{"type":"text","text":"), or find an"},{"type":"text","text":" "},{"type":"text","text":"earlier time ("},{"type":"codeVoice","code":".previousTimePreservingSmallerComponents"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, consider an event happening every year, starting on the"},{"type":"text","text":" "},{"type":"text","text":"29th of February 2020. When the matching policy is set to "},{"type":"codeVoice","code":".strict"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"it yields the following recurrences:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"2020-02-29"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-02-29"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2028-02-29"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"…"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"matchingPolicy"},{"type":"text","text":" of "},{"type":"codeVoice","code":".previousTimePreservingSmallerComponents"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"we get a result for each year:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"2020-02-29"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2021-02-28"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2022-02-28"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2023-02-28"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-02-29"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Lastly, a "},{"type":"codeVoice","code":"matchingPolicy"},{"type":"text","text":" of "},{"type":"codeVoice","code":".nextTimePreservingSmallerComponents"},{"type":"text","text":" "},{"type":"text","text":"moves invalid occurrences to the day after February 29:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"2020-02-29"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2021-03-01"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2022-03-01"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2023-03-01"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-02-29"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The same logic applies for missing leap hours during daylight saving"},{"type":"text","text":" "},{"type":"text","text":"time switches. For example, consider an event repeating daily, which"},{"type":"text","text":" "},{"type":"text","text":"starts at March 9 2024, 01:30 PST. With a "},{"type":"codeVoice","code":".strict"},{"type":"text","text":" matching policy,"},{"type":"text","text":" "},{"type":"text","text":"the event repeats on the following dates, and skips a day:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"(on 2024-03-10, there is a missing hour between 1am and 2am)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-11 01:30 PDT (08:30 UTC)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-12 01:30 PDT (08:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"With "},{"code":"matchingPolicy","type":"codeVoice"},{"type":"text","text":" of "},{"code":".previousTimePreservingSmallerComponents","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"we get a result for each day:"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-10 02:30 PST (10:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"(on 2024-03-10, there is a missing hour between 1am and 2am)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-11 01:30 PDT (08:30 UTC)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-12 01:30 PDT (08:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"Lastly, a "},{"code":"matchingPolicy","type":"codeVoice"},{"type":"text","text":" of "},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"moves invalid occurrences an hour forward:"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-10 00:30 PST (08:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"(on 2024-03-10, there is a missing hour between 1am and 2am)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-11 01:30 PDT (08:30 UTC)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-03-12 01:30 PDT (08:30 UTC)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Default value is "},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"What to do when a recurrence is not a valid date"}],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/matchingPolicy","interfaceLanguage":"swift"},"sections":[],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar":{"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Calendar"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Calendar"}],"abstract":[{"type":"text","text":"A definition of the