{"seeAlsoSections":[{"generated":true,"anchor":"Working-with-recurrence-rule-properties","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/calendar","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/frequency-swift.property","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/interval","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/end-swift.property","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/repeatedTimePolicy","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/setPositions"],"title":"Working with recurrence rule properties"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"matchingPolicy","kind":"identifier"},{"kind":"text","text":": "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials8CalendarV","text":"Calendar"},{"kind":"text","text":"."},{"preciseIdentifier":"s:20FoundationEssentials8CalendarV14MatchingPolicyO","kind":"typeIdentifier","text":"MatchingPolicy","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An occurrence may not be a valid date if it falls on a leap day or a"},{"type":"text","text":" "},{"type":"text","text":"leap hour when there is not one. When that happens, we can choose to"},{"type":"text","text":" "},{"type":"text","text":"ignore the occurrence ("},{"type":"codeVoice","code":".strict"},{"type":"text","text":"), choose a later time which has the"},{"type":"text","text":" "},{"type":"text","text":"same components ("},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"},{"text":"), or find an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"earlier time ("},{"type":"codeVoice","code":".previousTimePreservingSmallerComponents"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, consider an event happening every year, starting on the"},{"text":" ","type":"text"},{"text":"29th of February 2020. When the matching policy is set to ","type":"text"},{"code":".strict","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"it yields the following recurrences:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2020-02-29"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-02-29"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2028-02-29","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"…","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"With ","type":"text"},{"type":"codeVoice","code":"matchingPolicy"},{"text":" of ","type":"text"},{"type":"codeVoice","code":".previousTimePreservingSmallerComponents"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"we get a result for each year:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"2020-02-29"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2021-02-28"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"2022-02-28"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2023-02-28"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2024-02-29","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Lastly, a ","type":"text"},{"type":"codeVoice","code":"matchingPolicy"},{"text":" of ","type":"text"},{"type":"codeVoice","code":".nextTimePreservingSmallerComponents"},{"type":"text","text":" "},{"type":"text","text":"moves invalid occurrences to the day after February 29:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"2020-02-29"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2021-03-01"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2022-03-01","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2023-03-01","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-02-29"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The same logic applies for missing leap hours during daylight saving"},{"type":"text","text":" "},{"type":"text","text":"time switches. For example, consider an event repeating daily, which"},{"type":"text","text":" "},{"text":"starts at March 9 2024, 01:30 PST. With a ","type":"text"},{"type":"codeVoice","code":".strict"},{"type":"text","text":" matching policy,"},{"type":"text","text":" "},{"type":"text","text":"the event repeats on the following dates, and skips a day:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"2024-03-09 01:30 PST (09:30 UTC)","type":"text"},{"type":"text","text":" "},{"text":"(on 2024-03-10, there is a missing hour between 1am and 2am)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-11 01:30 PDT (08:30 UTC)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2024-03-12 01:30 PDT (08:30 UTC)","type":"text"},{"type":"text","text":" "},{"text":"With ","type":"text"},{"code":"matchingPolicy","type":"codeVoice"},{"text":" of ","type":"text"},{"code":".previousTimePreservingSmallerComponents","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"text":"we get a result for each day:","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"2024-03-09 01:30 PST (09:30 UTC)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2024-03-10 02:30 PST (10:30 UTC)","type":"text"},{"text":" ","type":"text"},{"text":"(on 2024-03-10, there is a missing hour between 1am and 2am)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-11 01:30 PDT (08:30 UTC)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-12 01:30 PDT (08:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"Lastly, a "},{"type":"codeVoice","code":"matchingPolicy"},{"type":"text","text":" of "},{"type":"codeVoice","code":".nextTimePreservingSmallerComponents"},{"type":"text","text":" "},{"type":"text","text":"moves invalid occurrences an hour forward:"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-10 00:30 PST (08:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"(on 2024-03-10, there is a missing hour between 1am and 2am)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-03-11 01:30 PDT (08:30 UTC)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-12 01:30 PDT (08:30 UTC)"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Default value is "},{"type":"codeVoice","code":".nextTimePreservingSmallerComponents"}