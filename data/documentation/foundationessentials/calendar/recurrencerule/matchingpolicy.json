{"abstract":[{"type":"text","text":"What to do when a recurrence is not a valid date"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"matchingPolicy","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Calendar","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials8CalendarV","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar"},{"text":".","kind":"text"},{"text":"MatchingPolicy","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials8CalendarV14MatchingPolicyO","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An occurrence may not be a valid date if it falls on a leap day or a"},{"type":"text","text":" "},{"type":"text","text":"leap hour when there is not one. When that happens, we can choose to"},{"type":"text","text":" "},{"type":"text","text":"ignore the occurrence ("},{"type":"codeVoice","code":".strict"},{"type":"text","text":"), choose a later time which has the"},{"type":"text","text":" "},{"type":"text","text":"same components ("},{"type":"codeVoice","code":".nextTimePreservingSmallerComponents"},{"type":"text","text":"), or find an"},{"type":"text","text":" "},{"type":"text","text":"earlier time ("},{"type":"codeVoice","code":".previousTimePreservingSmallerComponents"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, consider an event happening every year, starting on the"},{"type":"text","text":" "},{"type":"text","text":"29th of February 2020. When the matching policy is set to "},{"type":"codeVoice","code":".strict"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"it yields the following recurrences:"}]},{"items":[{"content":[{"inlineContent":[{"text":"2020-02-29","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-02-29","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2028-02-29"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"…"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"matchingPolicy"},{"type":"text","text":" of "},{"type":"codeVoice","code":".previousTimePreservingSmallerComponents"},{"type":"text","text":","},{"type":"text","text":" "},{"text":"we get a result for each year:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2020-02-29"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2021-02-28"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"2022-02-28"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2023-02-28"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2024-02-29","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Lastly, a "},{"type":"codeVoice","code":"matchingPolicy"},{"type":"text","text":" of "},{"type":"codeVoice","code":".nextTimePreservingSmallerComponents"},{"text":" ","type":"text"},{"text":"moves invalid occurrences to the day after February 29:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2020-02-29"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2021-03-01"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2022-03-01","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"2023-03-01","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-02-29","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The same logic applies for missing leap hours during daylight saving"},{"type":"text","text":" "},{"type":"text","text":"time switches. For example, consider an event repeating daily, which"},{"type":"text","text":" "},{"type":"text","text":"starts at March 9 2024, 01:30 PST. With a "},{"type":"codeVoice","code":".strict"},{"type":"text","text":" matching policy,"},{"type":"text","text":" "},{"type":"text","text":"the event repeats on the following dates, and skips a day:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"(on 2024-03-10, there is a missing hour between 1am and 2am)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-11 01:30 PDT (08:30 UTC)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-12 01:30 PDT (08:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"With "},{"type":"codeVoice","code":"matchingPolicy"},{"type":"text","text":" of "},{"type":"codeVoice","code":".previousTimePreservingSmallerComponents"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"we get a result for each day:"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-10 02:30 PST (10:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"(on 2024-03-10, there is a missing hour between 1am and 2am)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-11 01:30 PDT (08:30 UTC)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-12 01:30 PDT (08:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"Lastly, a "},{"type":"codeVoice","code":"matchingPolicy"},{"type":"text","text":" of "},{"type":"codeVoice","code":".nextTimePreservingSmallerComponents"},{"type":"text","text":" "},{"type":"text","text":"moves invalid occurrences an hour forward:"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-10 00:30 PST (08:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"(on 2024-03-10, there is a missing hour between 1am and 2am)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-11 01:30 PDT (08:30 UTC)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-12 01:30 PDT (08:30 UTC)"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Default value is "},{"type":"codeVoice","code":".nextTimePreservingSmallerComponents"}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/calendar","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/frequency-swift.property","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/interval","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/end-swift.property","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/repeatedTimePolicy","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/setPositions"],"generated":true,"title":"Working with recurrence rule properties","anchor":"Working-with-recurrence-rule-properties"}],"kind":"symbol","variants":[{"paths":["\/documentation\/foundationessentials\/calendar\/recurrencerule\/matchingpolicy"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"externalID":"s:20FoundationEss