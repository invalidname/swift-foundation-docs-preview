{"sections":[],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule"]]},"kind":"symbol","abstract":[{"text":"What to do when a recurrence is not a valid date","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"matchingPolicy"},{"kind":"text","text":": "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar","text":"Calendar","preciseIdentifier":"s:20FoundationEssentials8CalendarV","kind":"typeIdentifier"},{"kind":"text","text":"."},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy","text":"MatchingPolicy","preciseIdentifier":"s:20FoundationEssentials8CalendarV14MatchingPolicyO","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"An occurrence may not be a valid date if it falls on a leap day or a","type":"text"},{"text":" ","type":"text"},{"text":"leap hour when there is not one. When that happens, we can choose to","type":"text"},{"text":" ","type":"text"},{"text":"ignore the occurrence (","type":"text"},{"code":".strict","type":"codeVoice"},{"text":"), choose a later time which has the","type":"text"},{"text":" ","type":"text"},{"text":"same components (","type":"text"},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"},{"text":"), or find an","type":"text"},{"text":" ","type":"text"},{"text":"earlier time (","type":"text"},{"code":".previousTimePreservingSmallerComponents","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, consider an event happening every year, starting on the"},{"type":"text","text":" "},{"type":"text","text":"29th of February 2020. When the matching policy is set to "},{"code":".strict","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"it yields the following recurrences:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2020-02-29"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-02-29"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2028-02-29"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"…"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With "},{"code":"matchingPolicy","type":"codeVoice"},{"type":"text","text":" of "},{"code":".previousTimePreservingSmallerComponents","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"we get a result for each year:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2020-02-29"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2021-02-28"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2022-02-28"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2023-02-28"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-02-29"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Lastly, a "},{"code":"matchingPolicy","type":"codeVoice"},{"type":"text","text":" of "},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"moves invalid occurrences to the day after February 29:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2020-02-29"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2021-03-01"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2022-03-01"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2023-03-01"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-02-29"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The same logic applies for missing leap hours during daylight saving"},{"type":"text","text":" "},{"type":"text","text":"time switches. For example, consider an event repeating daily, which"},{"type":"text","text":" "},{"type":"text","text":"starts at March 9 2024, 01:30 PST. With a "},{"code":".strict","type":"codeVoice"},{"type":"text","text":" matching policy,"},{"type":"text","text":" "},{"text":"the event repeats on the following dates, and skips a day:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"},{"text":" ","type":"text"},{"type":"text","text":"(on 2024-03-10, there is a missing hour between 1am and 2am)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-11 01:30 PDT (08:30 UTC)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-12 01:30 PDT (08:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"With "},{"code":"matchingPolicy","type":"codeVoice"},{"type":"text","text":" of "},{"code":".previousTimePreservingSmallerComponents","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"we get a result for each day:"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2024-03-10 02:30 PST (10:30 UTC)","type":"text"},{"text":" ","type":"text"},{"text":"(on 2024-03-10, there is a missing hour between 1am and 2am)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2024-03-11 01:30 PDT (08:30 UTC)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2024-03-12 01:30 PDT (08:30 UTC)","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Lastly, a "},{"type":"codeVoice","code":"matchingPolicy"},{"type":"text","text":" of "},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"moves invalid occurrences an hour forward:"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-10 00:30 PST (08:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"(on 2024-03-10, there is a missing hour between 1am and 2am)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2024-03-11 01:30 PDT (08:30 UTC)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2024-03-12 01:30 PDT (08:30 UTC)","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Default value is "},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"}]}]}],"metadata":{"role":"symbol","symbolKind":"property","title":"matchingPolicy","externalID":"s:20FoundationEssentials8CalendarV14RecurrenceRuleV14matchingPolicyAC08MatchingG0Ovp","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"matchingPolicy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Calendar","preciseIdentifier":"s:20FoundationEssentials8CalendarV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"MatchingPolicy","preciseIdentifier":"s:20FoundationEssentials8CalendarV14MatchingPolicyO"}],"platforms":[{"name":"iOS","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"18.0"},{"name":"iPadOS","beta":false,"deprecated":false,"unavailable":fals