{"abstract":[{"type":"text","text":"What to do when a recurrence is not a valid date"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/calendar\/recurrencerule\/matchingpolicy"]}],"metadata":{"modules":[{"name":"FoundationEssentials"}],"roleHeading":"Instance Property","platforms":[{"introducedAt":"18.0","unavailable":false,"beta":false,"name":"iOS","deprecated":false},{"introducedAt":"18.0","unavailable":false,"beta":false,"name":"iPadOS","deprecated":false},{"introducedAt":"18.0","unavailable":false,"beta":false,"name":"Mac Catalyst","deprecated":false},{"introducedAt":"15.0","unavailable":false,"beta":false,"name":"macOS","deprecated":false},{"introducedAt":"18.0","unavailable":false,"beta":false,"name":"tvOS","deprecated":false},{"introducedAt":"11.0","unavailable":false,"beta":false,"name":"watchOS","deprecated":false}],"externalID":"s:20FoundationEssentials8CalendarV14RecurrenceRuleV14matchingPolicyAC08MatchingG0Ovp","symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"matchingPolicy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Calendar","preciseIdentifier":"s:20FoundationEssentials8CalendarV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"MatchingPolicy","preciseIdentifier":"s:20FoundationEssentials8CalendarV14MatchingPolicyO"}],"title":"matchingPolicy","role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"matchingPolicy"},{"kind":"text","text":": "},{"preciseIdentifier":"s:20FoundationEssentials8CalendarV","kind":"typeIdentifier","text":"Calendar","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar"},{"kind":"text","text":"."},{"preciseIdentifier":"s:20FoundationEssentials8CalendarV14MatchingPolicyO","kind":"typeIdentifier","text":"MatchingPolicy","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"An occurrence may not be a valid date if it falls on a leap day or a","type":"text"},{"text":" ","type":"text"},{"text":"leap hour when there is not one. When that happens, we can choose to","type":"text"},{"text":" ","type":"text"},{"text":"ignore the occurrence (","type":"text"},{"code":".strict","type":"codeVoice"},{"text":"), choose a later time which has the","type":"text"},{"text":" ","type":"text"},{"text":"same components (","type":"text"},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"},{"text":"), or find an","type":"text"},{"text":" ","type":"text"},{"text":"earlier time (","type":"text"},{"code":".previousTimePreservingSmallerComponents","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, consider an event happening every year, starting on the","type":"text"},{"text":" ","type":"text"},{"text":"29th of February 2020. When the matching policy is set to ","type":"text"},{"code":".strict","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"it yields the following recurrences:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2020-02-29"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-02-29"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2028-02-29"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"…"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"With ","type":"text"},{"code":"matchingPolicy","type":"codeVoice"},{"text":" of ","type":"text"},{"code":".previousTimePreservingSmallerComponents","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"we get a result for each year:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2020-02-29"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2021-02-28"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2022-02-28"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2023-02-28"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-02-29"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Lastly, a ","type":"text"},{"code":"matchingPolicy","type":"codeVoice"},{"text":" of ","type":"text"},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"},{"text":" ","type":"text"},{"text":"moves invalid occurrences to the day after February 29:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2020-02-29"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2021-03-01"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2022-03-01"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2023-03-01"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-02-29"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The same logic applies for missing leap hours during daylight saving","type":"text"},{"text":" ","type":"text"},{"text":"time switches. For example, consider an event repeating daily, which","type":"text"},{"text":" ","type":"text"},{"text":"starts at March 9 2024, 01:30 PST. With a ","type":"text"},{"code":".strict","type":"codeVoice"},{"text":" matching policy,","type":"text"},{"text":" ","type":"text"},{"text":"the event repeats on the following dates, and skips a day:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"(on 2024-03-10, there is a missing hour between 1am and 2am)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-11 01:30 PDT (08:30 UTC)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-12 01:30 PDT (08:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"With "},{"type":"codeVoice","code":"matchingPolicy"},{"type":"text","text":" of "},{"type":"codeVoice","code":".previousTimePreservingSmallerComponents"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"we get a result for each day:"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-10 02:30 PST (10:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"(on 2024-03-10, there is a missing hour between 1am and 2am)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-11 01:30 PDT (08:30 UTC)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-12 01:30 PDT (08:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"Lastly, a "},{"type":"codeVoice","code":"matchingPolicy"},{"type":"text","text":" of "},{"type":"codeVoice","code":".nextTimePreservingSmallerComponents"},{"type":"text","text":" "},{"type":"text","text":"moves invalid occurrences an hour forward:"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-10 00:30 PST (08:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"(on 2024-03-10, there is a missing hour between 1am and 2am)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-11 01:30 PDT (08:30 UTC)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-12 01:30 PDT (08:30 UTC)"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Default value is ","type":"text"},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/matchingPolicy"},"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar":{"url":"\/documentation\/foundationessentials\/calendar","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Calendar","kind":"identifier"}],"role":"symbol","abstract":[{"text":"A definition of the relationships between calendar units and absolute points in time, providing features for calculation and comparison of dates.","type":"text"}],"title":"Calendar","navigatorTitle":[{"text":"Calendar","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar"},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/MatchingPolicy":{"url":"\/documentation\/foundationessentials\/calendar\/matchingpolicy","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatchingPolicy","kind":"identifier"}],"role":"symbol","abstract":[{"text":"A hint to the search algorithm to control the method used for searching for dates.","type":"text"}],"title":"Calendar.MatchingPolicy","navigatorTitle":[{"text":"MatchingPolicy","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy"},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/RecurrenceRule/matchingPolicy":{"role":"symbol","abstract":[{"type":"text","text":"What to do when a recurrence is not a valid date"}],"url":"\/documentation\/foundationessentials\/calendar\/recurrencerule\/matchingpolicy","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"matchingPolicy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials8CalendarV","text":"Calendar"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials8CalendarV14MatchingPolicyO","text":"MatchingPolicy"}],"kind":"symbol","title":"matchingPolicy","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/matchingPolicy"},"doc://FoundationEssentials/documentation/FoundationEssentials":{"title":"FoundationEssentials","kind":"symbol","abstract":[{"text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app.","type":"text"}],"url":"\/documentation\/foundationessentials","role":"collection","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/RecurrenceRule":{"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"RecurrenceRule"}],"navigatorTitle":[{"kind":"identifier","text":"RecurrenceRule"}],"title":"Calendar.RecurrenceRule","abstract":[{"type":"text","text":"A rule which specifies how often an e