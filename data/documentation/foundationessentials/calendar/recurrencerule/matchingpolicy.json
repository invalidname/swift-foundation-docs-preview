{"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule"]]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","abstract":[{"text":"What to do when a recurrence is not a valid date","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/matchingPolicy"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"matchingPolicy","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar","text":"Calendar","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials8CalendarV"},{"text":".","kind":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy","text":"MatchingPolicy","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials8CalendarV14MatchingPolicyO"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"An occurrence may not be a valid date if it falls on a leap day or a","type":"text"},{"text":" ","type":"text"},{"text":"leap hour when there is not one. When that happens, we can choose to","type":"text"},{"text":" ","type":"text"},{"text":"ignore the occurrence (","type":"text"},{"code":".strict","type":"codeVoice"},{"text":"), choose a later time which has the","type":"text"},{"text":" ","type":"text"},{"text":"same components (","type":"text"},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"},{"text":"), or find an","type":"text"},{"text":" ","type":"text"},{"text":"earlier time (","type":"text"},{"code":".previousTimePreservingSmallerComponents","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, consider an event happening every year, starting on the","type":"text"},{"text":" ","type":"text"},{"text":"29th of February 2020. When the matching policy is set to ","type":"text"},{"code":".strict","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"it yields the following recurrences:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"2020-02-29"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-02-29"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"2028-02-29"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"…"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"With ","type":"text"},{"code":"matchingPolicy","type":"codeVoice"},{"text":" of ","type":"text"},{"code":".previousTimePreservingSmallerComponents","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"we get a result for each year:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"2020-02-29","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2021-02-28","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2022-02-28","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2023-02-28","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-02-29","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Lastly, a ","type":"text"},{"code":"matchingPolicy","type":"codeVoice"},{"text":" of ","type":"text"},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"},{"text":" ","type":"text"},{"text":"moves invalid occurrences to the day after February 29:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"2020-02-29","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2021-03-01","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2022-03-01","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2023-03-01","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-02-29","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The same logic applies for missing leap hours during daylight saving","type":"text"},{"text":" ","type":"text"},{"text":"time switches. For example, consider an event repeating daily, which","type":"text"},{"text":" ","type":"text"},{"text":"starts at March 9 2024, 01:30 PST. With a ","type":"text"},{"code":".strict","type":"codeVoice"},{"text":" matching policy,","type":"text"},{"text":" ","type":"text"},{"text":"the event repeats on the following dates, and skips a day:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"2024-03-09 01:30 PST (09:30 UTC)","type":"text"},{"text":" ","type":"text"},{"text":"(on 2024-03-10, there is a missing hour between 1am and 2am)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2024-03-11 01:30 PDT (08:30 UTC)","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"2024-03-12 01:30 PDT (08:30 UTC)","type":"text"},{"text":" ","type":"text"},{"text":"With ","type":"text"},{"code":"matchingPolicy","type":"codeVoice"},{"text":" of ","type":"text"},{"code":".previousTimePreservingSmallerComponents","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"we get a result for each day:","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"2024-03-09 01:30 PST (09:30 UTC)","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"2024-03-10 02:30 PST (10:30 UTC)","type":"text"},{"text":" ","type":"text"},{"text":"(on 2024-03-10, there is a missing hour between 1am and 2am)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-03-11 01:30 PDT (08:30 UTC)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-03-12 01:30 PDT (08:30 UTC)","type":"text"},{"text":" ","type":"text"},{"text":"Lastly, a ","type":"text"},{"code":"matchingPolicy","type":"codeVoice"},{"text":" of ","type":"text"},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"},{"text":" ","type":"text"},{"text":"moves invalid occurrences an hour forward:","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-03-09 01:30 PST (09:30 UTC)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-03-10 00:30 PST (08:30 UTC)","type":"text"},{"text":" ","type":"text"},{"text":"(on 2024-03-10, there is a missing hour between 1am and 2am)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-03-11 01:30 PDT (08:30 UTC)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-03-12 01:30 PDT (08:30 UTC)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Default value is ","type":"text"},{"code":".nextTimePreservingSmallerComponents","type":"codeVoice"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/calendar\/recurrencerule\/matchingpolicy"]}],"metadata":{"symbolKind":"property","modules":[{"name":"FoundationEssentials"}],"externalID":"s:20FoundationEssentials8CalendarV14RecurrenceRuleV14matchingPolicyAC08MatchingG0Ovp","platforms":[{"deprecated":false,"introducedAt":"18.0","unavailable":false,"beta":false,"name":"iOS"},{"unavailable":false,"beta":false,"name":"iPadOS","introducedAt":"18.0","deprecated":false},{"unavailable":f