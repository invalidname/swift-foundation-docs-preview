{"seeAlsoSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/calendar","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/frequency-swift.property","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/interval","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/end-swift.property","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/repeatedTimePolicy","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/setPositions"],"generated":true,"anchor":"Working-with-recurrence-rule-properties","title":"Working with recurrence rule properties"}],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/RecurrenceRule\/matchingPolicy","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"matchingPolicy","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar","text":"Calendar","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials8CalendarV"},{"text":".","kind":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy","text":"MatchingPolicy","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials8CalendarV14MatchingPolicyO"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An occurrence may not be a valid date if it falls on a leap day or a"},{"type":"text","text":" "},{"type":"text","text":"leap hour when there is not one. When that happens, we can choose to"},{"type":"text","text":" "},{"type":"text","text":"ignore the occurrence ("},{"type":"codeVoice","code":".strict"},{"type":"text","text":"), choose a later time which has the"},{"type":"text","text":" "},{"type":"text","text":"same components ("},{"type":"codeVoice","code":".nextTimePreservingSmallerComponents"},{"type":"text","text":"), or find an"},{"type":"text","text":" "},{"type":"text","text":"earlier time ("},{"type":"codeVoice","code":".previousTimePreservingSmallerComponents"},{"type":"text","text":")."}]},{"inlineContent":[{"text":"For example, consider an event happening every year, starting on the","type":"text"},{"text":" ","type":"text"},{"text":"29th of February 2020. When the matching policy is set to ","type":"text"},{"type":"codeVoice","code":".strict"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"it yields the following recurrences:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"2020-02-29"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-02-29","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2028-02-29"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"…"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"With ","type":"text"},{"type":"codeVoice","code":"matchingPolicy"},{"text":" of ","type":"text"},{"type":"codeVoice","code":".previousTimePreservingSmallerComponents"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"we get a result for each year:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"2020-02-29","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2021-02-28"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"2022-02-28"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2023-02-28","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-02-29"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Lastly, a ","type":"text"},{"type":"codeVoice","code":"matchingPolicy"},{"text":" of ","type":"text"},{"type":"codeVoice","code":".nextTimePreservingSmallerComponents"},{"text":" ","type":"text"},{"text":"moves invalid occurrences to the day after February 29:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"2020-02-29"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2021-03-01","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2022-03-01"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"2023-03-01"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-02-29","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The same logic applies for missing leap hours during daylight saving","type":"text"},{"text":" ","type":"text"},{"text":"time switches. For example, consider an event repeating daily, which","type":"text"},{"text":" ","type":"text"},{"text":"starts at March 9 2024, 01:30 PST. With a ","type":"text"},{"type":"codeVoice","code":".strict"},{"text":" matching policy,","type":"text"},{"text":" ","type":"text"},{"text":"the event repeats on the following dates, and skips a day:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"(on 2024-03-10, there is a missing hour between 1am and 2am)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-11 01:30 PDT (08:30 UTC)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-03-12 01:30 PDT (08:30 UTC)","type":"text"},{"text":" ","type":"text"},{"text":"With ","type":"text"},{"type":"codeVoice","code":"matchingPolicy"},{"text":" of ","type":"text"},{"type":"codeVoice","code":".previousTimePreservingSmallerComponents"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"we get a result for each day:","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-10 02:30 PST (10:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"(on 2024-03-10, there is a missing hour between 1am and 2am)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-03-11 01:30 PDT (08:30 UTC)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-12 01:30 PDT (08:30 UTC)"},{"type":"text","text":" "},{"type":"text","text":"Lastly, a "},{"type":"codeVoice","code":"matchingPolicy"},{"type":"text","text":" of "},{"type":"codeVoice","code":".nextTimePreservingSmallerComponents"},{"type":"text","text":" "},{"type":"text","text":"moves invalid occurrences an hour forward:"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-09 01:30 PST (09:30 UTC)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"2024-03-10 00:30 PST (08:30 UTC)","type":"text"},{"text":" ","type":"text"},{"text":"(on 2024-03-10, there is a missing hour between 1am and 2am)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2024-03-11 01:30 PDT (08:30 UTC)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"2024-03-12 01:30 PDT (08:30 UTC)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Default value is ","type":"text"},{"type":"codeVoice","code":".nextTimePreservingSmallerComponents"}]}]}],"metadata":{"roleHeading":"Instance Property","platforms":[{"unavailable":false,"introducedAt":"18.0","name":"iOS","deprecated":false,"beta":false},{