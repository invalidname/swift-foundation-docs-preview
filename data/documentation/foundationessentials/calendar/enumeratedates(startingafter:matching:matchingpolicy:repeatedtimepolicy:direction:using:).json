:"direction","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials8CalendarV","text":"Calendar","kind":"typeIdentifier","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar"},{"kind":"text","text":"."},{"preciseIdentifier":"s:20FoundationEssentials8CalendarV15SearchDirectionO","text":"SearchDirection","kind":"typeIdentifier","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/SearchDirection"},{"text":" = .forward, ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"block","kind":"internalParam"},{"text":": (","kind":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":")"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"start","content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Date"},{"type":"text","text":" at which to start the search."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"DateComponents"},{"type":"text","text":" to use as input to the search algorithm."}]}],"name":"components"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Determines the behavior of the search algorithm when the input produces an ambiguous result.","type":"text"}]}],"name":"matchingPolicy"},{"name":"repeatedTimePolicy","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Determines the behavior of the search algorithm when the input produces a time that occurs twice on a particular day."}]}]},{"name":"direction","content":[{"inlineContent":[{"type":"text","text":"Which direction in time to search. The default value is "},{"type":"codeVoice","code":".forward"},{"type":"text","text":", which means later in time."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A closure that is called with search results.","type":"text"}]}],"name":"block"}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"There will be at least one intervening date which does not match all the components (or the given date itself must not match) between the given date and any result.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If "},{"code":"direction","type":"codeVoice"},{"type":"text","text":" is set to "},{"code":".backward","type":"codeVoice"},{"type":"text","text":", this method finds the previous match before the given date. The intent is that the same matches as for a "},{"code":".forward","type":"codeVoice"},{"type":"text","text":" search will be found (that is, if you are enumerating forwards or backwards for each hour with minute “27”, the seconds in the date you will get in forwards search would obviously be 00, and the same will be true in a backwards search in order to implement this rule.  Similarly for DST backwards jumps which repeats times, you’ll get the first match by default, where “first” is defined from the point of view of searching forwards.  So, when searching backwards looking for a particular hour, with no minute and second specified, you don’t get a minute and second of 59:59 for the matching hour (which would be the nominal first match within a given hour, given the other rules here, when searching backwards)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If an exact match is not possible, and requested with the "},{"type":"codeVoice","code":"strict"},{"type":"text","text":" option, nil is passed to the closure and the enumeration ends.  (Logically, since an exact match searches indefinitely into the future, if no match is found there’s no point in continuing the enumeration.)"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Result dates have an integer number of seconds (as if 0 was specified for the nanoseconds property of the "},{"type":"codeVoice","code":"DateComponents"},{"type":"text","text":" matching parameter), unless a value was set in the nanoseconds property, in which case the result date will have that number of nanoseconds (or as close as possible with floating point numbers)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The enumeration is stopped by setting "},{"code":"stop","type":"codeVoice"},{"type":"text","text":" to "},{"code":"true","type":"codeVoice"},{"type":"text","text":" in the closure and returning. It is not necessary to set "},{"type":"codeVoice","code":"stop"},{"text":" to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" to keep the enumeration going.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/calendar\/enumeratedates(startingafter:matching:matchingpolicy:repeatedtimepolicy:direction:using:)"]}],"abstract":[{"type":"text","text":"Computes the dates which match (or most closely match) a given set of components, and calls the closure once for each of them, until the enumeration is stopped."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar":{"role":"symbol","title":"Calendar","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar","abstract":[{"text":"A defini