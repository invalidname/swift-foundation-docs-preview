"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"If specified, the algorithm travels as far forward or backward as necessary looking for a match."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"strict","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"For example, if searching for Feb 29 in the Gregorian calendar, the algorithm may choose March 1 instead (for example, if the year is not a leap year). If you wish to find the next Feb 29 without the algorithm adjusting the next higher component in the specified "},{"code":"DateComponents","type":"codeVoice"},{"text":", then use the ","type":"text"},{"code":"strict","type":"codeVoice"},{"text":" option.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"There are ultimately implementation-defined limits in how far distant the search will go."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"}]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/MatchingPolicy/nextTime":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy\/nextTime","type":"topic","title":"Calendar.MatchingPolicy.nextTime","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nextTime","kind":"identifier"}],"role":"symbol","abstract":[{"text":"If there is no matching time before the end of the next instance of the next higher component to the highest specified component in the ","type":"text"},{"code":"DateComponents","type":"codeVoice"},{"text":" argument, the algorithm will return the next existing time which exists.","type":"text"}],"url":"\/documentation\/foundationessentials\/calendar\/matchingpolicy\/nexttime"},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar":{"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Calendar"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Calendar"}],"abstract":[{"type":"text","text":"A definition of the relationships between calendar units and absolute points in time, providing features for calculation and comparison of dates."}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar","title":"Calendar","role":"symbol","url":"\/documentation\/foundationessentials\/calendar"},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/MatchingPolicy/nextTimePreservingSmallerComponents":{"abstract":[{"text":"If specified, and there is no matching time before the end of the next instance of the next higher component to the highest specified component in the ","type":"text"},{"code":"DateComponents","type":"codeVoice"},{"text":" argument, the method will return the next existing value of the missing component and preserves the lower components’ values (e.g., no 2:37am results in 3:37am, if that exists).","type":"text"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy\/nextTimePreservingSmallerComponents","kind":"symbol","url":"\/documentation\/foundationessentials\/calendar\/matchingpolicy\/nexttimepreservingsmallercomponents","title":"Calendar.MatchingPolicy.nextTimePreservingSmallerComponents","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nextTimePreservingSmallerComponents","kind":"identifier"}],"type":"topic"},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/MatchingPolicy":{"abstract":[{"text":"A hint to the search algorithm to control the method used for searching for dates.","type":"text"}],"navigatorTitle":[{"t