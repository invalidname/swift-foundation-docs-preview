n\/FoundationEssentials\/Calendar\/MatchingPolicy"]]},"abstract":[{"type":"text","text":"If specified, the algorithm travels as far forward or backward as necessary looking for a match."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"strict","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, if searching for Feb 29 in the Gregorian calendar, the algorithm may choose March 1 instead (for example, if the year is not a leap year). If you wish to find the next Feb 29 without the algorithm adjusting the next higher component in the specified "},{"type":"codeVoice","code":"DateComponents"},{"type":"text","text":", then use the "},{"type":"codeVoice","code":"strict"},{"type":"text","text":" option."}]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"There are ultimately implementation-defined limits in how far distant the search will go."}]}],"style":"note"}],"kind":"content"}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","title":"FoundationEssentials","url":"\/documentation\/foundationessentials","type":"topic","role":"collection","abstract":[{"type":"text","text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app."}],"kind":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Calendar"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Calendar"}],"title":"Calendar","url":"\/documentation\/foundationessentials\/calendar","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A definition of the relationships between calendar units and absolute points in time, providing features for calculation and comparison of dates."}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar"},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/MatchingPolicy/previousTimePreservingSmallerComponents":{"abstract":[{"type":"text","text":"If there is no matching time before the end of the next instance of the next higher component to the highest specified component in the "},{"code":"DateComponents","type":"codeVoice"},{"type":"text","text":" argument, the algorithm will return the previous existing value of the missing component and preserves the lower components’ values."}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"previousTimePreservingSmallerComponents","kind":"identifier"}],"role":"symbol","url":"\/documentation\/foundationessentials\/calendar\/matchingpolicy\/previoustimepreservingsmallercomponents","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy\/previousTimePreservingSmallerComponents","title":"Calendar.MatchingPolicy.previousTimePreservingSmallerComponents"},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/MatchingPolicy":{"kind":"symbol","navigatorTitle":[{"text":"MatchingPolicy","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatchingPolicy","kind":"identifier"}],"title":"Calendar.MatchingPolicy","url":"\/documentation\/foundationessentials\/calendar\/matchingpolicy","type":"topic","role":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy","abstract":[{"type":"text","text":"A hint to the search algorithm to control the method used for searching for dates."}]},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/MatchingPolicy/nextTimePreservingSmallerComponents":{"abstract":[{"type":"text","text":"If specified, and there is no matching time before the end of the next instance of the next higher component to the highest specified component in the "},{"code":"DateComponents","type":"codeVoice"},{"type":"text","text":" argument, the method will return the next existing value of the missing component and preserves the lower components’ values (e.g., no 2:37am results in 3:37am, if that exists)."}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nextTimePreservingSmallerComponents","kind":"identifier"}],"role":"symbol","url":"\/documentation\/foundationessentials\/calendar\/matchingpolicy\/nexttimepreservingsmallercomponents","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy\/nextTimePreservingSmallerComponents","title":"Calendar.MatchingPolicy.nextTimePreservingSmallerComponents"},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/MatchingPolicy/strict":{"abstract":[{"type":"text","text":"If specified, the algorithm travels as far forward or backward as necessary looking for a match."}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"strict","kind":"identifier"}],"role":"symbol","url":"\/documentation\/foundationessentials\/calendar\/matchingpolicy\/strict","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy\/strict","title":"Calendar.MatchingPolicy.strict"},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/MatchingPolicy/nextTime":{"abstract":[{"type":"text","text":"If there is no matching time before the end of the next instance of the next higher component to the highest specified component in the "},{"code":"DateComponents","type":"codeVoice"},{"type":"text","text":" argument, the algorithm will return the next existing time which exists."}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nextTime","kind":"identifier"}],"role":"symbol","url":"\/documentation\/foundationessentials\/calendar\/matchingpolicy\/nexttime","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy\/nextTime","title":"Calendar.MatchingPolicy.nextTime"}}}