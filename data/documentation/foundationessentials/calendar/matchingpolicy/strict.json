For example, if searching for Feb 29 in the Gregorian calendar, the algorithm may choose March 1 instead (for example, if the year is not a leap year). If you wish to find the next Feb 29 without the algorithm adjusting the next higher component in the specified ","type":"text"},{"code":"DateComponents","type":"codeVoice"},{"text":", then use the ","type":"text"},{"code":"strict","type":"codeVoice"},{"text":" option.","type":"text"}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"There are ultimately implementation-defined limits in how far distant the search will go."}]}],"name":"Note"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/calendar\/matchingpolicy\/strict"]}],"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy\/strict"},"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Calendar","kind":"identifier"}],"url":"\/documentation\/foundationessentials\/calendar","title":"Calendar","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Calendar"}],"role":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar","kind":"symbol","abstract":[{"type":"text","text":"A definition of the relationships between calendar units and absolute points in time, providing features for calculation and comparison of dates."}]},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/MatchingPolicy/previousTimePreservingSmallerComponents":{"role":"symbol","type":"topic","title":"Calendar.MatchingPolicy.previousTimePreservingSmallerComponents","url":"\/documentation\/foundationessentials\/calendar\/matchingpolicy\/previoustimepreservingsmallercomponents","abstract":[{"type":"text","text":"If there is no matching time before the end of the next instance of the next higher component to the highest specified component in the "},{"type":"codeVoice","code":"DateComponents"},{"type":"text","text":" argument, the algorithm will return the previous existing value of the missing component and preserves the lower components’ values."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"previousTimePreservingSmallerComponents","kind":"identifier"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy\/previousTimePreservingSmallerComponents","kind":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/MatchingPolicy/strict":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"strict"}],"type":"topic","title":"Calendar.MatchingPolicy.strict","url":"\/documentation\/foundationessentials\/calendar\/matchingpolicy\/strict","role":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy\/strict","abstract":[{"text":"If specified, the algorithm travels as far forward or backward as necessary looking for a match.","type":"text"}],"kind":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/MatchingPolicy/nextTime":{"role":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy\/nextTime","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"text":"nextTime","kind":"identifier"}],"abstract":[{"type":"text","text":"If there is no matching time before the end of the next instance of the next higher component to the highest specified component in the "},{"code":"DateComponents","type":"codeVoice"},{"type":"text","text":" argument, the algorithm will return the next existing time which exists."}],"type":"topic","url":"\/documentation\/foundationessentials\/calendar\/matchingpolicy\/nexttime","title":"Calendar.MatchingPolicy.nextTime","kind":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/MatchingPolicy":{"title":"Calendar.MatchingPolicy","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatchingPolicy","kind":"identifier"}],"navigatorTitle":[{"text":"MatchingPolicy","kind":"identifier"}],"abstract":[{"text":"A hint to the search algorithm to control the method used for searching for dates.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy","url":"\/documentation\/foundationessentials\/calendar\/matchingpolicy"},"doc://FoundationEssentials/documentation/FoundationEssentials":{"abstract":[{"text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app.","type":"text"}],"url":"\/documentation\/foundationessentials","type":"topic","role":"collection","title":"FoundationEssentials","kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"},"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/MatchingPolicy/nextTimePreservingSmallerComponents":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"nextTimePreservingSmallerComponents"}],"type":"topic","title":"Calendar.MatchingPolicy.nextTimePreservingSmallerComponents","url":"\/documentation\/foundationessentials\/calendar\/matchingpolicy\/nexttimepreservingsmallercomponents","role":"symbol","abstract":[{"type":"text","text":"If specified, and there is no matching time before the end of the next instance of the next higher component to the highest specified component in the "},{"code":"DateComponents","type":"codeVoice"},{"type":"text","text":" argument, the method will return the next existing value of the missing component and preserves the lower components’ values (e.g., no 2:37am results in 3:37am, if that exists)."}],"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy\/nextTimePreservingSmallerComponents"}}}