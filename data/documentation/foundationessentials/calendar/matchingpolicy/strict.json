:[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"strict"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, if searching for Feb 29 in the Gregorian calendar, the algorithm may choose March 1 instead (for example, if the year is not a leap year). If you wish to find the next Feb 29 without the algorithm adjusting the next higher component in the specified "},{"code":"DateComponents","type":"codeVoice"},{"type":"text","text":", then use the "},{"code":"strict","type":"codeVoice"},{"type":"text","text":" option."}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"There are ultimately implementation-defined limits in how far distant the search will go."}],"type":"paragraph"}],"style":"note","name":"Note"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Calendar\/MatchingPolicy\/strict"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/Calendar/MatchingPolicy/nextTimePreservingSmallerComponents":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nextTimePreservingSmallerComponents","kind":"identifier"}],"title":"Calendar.MatchingPolicy.nextTimePreservingSmallerComponents","kind":"symbol","url":"\/documentation\/foundationessentials\/calendar\/matchingpolicy\/nexttimepreservingsmallercomponents","abstract":[{"type":"text","text":"If specified, and there is no matching time before the end of the next instance of the next higher component to the highest specified component in the "},{"type":"codeVoice","code":"DateComponents"},{"text":" argument, the method will return the next existing value of the missin