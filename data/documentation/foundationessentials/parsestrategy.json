{"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ParseStrategy"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Se","kind":"typeIdentifier","text":"Decodable"},{"kind":"text","text":", "},{"preciseIdentifier":"s:SE","kind":"typeIdentifier","text":"Encodable"},{"kind":"text","text":", "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy","type":"reference","isActive":true},{"text":" allows you to convert a formatted representation into a data type, using one of two approaches:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Initialize the data type by calling an initializer of that type that takes a formatted instance and a parse strategy as parameters. For example, you can create a ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Decimal","isActive":true},{"text":" from a formatted string with the initializer ","type":"text"},{"type":"codeVoice","code":"Decimal.init(_:format:lenient:)"},{"text":" from the FoundationInternationalization module.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Create a parse strategy and call its ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy\/parse(_:)","isActive":true},{"text":" method on one or more formatted instances.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy","isActive":true},{"type":"text","text":" is closely related to "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","isActive":true},{"type":"text","text":", which provides the opposite conversion: from data type to formatted representation. To use a parse strategy, you create a "},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","isActive":true},{"type":"text","text":" to define the representation you expect, then access the style’s "},{"type":"codeVoice","code":"parseStrategy"},{"type":"text","text":" property to get a strategy instance."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example creates a "},{"type":"codeVoice","code":"Decimal.FormatStyle.Currency"},{"type":"text","text":" format style (as provided by FoundationInternationalization) that uses US dollars and US English number-formatting conventions. It then creates a "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Decimal","isActive":true,"type":"reference"},{"type":"text","text":" instance by providing a formatted string to parse and the format style’s `Decimal.FormatStyle.Currency.parseStrategy``."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let style = Decimal.FormatStyle.Currency(code: \"USD\",","locale: Locale(identifier: \"en_US\"))","let parsed = try? Decimal(\"$12,345.67\",","strategy: style.parseStrategy) \/\/ 12345.67"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/foundationessentials\/parsestrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ParseStrategy","kind":"identifier"}],"navigatorTitle":[{"text":"ParseStrategy","kind":"identifier"}],"externalID":"s:20FoundationEssentials13ParseStrategyP","symbolKind":"p