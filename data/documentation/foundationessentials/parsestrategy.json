lt values: "},{"code":"Sun","type":"codeVoice"},{"type":"text","text":", "},{"code":"01","type":"codeVoice"},{"type":"text","text":", "},{"code":"Jan","type":"codeVoice"},{"type":"text","text":", "},{"code":"2000","type":"codeVoice"},{"type":"text","text":", "},{"code":"00:00:00","type":"codeVoice"},{"type":"text","text":", "},{"code":"GMT","type":"codeVoice"},{"type":"text","text":". Note that missing fields may result in an invalid date or time. Other values in the "},{"code":"DateComponents","type":"codeVoice"},{"type":"text","text":" are ignored."}]},"doc://FoundationEssentials/documentation/FoundationEssentials/Date/HTTPFormatStyle":{"title":"Date.HTTPFormatStyle","navigatorTitle":[{"kind":"identifier","text":"HTTPFormatStyle"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","url":"\/documentation\/foundationessentials\/date\/httpformatstyle","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPFormatStyle"}],"abstract":[{"type":"text","text":"Options for generating and parsing string representations of dates following the HTTP date format from "},{"identifier":"https:\/\/www.rfc-editor.org\/rfc\/rfc9110.html#http.date","type":"reference","isActive":true},{"type":"text","text":"."}],"role":"symbol","kind":"symbol"}}}