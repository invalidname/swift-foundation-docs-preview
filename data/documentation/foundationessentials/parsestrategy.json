{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"]]},"topicSections":[{"title":"Performing parsing","anchor":"Performing-parsing","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy\/parse(_:)"]},{"title":"Using common format styles","anchor":"Using-common-format-styles","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy\/http-1oj46","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy\/http-952ct","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy\/iso8601-2oypx","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy\/iso8601-2pu9d"]},{"title":"Supporting types","anchor":"Supporting-types","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy\/ParseInput","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy\/ParseOutput"]}],"metadata":{"title":"ParseStrategy","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ParseStrategy"}],"navigatorTitle":[{"kind":"identifier","text":"ParseStrategy"}],"modules":[{"name":"FoundationEssentials"}],"externalID":"s:20FoundationEssentials13ParseStrategyP","symbolKind":"protocol","roleHeading":"Protocol","platforms":[{"beta":false,"unavailable":false,"deprecated":false,"name":"iOS","introducedAt":"15.0"},{"beta":false,"unavailable":false,"deprecated":false,"name":"iPadOS","introducedAt":"15.0"},{"beta":false,"unavailable":false,"deprecated":false,"name":"Mac Catalyst","introducedAt":"15.0"},{"beta":false,"unavailable":false,"deprecated":false,"name":"macOS","introducedAt":"12.0"},{"beta":false,"unavailable":false,"deprecated":false,"name":"tvOS","introducedAt":"15.0"},{"introducedAt":"8.0","beta":false,"name":"watchOS","unavailable":false,"deprecated":false}],"role":"symbol"},"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A type that parses an input representation, such as a formatted string, into a provided data type."}],"sections":[],"relationshipsSections":[{"title":"Inherits From","kind":"relationships","type":"inheritsFrom","identifiers":["doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH"]},{"title":"Conforming Types","kind":"relationships","type":"conformingTypes","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/ISO8601FormatStyle"]}],"seeAlsoSections":[{"title":"Data parsing","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"generated":true,"anchor":"Data-parsing"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ParseStrategy"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Se","kind":"typeIdentifier","text":"Decodable"},{"kind":"text","text":", "},{"preciseIdentifier":"s:SE","kind":"typeIdentifier","text":"Encodable"},{"kind":"text","text":", "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy","isActive":true},{"text":" allows you to convert a formatted representation into a data type, using one of two approaches:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Initialize the data type by calling an initializer of that type that takes a formatted instance and a parse strategy as parameters. For example, you can create a "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Decimal","isActive":true,"type":"reference"},{"type":"text","text":" from a formatted string with the initializer "},{"type":"codeVoice","code":"Decimal.init(_:format:lenient:)"},{"type":"text","text":" from the FoundationInternationalization module."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Create a parse strategy and call its "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy\/parse(_:)","isActive":true,"type":"reference"},{"type":"text","text":" method on one or more formatted instances."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy","isActive":true},{"text":" is closely related to ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","isActive":true},{"text":", which provides the opposite conversion: from data type to formatted representation. To use a parse strategy, you create a ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","isActive":true},{"text":" to define the representation you expect, then access the style’s ","type":"text"},{"type":"codeVoice","code":"parseStrategy"},{"text":" property to get a strategy instance.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example creates a ","type":"text"},{"type":"codeVoice","code":"Decimal.FormatStyle.Currency"},{"text":" format style (as provided by FoundationInternationalization) that uses US dollars and US English number-formatting conventions. It then creates a ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Decimal","isActive":true},{"text":" instance by providing a formatted string to parse and the format style’s `Decimal.FormatStyle.Currency.parseStrategy``.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let style = Decimal.FormatStyle.Currency(code: \"USD\",","locale: Locale(identifier: \"en_US\"))","let parsed = try? Decimal(\"$12,345.67\",","strategy: style.parseStrategy) \/\/ 12345.67"],"syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/parsestrategy"]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FormatStyle","kind":"identifier"}],"abstract":[{"type":"text","text":"A type that converts a given data type into a representation in another type, such as a string."}],"role":"symbol","navigatorTitle":[{"text":"FormatStyle","kind":"identifier"}],"title":"FormatStyle","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","type":"topic","url":"\/documentation\/foundationessentials\/formatstyle","kind":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/ParseableFormatStyle":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ParseableFormatStyle"}],"abstract":[{"type":"text","text":"A type that can convert a given input data type into a representation in an output type."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ParseableFormatSty