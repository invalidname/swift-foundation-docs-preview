inlineContent":[{"type":"text","text":"Initialize the data type by calling an initializer of that type that takes a formatted instance and a parse strategy as parameters. For example, you can create a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Decimal"},{"type":"text","text":" from a formatted string with the initializer "},{"type":"codeVoice","code":"Decimal.init(_:format:lenient:)"},{"type":"text","text":" from the FoundationInternationalization module."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Create a parse strategy and call its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy\/parse(_:)"},{"type":"text","text":" method on one or more formatted instances."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy","type":"reference"},{"text":" is closely related to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","type":"reference"},{"text":", which provides the opposite conversion: from data type to formatted representation. To use a parse strategy, you create a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","type":"reference"},{"text":" to define the representation you expect, then access the style’s ","type":"text"},{"code":"parseStrategy","type":"codeVoice"},{"text":" property to get a strategy instance.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example creates a ","type":"text"},{"code":"Decimal.FormatStyle.Currency","type":"codeVoice"},{"text":" format style (as provided by FoundationInternationalization) that uses US dollars and US English number-formatting conventions. It then creates a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Decimal","type":"reference"},{"type":"text","text":" instance by providing a formatted string to parse and the format style’s `Decimal.FormatStyle.Currency.parseStrategy``."}]},{"syntax":"swift","code":["let style = Decimal.FormatStyle.Currency(code: \"USD\",","locale: Locale(identifier: \"en_US\"))","let parsed = try? Decimal(\"$12,345.67\",","strategy: style.parseStrategy) \/\/ 12345.67"],"type":"codeListing"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"generated":true,"title":"Data parsing","anchor":"Data-parsing"}],"variants":[{"paths":["\/documentation\/foundationessentials\/parsestrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/FormatStyle":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatStyle"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A type that converts a given data type into a representation in another type, such as a string."}],"url":"\/documentation\/foundationessentials\/formatstyle","title":"FormatStyle","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","navigatorTitle":[{"kind":"identifier","text":"FormatStyle"}],"type":"topic"},"doc://FoundationEssentials/documentation/FoundationEssentials/Date/HTTPFormatStyle":{"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","url":"\/documentation\/foundationessentials\/date\/httpformatstyle","kind":"symbol","title":"Date.HTTPFormatStyle","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPFormatStyle"}],"role"