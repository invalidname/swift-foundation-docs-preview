]]},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"A type that parses an input representation, such as a formatted string, into a provided data type."}],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseableFormatStyle"],"anchor":"Data-parsing","generated":true,"title":"Data parsing"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ParseStrategy","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Se","text":"Decodable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:SE","text":"Encodable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy","type":"reference"},{"text":" allows you to convert a formatted representation into a data type, using one of two approaches:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Initialize the data type by calling an initializer of that type that takes a formatted instance and a parse strategy as parameters. For example, you can create a "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Decimal","type":"reference","isActive":true},{"type":"text","text":" from a formatted string with the initializer "},{"type":"codeVoice","code":"Decimal\/init(_:format:lenient:)-6fk71"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Create a parse strategy and call its "},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy\/parse(_:)","type":"reference","isActive":true},{"type":"text","text":" method on one or more formatted instances."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy","type":"reference"},{"text":" is closely related to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","type":"reference"},{"text":", which provides the opposite conversion: from data type to formatted representation. To use a parse strategy, you create a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","type":"reference"},{"text":" to define the representation you expect, then access the style’s ","type":"text"},{"code":"parseStrategy","type":"codeVoice"},{"text":" property to get a strategy instance.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example creates a ","type":"text"},{"code":"Decimal\/FormatStyle\/Currency","type":"codeVoice"},{"text":" format style that uses US dollars and US English number-formatting conventions. It then creates a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Decimal","type":"reference"},{"text":" instance by providing a formatted string to parse and the format style’s ","type":"text"},{"code":"Decimal\/FormatStyle\/Currency\/parseStrategy","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","code":["let style = Decimal.FormatStyle.Currency(code: \"USD\",","locale: Locale(identifier: \"en_US\"))","let parsed = try? Decimal(\"$12,345.67\",","strategy: style.parseStrategy) \/\/ 12345.67"],"syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/foundationessentials\/parsestrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/Se","doc:\/\/FoundationEssentials\/SE","doc:\/\/FoundationEssentials\/SQ","doc:\/\/FoundationEssentials\/SH"],"type":"inheritsFrom","title":"Inherits From"},{"kind":"relationships","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Date\/ISO8601FormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/ISO8601FormatStyle"],"type":"conformingTypes","title":"Conforming Types"}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/ParseStrategy/ParseOutput":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy\/ParseOutput","role":"symbol","title":"ParseOutput","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"ParseOutput"}],"type":"topic","required":true,"url":"\/documentation\/foundationessentials\/parsestrategy\/parseoutput","kind":"symbol","abstract":[{"type":"text","text":"The output type returned by this strategy."}]},"doc://FoundationEssentials/documentation/FoundationEssentials/ParseStrategy/parse(_:)":{"url":"\/documentation\/foundationessentials\/parsestrategy\/parse(_:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"parse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials13ParseStrategyP0C5InputQa","text":"ParseInput","kind":"typeIdentifier"},{"text":") "