t":"A ","type":"text"},{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy","isActive":true,"type":"reference"},{"text":" allows you to convert a formatted representation into a data type, using one of two approaches:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Initialize the data type by calling an initializer of that type that takes a formatted instance and a parse strategy as parameters. For example, you can create a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Decimal","type":"reference"},{"text":" from a formatted string with the initializer ","type":"text"},{"code":"Decimal\/init(_:format:lenient:)-6fk71","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Create a parse strategy and call its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy\/parse(_:)"},{"type":"text","text":" method on one or more formatted instances."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/ParseStrategy","type":"reference"},{"text":" is closely related to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","type":"reference"},{"text":", which provides the opposite conversion: from data type to formatted representation. To use a parse strategy, you create a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/FormatStyle","type":"reference"},{"text":" to define the representation you expect, then access the style’s ","type":"text"},{"code":"parseStrategy","type":"codeVoice"},{"text":" property to get a strategy instance.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The following example creates a "},{"type":"codeVoice","code":"Decimal\/FormatStyle\/Currency"},{"type":"text","text":" format style that uses US dollars and US English number-formatting conventions. It then creates a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Decimal"},{"type":"text","text":" instance by providing a formatted string to parse and the format style’s "},{"type":"codeVoice","code":"Decimal\/FormatStyle\/Currency\/parseStrategy"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","code":["let style = Decimal.FormatStyle.Currency(code: \"USD\",","locale: Locale(identifier: \"en_US\"))","let parsed = try? Decimal(\"$12,345.67\",","strategy: style.parseStrategy) \/\/ 12345.67"],"syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/foundationessentials\/parsestrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"FoundationEssentials"}],"navigatorTitle":[{"text":"ParseStrategy","kind":"identifier"}],"platforms":[{"deprecated":false,"unavailable":false,"name":"iOS","introducedAt":"15.0","beta":false},{"deprecated":false,"unavailable":false,"name":"iPadOS","introducedAt":"15.0","beta":false},{"deprecated":false,"unavailable":false,"name":"Mac Catalyst","introducedAt":"15.0","beta":false},{"deprecated":false,"unavailable":false,"name":"macOS","introducedAt":"12.0","beta":false},{"deprecated":false,"unavailable":false,"name":"tvOS","introducedAt":"15.0","beta":false},{"deprecated":false,"unavailable":false,"name":"watchOS","introducedAt":"8.0","beta":false}],"role":"symbol","symbolKind":"protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ParseStrategy","kind":"identifier"}],"externalID":"s:20FoundationEssentials13ParseStrategyP","title":"ParseStrategy","roleHeading":"Protocol"},"seeAlsoSections":[{"title":"Data pars