{"abstract":[{"text":"Returns an array containing substrings from the string that have been","type":"text"},{"text":" ","type":"text"},{"text":"divided by the given separator.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/swift\/stringprotocol\/components(separatedby:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"components"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"externalParam","text":"separatedBy"},{"kind":"text","text":" "},{"text":"separator","kind":"internalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"text":"] ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sy","text":"StringProtocol","kind":"typeIdentifier"}],"platforms":["macOS"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The separator string.","type":"text"}]}],"name":"separator"}],"kind":"parameters"},{"content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"inlineContent":[{"text":"An array containing substrings that have been divided from the","type":"text"},{"text":" ","type":"text"},{"text":"string using ","type":"text"},{"code":"separator","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The substrings in the resulting array appear in the same order as the","type":"text"},{"text":" ","type":"text"},{"text":"original string. Adjacent occurrences of the separator string produce","type":"text"},{"text":" ","type":"text"},{"text":"empty strings in the result. Similarly, if the string begins or ends","type":"text"},{"text":" ","type":"text"},{"text":"with the separator, the first or last substring, respectively, is empty.","type":"text"},{"text":" ","type":"text"},{"text":"The following example shows this behavior:","type":"text"}],"type":"paragraph"},{"code":["let list1 = \"Karin, Carrie, David\"","let items1 = list1.components(separatedBy: \", \")","\/\/ [\"Karin\", \"Carrie\", \"David\"]","","\/\/ Beginning with the separator:","let list2 = \", Norman, Stanley, Fletcher\"","let items2 = list2.components(separatedBy: \", \")","\/\/ [\"\", \"Norman\", \"Stanley\", \"Fletcher\""],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"If the list has no separators, the array contains only the original","type":"text"},{"text":" ","type":"text"},{"text":"string itself.","type":"text"}],"type":"paragraph"},{"code":["let name = \"Karin\"","let list = name.components(separatedBy: \", \")","\/\/ [\"Karin\"]"],"syntax":null,"type":"codeListing"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Swift\/StringProtocol\/components(separatedBy:)"},"sections":[],"metadata":{"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"components","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"separatedBy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"modules":[{"relatedModules":["Swift"],"name":"FoundationEssentials"}],"role":"symbol","externalID":"s:Sy20FoundationEssentialsE10components11separatedBySaySSGqd___tSyRd__lF","platforms":[{"de