{"abstract":[{"text":"Returns an array containing substrings from the string that have been","type":"text"},{"text":" ","type":"text"},{"text":"divided by the given separator.","type":"text"}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Swift","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Swift\/StringProtocol"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"components"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"externalParam","text":"separatedBy"},{"kind":"text","text":" "},{"kind":"internalParam","text":"separator"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":") -> ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"] "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Sy","kind":"typeIdentifier","text":"StringProtocol"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The separator string."}]}],"name":"separator"}]},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An array containing substrings that have been divided from the"},{"type":"text","text":" "},{"type":"text","text":"string using "},{"code":"separator","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The substrings in the resulting array appear in the same order as the"},{"type":"text","text":" "},{"type":"text","text":"original string. Adjacent occurrences of the separator string produce"},{"type":"text","text":" "},{"type":"text","text":"empty strings in the result. Similarly, if the string begins or ends"},{"type":"text","text":" "},{"type":"text","text":"with the separator, the first or last substring, respectively, is empty."},{"type":"text","text":" "},{"type":"text","text":"The following example shows this behavior:"}]},{"type":"codeListing","code":["let list1 = \"Karin, Carrie, David\"","let items1 = list1.components(separatedBy: \", \")","\/\/ [\"Karin\", \"Carrie\", \"David\"]","","\/\/ Beginning with the separator:","let list2 = \", Norman, Stanley, Fletcher\"","let items2 = list2.components(separatedBy: \", \")","\/\/ [\"\", \"Norman\", \"Stanley\", \"Fletcher\""],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the list has no separators, the array contains only the original"},{"type":"text","text":" "},{"type":"text","text":"string itself."}]},{"type":"codeListing","code":["let name = \"Karin\"","let list = name.components(separatedBy: \", \")","\/\/ [\"Karin\"]"],"syntax":null}],"kind":"content"}],"identifier":{"url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Swift\/StringProtocol\/components(separatedBy:)","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"symbolKind":"method","externalID":"s:Sy20FoundationEssentialsE10components11separatedBySaySSGqd___tSyRd__lF","role":"symbol","title":"components(separatedBy:)","modules":[{"name":"FoundationEssentials","relatedModules":["Swift"]}],"extendedModule":"Swift","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"components","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"separatedBy","kind"