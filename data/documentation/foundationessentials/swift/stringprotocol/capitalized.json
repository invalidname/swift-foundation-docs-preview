{"abstract":[{"type":"text","text":"A copy of the string with each word changed to its corresponding"},{"type":"text","text":" "},{"type":"text","text":"capitalized spelling."}],"sections":[],"metadata":{"modules":[{"relatedModules":["Swift"],"name":"FoundationEssentials"}],"platforms":[{"beta":false,"introducedAt":"8.0","unavailable":false,"name":"iOS","deprecated":false},{"beta":false,"introducedAt":"8.0","unavailable":false,"name":"iPadOS","deprecated":false},{"beta":false,"introducedAt":"8.0","unavailable":false,"name":"Mac Catalyst","deprecated":false},{"beta":false,"introducedAt":"10.10","unavailable":false,"name":"macOS","deprecated":false},{"beta":false,"introducedAt":"9.0","unavailable":false,"name":"tvOS","deprecated":false},{"beta":false,"introducedAt":"2.0","unavailable":false,"name":"watchOS","deprecated":false}],"role":"symbol","symbolKind":"property","extendedModule":"Swift","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"capitalized"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"externalID":"s:Sy20FoundationEssentialsE11capitalizedSSvp","title":"capitalized","roleHeading":"Instance Property"},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/swift\/stringprotocol\/capitalized"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Swift\/StringProtocol\/capitalized"},"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Swift","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Swift\/StringProtocol"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"capitalized","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"This property performs the canonical (non-localized) mapping. It is","type":"text"},{"text":" ","type":"text"},{"text":"suitable for programming operations that require stable results not","type":"text"},{"text":" ","type":"text"},{"text":"depending on the current locale.","type":"text"}]},{"inlineContent":[{"type":"text","text":"A capitalized string is a string with the first character in each word"},{"type":"text","text":" "},{"type":"text","text":"changed to its corresponding uppercase value, and all remaining"},{"type":"text","text":" "},{"type":"text","text":"characters set to their corresponding lowercase values. A “word” is any"},{"type":"text","text":" "},{"type":"text","text":"sequence of characters delimited by spaces, tabs, or line terminators."},{"type":"text","text":" "},{"type":"text","text":"Some common word delimiting punctuation isn’t considered, so this"},{"type":"text","text":" "},{"type":"text","text":"property may not generally produce the desired results for multiword"},{"type":"text","text":" "},{"type":"text","text":"strings. See the "},{"type":"codeVoice","code":"getLineStart(_:end:contentsEnd:for:)"},{"type":"text","text":" method for"},{"type":"text","text":" "},{"type":"text","text":"additional information."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Case transformations aren’t guaranteed to be symmetrical or to produce","type":"text"},{"text":" ","type":"text"},{"text":"strings of the same lengths as the originals.","type":"text"}]}],"kind":"content"}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/Swift/StringProtocol/capitalized":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"capitalized"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"abstract":[{"text":"A copy of the string with each word changed to its corresponding","type":"text"},{"text":" ","type":"text"},{"text":"capitalized spelling.","type":"text"}],"role":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Swift\/StringProtocol\/capitalized","type":"topic","kind":"symbol","url":"\/documentation\/foundationessentials\/swift\/stringprotocol\/capitalized","title":"capitalized"},"doc://FoundationEssentials/documentation/FoundationEssentials/Swift":{"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Swift","title":"Swift","type":"topic","role":"collection","abstract":[],"url":"\/documentation\/foundationessentials\/swift"},"doc://FoundationEssentials/documentation/FoundationEssentials":{"kind":"symbol","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","title":"FoundationEssentials","type":"topic","role":"collection","abstract":[{"type":"text","text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app."}],"url":"\/documentation\/foundationessentials"},"doc://FoundationEssentials/documentation/FoundationEssentials/Swift/StringProtocol":{"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Swift\/StringProtocol","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"StringProtocol","preciseIdentifier":"s:Sy"}],"navigatorTitle":[{"kind":"identifier","text":"StringProtocol"}],"title":"StringProtocol","url":"\/documentation\/foundationessentials\/swift\/stringprotocol","abstract":[]}}}