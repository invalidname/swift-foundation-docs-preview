{"abstract":[{"type":"text","text":"A copy of the string with each word changed to its corresponding"},{"type":"text","text":" "},{"type":"text","text":"capitalized spelling."}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Swift","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Swift\/StringProtocol"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"capitalized"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"This property performs the canonical (non-localized) mapping. It is","type":"text"},{"text":" ","type":"text"},{"text":"suitable for programming operations that require stable results not","type":"text"},{"text":" ","type":"text"},{"text":"depending on the current locale.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A capitalized string is a string with the first character in each word","type":"text"},{"text":" ","type":"text"},{"text":"changed to its corresponding uppercase value, and all remaining","type":"text"},{"text":" ","type":"text"},{"text":"characters set to their corresponding lowercase values. A “word” is any","type":"text"},{"text":" ","type":"text"},{"text":"sequence of characters delimited by spaces, tabs, or line terminators.","type":"text"},{"text":" ","type":"text"},{"text":"Some common word delimiting punctuation isn’t considered, so this","type":"text"},{"text":" ","type":"text"},{"text":"property may not generally produce the desired results for multiword","type":"text"},{"text":" ","type":"text"},{"text":"strings. See the ","type":"text"},{"code":"getLineStart(_:end:contentsEnd:for:)","type":"codeVoice"},{"text":" method for","type":"text"},{"text":" ","type":"text"},{"text":"additional information.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Case transformations aren’t guaranteed to be symmetrical or to produce","type":"text"},{"text":" ","type":"text"},{"text":"strings of the same lengths as the originals.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/Swift\/StringProtocol\/capitalized"},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"symbolKind":"property","externalID":"s:Sy20FoundationEssentialsE11capitalizedSSvp","modules":[{"name":"FoundationEssentials","relatedModules":["Swift"]}],"role":"symbol","title":"capitalized","roleHeading":"Instance Property","extendedModule":"Swift","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"capitalized"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"platforms":[{"name":"iOS","beta":false,"deprecated":false,"introducedAt":"8.0","unavailable":false},{"name":"iPadOS","beta":false,"deprecated":false,"introducedAt":"8.0","unavailable":false},{"name":"Mac Catalyst","beta":false,"deprecated":false,"introducedAt":"8.0","unavailable":false},{"name":"macOS","beta":false,"deprecated":false,"introducedAt":"10.10","unavailable":false},{"name":"tvOS","beta":false,"deprecated":false,"introducedAt":"9.0","unavailable":false},{"name":"watchOS","beta":false,"deprecated":false,"introducedAt":"2.0","unavailable":false}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/swift\/stringprotocol\/capitalized"]}],"references":{"doc://FoundationEssentials/documentation/FoundationEssentials