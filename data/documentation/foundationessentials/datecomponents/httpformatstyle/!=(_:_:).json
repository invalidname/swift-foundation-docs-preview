xt":"DateComponents","kind":"identifier"}],"abstract":[{"text":"A date or time specified in terms of units (such as year, month, day, hour, minute) to be evaluated in a calendar system and time zone.","type":"text"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents","title":"DateComponents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DateComponents","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/foundationessentials\/datecomponents","type":"topic"},"doc://FoundationEssentials/documentation/FoundationEssentials/DateComponents/HTTPFormatStyle":{"kind":"symbol","abstract":[{"text":"Converts ","type":"text"},{"code":"DateComponents","type":"codeVoice"},{"text":" into RFC 9110-compatible “HTTP date” ","type":"text"},{"code":"String","type":"codeVoice"},{"text":", and parses in the reverse direction.","type":"text"},{"text":" ","type":"text"},{"text":"This parser does not do validation on the individual values of the components. An optional date can be created from the result using ","type":"text"},{"type":"codeVoice","code":"Calendar(identifier: .gregorian).date(from: ...)"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"When formatting, missing or invalid fields are filled with default values: ","type":"text"},{"code":"Sun","type":"codeVoice"},{"text":", ","type":"text"},{"code":"01","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Jan"},{"text":", ","type":"text"},{"code":"2000","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"00:00:00"},{"text":", ","type":"text"},{"code":"GMT","type":"codeVoice"},{"text":". Note that missing fields may result in an invalid date or time. Other values in the ","type":"text"},{"code":"DateComponents","type":"codeVoice"},{"text":" are ignored.","type":"text"}],"title":"DateComponents.HTTPFormatStyle","identifier":"doc:\/\/FoundationEssentials\/documentation\/Foundation