r"},{"text":"()","kind":"text"}],"abstract":[],"title":"init()","url":"\/documentation\/foundationessentials\/datecomponents\/httpformatstyle\/init()","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/HTTPFormatStyle\/init()","role":"symbol"},"doc://FoundationEssentials/documentation/FoundationEssentials/DateComponents":{"navigatorTitle":[{"text":"DateComponents","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[{"text":"A date or time specified in terms of units (such as year, month, day, hour, minute) to be evaluated in a calendar system and time zone.","type":"text"}],"type":"topic","title":"DateComponents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DateComponents","kind":"identifier"}],"identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents","url":"\/documentation\/foundationessentials\/datecomponents"},"doc://FoundationEssentials/documentation/FoundationEssentials/DateComponents/HTTPFormatStyle":{"navigatorTitle":[{"text":"HTTPFormatStyle","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[{"text":"Converts ","type":"text"},{"code":"DateComponents","type":"codeVoice"},{"text":" into RFC 9110-compatible “HTTP date” ","type":"text"},{"code":"String","type":"codeVoice"},{"text":", and parses in the reverse direction.","type":"text"},{"text":" ","type":"text"},{"text":"This parser does not do validation on the individual values of the components. An optional date can be created from the result using ","type":"text"},{"code":"Calendar(identifier: .gregorian).date(from: ...)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"When formatting, missing or invalid fields are filled with default values: ","type":"text"},{"code":"Sun","type":"codeVoice"},{"text":", ","type":"text"},{"code":"01","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Jan","type":"codeVoice"},{"text":"