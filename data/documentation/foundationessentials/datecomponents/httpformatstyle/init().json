xt":"Converts "},{"code":"DateComponents","type":"codeVoice"},{"type":"text","text":" into RFC 9110-compatible “HTTP date” "},{"code":"String","type":"codeVoice"},{"type":"text","text":", and parses in the reverse direction."},{"type":"text","text":" "},{"type":"text","text":"This parser does not do validation on the individual values of the components. An optional date can be created from the result using "},{"code":"Calendar(identifier: .gregorian).date(from: ...)","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"When formatting, missing or invalid fields are filled with default values: "},{"code":"Sun","type":"codeVoice"},{"type":"text","text":", "},{"code":"01","type":"codeVoice"},{"type":"text","text":", "},{"code":"Jan","type":"codeVoice"},{"type":"text","text":", "},{"code":"2000","type":"codeVoice"},{"type":"text","text":", "},{"code":"00:00:00","type":"codeVoice"},{"type":"text","text":", "},{"code":"GMT","type":"codeVoice"},{"type":"text","text":". Note that missing fields may result in an invalid date or time. Other values in the "},{"code":"DateComponents","type":"codeVoice"},{"type":"text","text":" are ignored."}]}}}