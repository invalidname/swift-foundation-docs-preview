:"text"},{"type":"text","text":" "},{"type":"text","text":"This parser does not do validation on the individual values of the components. An optional date can be created from the result using "},{"type":"codeVoice","code":"Calendar(identifier: .gregorian).date(from: ...)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"When formatting, missing or invalid fields are filled with default values: "},{"type":"codeVoice","code":"Sun"},{"type":"text","text":", "},{"type":"codeVoice","code":"01"},{"type":"text","text":", "},{"type":"codeVoice","code":"Jan"},{"type":"text","text":", "},{"type":"codeVoice","code":"2000"},{"type":"text","text":", "},{"type":"codeVoice","code":"00:00:00"},{"type":"text","text":", "},{"type":"codeVoice","code":"GMT"},{"type":"text","text":". Note that missing fields may result in an invalid date or time. Other values in the "},{"type":"codeVoice","code":"DateComponents"},{"type":"text","text":" are ignored."}],"url":"\/documentation\/foundationessentials\/datecomponents\/httpformatstyle","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"HTTPFormatStyle","kind":"identifier"}],"title":"DateComponents.HTTPFormatStyle"}}}