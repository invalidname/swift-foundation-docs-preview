{"hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/yearForWeekOfYear"},"abstract":[{"text":"The year corresponding to a week-counting week.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"yearForWeekOfYear"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"? { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Gregorian calendar defines a week to have 7 days, and a year to have 365 days, or 366 in a leap year. However, neither 365 or 366 divide evenly into a 7 day week, so it is often the case that the last week of a year ends on a day in the next year, and the first week of a year begins in the preceding year. To reconcile this, ISO 8601 defines a week-numbering year, consisting of either 52 or 53 full weeks (364 or 371 days), such that the first week of a year is designated to be the week containing the first Thursday of the year."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use the yearForWeekOfYear property with the weekOfYear and weekday properties to get the date corresponding to a particular weekday of a given week of a year. For example, the 6th day of the 53rd week of the year 2005 (ISO 2005-W53-6) corresponds to Sat 1 January 2005 on the Gregorian calendar."}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This value is interpreted in the context of the calendar in which it is used."}]}],"name":"Note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/datecomponents\/yearforweekofyear"]}],"seeAlsoSections":[{"anchor":"Working-with-months-and-years","generated":true,"title":"Working with months and years","identifiers":["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/era","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/year","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/quarter","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/month","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/isLeapMonth"]}],"sections":[],"metadata":{"platforms":[{"beta":false,"introducedAt":"8.0","name":"iOS","deprecated":false,"unavailable":false},{"beta":false,"introducedAt":"8.0","name":"iPadOS","deprecated":false,"unavailable":false},{"beta":false,"introducedAt":"8.0","name":"Mac Catalyst","deprecated":false,"unavailable":false},{"beta":false,"introducedAt":"10.9","name":"macOS","deprecated":false,"unavailable":false},{"beta":false,"introducedAt":"9.0","name":"tvOS","deprecated":false,"unavailable":false},{"beta":false,"introducedAt":"2.0","name":"watchOS","deprecated":false,"unavailable":false}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"yearForWeekOfYear","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?","kind":"text"}],"title":"yearForWeekOfYear","externalID":"s:20FoundationEssentials14DateComponentsV17yearForWeekOfYearSiSgvp","role":"symbol","modules":[{"name":"FoundationEssentials"}],"symbolKind":"property","roleHeadi