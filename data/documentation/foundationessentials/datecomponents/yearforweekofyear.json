{"abstract":[{"text":"The year corresponding to a week-counting week.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationessentials\/datecomponents\/yearforweekofyear"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials","doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/yearForWeekOfYear"},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"yearForWeekOfYear","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"? { ","kind":"text"},{"text":"get","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Gregorian calendar defines a week to have 7 days, and a year to have 365 days, or 366 in a leap year. However, neither 365 or 366 divide evenly into a 7 day week, so it is often the case that the last week of a year ends on a day in the next year, and the first week of a year begins in the preceding year. To reconcile this, ISO 8601 defines a week-numbering year, consisting of either 52 or 53 full weeks (364 or 371 days), such that the first week of a year is designated to be the week containing the first Thursday of the year."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use the yearForWeekOfYear property with the weekOfYear and weekday properties to get the date corresponding to a particular weekday of a given week of a year. For example, the 6th day of the 53rd week of the year 2005 (ISO 2005-W53-6) corresponds to Sat 1 January 2005 on the Gregorian calendar."}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"This value is interpreted in the context of the calendar in which it is used.","type":"text"}]}],"name":"Note"}]}],"metadata":{"platforms":[{"introducedAt":"8.0","deprecated":false,"unavailable":false,"name":"iOS","beta":false},{"introducedAt":"8.0","deprecated":false,"unavailable":false,"name":"iPadOS","beta":false},{"introducedAt":"8.0","deprecated":false,"unavailable":false,"name":"Mac Catalyst","beta":false},{"introducedAt":"10.9","deprecated":false,"unavailable":false,"name":"macOS","beta":false},{"introducedAt":"9.0","deprecated":false,"unavailable":false,"name":"tvOS","beta":false},{"introducedAt":"2.0","deprecated":false,"unavailable":false,"name":"watchOS","beta":false}],"title":"yearForWeekOfYear","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"yearForWeekOfYear"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"?"}],"modules":[{"name":"FoundationEssentials"}],"symbolKind":"property","roleHeading":"Instance Property","externalID":"s:20FoundationEssentials14DateComponentsV17yearForWeekOfYearSiSgvp"},"references":{"doc://FoundationEssentials/documentation/FoundationEssentials/DateComponents":{"type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents","abstract":[{"text":"A date or time specified in terms of units (such as year, month, day, hour, minute) to be evaluated in a calendar system and time zone.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DateComponents","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"DateComponents","kind":"identifier"}],"title":"DateComponents","url":"\/documentation\/foundationessentials\/datecomponents"},"doc://FoundationEssentials/documentation/FoundationEssentials":{"title":"FoundationEssentials","kind":"symbol","abstract":[{"text":"Access essential data types, collections, and operating-system services to define the base layer of functionality for your app.","type":"text"}],"url":"\/documentation\/foundationessentials","role":"collection","type":"topic","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials"},"doc://FoundationEssentials/documentation/FoundationEssentials/DateComponents/yearForWeekOfYear":{"abstract":[{"type":"text","text":"The year corresponding to a week-counting week."}],"url":"\/documentation\/foundationessentials\/datecomponents\/yearforweekofyear","identifier":"doc:\/\/FoundationEssentials\/documentation\/FoundationEssentials\/DateComponents\/yearForWeekOfYear","type":"topic","kind":"symbol","title":"yearForWeekOfYear","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"yearForWeekOfYear"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}],"role":"symbol"}}}