{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/attributed-swift.property","isActive":true,"type":"reference"},{"text":" modifier on a ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","isActive":true,"type":"reference"},{"text":" to create a format style of this type.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The attributed strings that this format style creates contain attributes from the ","type":"text"},{"code":"AttributeScopes\/FoundationAttributes\/NumberFormatAttributes","type":"codeVoice"},{"text":" attribute scope. Use these attributes to determine which runs of the attributed string represent different parts of the formatted value.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example finds runs of the attributed string that represent different parts of a formatted currency, and adds additional attributes like ","type":"text"},{"code":"AttributeScopes\/SwiftUIAttributes\/foregroundColor","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AttributeScopes\/FoundationAttributes\/inlinePresentationIntent","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["func attributedPrice(price: Decimal) -> AttributedString {","var attributedPrice = price.formatted(",".currency(code: \"USD\")",".attributed)","","for run in attributedPrice.runs {","if run.attributes.numberSymbol == .currency ||","run.attributes.numberSymbol == .decimalSeparator  {","attributedPrice[run.range].foregroundColor = .red","}","if run.attributes.numberPart == .integer ||","run.attributes.numberPart == .fraction {","attributedPrice[run.range].inlinePresentationIntent = [.stronglyEmphasized]","}","}","return attributedPrice","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"User interface frameworks like SwiftUI can use these attributes when presenting the attributed string, as seen here:","type":"text"}]},{"type":"paragraph","inlineContent":[]}],"kind":"content"}],"identifier":{"url":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Attributed-swift.struct","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationinternationalization\/integerformatstyle\/attributed-swift.struct"]}],"metadata":{"roleHeading":"Structure","role":"symbol","externalID":"s:30FoundationInternationalization18IntegerFormatStyleV10AttributedV","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Attributed","kind":"identifier"}],"navigatorTitle":[{"text":"Attributed","kind":"identifier"}],"platforms":[{"beta":false,"introducedAt":"15.0","deprecated":false,"name":"iOS","unavailable":false},{"beta":false,"introducedAt":"15.0","deprecated":false,"name":"iPadOS","unavailable":false},{"beta":false,"introducedAt":"15.0","deprecated":false,"name":"Mac Catalyst","unavailable":false},{"beta":false,"introducedAt":"12.0","deprecated":false,"name":"macOS","unavailable":false},{"beta":false,"introducedAt":"15.0","deprecated":false,"name":"tvOS","unavailable":false},{"beta":false,"introducedAt":"8.0","deprecated":false,"name":"watchOS","unavailable":false}],"extendedModule":"FoundationInternationalization","modules":[{"name":"FoundationInternationalization"}],"title":"IntegerFormatStyle.Attributed","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Value"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"BinaryInteger"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]}},"kind":"symbol","sectio