{"identifier":{"url":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","interfaceLanguage":"swift"},"abstract":[{"text":"A structure that converts between floating-point values and their textual representations.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FloatingPointFormatStyle","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SB","kind":"typeIdentifier","text":"BinaryFloatingPoint"}]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"Instances of "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","isActive":true},{"type":"text","text":" create localized, human-readable text from "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint"},{"type":"text","text":" numbers and parse string representations of numbers into instances of "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint"},{"type":"text","text":" types. All of the Swift standard library’s floating-point types, such as "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/double"},{"type":"text","text":", "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/float"},{"type":"text","text":", and "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/float80"},{"type":"text","text":", conform to "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint"},{"type":"text","text":", and therefore work with this format style."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle"},{"type":"text","text":" includes two nested types, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/Percent"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/Currency"},{"type":"text","text":", for working with percentages and currencies, respectively. Each format style includes a configuration that determines how it represents numeric values, for things like grouping, displaying signs, and variant presentations like scientific notation. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/Percent"},{"type":"text","text":" include a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/NumberFormatStyleConfiguration"},{"text":", and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/Currency"},{"text":" includes a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/CurrencyFormatStyleConfiguration","type":"reference"},{"type":"text","text":". You can customize numeric formatting for a style by adjusting its backing configuration. The system automatically caches unique configurations of a format style to enhance performance."}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"Foundation provides another format style type, "},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","type":"reference","isActive":true},{"type":"text","text":", for working with numbers that conform to "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger"},{"type":"text","text":". For Foundation’s "},{"type":"codeVoice","code":"Decimal"},{"type":"text","text":" type, use "},{"type":"codeVoice","code":"Decimal\/FormatStyle"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","name":"Note"},{"text":"Formatting floating-point values","anchor":"Formatting-floating-point-values","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint\/formatted()"},{"type":"text","text":" method to create a string representation of a floating-point value using the default "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","isActive":true},{"type":"text","text":" configuration."}],"type":"paragraph"},{"syntax":"swift","code":["let formattedDefault = 12345.67.formatted()","\/\/ formattedDefault is \"12,345.67\" in the en_US locale.","\/\/ Other locales may use different separator and grouping behavior."],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can specify a format style by providing an argument to the "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint\/formatted(_:)-4ksqj"},{"type":"text","text":" method. The following example shows the number "},{"type":"codeVoice","code":"0.1"},{"type":"text","text":" represented in each of the available styles, in the "},{"type":"codeVoice","code":"en_US"},{"type":"text","text":" locale:"}],"type":"paragraph"},{"syntax":"swift","code":["let number = 0.1","","let formattedNumber = number.formatted(.number)","\/\/ formattedNumber is \"0.1\".","","let formattedPercent = number.formatted(.percent)","\/\/ formattedPercent is \"10%\".","","let formattedCurrency = number.formatted(.currency(code: \"USD\"))","\/\/ formattedCurrency is \"$0.10\"."],"type":"codeListing"},{"inlineContent":[{"text":"Each style provides methods for updating its numeric configuration, including the number of significant digits, grouping length, and more. You can specify a numeric configuration by calling as many of these methods as you need in any order you choose. The following example shows the same number with default and custom configurations:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let exampleNumber = 123456.78","","let defaultFormatting = exampleNumber.formatted(.number)","\/\/ defaultFormatting is \"123 456,78\" for the \"fr_FR\" locale.","\/\/ defaultFormatting is \"123,456.78\" for the \"en_US\" locale.","","let customFormatting = exampleNumber.formatted(",".number",".grouping(.never)",".sign(strategy: .always()))","\/\/ customFormatting is \"+123456.78\""],"type":"codeListing"},{"type":"heading","anchor":"Creating-a-floating-point-format-style-instance","level":3,"text":"Creating a floating-point format style instance"},{"inlineContent":[{"text":"The previous examples use static factory methods like ","type":"text"},{"code":"FormatStyle\/number-8c8rj","type":"codeVoice"},{"text":" to create format styles within the call to the ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint\/formatted(_:)-4ksqj","type":"text"},{"text":" method. You can also create a ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","isActive":true},{"text":" instance and use it to repeatedly format different values, with the ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/format(_:)","isActive":true},{"text":" method:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let percentFormatStyle = FloatingPointFormatStyle<Double>.Percent()","","percentFormatStyle.format(0.5) \/\/ \"50%\"","percentFormatStyle.format(0.855) \/\/ \"85.5%\"","percentFormatStyle.format(1.0) \/\/ \"100%\"",""]},{"type":"heading","anchor":"Parsing-floating-point-values","level":3,"text":"Parsing floating-point values"},{"inlineContent":[{"type":"text","text":"You can use "},{"isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","type":"reference"},{"type":"text","text":" to parse strings into floating-point values. You can define the format style within the type’s initializer or pass in a format style created outside the function, as shown here:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let price = try? Double(\"$3,500.63\",","format: .currency(code: \"USD\")) \/\/ 3500.63","","let priceFormatStyle = FloatingPointFormatStyle<Double>.Currency(code: \"USD\")","let salePrice = try? Double(\"$731.67\",","format: priceFormatStyle) \/\/ 731.67"]},{"type":"heading","anchor":"Matching-regular-expressions","level":3,"text":"Matching regular expressions"},{"inlineContent":[{"text":"Along with parsing numeric values in strings, you can use theSwift regular expression domain-specific language to match and capture numeric substrings. The following example defines a percentage format style to match a percentage value using ","type":"text"},{"type":"codeVoice","code":"en_US"},{"text":" numeric conventions. The rest of the regular expression ignores any characters prior to a ","type":"text"},{"type":"codeVoice","code":"\": \""},{"text":" sequence that precedes the percentage substring.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import RegexBuilder","let source = \"Percentage complete: 55.1%\"","let matcher = Regex {","OneOrMore(.any)","\": \"","Capture {","One(.localizedDoublePercentage(locale: Locale(identifier: \"en_US\")))","}","}","let match = source.firstMatch(of: matcher)","let localizedPercentage = match?.1","print(\"\\(localizedPercentage!)\") \/\/ 0.551"]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationinternationalization\/floatingpointformatstyle"]}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FloatingPointFormatStyle"}],"title":"FloatingPointFormatStyle","navigatorTitle":[{"kind":"identifier","text":"FloatingPointFormatStyle"}],"symbolKind":"struct","modules":[{"name":"FoundationInternationalization"}],"roleHeading":"Structure","externalID":"s:30FoundationInternationalization24FloatingPointFormatStyleV","role":"symbol","platforms":[{"deprecated":false,"unavailable":false,"name":"iOS","beta":false,"introducedAt":"15.0"},{"deprecated":false,"unavailable":false,"name":"iPadOS","beta":false,"introducedAt":"15.0"},{"deprecated":false,"unavailable":false,"name":"Mac Catalyst","beta":false,"introducedAt":"15.0"},{"deprecated":false,"unavailable":false,"name":"macOS","beta":false,"introducedAt":"12.0"},{"deprecated":false,"unavailable":false,"name":"tvOS","beta":false,"introducedAt":"15.0"},{"deprecated":false,"unavailable":false,"nam