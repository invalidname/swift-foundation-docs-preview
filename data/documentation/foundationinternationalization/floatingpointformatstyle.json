{"schemaVersion":{"major":0,"patch":0,"minor":3},"relationshipsSections":[{"identifiers":["doc:\/\/FoundationInternationalization\/20FoundationEssentials11FormatStyleP","doc:\/\/FoundationInternationalization\/20FoundationEssentials20ParseableFormatStyleP","doc:\/\/FoundationInternationalization\/s8CopyableP","doc:\/\/FoundationInternationalization\/Se","doc:\/\/FoundationInternationalization\/SE","doc:\/\/FoundationInternationalization\/SQ","doc:\/\/FoundationInternationalization\/s9EscapableP","doc:\/\/FoundationInternationalization\/SH","doc:\/\/FoundationInternationalization\/s8SendableP","doc:\/\/FoundationInternationalization\/s16SendableMetatypeP","doc:\/\/FoundationInternationalization\/17_StringProcessing29CustomConsumingRegexComponentP","doc:\/\/FoundationInternationalization\/17_StringProcessing14RegexComponentP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"identifier":{"url":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","interfaceLanguage":"swift"},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"FloatingPointFormatStyle"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FloatingPointFormatStyle"}],"roleHeading":"Structure","externalID":"s:30FoundationInternationalization24FloatingPointFormatStyleV","symbolKind":"struct","role":"symbol","modules":[{"name":"FoundationInternationalization"}],"platforms":[{"deprecated":false,"unavailable":false,"beta":false,"name":"iOS","introducedAt":"15.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"iPadOS","introducedAt":"15.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"Mac Catalyst","introducedAt":"15.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"macOS","introducedAt":"12.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"tvOS","introducedAt":"15.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"watchOS","introducedAt":"8.0"}],"title":"FloatingPointFormatStyle"},"sections":[],"abstract":[{"text":"A structure that converts between floating-point values and their textual representations.","type":"text"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FloatingPointFormatStyle","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryFloatingPoint","kind":"typeIdentifier","preciseIdentifier":"s:SB"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Instances of "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","isActive":true},{"type":"text","text":" create localized, human-readable text from "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint"},{"type":"text","text":" numbers and parse string representations of numbers into instances of "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint"},{"type":"text","text":" types. All of the Swift standard library’s floating-point types, such as "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/double"},{"type":"text","text":", "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/float"},{"type":"text","text":", and "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/float80"},{"type":"text","text":", conform to "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint"},{"type":"text","text":", and therefore work with this format style."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle"},{"type":"text","text":" includes two nested types, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/Percent"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/Currency"},{"type":"text","text":", for working with percentages and currencies, respectively. Each format style includes a configuration that determines how it represents numeric values, for things like grouping, displaying signs, and variant presentations like scientific notation. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/Percent"},{"type":"text","text":" include a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/NumberFormatStyleConfiguration"},{"type":"text","text":", and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/Currency"},{"type":"text","text":" includes a "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/CurrencyFormatStyleConfiguration","isActive":true},{"type":"text","text":". You can customize numeric formatting for a style by adjusting its backing configuration. The system automatically caches unique configurations of a format style to enhance performance."}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"Foundation provides another format style type, ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","type":"reference","isActive":true},{"text":", for working with numbers that conform to ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger","type":"text"},{"text":". For Foundation’s ","type":"text"},{"code":"Decimal","type":"codeVoice"},{"text":" type, use ","type":"text"},{"code":"Decimal\/FormatStyle","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"level":3,"type":"heading","anchor":"Formatting-floating-point-values","text":"Formatting floating-point values"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint\/formatted()"},{"type":"text","text":" method to create a string representation of a floating-point value using the default "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","isActive":true},{"type":"text","text":" configuration."}]},{"type":"codeListing","code":["let formattedDefault = 12345.67.formatted()","\/\/ formattedDefault is \"12,345.67\" in the en_US locale.","\/\/ Other locales may use different separator and grouping behavior."],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can specify a format style by providing an argument to the "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint\/formatted(_:)-4ksqj"},{"type":"text","text":" method. The following example shows the number "},{"type":"codeVoice","code":"0.1"},{"type":"text","text":" represented in each of the available styles, in the "},{"type":"codeVoice","code":"en_US"},{"type":"text","text":" locale:"}]},{"type":"codeListing","code":["let number = 0.1","","let formattedNumber = number.formatted(.number)","\/\/ formattedNumber is \"0.1\".","","let formattedPercent = number.formatted(.percent)","\/\/ formattedPercent is \"10%\".","","let formattedCurrency = number.formatted(.currency(code: \"USD\"))","\/\/ formattedCurrency is \"$0.10\"."],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each style provides methods for updating its numeric configuration, including the number of significant digits, grouping length, and more. You can specify a numeric configuration by calling as many of these methods as you need in any order you choose. The following example shows the same number with default and custom configurations:"}],"type":"paragraph"},{"type":"codeListing","code":["let exampleNumber = 123456.78","","let defaultFormatting = exampleNumber.formatted(.number)","\/\/ defaultFormatting is \"123 456,78\" for the \"fr_FR\" locale.","\/\/ defaultFormatting is \"123,456.78\" for the \"en_US\" locale.","","let customFormatting = exampleNumber.formatted(",".number",".grouping(.never)",".sign(strategy: .always()))","\/\/ customFormatting is \"+123456.78\""],"syntax":"swift"},{"anchor":"Creating-a-floating-point-format-style-instance","type":"heading","level":3,"text":"Creating a floating-point format style instance"},{"type":"paragraph","inlineContent":[{"text":"The previous examples use static factory methods like ","type":"text"},{"type":"codeVoice","code":"FormatStyle\/number-8c8rj"},{"text":" to create format styles within the call to the ","type":"text"},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint\/formatted(_:)-4ksqj"},{"text":" method. You can also create a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle"},{"text":" instance and use it to repeatedly format different values, with the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/format(_:)"},{"type":"text","text":" method:"}]},{"type":"codeListing","syntax":"swift","code":["let percentFormatStyle = FloatingPointFormatStyle<Double>.Percent()","","percentFormatStyle.format(0.5) \/\/ \"50%\"","percentFormatStyle.format(0.855) \/\/ \"85.5%\"","percentFormatStyle.format(1.0) \/\/ \"100%\"",""]},{"type":"heading","level":3,"anchor":"Parsing-floating-point-values","text":"Parsing floating-point values"},{"inlineContent":[{"type":"text","text":"You can use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle"},{"type":"text","text":" to parse strings into floating-point values. You can define the format style within the type’s initializer or pass in a format style created outside the function, as shown here:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let price = try? Double(\"$3,500.63\",","format: .currency(code: \"USD\")) \/\/ 3500.63","","let priceFormatStyle = FloatingPointFormatStyle<Double>.Currency(code: \"USD\")","let salePrice = try? Double(\"$731.67\",","format: priceFormatStyle) \/\/ 731.67"]},{"type":"heading","level":3,"anchor":"Matching-regular-expressions","text":"Matching regular expressions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Along with parsing numeric values in strings, you can use theSwift regular expression domain-specific language to match and capture numeric substrings. The following example defines a percentage format style to match a percentage value using "},{"type":"codeVoice","code":"en_US"},{"type":"text","text":" numeric conventions. The rest of the regular expression ignores any characters prior to a "},{"type":"codeVoice","code":"\": \""},{"type":"text","text":" sequence that precedes the percentage substring."}]},{"type":"codeListing","syntax":"swift","code":["import RegexBuilder","let source = \"Percentage complete: 55.1%\"","let matcher = Regex {","OneOrMore(.any)","\": \"","Capture {","One(.localizedDoublePercentage(locale: Locale(identifier: \"en_US\")))","}","}","let match = source.firstMatch(of: matcher)","let localizedPercentage = match?.1","print(\"\\(localizedPercentage!)\") \/\/ 0.551"]}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/Attributed-swift.struct","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/Currency","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/Percent"],"title":"Structures","anchor":"Structures","generated":true},{"identifiers":["doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/init(from:)","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/init(locale:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/attributed-swift.property","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/locale"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/FoundationInternatio