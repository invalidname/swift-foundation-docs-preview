nationalization\/FloatingPointFormatStyle\/FormatStyle-Implementations","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/ParseableFormatStyle-Implementations","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/RegexComponent-Implementations","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/RegexComponent-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationinternationalization\/floatingpointformatstyle"]}],"abstract":[{"type":"text","text":"A structure that converts between floating-point values and their textual representations."}],"hierarchy":{"paths":[["doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization"]]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FloatingPointFormatStyle","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"Value"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SB","text":"BinaryFloatingPoint","kind":"typeIdentifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Instances of "},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","type":"reference","isActive":true},{"type":"text","text":" create localized, human-readable text from "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint"},{"type":"text","text":" numbers and parse string representations of numbers into instances of "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint"},{"type":"text","text":" types. All of the Swift standard library’s floating-point types, such as "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/double"},{"type":"text","text":", "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/float"},{"type":"text","text":", and "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/float80"},{"type":"text","text":", conform to "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint"},{"type":"text","text":", and therefore work with this format style."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","type":"reference","isActive":true},{"type":"text","text":" includes two nested types, "},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/Percent","type":"reference","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/Currency","isActive":true},{"type":"text","text":", for working with percentages and currencies, respectively. Each format style includes a configuration that determines how it represents numeric values, for things like grouping, displaying signs, and variant presentations like scientific notation. "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/Percent","isActive":true},{"type":"text","text":" include a "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/NumberFormatStyleConfiguration","isActive":true},{"type":"text","text":", and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/Currency"},{"text":" includes a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/CurrencyFormatStyleConfiguration"},{"text":". You can customize numeric formatting for a style by adjusting its backing configuration. The system automatically caches unique configurations of a format style to enhance performance.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Foundation provides another format style type, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle"},{"text":", for working with numbers that conform to ","type":"text"},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger"},{"type":"text","text":". For Foundation’s "},{"type":"codeVoice","code":"Decimal"},{"type":"text","text":" type, use "},{"type":"codeVoice","code":"Decimal\/FormatStyle"},{"type":"text","text":"."}]}]},{"anchor":"Formatting-floating-point-values","level":3,"text":"Formatting floating-point values","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint\/formatted()","type":"text"},{"text":" method to create a string representation of a floating-point value using the default ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle"},{"text":" configuration.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let formattedDefault = 12345.67.formatted()","\/\/ formattedDefault is \"12,345.67\" in the en_US locale.","\/\/ Other locales may use different separator and grouping behavior."]},{"inlineContent":[{"text":"You can specify a format style by providing an argument to the ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint\/formatted(_:)-4ksqj","type":"text"},{"type":"text","text":" method. The following example shows the number "},{"type":"codeVoice","code":"0.1"},{"text":" represented in each of the available styles, in the ","type":"text"},{"type":"codeVoice","code":"en_US"},{"text":" locale:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let number = 0.1","","let formattedNumber = number.formatted(.number)","\/\/ formattedNumber is \"0.1\".","","let formattedPercent = number.formatted(.percent)","\/\/ formattedPercent is \"10%\".","","let formattedCurrency = number.formatted(.currency(code: \"USD\"))","\/\/ formattedCurrency is \"$0.10\"."],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each style provides methods for updating its numeric configuration, including the number of significant digits, grouping length, and more. You can specify a numeric configuration by calling as many of these methods as you need in any order you choose. The following example shows the same number with default and custom configurations:"}]},{"type":"codeListing","syntax":"swift","code":["let exampleNumber = 123456.78","","let defaultFormatting = exampleNumber.formatted(.number)","\/\/ defaultFormatting is \"123 456,78\" for the \"fr_FR\" locale.","\/\/ defaultFormatting is \"123,456.78\" for the \"en_US\" locale.","","let customFormatting = exampleNumber.formatted(",".number",".grouping(.never)",".sign(strategy: .always()))","\/\/ customFormatting is \"+123456.78\""]},{"type":"heading","level":3,"text":"Creating a floating-point format style instance","anchor":"Creating-a-floating-point-format-style-instance"},{"type":"paragraph","inlineContent":[{"text":"The previous examples use static factory methods like ","type":"text"},{"code":"FormatStyle\/number-8c8rj","type":"codeVoice"},{"text":" to create format styles within the call to the ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint\/formatted(_:)-4ksqj","type":"text"},{"text":" method. You can also create a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle"},{"type":"text","text":" instance and use it to repeatedly format different values, with the "},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle\/format(_:)","type":"reference","isActive":true},{"type":"text","text":" method:"}]},{"code":["let percentFormatStyle = FloatingPointFormatStyle<Double>.Percent()","","percentFormatStyle.format(0.5) \/\/ \"50%\"","percentFormatStyle.format(0.855) \/\/ \"85.5%\"","percentFormatStyle.format(1.0) \/\/ \"100%\"",""],"syntax":"swift","type":"codeListing"},{"type":"heading","level":3,"text":"Parsing floating-point values","anchor":"Parsing-floating-point-values"},{"type":"paragraph","inlineContent":[{"text":"You can use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle"},{"text":" to parse strings into floating-point values. You can define the format style within the type’s initializer or pass in a format style created outside the function, as shown here:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let price = try? Double(\"$3,500.63\",","format: .currency(code: \"USD\")) \/\/ 3500.63","","let priceFormatStyle = FloatingPointFormatStyle<Double>.Currency(code: \"USD\")","let salePrice = try? Double(\"$731.67\",","format: priceFormatStyle) \/\/ 731.67"]},{"anchor":"Matching-regular-expressions","type":"heading","text":"Matching regular expressions","level":3},{"inlineContent":[{"text":"Along with parsing numeric values in strings, you can use theSwift regular expression domain-specific language to match and capture numeric substrings. The following example defines a percentage format style to match a percentage value using ","type":"text"},{"type":"codeVoice","code":"en_US"},{"type":"text","text":" numeric conventions. The rest of the regular expression ignores any characters prior to a "},{"type":"codeVoice","code":"\": \""},{"type":"text","text":" sequence that precedes the percentage substring."}],"type":"paragraph"},{"type":"codeListing","code":["import RegexBuilder","let source = \"Percentage complete: 55.1%\"","let matcher = Regex {","OneOrMore(.any)","\": \"","Capture {","One(.localizedDoublePercentage(locale: Locale(identifier: \"en_US\")))","}","}","let match = source.firstMatch(of: matcher)","let localizedPercentage = match?.1","print(\"\\(localizedPercentage!)\") \/\/ 0.551"],"syntax":"swift"}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/FoundationInternationalization\/20FoundationEssentials11FormatStyleP","doc:\/\/FoundationInternationalization\/20FoundationEssentials20ParseableFormatStyleP","doc:\/\/FoundationInternationalization\/s8CopyableP","doc:\/\/FoundationInternationaliz