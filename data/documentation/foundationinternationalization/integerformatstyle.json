xt":" ","kind":"text"},{"text":"IntegerFormatStyle","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","kind":"typeIdentifier","preciseIdentifier":"s:Sz"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Instances of "},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","isActive":true,"type":"reference"},{"type":"text","text":" create localized, human-readable text from "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger"},{"type":"text","text":" numbers and parse string representations of numbers into instances of "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger"},{"type":"text","text":" types. All of the Swift standard library’s integer types, such as "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/int"},{"type":"text","text":" and "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/uint32"},{"type":"text","text":", conform to "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger"},{"type":"text","text":", and therefore work with this format style."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","isActive":true,"type":"reference"},{"type":"text","text":" includes two nested types, "},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Percent","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Currency","isActive":true,"type":"reference"},{"type":"text","text":", for working with percentages and currencies. Each format style includes a configuration that determines how it represents numeric values, for things like grouping, displaying signs, and variant presentations like scientific notation. "},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Percent","isActive":true,"type":"reference"},{"type":"text","text":" include a "},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/NumberFormatStyleConfiguration","isActive":true,"type":"reference"},{"type":"text","text":", and "},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Currency","isActive":true,"type":"reference"},{"type":"text","text":" includes a "},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/CurrencyFormatStyleConfiguration","isActive":true,"type":"reference"},{"type":"text","text":". You can customize numeric formatting for a style by adjusting its backing configuration. The system automatically caches unique configurations of a format style to enhance performance."}]},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"Foundation provides another format style type, ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","type":"reference","isActive":true},{"text":", for working with numbers that conform to ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint","type":"text"},{"text":". For Foundation’s ","type":"text"},{"code":"Decimal","type":"codeVoice"},{"text":" type, use ","type":"text"},{"code":"Decimal\/FormatStyle","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"level":3,"type":"heading","anchor":"Formatting-integers","text":"Formatting integers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger\/formatted()"},{"type":"text","text":" method to create a string representation of an integer using the default "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle"},{"type":"text","text":" configuration."}]},{"type":"codeListing","syntax":"swift","code":["let formattedDefault = 123456.formatted()","\/\/ formattedDefault is \"123,456\" in en_US locale.","\/\/ Other locales may use different separator and grouping behavior."]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can specify a format style by providing an argument to the "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger\/formatted(_:)-73k3e"},{"type":"text","text":" method. The following example shows the number "},{"code":"12345","type":"codeVoice"},{"type":"text","text":" represented in each of the available styles, in the "},{"code":"en_US","type":"codeVoice"},{"type":"text","text":" locale:"}]},{"type":"codeListing","syntax":"swift","code":["let number = 123456","","let formattedNumber = number.formatted(.number)","\/\/ formattedNumber is \"123,456\".","","let formattedPercent = number.formatted(.percent)","\/\/ formattedPercent is \"123,456%\".","","let formattedCurrency = number.formatted(.currency(code: \"USD\"))","\/\/ formattedCurrency is \"$123,456.00\"."]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each style provides methods for updating its numeric configuration, including the number of significant digits, grouping length, and more. You can specify a numeric configuration by calling as many of these methods as you need in any order you choose. The following example shows the same number with default and custom configurations:"}]},{"type":"codeListing","syntax":"swift","code":["let exampleNumber = 123456","","let defaultFormatting = exampleNumber.formatted(.number)","\/\/ defaultFormatting is \"125 000\" for the \"fr_FR\" locale","\/\/ defaultFormatting is \"125000\" for the \"jp_JP\" locale","\/\/ defaultFormatting is \"125,000\" for the \"en_US\" locale","","let customFormatting = exampleNumber.formatted(",".number",".grouping(.never)",".sign(strategy: .always()))","\/\/ customFormatting is \"+123456\""]},{"level":3,"type":"heading","anchor":"Creating-an-integer-format-style-instance","text":"Creating an integer format style instance"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The previous examples use static factory methods like "},{"code":"FormatStyle\/number-7fxvo","type":"codeVoice"},{"type":"text","text":" to create format styles within the call to the "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger\/formatted(_:)-73k3e"},{"type":"text","text":" method. You can also create an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle"},{"type":"text","text":" instance and use it to repeatedly format different values with the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/format(_:)"},{"type":"text","text":" method:"}]},{"type":"codeListing","syntax":"swift","code":["let percentFormatStyle = IntegerFormatStyle<Int>.Percent()","","percentFormatStyle.format(50) \/\/ \"50%\"","percentFormatStyle.format(85) \/\/ \"85%\"","percentFormatStyle.format(100) \/\/ \"100%\""]},{"level":3,"type":"heading","anchor":"Parsing-integers","text":"Parsing integers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle"},{"type":"text","text":" to parse strings into integer values. You can define the format style within the type’s initializer or pass in a format style you create prior to calling the method, as shown here:"}]},{"type":"codeListing","syntax":"swift","code":["let price = try? Int(\"$123,456\",","format: .currency(code: \"USD\")) \/\/ 123456","","let priceFormatStyle = IntegerFormatStyle<Int>.Currency(code: \"USD\")","let salePrice = try? Int(\"$120,000\",","format: priceFormatStyle) \/\/ 120000"]},{"level":3,"type":"heading","anchor":"Matching-regular-expressions","text":"Matching regular expressions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Along with parsing numeric values in strings, you can use the Swift regular expression domain-specific language to match and capture numeric substrings. The following example defines a currency format style to match and capture a currency value using US dollars and "},{"code":"en_US","type":"codeVoice"},{"type":"text","text":" numeric conventions. The rest of the regular expression ignores any characters prior to a "},{"code":"\": \"","type":"codeVoice"},{"type":"text","text":" sequence that precedes the currency substring."}]},{"type":"codeListing","syntax":"swift","code":["import RegexBuilder","","let source = \"Payment due: $123,456\"","let matcher = Regex {","OneOrMore(.any)","\": \"","Capture {","One(.localizedIntegerCurrency(code: Locale.Currency(\"USD\"),","locale: Locale(identifier: \"en_US\")))","}","}","let match = source.firstMatch(of: matcher)","let localizedInteger = match?.1 \/\/ 123456"]}],"kind":"content"}],"references":{"doc://FoundationInternationalization/documentation/FoundationInternationalization/IntegerFormatStyle/notation(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notation","kind":"identifier"},{"text":"(","kind":"text"},{"text":"IntegerFormatStyle","kind":"typeIdentifier","preciseIdentifier":"s:30FoundationInternationalization18IntegerFormatStyleV"},{"text":"<","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Configuration","kind":"typeIdentifier","preciseIdentifier":"s:30FoundationInternationalization18IntegerFormatStyleV13Configurationa"},{"text":".","kind":"text"},{"text":"Notation","kind":"typeIdentifier","preciseIdentifier":"s:30FoundationInternationalization30NumberFormatStyleConfigurationO8NotationV"},{"text":") -> ","kind":"text"},{"text":"IntegerFormatStyle","kind":"typeIdentifier","preciseIdentifier":"s:30FoundationInternationalization18IntegerFormatStyleV"},{"text":"<","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/notation(_:)","url":"\/documentation\/foundationinternationalization\/integerformatstyle\/notation(_:)","abstract":[{"type":"text","text":"Modifies the format style to use the specified notation."}],"type":"topic","kind":"symbol","title":"notation(_:)"},"doc://FoundationInternationalization/documentation/FoundationInternationalization/IntegerFormatStyle/Percent":{"url":"\/documentation\/foundationinternationalization\/integerformatstyle\/percent","kind":"symbol","navigatorTitle":[{"text":"Percent","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Percen