undationInternationalization\/20FoundationEssentials20ParseableFormatStyleP","doc:\/\/FoundationInternationalization\/s8CopyableP","doc:\/\/FoundationInternationalization\/Se","doc:\/\/FoundationInternationalization\/SE","doc:\/\/FoundationInternationalization\/SQ","doc:\/\/FoundationInternationalization\/s9EscapableP","doc:\/\/FoundationInternationalization\/SH","doc:\/\/FoundationInternationalization\/s8SendableP","doc:\/\/FoundationInternationalization\/s16SendableMetatypeP","doc:\/\/FoundationInternationalization\/17_StringProcessing29CustomConsumingRegexComponentP","doc:\/\/FoundationInternationalization\/17_StringProcessing14RegexComponentP"],"title":"Conforms To","type":"conformsTo"}],"metadata":{"title":"IntegerFormatStyle","externalID":"s:30FoundationInternationalization18IntegerFormatStyleV","modules":[{"name":"FoundationInternationalization"}],"navigatorTitle":[{"kind":"identifier","text":"IntegerFormatStyle"}],"roleHeading":"Structure","platforms":[{"beta":false,"introducedAt":"15.0","deprecated":false,"name":"iOS","unavailable":false},{"beta":false,"introducedAt":"15.0","deprecated":false,"name":"iPadOS","unavailable":false},{"beta":false,"introducedAt":"15.0","deprecated":false,"name":"Mac Catalyst","unavailable":false},{"beta":false,"introducedAt":"12.0","deprecated":false,"name":"macOS","unavailable":false},{"beta":false,"introducedAt":"15.0","deprecated":false,"name":"tvOS","unavailable":false},{"beta":false,"introducedAt":"8.0","deprecated":false,"name":"watchOS","unavailable":false}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IntegerFormatStyle"}],"symbolKind":"struct","role":"symbol"},"abstract":[{"type":"text","text":"A structure that converts between integer values and their textual representations."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IntegerFormatStyle","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sz","text":"BinaryInteger","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"Instances of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle"},{"type":"text","text":" create localized, human-readable text from "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger"},{"type":"text","text":" numbers and parse string representations of numbers into instances of "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger"},{"type":"text","text":" types. All of the Swift standard library’s integer types, such as "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/int"},{"type":"text","text":" and "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/uint32"},{"type":"text","text":", conform to "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger"},{"type":"text","text":", and therefore work with this format style."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle"},{"type":"text","text":" includes two nested types, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Percent"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Currency"},{"type":"text","text":", for working with percentages and currencies. Each format style includes a configuration that determines how it represents numeric values, for things like grouping, displaying signs, and variant presentations like scientific notation. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Percent"},{"type":"text","text":" include a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/NumberFormatStyleConfiguration"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Currency"},{"type":"text","text":" includes a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/CurrencyFormatStyleConfiguration"},{"type":"text","text":". You can customize numeric formatting for a style by adjusting its backing configuration. The system automatically caches unique configurations of a format style to enhance performance."}],"type":"paragraph"},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"Foundation provides another format style type, "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","isActive":true},{"type":"text","text":", for working with numbers that conform to "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint"},{"type":"text","text":". For Foundation’s "},{"type":"codeVoice","code":"Decimal"},{"type":"text","text":" type, use "},{"type":"codeVoice","code":"Decimal\/FormatStyle"},{"type":"text","text":"."}]}]},{"anchor":"Formatting-integers","type":"heading","text":"Formatting integers","level":3},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger\/formatted()"},{"type":"text","text":" method to create a string representation of an integer using the default "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","isActive":true},{"type":"text","text":" configuration."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let formattedDefault = 123456.formatted()","\/\/ formattedDefault is \"123,456\" in en_US locale.","\/\/ Other locales may use different separator and grouping behavior."]},{"inlineContent":[{"type":"text","text":"You can specify a format style by providing an argument to the "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger\/formatted(_:)-73k3e"},{"type":"text","text":" method. The following example shows the number "},{"type":"codeVoice","code":"12345"},{"type":"text","text":" represented in each of the available styles, in the "},{"type":"codeVoice","code":"en_US"},{"type":"text","text":" locale:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let number = 123456","","let formattedNumber = number.formatted(.number)","\/\/ formattedNumber is \"123,456\".","","let formattedPercent = number.formatted(.percent)","\/\/ formattedPercent is \"123,456%\".","","let formattedCurrency = number.formatted(.currency(code: \"USD\"))","\/\/ formattedCurrency is \"$123,456.00\"."]},{"inlineContent":[{"type":"text","text":"Each style provides methods for updating its numeric configuration, including the number of significant digits, grouping length, and more. You can specify a numeric configuration by calling as many of these methods as you need in any order you choose. The following example shows the same number with default and custom configurations:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let exampleNumber = 123456","","let defaultFormatting = exampleNumber.formatted(.number)","\/\/ defaultFormatting is \"125 000\" for the \"fr_FR\" locale","\/\/ defaultFormatting is \"125000\" for the \"jp_JP\" locale","\/\/ defaultFormatting is \"125,000\" for the \"en_US\" locale","","let customFormatting = exampleNumber.formatted(",".number",".grouping(.never)",".sign(strategy: .always()))","\/\/ customFormatting is \"+123456\""]},{"anchor":"Creating-an-integer-format-style-instance","type":"heading","text":"Creating an integer format style instance","level":3},{"inlineContent":[{"type":"text","text":"The previous examples use static factory methods like "},{"type":"codeVoice","code":"FormatStyle\/number-7fxvo"},{"type":"text","text":" to create format styles within the call to the "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger\/formatted(_:)-73k3e"},{"type":"text","text":" method. You can also create an "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","isActive":true},{"type":"text","text":" instance and use it to repeatedly format different values with the "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/format(_:)","isActive":true},{"type":"text","text":" method:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let percentFormatStyle = IntegerFormatStyle<Int>.Percent()","","percentFormatStyle.format(50) \/\/ \"50%\"","percentFormatStyle.format(85) \/\/ \"85%\"","percentFormatStyle.format(100) \/\/ \"100%\""]},{"anchor":"Parsing-integers","type":"heading","text":"Parsing integers","level":3},{"inlineContent":[{"type":"text","text":"You can use "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","isActive":true},{"type":"text","text":" to parse strings into integer values. You can define the format style within the type’s initializer or pass in a format style you create prior to calling the method, as shown here:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let price = try? Int(\"$123,456\",","format: .currency(code: \"USD\")) \/\/ 123456","","let priceFormatStyle = IntegerFormatStyle<Int>.Currency(code: \"USD\")","let salePrice = try? Int(\"$120,000\",","format: priceFormatStyle) \/\/ 120000"]},{"anchor":"Matching-regular-expressions","type":"heading","text":"Matching regular expressions","level":3},{"inlineContent":[{"type":"text","text":"Along with parsing numeric values in strings, you can use the Swift regular expression domain-specific language to match and capture numeric substrings. The following example defines a currency format style to match and capture a currency value using US dollars and "},{"type":"codeVoice","code":"en_US"},{"type":"text","text":" numeric conventions. The rest of the regular expression ignores any characters prior to a "},{"type":"codeVoice","code":"\": \""},{"type":"text","text":" sequence that precedes the currency substring."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import RegexBuilder","","let source = \"Payment due: $123,456\"","let matcher = Regex {","OneOrMore(.any)","\": \"","Capture {","One(.localizedIntegerCurrency(code: Locale.Currency(\"USD\"),","locale: Locale(identifier: \"en_US\")))","}","}","let match = source.firstMatch(of: matcher)","let localizedInteger = match?.1 \/\/ 123456"]}]}],"references":{"doc://FoundationInternationalization/documentation/FoundationInternationalization/IntegerFormatStyle/FormatStyle-Implementations":{"url":"\/documentation\/foundationinternationalization\/integerformatstyle\/formatstyle-implementations","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/FormatStyle-Implementations","role":"collectionGroup","type":"topic","kind":"article","abstract":[],"title":"FormatStyle Implementations"},"doc://FoundationInternationalization/documentation/FoundationInternationalization/IntegerFormatStyle/locale":{"url":"\/documentation\/foundationinternationalization\/integerformatstyle\/locale","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/locale","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"locale","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials6LocaleV","text":"Locale","kind":"typeIdentifier"}],"abstract":[{"text":"The locale of the format style.","type":"text"}],"title":"locale"},"doc://FoundationInternationalization/documentation/FoundationInternationalization/IntegerFormatStyle/notation(_:)":{"url":"\/documentation\/foundationinternationalization\/integerformatstyle\/notation(_:)","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/notation(_:)","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notation","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:30FoundationInternationalization18IntegerFormatStyleV","text":"IntegerFormatStyle","kind":"typeIdentifier"},{"text":"