le","kind":"identifier"}],"modules":[{"name":"FoundationInternationalization"}],"externalID":"s:30FoundationInternationalization18IntegerFormatStyleV","platforms":[{"deprecated":false,"introducedAt":"15.0","beta":false,"name":"iOS","unavailable":false},{"deprecated":false,"introducedAt":"15.0","beta":false,"name":"iPadOS","unavailable":false},{"deprecated":false,"introducedAt":"15.0","beta":false,"name":"Mac Catalyst","unavailable":false},{"deprecated":false,"introducedAt":"12.0","beta":false,"name":"macOS","unavailable":false},{"deprecated":false,"introducedAt":"15.0","beta":false,"name":"tvOS","unavailable":false},{"deprecated":false,"unavailable":false,"beta":false,"name":"watchOS","introducedAt":"8.0"}],"title":"IntegerFormatStyle","navigatorTitle":[{"text":"IntegerFormatStyle","kind":"identifier"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization"]]},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/FoundationInternationalization\/20FoundationEssentials11FormatStyleP","doc:\/\/FoundationInternationalization\/20FoundationEssentials20ParseableFormatStyleP","doc:\/\/FoundationInternationalization\/s8CopyableP","doc:\/\/FoundationInternationalization\/Se","doc:\/\/FoundationInternationalization\/SE","doc:\/\/FoundationInternationalization\/SQ","doc:\/\/FoundationInternationalization\/s9EscapableP","doc:\/\/FoundationInternationalization\/SH","doc:\/\/FoundationInternationalization\/s8SendableP","doc:\/\/FoundationInternationalization\/s16SendableMetatypeP","doc:\/\/FoundationInternationalization\/17_StringProcessing29CustomConsumingRegexComponentP","doc:\/\/FoundationInternationalization\/17_StringProcessing14RegexComponentP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IntegerFormatStyle","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","kind":"typeIdentifier","preciseIdentifier":"s:Sz"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"Instances of ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","type":"reference","isActive":true},{"text":" create localized, human-readable text from ","type":"text"},{"code":"BinaryInteger","type":"codeVoice"},{"text":" numbers and parse string representations of numbers into instances of ","type":"text"},{"code":"BinaryInteger","type":"codeVoice"},{"text":" types. All of the Swift standard library’s integer types, such as ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"UInt32","type":"codeVoice"},{"text":", conform to ","type":"text"},{"code":"BinaryInteger","type":"codeVoice"},{"text":", and therefore work with this format style.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","type":"reference","isActive":true},{"text":" includes two nested types, ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Percent","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Currency","type":"reference","isActive":true},{"text":", for working with percentages and currencies. Each format style includes a configuration that determines how it represents numeric values, for things like grouping, displaying signs, and variant presentations like scientific notation. ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Percent","type":"reference","isActive":true},{"text":" include a ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/NumberFormatStyleConfiguration","type":"reference","isActive":true},{"text":", and ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Currency","type":"reference","isActive":true},{"text":" includes a ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/CurrencyFormatStyleConfiguration","type":"reference","isActive":true},{"text":". You can customize numeric formatting for a style by adjusting its backing configuration. The system automatically caches unique configurations of a format style to enhance performance.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"Foundation provides another format style type, ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","isActive":true},{"text":", for working with numbers that conform to ","type":"text"},{"code":"BinaryFloatingPoint","type":"codeVoice"},{"text":". For Foundation’s ","type":"text"},{"code":"Decimal","type":"codeVoice"},{"text":" type, use ","type":"text"},{"code":"Decimal.FormatStyle","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"anchor":"Formatting-integers","level":3,"type":"heading","text":"Formatting integers"},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":"BinaryInteger.formatted()","type":"codeVoice"},{"text":" method to create a string representation of an integer using the default ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","type":"reference","isActive":true},{"text":" configuration.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let formattedDefault = 123456.formatted()","\/\/ formattedDefault is \"123,456\" in en_US locale.","\/\/ Other locales may use different separator and grouping behavior."],"syntax":"swift"},{"inlineContent":[{"text":"You can specify a format style by providing an argument to the ","type":"text"},{"code":"BinaryInteger.formatted(_:)","type":"codeVoice"},{"text":" method. The following example shows the number ","type":"text"},{"code":"12345","type":"codeVoice"},{"text":" represented in each of the available styles, in the ","type":"text"},{"code":"en_US","type":"codeVoice"},{"text":" locale:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let number = 123456","","let formattedNumber = number.formatted(.number)","\/\/ formattedNumber is \"123,456\".","","let formattedPercent = number.formatted(.percent)","\/\/ formattedPercent is \"123,456%\".","","let formattedCurrency = number.formatted(.currency(code: \"USD\"))","\/\/ formattedCurrency is \"$123,456.00\"."],"syntax":"swift"},{"inlineContent":[{"text":"Each style provides methods for updating its numeric configuration, including the number of significant digits, grouping length, and more. You can specify a numeric configuration by calling as many of these methods as you need in any order you choose. The following example shows the same number with default and custom configurations:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let exampleNumber = 123456","","let defaultFormatting = exampleNumber.formatted(.number)","\/\/ defaultFormatting is \"125 000\" for the \"fr_FR\" locale","\/\/ defaultFormatting is \"125000\" for the \"jp_JP\" locale","\/\/ defaultFormatting is \"125,000\" for the \"en_US\" locale","","let customFormatting = exampleNumber.formatted(",".number",".grouping(.never)",".sign(strategy: .always()))","\/\/ customFormatting is \"+123456\""],"syntax":"swift"},{"anchor":"Creating-an-integer-format-style-instance","level":3,"type":"heading","text":"Creating an integer format style instance"},{"inlineContent":[{"text":"The previous examples use static factory methods like ","type":"text"},{"code":"FormatStyle.number","type":"codeVoice"},{"text":" to create format styles within the call to the ","type":"text"},{"code":"BinaryInteger.formatted()","type":"codeVoice"},{"text":" method. You can also create an ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","type":"reference","isActive":true},{"text":" instance and use it to repeatedly format different values with the ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/format(_:)","type":"reference","isActive":true},{"text":" method:","type":"text"}],"type":"paragraph"},{"code":["let percentFormatStyle = IntegerFormatStyle<Int>.Percent()","","percentFormatStyle.format(50) \/\/ \"50%\"","percentFormatStyle.format(85) \/\/ \"85%\"","percentFormatStyle.format(100) \/\/ \"100%\""],"syntax":"swift","type":"codeListing"},{"anchor":"Parsing-integers","text":"Parsing integers","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"You can use ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","isActive":true,"type":"reference"},{"text":" to parse strings into integer values. You can define the format style within the type’s initializer or pass in a format style you create prior to calling the method, as shown here:","type":"text"}]},{"code":["let price = try? Int(\"$123,456\",","format: .currency(code: \"USD\")) \/\/ 123456","","let priceFormatStyle = IntegerFormatStyle<Int>.Currency(code: \"USD\")","let salePrice = try? Int(\"$120,000\",","format: priceFormatStyle) \/\/ 120000"],"syntax":"swift","type":"codeListing"},{"anchor":"Matching-regular-expressions","text":"Matching regular expressions","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Along with parsing numeric values in strings, you can use the Swift regular expression domain-specific language to match and capture numeric substrings. The following example defines a currency format style to match and capture a currency value using US dollars and ","type":"text"},{"code":"en_US","type":"codeVoice"},{"text":" numeric conventions. The rest of the regular expression ignores any characters prior to a ","type":"text"},{"code":"\": \"","type":"codeVoice"},{"text":" sequence that precedes the currency substring.","type":"text"}]},{"code":["import RegexBuilder","","let source = \"Payment due: $123,456\"","let matcher = Regex {","OneOrMore(.any)","\": \"","Capture {","One(.localizedIntegerCurrency(code: Locale.Currency(\"USD\"),","locale: Locale(identifier: \"en_US\")))","}","}","let match = source.firstMatch(of: matcher)","let localizedInteger = match?.1 \/\/ 123456"],"syntax":"swift","type":"codeListing"}]}],"references":{"doc://FoundationInternationalization/documentation/FoundationInternationalization/IntegerFormatStyle/notation(_:)":{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/notation(_:)","url":"\/documentation\/foundationinternationalization\/integerformatstyle\/notation(