{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationinternationalization\/integerformatstyle"]}],"sections":[],"identifier":{"url":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","interfaceLanguage":"swift"},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/FoundationInternationalization\/20FoundationEssentials11FormatStyleP","doc:\/\/FoundationInternationalization\/20FoundationEssentials20ParseableFormatStyleP","doc:\/\/FoundationInternationalization\/s8CopyableP","doc:\/\/FoundationInternationalization\/Se","doc:\/\/FoundationInternationalization\/SE","doc:\/\/FoundationInternationalization\/SQ","doc:\/\/FoundationInternationalization\/s9EscapableP","doc:\/\/FoundationInternationalization\/SH","doc:\/\/FoundationInternationalization\/s8SendableP","doc:\/\/FoundationInternationalization\/s16SendableMetatypeP","doc:\/\/FoundationInternationalization\/17_StringProcessing29CustomConsumingRegexComponentP","doc:\/\/FoundationInternationalization\/17_StringProcessing14RegexComponentP"],"title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IntegerFormatStyle"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Sz","kind":"typeIdentifier","text":"BinaryInteger"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Instances of ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","isActive":true,"type":"reference"},{"text":" create localized, human-readable text from ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger","type":"text"},{"text":" numbers and parse string representations of numbers into instances of ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger","type":"text"},{"text":" types. All of the Swift standard library’s integer types, such as ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/swift\/int","type":"text"},{"text":" and ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/swift\/uint32","type":"text"},{"text":", conform to ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger","type":"text"},{"text":", and therefore work with this format style.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","isActive":true,"type":"reference"},{"text":" includes two nested types, ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Percent","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Currency","isActive":true,"type":"reference"},{"text":", for working with percentages and currencies. Each format style includes a configuration that determines how it represents numeric values, for things like grouping, displaying signs, and variant presentations like scientific notation. ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Percent","isActive":true,"type":"reference"},{"text":" include a ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/NumberFormatStyleConfiguration","isActive":true,"type":"reference"},{"text":", and ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Currency","isActive":true,"type":"reference"},{"text":" includes a ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/CurrencyFormatStyleConfiguration","isActive":true,"type":"reference"},{"text":". You can customize numeric formatting for a style by adjusting its backing configuration. The system automatically caches unique configurations of a format style to enhance performance.","type":"text"}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"Foundation provides another format style type, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","type":"reference"},{"text":", for working with numbers that conform to ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint","type":"text"},{"text":". For Foundation’s ","type":"text"},{"code":"Decimal","type":"codeVoice"},{"text":" type, use ","type":"text"},{"code":"Decimal\/FormatStyle","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"type":"heading","text":"Formatting integers","anchor":"Formatting-integers","level":3},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger\/formatted()","type":"text"},{"text":" method to create a string representation of an integer using the default ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","isActive":true,"type":"reference"},{"text":" configuration.","type":"text"}]},{"type":"codeListing","code":["let formattedDefault = 123456.formatted()","\/\/ formattedDefault is \"123,456\" in en_US locale.","\/\/ Other locales may use different separator and grouping behavior."],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"You can specify a format style by providing an argument to the ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger\/formatted(_:)-73k3e","type":"text"},{"text":" method. The following example shows the number ","type":"text"},{"code":"12345","type":"codeVoice"},{"text":" represented in each of the available styles, in the ","type":"text"},{"code":"en_US","type":"codeVoice"},{"text":" locale:","type":"text"}]},{"type":"codeListing","code":["let number = 123456","","let formattedNumber = number.formatted(.number)","\/\/ formattedNumber is \"123,456\".","","let formattedPercent = number.formatted(.percent)","\/\/ formattedPercent is \"123,456%\".","","let formattedCurrency = number.formatted(.currency(code: \"USD\"))","\/\/ formattedCurrency is \"$123,456.00\"."],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Each style provides methods for updating its numeric configuration, including the number of significant digits, grouping length, and more. You can specify a numeric configuration by calling as many of these methods as you need in any order you choose. The following example shows the same number with default and custom configurations:","type":"text"}]},{"type":"codeListing","code":["let exampleNumber = 123456","","let defaultFormatting = exampleNumber.formatted(.number)","\/\/ defaultFormatting is \"125 000\" for the \"fr_FR\" locale","\/\/ defaultFormatting is \"125000\" for the \"jp_JP\" locale","\/\/ defaultFormatting is \"125,000\" for the \"en_US\" locale","","let customFormatting = exampleNumber.formatted(",".number",".grouping(.never)",".sign(strategy: .always()))","\/\/ customFormatting is \"+123456\""],"syntax":"swift"},{"type":"heading","text":"Creating an integer format style instance","anchor":"Creating-an-integer-format-style-instance","level":3},{"type":"paragraph","inlineContent":[{"text":"The previous examples use static factory methods like ","type":"text"},{"code":"FormatStyle\/number-7fxvo","type":"codeVoice"},{"type":"text","text":" to create format styles within the call to the "},{"text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger\/formatted(_:)-73k3e","type":"text"},{"text":" method. You can also create an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","type":"reference"},{"text":" instance and use it to repeatedly format different values with the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/format(_:)","type":"reference"},{"text":" method:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let percentFormatStyle = IntegerFormatStyle<Int>.Percent()","","percentFormatStyle.format(50) \/\/ \"50%\"","percentFormatStyle.format(85) \/\/ \"85%\"","percentFormatStyle.format(100) \/\/ \"100%\""]},{"type":"heading","text":"Parsing integers","anchor":"Parsing-integers","level":3},{"type":"paragraph","inlineContent":[{"text":"You can use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","type":"reference"},{"text":" to parse strings into integer values. You can define the format style within the type’s initializer or pass in a format style you create prior to calling the method, as shown here:","type":"text"}]},{"type":"codeListing","code":["let price = try? Int(\"$123,456\",","format: .currency(code: \"USD\")) \/\/ 123456","","let priceFormatStyle = IntegerFormatStyle<Int>.Currency(code: \"USD\")","let salePrice = try? Int(\"$120,000\",","format: priceFormatStyle) \/\/ 120000"],"syntax":"swift"},{"type":"heading","text":"Matching regular expressions","anchor":"Matching-regular-expressions","level":3},{"type":"paragraph","inlineContent":[{"text":"Along with parsing numeric values in strings, you can use the Swift regular expression domain-specific language to match and capture numeric substrings. The following example defines a currency format style to match and capture a currency value using US dollars and ","type":"text"},{"type":"codeVoice","code":"en_US"},{"text":" numeric conventions. The rest of the regular expression ignores any characters prior to a ","type":"text"},{"type":"codeVoice","code":"\": \""},{"text":" sequence that precedes the currency substring.","type":"text"}]},{"type":"codeListing","code":["import RegexBuilder","","let source = \"Payment due: $123,456\"","let matcher = Regex {","OneOrMore(.any)","\": \"","Capture {","One(.localizedIntegerCurrency(code: Locale.Currency(\"USD\"),","locale: Locale(identifier: \"en_US\")))","}","}","let match = source.firstMatch(of: matcher)","let localizedInteger = match?.1 \/\/ 123456"],"syntax":"swift"}],"kind":"content"}],"metadata":{"externalID":"s:30FoundationInternationalization18IntegerFormatStyleV","symbolKind":"struct","title":"IntegerFormatStyle","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IntegerFormatStyle"}],"modules":[{"name":"FoundationInternationalization"}],"role":"symbol","platforms":[{"introducedAt":"15.0","name":"iOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"15.0","name":"iPadOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"15.0","na