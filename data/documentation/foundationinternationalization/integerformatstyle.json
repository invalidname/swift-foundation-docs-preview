"BinaryInteger","kind":"typeIdentifier","preciseIdentifier":"s:Sz"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Instances of "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","isActive":true},{"type":"text","text":" create localized, human-readable text from "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger"},{"type":"text","text":" numbers and parse string representations of numbers into instances of "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger"},{"type":"text","text":" types. All of the Swift standard library’s integer types, such as "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/int"},{"type":"text","text":" and "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/uint32"},{"text":", conform to ","type":"text"},{"text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger","type":"text"},{"text":", and therefore work with this format style.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle"},{"text":" includes two nested types, ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Percent"},{"text":" and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Currency"},{"text":", for working with percentages and currencies. Each format style includes a configuration that determines how it represents numeric values, for things like grouping, displaying signs, and variant presentations like scientific notation. ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Percent"},{"type":"text","text":" include a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/NumberFormatStyleConfiguration"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/Currency"},{"text":" includes a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/CurrencyFormatStyleConfiguration"},{"type":"text","text":". You can customize numeric formatting for a style by adjusting its backing configuration. The system automatically caches unique configurations of a format style to enhance performance."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"text","text":" "},{"text":"Foundation provides another format style type, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FloatingPointFormatStyle","type":"reference"},{"type":"text","text":", for working with numbers that conform to "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryfloatingpoint"},{"type":"text","text":". For Foundation’s "},{"type":"codeVoice","code":"Decimal"},{"text":" type, use ","type":"text"},{"type":"codeVoice","code":"Decimal\/FormatStyle"},{"text":".","type":"text"}]}],"type":"aside","name":"Note"},{"level":3,"anchor":"Formatting-integers","type":"heading","text":"Formatting integers"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger\/formatted()"},{"type":"text","text":" method to create a string representation of an integer using the default "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","isActive":true},{"type":"text","text":" configuration."}]},{"code":["let formattedDefault = 123456.formatted()","\/\/ formattedDefault is \"123,456\" in en_US locale.","\/\/ Other locales may use different separator and grouping behavior."],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"You can specify a format style by providing an argument to the ","type":"text"},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger\/formatted(_:)-73k3e"},{"type":"text","text":" method. The following example shows the number "},{"type":"codeVoice","code":"12345"},{"type":"text","text":" represented in each of the available styles, in the "},{"type":"codeVoice","code":"en_US"},{"type":"text","text":" locale:"}]},{"syntax":"swift","type":"codeListing","code":["let number = 123456","","let formattedNumber = number.formatted(.number)","\/\/ formattedNumber is \"123,456\".","","let formattedPercent = number.formatted(.percent)","\/\/ formattedPercent is \"123,456%\".","","let formattedCurrency = number.formatted(.currency(code: \"USD\"))","\/\/ formattedCurrency is \"$123,456.00\"."]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each style provides methods for updating its numeric configuration, including the number of significant digits, grouping length, and more. You can specify a numeric configuration by calling as many of these methods as you need in any order you choose. The following example shows the same number with default and custom configurations:"}]},{"syntax":"swift","type":"codeListing","code":["let exampleNumber = 123456","","let defaultFormatting = exampleNumber.formatted(.number)","\/\/ defaultFormatting is \"125 000\" for the \"fr_FR\" locale","\/\/ defaultFormatting is \"125000\" for the \"jp_JP\" locale","\/\/ defaultFormatting is \"125,000\" for the \"en_US\" locale","","let customFormatting = exampleNumber.formatted(",".number",".grouping(.never)",".sign(strategy: .always()))","\/\/ customFormatting is \"+123456\""]},{"text":"Creating an integer format style instance","type":"heading","anchor":"Creating-an-integer-format-style-instance","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The previous examples use static factory methods like "},{"type":"codeVoice","code":"FormatStyle\/number-7fxvo"},{"type":"text","text":" to create format styles within the call to the "},{"type":"text","text":"doc:\/\/com.apple.documentation\/documentation\/swift\/binaryinteger\/formatted(_:)-73k3e"},{"type":"text","text":" method. You can also create an "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","isActive":true},{"type":"text","text":" instance and use it to repeatedly format different values with the "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle\/format(_:)","isActive":true},{"type":"text","text":" method:"}]},{"syntax":"swift","type":"codeListing","code":["let percentFormatStyle = IntegerFormatStyle<Int>.Percent()","","percentFormatStyle.format(50) \/\/ \"50%\"","percentFormatStyle.format(85) \/\/ \"85%\"","percentFormatStyle.format(100) \/\/ \"100%\""]},{"text":"Parsing integers","type":"heading","anchor":"Parsing-integers","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/IntegerFormatStyle","isActive":true},{"type":"text","text":" to parse strings into integer values. You can define the format style within the type’s initializer or pass in a format style you create prior to calling the method, as shown here:"}]},{"syntax":"swift","type":"codeListing","code":["let price = try? Int(\"$123,456\",","format: .currency(code: \"USD\")) \/\/ 123456","","let priceFormatStyle = IntegerFormatStyle<Int>.Currency(code: \"USD\")","let salePrice = try? Int(\"$120,000\",","format: priceFormatStyle) \/\/ 120000"]},{"text":"Matching regular expressions","type":"heading","anchor":"Matching-regular-expressions","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Along with parsing numeric values in strings, you can use the Swift regular expression domain-specific language to match and capture numeric substrings. The following example defines a currency format style to match and capture a currency value using US dollars and "},{"type":"codeVoice","code":"en_US"},{"type":"text","text":" numeric conventions. The rest of the regular expression ignores any characters prior to a "},{"type":"codeVoice","code":"\": \""},{"type":"text","text":" sequence that precedes the currency substring."}]},{"syntax":"swift","type":"codeListing","code":["import RegexBuilder","","let source = \"Payment due: $123,456\"","let matcher = Regex {","OneOrMore(.any)","\": \"","Capture {","One(.localizedIntegerCurrency(code: Locale.Currency(\"USD\"),","locale: Locale(identifier: \"en_US\")))","}","}","let match = source.firstMatch(of: matcher)","let localizedInteger = match?.1 \/\/ 123456"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/foundationinternationalization\/integerformatstyle"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[