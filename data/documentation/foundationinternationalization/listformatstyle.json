,"type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/listType-swift.property","type":"reference"},{"type":"text","text":", and "},{"isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/locale","type":"reference"},{"type":"text","text":" properties. The system automatically caches unique"},{"type":"text","text":" "},{"type":"text","text":"configurations of "},{"isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle","type":"reference"},{"type":"text","text":" to enhance performance."}],"type":"paragraph"},{"inlineContent":[{"text":"Use either ","type":"text"},{"type":"codeVoice","code":"formatted()"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"formatted(_:)"},{"type":"text","text":", both instance methods of "},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":", to create a string"},{"type":"text","text":" "},{"type":"text","text":"representation of the items."}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"formatted()","type":"codeVoice"},{"text":" method applies the default list format style to a sequence of strings. For example:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["[\"Kristin\", \"Paul\", \"Ana\", \"Bill\"].formatted()","\/\/ Kristin, Paul, Ana, and Bill"],"type":"codeListing"},{"inlineContent":[{"text":"You can customize a list’s ","type":"text"},{"code":"type","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"width","type":"codeVoice"},{"text":" properties.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\