onalization\/ListFormatStyle\/width-swift.property","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/listType-swift.property","type":"reference"},{"text":", and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/locale","type":"reference"},{"text":" properties. The system automatically caches unique","type":"text"},{"text":" ","type":"text"},{"text":"configurations of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle","type":"reference"},{"text":" to enhance performance.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use either ","type":"text"},{"code":"formatted()","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"formatted(_:)","type":"codeVoice"},{"text":", both instance methods of ","type":"text"},{"code":"Sequence","type":"codeVoice"},{"text":", to create a string","type":"text"},{"text":" ","type":"text"},{"text":"representation of the items.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"formatted()"},{"type":"text","text":" method applies the default list format style to a sequence of strings. For example:"}],"type":"paragraph"},{"type":"codeListing","code":["[\"Kristin\", \"Paul\", \"Ana\", \"Bill\"].formatted()","\/\/ Kristin, Paul, Ana, and Bill"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"You can customize a list’s "},{"code":"type","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"width"},{"text":" properties.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/FoundationInte