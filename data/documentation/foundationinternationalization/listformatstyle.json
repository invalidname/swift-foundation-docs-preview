"text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Style"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP","kind":"typeIdentifier","text":"FormatStyle"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Style"},{"kind":"text","text":"."},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C5InputQa","kind":"typeIdentifier","text":"FormatInput"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":"."},{"preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier","text":"Element"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Style"},{"kind":"text","text":"."},{"preciseIdentifier":"s:20FoundationEssentials11FormatStyleP0C6OutputQa","kind":"typeIdentifier","text":"FormatOutput"},{"kind":"text","text":" == "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}]}]},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A list format style creates human readable text from a "},{"code":"Sequence","type":"codeVoice"},{"type":"text","text":" of values. Customize the formatting behavior"},{"type":"text","text":" "},{"type":"text","text":"of the list using the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/width-swift.property"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/listType-swift.property"},{"type":"text","text":", and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/locale"},{"type":"text","text":" properties. The system automatically caches unique"},{"type":"text","text":" "},{"type":"text","text":"configurations of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle"},{"type":"text","text":" to enhance performance."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use either "},{"type":"codeVoice","code":"formatted()"},{"type":"text","text":" or "},{"type":"codeVoice","code":"formatted(_:)"},{"type":"text","text":", both instance methods of "},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":", to create a string"},{"type":"text","text":" "},{"type":"text","text":"representation of the items."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"formatted()"},{"type":"text","text":" method applies the default list format style to a sequence of strings. For example:"}],"type":"paragraph"},{"code":["[\"Kristin\", \"Paul\", \"Ana\", \"Bill\"].formatted()","\/\/ Kristin, Paul, Ana, and Bill"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"You can customize a list’s "},{"type":"codeVoice","code":"type"},{"type":"text","text":" and "},{"type":"codeVoice","code":"width"},{"type":"text","text":" properties."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/listType-swift.property","type":"reference","isActive":true},{"text":" property specifies the semantics of the list.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/width-swift.property","type":"reference","isActive":true},{"text":" property determines the size of the returned string.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"The "},{"code":"formatted(_:)","type":"codeVoice"},{"type":"text","text":" method applies a custom list format style. You can use the static factory method"},{"type":"text","text":" "},{"type":"codeVoice","code":"list(type:width:)"},{"type":"text","text":" to create a custom list format style as a parameter to the method."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This example formats a sequence with a "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/ListType-swift.enum\/and","isActive":true},{"type":"text","text":" list type and "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/Width-swift.enum\/short","isActive":true},{"type":"text","text":" width:"}],"type":"paragraph"},{"code":["[\"Kristin\", \"Paul\", \"Ana\", \"Bill\"].formatted(.list(type: .and, width: .short))","\/\/ Kristin, Paul, Ana, & Bill"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"You can provide a member format style to transform each list element to a string in applications where the"},{"type":"text","text":" "},{"type":"text","text":"elements aren’t already strings. For example, the following code sample uses an "},{"code":"IntegerFormatStyle","type":"codeVoice"},{"type":"text","text":" to convert"},{"type":"text","text":" "},{"type":"text","text":"a range of integer values into a list:"}],"type":"paragraph"},{"code":["(5201719 ... 5201722).formatted(.list(memberStyle: IntegerFormatStyle(), type: .or, width: .standard))","\/\/ For locale: en_US: 5,201,719, 5,201,720, 5,201,721, or 5,201,722","\/\/ For locale: fr_CA: 5 201 719, 5 201 720, 5 201 721, ou 5 201 722"],"type":"codeListing","syntax":"swift"},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"The generated string is locale-dependent and incorporates linguistic and cultural conventions of the user."}],"type":"paragraph"}],"name":"Note"},{"inlineContent":[{"type":"text","text":"You can create and reuse a list format style instance to format similar sequences. For example:"}],"type":"paragraph"},{"code":["let percentStyle = ListFormatStyle<FloatingPointFormatStyle.Percent, StrideThrough<Double>>(memberStyle: .percent)","stride(from: 7.5, through: 9.0, by: 0.5).formatted(percentStyle)","\/\/ 7.5%, 8%, 8.5%, and 9%","stride(from: 89.0, through: 95.0, by: 2.0).formatted(percentStyle)","\/\/ 89%, 91%, 93%, and 95%"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationinternationalization\/listformatstyle"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle"},"references":{"doc://FoundationInternationalization/documentation/FoundationInternationalization/ListFormatStyle/ListType-swift.enum/and":{"abstract":[{"type":"text","text":"Specifies an "},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"type":"text","text":" list type."}],"title":"ListFormatStyle.ListType.and","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/foundationinternationalization\/listformatstyle\/listtype-swift.enum\/and","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"and","kind":"identifier"}],"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/ListType-swift.enum\/and"},"doc://FoundationInternationalization/documentation/FoundationInternationalization/ListFormatStyle/in