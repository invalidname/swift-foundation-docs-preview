"},{"text":", ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/listType-swift.property"},{"text":", and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/locale"},{"text":" properties. The system automatically caches unique","type":"text"},{"text":" ","type":"text"},{"text":"configurations of ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle","isActive":true},{"type":"text","text":" to enhance performance."}],"type":"paragraph"},{"inlineContent":[{"text":"Use either ","type":"text"},{"type":"codeVoice","code":"formatted()"},{"text":" or ","type":"text"},{"code":"formatted(_:)","type":"codeVoice"},{"type":"text","text":", both instance methods of "},{"code":"Sequence","type":"codeVoice"},{"type":"text","text":", to create a string"},{"type":"text","text":" "},{"type":"text","text":"representation of the items."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"code":"formatted()","type":"codeVoice"},{"text":" method applies the default list format style to a sequence of strings. For example:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["[\"Kristin\", \"Paul\", \"Ana\", \"Bill\"].formatted()","\/\/ Kristin, Paul, Ana, and Bill"]},{"inlineContent":[{"text":"You can customize a list’s ","type":"text"},{"type":"codeVoice","code":"type"},{"text":" and ","type":"text"},{"code":"width","type":"codeVoice"},{"text":" properties.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationIntern