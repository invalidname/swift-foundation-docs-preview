_:)"},{"text":", both instance methods of ","type":"text"},{"type":"codeVoice","code":"Sequence"},{"text":", to create a string","type":"text"},{"text":" ","type":"text"},{"text":"representation of the items.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"formatted()"},{"text":" method applies the default list format style to a sequence of strings. For example:","type":"text"}]},{"type":"codeListing","code":["[\"Kristin\", \"Paul\", \"Ana\", \"Bill\"].formatted()","\/\/ Kristin, Paul, Ana, and Bill"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"You can customize a list’s ","type":"text"},{"type":"codeVoice","code":"type"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"width"},{"text":" properties.","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/listType-swift.property","isActive":true,"type":"reference"},{"text":" property specifies the semantics of the list.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/width-swift.property","isActive":true,"type":"reference"},{"text":" property determines the size of the returned string.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"formatted(_:)"},{"text":" method applies a custom list format style. You can use the static factory method","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"list(type:width:)"},{"text":" to create a custom list format style as a parameter to the method.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This example formats a sequence wit