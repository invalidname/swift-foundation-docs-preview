dth-swift.property"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/listType-swift.property"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/locale"},{"type":"text","text":" properties. The system automatically caches unique"},{"type":"text","text":" "},{"type":"text","text":"configurations of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle"},{"type":"text","text":" to enhance performance."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use either "},{"type":"codeVoice","code":"formatted()"},{"type":"text","text":" or "},{"type":"codeVoice","code":"formatted(_:)"},{"type":"text","text":", both instance methods of "},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":", to create a string"},{"type":"text","text":" "},{"type":"text","text":"representation of the items."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"formatted()"},{"type":"text","text":" method applies the default list format style to a sequence of strings. For example:"}],"type":"paragraph"},{"syntax":"swift","code":["[\"Kristin\", \"Paul\", \"Ana\", \"Bill\"].formatted()","\/\/ Kristin, Paul, Ana, and Bill"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can customize a list’s "},{"type":"codeVoice","code":"type"},{"type":"text","text":" and "},{"type":"codeVoice","code":"width"},{"type":"text","text":" properties."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/listType-swift.property","type":"reference","isActive":true},{"type":"text","text":" property specifies the semantics of the list."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/width-swift.property"},{"type":"text","text":" property determines the size of the returned string."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"formatted(_:)","type":"codeVoice"},{"text":" method applies a custom list format style. You can use the static factory method","type":"text"},{"text":" ","type":"text"},{"code":"list(type:width:)","type":"codeVoice"},{"text":" to create a custom list format style as a parameter to the method.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This example formats a sequence with a ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/ListType-swift.enum\/and","isActive":true,"type":"reference"},{"text":" list type and ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/Width-swift.enum\/short","isActive":true,"type":"reference"},{"text":" width:","type":"text"}],"type":"paragraph"},{"code":["[\"Kristin\", \"Paul\", \"Ana\", \"Bill\"].formatted(.list(type: .and, width: .short))","\/\/ Kristin, Paul, Ana, & Bill"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"You can provide a member format style to transform each list element to a string in applications where the","type":"text"},{"text":" ","type":"text"},{"text":"elements aren’t already strings. For example, the following code sample uses an ","type":"text"},{"code":"IntegerFormatStyle","type":"codeVoice"},{"text":" to convert","type":"text"},{"text":" ","type":"text"},{"text":"a range of integer values into a list:","type":"text"}],"type":"paragraph"},{"code":["(5201719 ... 5201722).formatted(.list(memberStyle: IntegerFormatStyle(), type: .or, width: .standard))","\/\/ For locale: en_US: 5,201,719, 5,201,720, 5,201,721, or 5,201,722","\/\/ For locale: fr_CA: 5 201 719, 5 201 720, 5 201 721, ou 5 201 722"],"syntax":"swift","type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"The generated string is locale-dependent and incorporates linguistic and cultural conventions of the user.","type":"text"}]}],"style":"note","name":"Note","type":"aside"},{"type":"paragraph","inlineContent":[{"text":"You can create and reuse a list format style instance to format similar sequences. For example:","type":"text"}]},{"code":["let percentStyle = ListFormatStyle<FloatingPointFormatStyle.Percent, StrideThrough<Double>>(memberStyle: .percent)","stride(from: 7.5, through: 9.0, by: 0.5).formatted(percentStyle)","\/\/ 7.5%, 8%, 8.5%, and 9%","stride(from: 89.0, through: 95.0, by: 2.0).formatted(percentStyle)","\/\/ 89%, 91%, 93%, and 95%"],"syntax":"swift","type":"codeListing"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationinternationalization\/listformatstyle"]}],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/init(from:)","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/init(memberStyle:)"]},{"identifiers":["doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/listType-swift.property","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/ListFormatStyle\/locale","doc:\/\/FoundationInternationalization\/documentation\/FoundationIn