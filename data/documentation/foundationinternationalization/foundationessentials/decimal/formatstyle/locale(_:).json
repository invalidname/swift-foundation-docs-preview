ormat style uses. To instead"},{"type":"text","text":" "},{"type":"text","text":"determine the locale that this format style uses, use the "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Decimal\/FormatStyle\/locale","isActive":true},{"type":"text","text":" property."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example creates a default "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Decimal\/FormatStyle","isActive":true},{"type":"text","text":" for the "},{"type":"codeVoice","code":"en_US"},{"type":"text","text":" locale,"},{"type":"text","text":" "},{"type":"text","text":"and applies the "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Decimal\/FormatStyle\/notation(_:)","isActive":true},{"type":"text","text":" modifier to use compact name notation. Next, the sample"},{"type":"text","text":" "},{"type":"text","text":"creates a second style based on this, but that uses the German ("},{"type":"codeVoice","code":"DE"},{"type":"text","text":") locale. It then"},{"type":"text","text":" "},{"type":"text","text":"applies each style to an array of decimal values."}]},{"code":["let compactStyle = Decimal.FormatStyle(locale: Locale(identifier: \"en_US\"))","    .notation(.compactName)","let germanStyle = compactStyle.locale(Locale(identifier: \"DE\"))","let nums: [Decimal] = [100, 1000, 10000, 100000, 1000000]","let enUSCompactNums = nums.map { compactStyle.format($0) } \/\/ [\"100\", \"1K\", \"10K\", \"100K\", \"1M\"]","let deCompactNums = nums.map { germanStyle.format($0) } \/\/ [\"100\", \"1000\", \"10.000\", \"100.000\", \"1 Mio.\"]"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"pat