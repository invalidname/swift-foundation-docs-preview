mum of four significant digits. It then applies each","type":"text"},{"text":" ","type":"text"},{"text":"style to an array of decimal values. The formatting applied by the modified style truncates","type":"text"},{"text":" ","type":"text"},{"text":"precision to ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" after the fourth most-significant digit.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let defaultStyle = Decimal.FormatStyle(locale: Locale(identifier: \"en_US\"))","let precisionStyle = defaultStyle.precision(.significantDigits(1...4))","let nums: [Decimal] = [123.1, 1234.1, 12345.1, 123456.1, 1234567.1]","let defaultNums = nums.map { defaultStyle.format($0) } \/\/ [\"123.1\", \"1,234.1\", \"12,345.1\", \"123,456.1\", \"1,234,567.1\"]","let precisionNums = nums.map { precisionStyle.format($0) } \/\/ [\"123.1\", \"1,234\", \"12,350\", \"123,500\", \"1,235,000\"]"],"type":"codeListing"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Decimal\/FormatStyle\/precision(_:)"},"metadata":{"roleHeading":"Instance Method","modules":[{"name":"FoundationInternationalization"}],"platforms":[{"introducedAt":"15.0","name":"iOS","deprecated":false,"beta":false,"unavailable":false},{"introducedAt":"15.0","name":"iPadOS","deprecated":false,"beta":false,"unavailable":false},{"introducedAt":"15.0","name":"Mac Catalyst","deprecated":false,"beta":false,"unavailable":false},{"introducedAt":"12.0","name":"macOS","deprecated":false,"beta":false,"unavailable":false},{"introducedAt":"15.0","name":"tvOS","deprecated":false,"beta":false,"unavailable":false},{"introducedAt":"8.0","name":"watchOS","deprecated":false,"beta":false,"unavailable":false}],"externalID":"s:20FoundationEssentials7DecimalV0A20InternationalizationE11FormatStyleV9precisionyAfD06NumbereF13ConfigurationO9PrecisionVF","title":"precision(_:)","symbolKind":"method","fra