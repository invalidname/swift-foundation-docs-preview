uted string represent different","type":"text"},{"type":"text","text":" "},{"type":"text","text":"parts of the formatted value."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The following example finds runs of the attributed string that represent different parts","type":"text"},{"text":" ","type":"text"},{"text":"of a formatted currency, and adds additional attributes like","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AttributeScopes\/SwiftUIAttributes\/foregroundColor"},{"type":"text","text":" and"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AttributeScopes\/FoundationAttributes\/inlinePresentationIntent"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func attributedPrice(price: Decimal) -> AttributedString {","    var attributedPrice = price.formatted(","        .currency(code: \"USD\")","        .attributed)","","    for run in attributedPrice.runs {","        if run.attributes.numberSymbol == .currency ||","            run.attributes.numberSymbol == .decimalSeparator {","            attributedPrice[run.range].foregroundColor = .red","        }","        if run.attributes.numberPart == .integer ||","            run.attributes.numberPart == .fraction {","            attributedPrice[run.range].inlinePresentationIntent = [.stronglyEmphasized]","        }","    }","    return attributedPrice","}"]},{"inlineContent":[{"text":"User interface frameworks like SwiftUI can use these attributes when presenting the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"attributed string."}],"type":"paragraph"}]}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Decimal