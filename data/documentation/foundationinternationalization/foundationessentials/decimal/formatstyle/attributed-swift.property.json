These attributed strings contain attributes from"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"AttributeScopes\/FoundationAttributes\/NumberFormatAttributes","type":"codeVoice"},{"type":"text","text":" attribute scope. Use"},{"type":"text","text":" "},{"type":"text","text":"these attributes to determine which runs of the attributed string represent different"},{"type":"text","text":" "},{"type":"text","text":"parts of the formatted value."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example finds runs of the attributed string that represent different parts"},{"type":"text","text":" "},{"type":"text","text":"of a formatted currency, and adds additional attributes like"},{"type":"text","text":" "},{"type":"codeVoice","code":"AttributeScopes\/SwiftUIAttributes\/foregroundColor"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"AttributeScopes\/FoundationAttributes\/inlinePresentationIntent"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["func attributedPrice(price: Decimal) -> AttributedString {","    var attributedPrice = price.formatted(","        .currency(code: \"USD\")","        .attributed)","","    for run in attributedPrice.runs {","        if run.attributes.numberSymbol == .currency ||","            run.attributes.numberSymbol == .decimalSeparator {","            attributedPrice[run.range].foregroundColor = .red","        }","        if run.attributes.numberPart == .integer ||","            run.attributes.numberPart == .fraction {","            attributedPrice[run.range].inlinePresentationIntent = [.stronglyEmphasized]","        }","    }","    return attributedPrice","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"User interface frameworks like SwiftUI can use these attributes when presenting the"},{"type":"text","text":" "},{"type":"text","text":"attributed string."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift