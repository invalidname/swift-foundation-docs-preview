":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"AttributeScopes\/FoundationAttributes\/inlinePresentationIntent"},{"type":"text","text":"."}]},{"type":"codeListing","code":["func attributedPrice(price: Decimal) -> AttributedString {","    var attributedPrice = price.formatted(","        .currency(code: \"USD\")","        .attributed)","","    for run in attributedPrice.runs {","        if run.attributes.numberSymbol == .currency ||","            run.attributes.numberSymbol == .decimalSeparator {","            attributedPrice[run.range].foregroundColor = .red","        }","        if run.attributes.numberPart == .integer ||","            run.attributes.numberPart == .fraction {","            attributedPrice[run.range].inlinePresentationIntent = [.stronglyEmphasized]","        }","    }","    return attributedPrice","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"User interface frameworks like SwiftUI can use these attributes when presenting the"},{"type":"text","text":" "},{"type":"text","text":"attributed string."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Decimal\/FormatStyle\/attributed-swift.property"},"variants":[{"paths":["\/documentation\/foundationinternationalization\/foundationessentials\/decimal\/formatstyle\/attributed-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Decimal","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Decimal\/FormatStyle"]]},"schemaVersion":{"minor":