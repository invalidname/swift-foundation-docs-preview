{"kind":"symbol","identifier":{"url":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/formatted(date:time:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationinternationalization\/foundationessentials\/date\/formatted(date:time:)"]}],"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"formatted","kind":"identifier"},{"text":"(","kind":"text"},{"text":"date","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":".","kind":"text"},{"text":"FormatStyle","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle"},{"text":".","kind":"text"},{"text":"DateStyle","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV0cF0V","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle\/DateStyle"},{"text":", ","kind":"text"},{"text":"time","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":".","kind":"text"},{"text":"FormatStyle","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle"},{"text":".","kind":"text"},{"text":"TimeStyle","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV04TimeF0V","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle\/TimeStyle"},{"text":") -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"date","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The style for describing the date part."}]}]},{"name":"time","content":[{"inlineContent":[{"type":"text","text":"The style for describing the time part."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"A string, formatted according to the specified date and time styles.","type":"text"}]}],"kind":"content"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"When displaying a date to a user, use the convenient "},{"type":"codeVoice","code":"formatted(date:time:)"},{"type":"text","text":" instance method to customize the string representation of the date. Set the date and time styles of the date format style separately, according to your particular needs."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, to create a string with a full date and no time representation, set the date style to "},{"type":"codeVoice","code":"complete"},{"type":"text","text":" and the time style to "},{"type":"codeVoice","code":"omitted"},{"type":"text","text":". Conversely, to create a string representing only the time, set the date style to "},{"code":"omitted","type":"codeVoice"},{"text":" and the time style to ","type":"text"},{"code":"complete","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let birthday = Date()","","birthday.formatted(date: .complete, time: .omitted) \/\/ Sunday, January 17, 2021","birthday.formatted(date: .omitted, time: .complete) \/\/ 4:03:12 PM CST"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can create string representations of a "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" instance with several levels of brevity using a variety of preset date and time styles. This example shows date styles of "},{"type":"codeVoice","code":"long"},{"type":"text","text":", "},{"type":"codeVoice","code":"abbreviated"},{"type":"text","text":", and "},{"type":"codeVoice","code":"numeric"},{"type":"text","text":", and time styles of "},{"type":"codeVoice","code":"shortened"},{"type":"text","text":", "},{"type":"codeVoice","code":"standard"},{"type":"text","text":", and "},{"type":"codeVoice","code":"complete"},{"type":"text","text":"."}]},{"code":["let birthday = Date()","","birthday.formatted(date: .long, time: .shortened) \/\/ January 17, 2021, 4:03 PM","birthday.formatted(date: .abbreviated, time: .standard) \/\/ Jan 17, 2021, 4:03:12 PM","birthday.formatted(date: .numeric, time: .complete) \/\/ 1\/17\/2021, 4:03:12 PM CST","","birthday.formatted() \/\/ Jan 17, 2021, 4:03 PM"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default date style is "},{"type":"codeVoice","code":"abbreviated"},{"type":"text","text":" and the default time style is "},{"type":"codeVoice","code":"shortened"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For the default date formatting, use the "},{"type":"codeVoice","code":"formatted()"},{"type":"text","text":" method. To customize the formatted measurement string, use the "},{"type":"codeVoice","code":"formatted(_:)"},{"type":"text","text":" method and include a "},{"type":"codeVoice","code":"Date.FormatStyle"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"For more information about formatting dates, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Generates a locale-aware string representation of a date using specified date and time format styles."}],"metadata":{"externalID":"s:20FoundationEssentials4DateV0A20InternationalizationE9formatted4date4timeSSAcDE11FormatStyleV0cI0V_AI04TimeI0VtF","title":"formatted(date:time:)","roleHeading":"Instance Method","modules":[{"relatedModules":["FoundationEssentials"],"name":"FoundationInternationalization"}],"extendedModule":"FoundationEssentials","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"formatted","kind":"identifier"},{"text":"(","kind":"text"},{"text":"date","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV","text":"FormatStyle","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"DateStyle","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV0cF0V"},{"text":", ","kind":"text"},{"text":"time","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":".","kind":"text"},{"text":"FormatStyle","pr