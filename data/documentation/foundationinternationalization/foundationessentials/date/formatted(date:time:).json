"code":"omitted"},{"type":"text","text":" and the time style to "},{"type":"codeVoice","code":"complete"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["let birthday = Date()","","birthday.formatted(date: .complete, time: .omitted) \/\/ Sunday, January 17, 2021","birthday.formatted(date: .omitted, time: .complete) \/\/ 4:03:12 PM CST"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can create string representations of a "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" instance with several levels of brevity using a variety of preset date and time styles. This example shows date styles of "},{"type":"codeVoice","code":"long"},{"type":"text","text":", "},{"type":"codeVoice","code":"abbreviated"},{"type":"text","text":", and "},{"type":"codeVoice","code":"numeric"},{"type":"text","text":", and time styles of "},{"type":"codeVoice","code":"shortened"},{"type":"text","text":", "},{"type":"codeVoice","code":"standard"},{"type":"text","text":", and "},{"type":"codeVoice","code":"complete"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["let birthday = Date()","","birthday.formatted(date: .long, time: .shortened) \/\/ January 17, 2021, 4:03 PM","birthday.formatted(date: .abbreviated, time: .standard) \/\/ Jan 17, 2021, 4:03:12 PM","birthday.formatted(date: .numeric, time: .complete) \/\/ 1\/17\/2021, 4:03:12 PM CST","","birthday.formatted() \/\/ Jan 17, 2021, 4:03 PM"]},{"type":"paragraph","inlineContent":[{"text":"The default date style is ","type":"text"},{"code":"abbreviated","type":"codeVoice"},{"text":" and the default time style is ","type":"text"},{"code":"shortened","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For the default date formatting, use the ","type":"text"},{"code":"formatted()","type":"codeVoice"},{"text":" method. To customize the formatted measurement string, use the ","type":"text"},{"code":"formatted(_:)","type":"