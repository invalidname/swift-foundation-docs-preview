tials4DateV"},{"text":".","kind":"text"},{"text":"FormatStyle","kind":"typeIdentifier","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle","preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV"},{"text":".","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV04TimeF0V","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle\/TimeStyle","text":"TimeStyle","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}]}]},{"kind":"parameters","parameters":[{"name":"date","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The style for describing the date part."}]}]},{"name":"time","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The style for describing the time part."}]}]}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A string, formatted according to the specified date and time styles."}]}]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"When displaying a date to a user, use the convenient ","type":"text"},{"code":"formatted(date:time:)","type":"codeVoice"},{"text":" instance method to customize the string representation of the date. Set the date and time styles of the date format style separately, according to your particular needs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, to create a string with a full date and no time representation, set the date style to ","type":"text"},{"code":"complete","type":"codeVoice"},{"type":"text","text":" and the time style to "},{"code":"omitted","type":"codeVoice"},{"type":"text","text":". Conversely, to create a string representing only the time, set the date style to "},{"code":"omitted","type":"codeVoice"},{"type":"text","text":" and the time style to "},{"code":"complete","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","code":["let birthday = Date()","","birthday.formatted(date: .complete, time: .omitted) \/\/ Sunday, January 17, 2021","birthday.formatted(date: .omitted, time: .complete) \/\/ 4:03:12 PM CST"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can create string representations of a "},{"code":"Date","type":"codeVoice"},{"type":"text","text":" instance with several levels of brevity using a variety of preset date and time styles. This example shows date styles of "},{"code":"long","type":"codeVoice"},{"type":"text","text":", "},{"code":"abbreviated","type":"codeVoice"},{"type":"text","text":", and "},{"code":"numeric","type":"codeVoice"},{"type":"text","text":", and time styles of "},{"code":"shortened","type":"codeVoice"},{"type":"text","text":", "},{"code":"standard","type":"codeVoice"},{"type":"text","text":", and "},{"code":"complete","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","code":["let birthday = Date()","","birthday.formatted(date: .long, time: .shortened) \/\/ January 17, 2021, 4:03 PM","birthday.formatted(date: .abbreviated, time: .standard) \/\/ Jan 17, 2021, 4:03:12 PM","birthday.formatted(date: .numeric, time: .complete) \/\/ 1\/17\/2021, 4:03:12 PM CST","","birthday.formatted() \/\/ Jan 17, 2021, 4:03 PM"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default date style is "},{"code":"abbreviated","type":"codeVoice"},{"type":"text","text":" and the default time style is "},{"code":"shortened","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For the default date formatting, use the "},{"code":"formatted()","type":"codeVoice"},{"type":"text","text":" method. To customize the formatted measurement string, use the "},{"code":"formatted(_:)","type":"codeVoice"},{"type":"text","text":" method and include a "},{"code":"Date.FormatStyle","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more information about formatting dates, see "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationinternationalization\/foundationessentials\/date\/formatted(date:time:)"]}],"kind":"symbol","sections":[],"abstract":[{"text":"Generates a locale-aware string representation of a date using specified date and time format styles.","type":"text"}],"references":{"doc://FoundationInternationalization/documentation/FoundationInternationalization/FoundationEssentials":{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials","type":"topic","url":"\/documentation\/foundationinternationalization\/foundationessentials","title":"FoundationEssentials","role":"collection","kind":"symbol","abstract":[]},"doc://FoundationInternationalization/documentation/FoundationInternationalization/FoundationEssentials/Date":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"identifier"}],"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date","type":"topic","title":"Date","abstract":[],"kind":"symbol","role":"symbol","url":"\/documentation\/foundationinternationalization\/foundationessentials\/date","navigatorTitle":[{"text":"Date","kind":"id