eciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV0cF0V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"time","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"FormatStyle","preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV","kind":"typeIdentifier","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle"},{"kind":"text","text":"."},{"text":"TimeStyle","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle\/TimeStyle","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV04TimeF0V"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"date","content":[{"inlineContent":[{"text":"The style for describing the date part.","type":"text"}],"type":"paragraph"}]},{"name":"time","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The style for describing the time part."}]}]}]},{"kind":"content","content":[{"anchor":"return-value","text":"Return Value","level":2,"type":"heading"},{"inlineContent":[{"text":"A string, formatted according to the specified date and time styles.","type":"text"}],"type":"paragraph"}]},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"When displaying a date to a user, use the convenient "},{"code":"formatted(date:time:)","type":"codeVoice"},{"type":"text","text":" instance method to customize the string representation of the date. Set the date and time styles of the date format style separately, according to your particular needs."}],"type":"paragraph"},{"inlineContent":[{"text":"For example, to create a string with a full date and no time representation, set the date style to ","type":"text"},{"code":"complete","type":"codeVoice"},{"text":" and the time style to ","type":"text"},{"code":"omitted","type":"codeVoice"},{"text":". Conversely, to create a string representing only the time, set the date style to ","type":"text"},{"type":"codeVoice","code":"omitted"},{"type":"text","text":" and the time style to "},{"type":"codeVoice","code":"complete"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["let birthday = Date()","","birthday.formatted(date: .complete, time: .omitted) \/\/ Sunday, January 17, 2021","birthday.formatted(date: .omitted, time: .complete) \/\/ 4:03:12 PM CST"],"type":"codeListing"},{"inlineContent":[{"text":"You can create string representations of a ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" instance with several levels of brevity using a variety of preset date and time styles. This example shows date styles of ","type":"text"},{"code":"long","type":"codeVoice"},{"text":", ","type":"text"},{"code":"abbreviated","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"numeric","type":"codeVoice"},{"text":", and time styles of ","type":"text"},{"code":"shortened","type":"codeVoice"},{"text":", ","type":"text"},{"code":"standard","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"complete","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["let birthday = Date()","","birthday.formatted(date: .long, time: .shortened) \/\/ January 17, 2021, 4:03 PM","birthday.formatted(date: .abbreviated, time: .standard) \/\/ Jan 17, 2021, 4:03:12 PM","birthday.formatted(date: .numeric, time: .complete) \/\/ 1\/17\/2021, 4:03:12 PM CST","","birthday.formatted() \/\/ Jan 17, 2021, 4:03 PM"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineCon