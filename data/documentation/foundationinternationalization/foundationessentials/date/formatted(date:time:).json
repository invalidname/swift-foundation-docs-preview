"paragraph","inlineContent":[{"text":"The style for describing the date part.","type":"text"}]}],"name":"date"},{"name":"time","content":[{"type":"paragraph","inlineContent":[{"text":"The style for describing the time part.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A string, formatted according to the specified date and time styles."}]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"When displaying a date to a user, use the convenient ","type":"text"},{"type":"codeVoice","code":"formatted(date:time:)"},{"type":"text","text":" instance method to customize the string representation of the date. Set the date and time styles of the date format style separately, according to your particular needs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, to create a string with a full date and no time representation, set the date style to "},{"type":"codeVoice","code":"complete"},{"type":"text","text":" and the time style to "},{"type":"codeVoice","code":"omitted"},{"type":"text","text":". Conversely, to create a string representing only the time, set the date style to "},{"type":"codeVoice","code":"omitted"},{"type":"text","text":" and the time style to "},{"type":"codeVoice","code":"complete"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["let birthday = Date()","","birthday.formatted(date: .complete, time: .omitted) \/\/ Sunday, January 17, 2021","birthday.formatted(date: .omitted, time: .complete) \/\/ 4:03:12 PM CST"]},{"type":"paragraph","inlineContent":[{"text":"You can create string representations of a ","type":"text"},{"type":"codeVoice","code":"Date"},{"type":"text","text":" instance with several levels of brevity using a variety of preset date and time styles. This example shows date styles of "},{"code":"long","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"abbreviated"},{"type":"text","text":", and "},{"type":"codeVoice","code":"numeric"},{"type":"text","text":", and time styles of "},{"type":"codeVoice","code":"shortened"},{"type":"text","text":", "},{"type":"codeVoice","code":"standard"},{"type":"text","text":", and "},{"type":"codeVoice","code":"complete"},{"text":".","type":"text"}]},{"type":"codeListing","code":["let birthday = Date()","","birthday.formatted(date: .long, time: .shortened) \/\/ January 17, 2021, 4:03 PM","birthday.formatted(date: .abbreviated, time: .standard) \/\/ Jan 17, 2021, 4:03:12 PM","birthday.formatted(date: .numeric, time: .complete) \/\/ 1\/17\/2021, 4:03:12 PM CST","","birthday.formatted() \/\/ Jan 17, 2021, 4:03 PM"],"syntax":"swift"},{"inlineContent":[{"text":"The default date style is ","type":"text"},{"type":"codeVoice","code":"abbreviated"},{"text":" and the default time style is ","type":"text"},{"type":"codeVoice","code":"shortened"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"For the default date formatting, use the ","type":"text"},{"code":"formatted()","type":"codeVoice"},{"text":" method. To customize the formatted measurement string, use the ","type":"text"},{"code":"formatted(_:)","type":"codeVoice"},{"text":" method and include a ","type":"text"},{"type":"codeVoice","code":"Date.FormatStyle"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For more information about formatting dates, see ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/foundationinternationalization\/foundationessentials\/date\/formatted(date:time:)"],"traits":[{"interfaceLanguage