ype":"text"},{"code":"complete","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let birthday = Date()","","birthday.formatted(date: .long, time: .shortened) \/\/ January 17, 2021, 4:03 PM","birthday.formatted(date: .abbreviated, time: .standard) \/\/ Jan 17, 2021, 4:03:12 PM","birthday.formatted(date: .numeric, time: .complete) \/\/ 1\/17\/2021, 4:03:12 PM CST","","birthday.formatted() \/\/ Jan 17, 2021, 4:03 PM"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default date style is "},{"type":"codeVoice","code":"abbreviated"},{"type":"text","text":" and the default time style is "},{"type":"codeVoice","code":"shortened"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For the default date formatting, use the "},{"type":"codeVoice","code":"formatted()"},{"type":"text","text":" method. To customize the formatted measurement string, use the "},{"type":"codeVoice","code":"formatted(_:)"},{"type":"text","text":" method and include a "},{"type":"codeVoice","code":"Date.FormatStyle"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more information about formatting dates, see "},{"isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle","type":"reference"},{"type":"text","text":"."}]}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date"]]},"metadata":{"extendedModule":"FoundationEssentials","platforms":[{"unavailable":false,"name":"iOS","introducedAt":"15.0","beta":false,"deprecated":false},{"unavailable":false,