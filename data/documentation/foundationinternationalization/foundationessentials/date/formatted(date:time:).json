"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"TimeStyle","preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV04TimeF0V","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle\/TimeStyle"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"date","content":[{"inlineContent":[{"type":"text","text":"The style for describing the date part."}],"type":"paragraph"}]},{"name":"time","content":[{"inlineContent":[{"type":"text","text":"The style for describing the time part."}],"type":"paragraph"}]}]},{"content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"inlineContent":[{"text":"A string, formatted according to the specified date and time styles.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"When displaying a date to a user, use the convenient ","type":"text"},{"code":"formatted(date:time:)","type":"codeVoice"},{"text":" instance method to customize the string representation of the date. Set the date and time styles of the date format style separately, according to your particular needs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, to create a string with a full date and no time representation, set the date style to ","type":"text"},{"code":"complete","type":"codeVoice"},{"text":" and the time style to ","type":"text"},{"code":"omitted","type":"codeVoice"},{"text":". Conversely, to create a string representing only the time, set the date style to ","type":"text"},{"code":"omitted","type":"codeVoice"},{"text":" and the time style to ","type":"text"},{"code":"complete","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let birthday = Date()","","birthday.formatted(date: .complete, time: .omitted) \/\/ Sunday, January 17, 2021","birthday.formatted(date: .omitted, time: .complete) \/\/ 4:03:12 PM CST"]},{"inlineContent":[{"text":"You can create string representations of a ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" instance with several levels of brevity using a variety of preset date and time styles. This example shows date styles of ","type":"text"},{"code":"long","type":"codeVoice"},{"text":", ","type":"text"},{"code":"abbreviated","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"numeric","type":"codeVoice"},{"text":", and time styles of ","type":"text"},{"code":"shortened","type":"codeVoice"},{"text":", ","type":"text"},{"code":"standard","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"complete","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let birthday = Date()","","birthday.formatted(date: .long, time: .shortened) \/\/ January 17, 2021, 4:03 PM","birthday.formatted(date: .abbreviated, time: .standard) \/\/ Jan 17, 2021, 4:03:12 PM","birthday.formatted(date: .numeric, time: .complete) \/\/ 1\/17\/2021, 4:03:12 PM CST","","birthday.formatted() \/\/ Jan 17, 2021, 4:03 PM"]},{"inlineContent":[{"type":"text","text":"The default date style is "},{"type":"codeVoice","code":"abbreviated"},{"type":"text","text":" and the default time style is "},{"type":"codeVoice","code":"shortened"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For the default date formatting, use the "},{"type":"codeVoice","code":"formatted()"},{"type":"text","text":" method. To customize the formatted measurement string, use the "},{"type":"codeVoice","code":"formatted(_:)"},{"type":"text","text":" method and include a "},{"type":"codeVoice","code":"Date.FormatStyle"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For more information about formatting dates, see "},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/foundationinternationalization\/foundationessentials\/date\/formatted(date:time:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date"]]},"references":{"doc://FoundationInternationalization/documentation/FoundationInternationalization/FoundationEssentials":{"type":"topic","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials","url":"\/documentation\/foundationinternationalization\/foundationessentials","kind":"symbol","title":"FoundationEssentials","role":"collection","abstract":[]},"doc://FoundationInternationalization/documentation/FoundationInternationalization/FoundationEssentials/Date/FormatStyle/DateStyle":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DateStyle","kind":"identifier"}],"navigatorTitle":[{"text":"DateStyle","kind":"identifier"}],"abstract":[{"type":"text","text":"Type that defines date styles varied in length or components included."}],"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle\/DateStyle","kind":"symbol","type":"topic","url":"\