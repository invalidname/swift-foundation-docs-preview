{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/formatted(date:time:)"},"abstract":[{"type":"text","text":"Generates a locale-aware string representation of a date using specified date and time format styles."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"formatted","kind":"identifier"},{"text":"(","kind":"text"},{"text":"date","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV","text":"FormatStyle","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV0cF0V","text":"DateStyle","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle\/DateStyle","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"time","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV","text":"FormatStyle","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV04TimeF0V","text":"TimeStyle","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle\/TimeStyle","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}]}],"kind":"declarations"},{"parameters":[{"name":"date","content":[{"inlineContent":[{"type":"text","text":"The style for describing the date part."}],"type":"paragraph"}]},{"name":"time","content":[{"inlineContent":[{"type":"text","text":"The style for describing the time part."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A string, formatted according to the specified date and time styles."}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When displaying a date to a user, use the convenient "},{"type":"codeVoice","code":"formatted(date:time:)"},{"type":"text","text":" instance method to customize the string representation of the date. Set the date and time styles of the date format style separately, according to your particular needs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, to create a string with a full date and no time representation, set the date style to "},{"type":"codeVoice","code":"complete"},{"type":"text","text":" and the time style to "},{"type":"codeVoice","code":"omitted"},{"type":"text","text":". Conversely, to create a string representing only the time, set the date style to "},{"type":"codeVoice","code":"omitted"},{"type":"text","text":" and the time style to "},{"type":"codeVoice","code":"complete"},{"type":"text","text":"."}]},{"type":"codeListing","code":["let birthday = Date()","","birthday.formatted(date: .complete, time: .omitted) \/\/ Sunday, January 17, 2021","birthday.formatted(date: .omitted, time: .complete) \/\/ 4:03:12 PM CST"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can create string representations of a "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" instance with several levels of brevity using a variety of preset date and time styles. This example shows date styles of "},{"type":"codeVoice","code":"long"},{"type":"text","text":", "},{"type":"codeVoice","code":"abbreviated"},{"type":"text","text":", and "},{"type":"codeVoice","code":"numeric"},{"type":"text","text":", and time styles of "},{"type":"codeVoice","code":"shortened"},{"type":"text","text":", "},{"type":"codeVoice","code":"standard"},{"type":"text","text":", and "},{"type":"codeVoice","code":"complete"},{"type":"text","text":"."}]},{"type":"codeListing","code":["let birthday = Date()","","birthday.formatted(date: .long, time: .shortened) \/\/ January 17, 2021, 4:03 PM","birthday.formatted(date: .abbreviated, time: .standard) \/\/ Jan 17, 2021, 4:03:12 PM","birthday.formatted(date: .numeric, time: .complete) \/\/ 1\/17\/2021, 4:03:12 PM CST","","birthday.formatted() \/\/ Jan 17, 2021, 4:03 PM"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default date style is "},{"code":"abbreviated","type":"codeVoice"},{"type":"text","text":" and the default time style is "},{"code":"shortened","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For the default date formatting, use the "},{"code":"formatted()","type":"codeVoice"},{"type":"text","text":" method. To customize the formatted measurement string, use the "},{"code":"formatted(_:)","type":"codeVoice"},{"type":"text","text":" method and include a "},{"code":"Date.FormatStyle","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more information about formatting da