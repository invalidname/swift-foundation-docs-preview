ation\/FoundationEssentials\/Date\/FormatStyle","type":"reference"},{"text":" instance to customize the lexical","type":"text"},{"text":" ","type":"text"},{"text":"representation of a date as a string. Use the format style’s","type":"text"},{"text":" ","type":"text"},{"code":"attributed","type":"codeVoice"},{"text":" property to customize the visual representation of the","type":"text"},{"text":" ","type":"text"},{"text":"date as a string. Attributed strings can represent the subcomponent","type":"text"},{"text":" ","type":"text"},{"text":"characters, words, and phrases of a string with a custom combination","type":"text"},{"text":" ","type":"text"},{"text":"of font size, weight, and color.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, the function below uses a date format style to create a","type":"text"},{"text":" ","type":"text"},{"text":"custom lexical representation of a date, then retrieves an attributed","type":"text"},{"text":" ","type":"text"},{"text":"string representation of the same date and applies a visual emphasis","type":"text"},{"text":" ","type":"text"},{"text":"to the year component of the date.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["private func makeAttributedString() -> AttributedString {","    let date = Date()","    let formatStyle = Date.FormatStyle(date: .abbreviated, time: .standard)","    var attributedString = formatStyle.attributed.format(date)","    for run in attributedString.runs {","        if let dateFieldAttribute = run.attributes.foundation.dateField,","           dateFieldAttribute == .year {","            attributedString[run.range].inlinePresentationIntent = [.emphasized, .stronglyEmphasized]","        }","    }","    return attributedString","}"],"type":"codeListing"}]}],"sections":[],"references":{"doc://FoundationInternationalization/documentation/FoundationInternationalization/FoundationEssentials/Date/AttributedStyle":{"kind":"symbol","type":"topic","title":"Date.Attr