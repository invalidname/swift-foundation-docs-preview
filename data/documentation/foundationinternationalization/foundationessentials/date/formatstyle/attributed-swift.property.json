d":"typeIdentifier"},{"kind":"text","text":"."},{"text":"AttributedStyle","preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE15AttributedStyleV","kind":"typeIdentifier"}],"externalID":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV10attributedAcDE010AttributedF0Vvp","roleHeading":"Instance Property","modules":[{"name":"FoundationInternationalization"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationinternationalization\/foundationessentials\/date\/formatstyle\/attributed-swift.property"]}],"deprecationSummary":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use attributedStyle instead"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"attributed"},{"kind":"text","text":": "},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/AttributedStyle","text":"AttributedStyle","preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE15AttributedStyleV"},{"text":" { ","kind":"text"},{"kind":"keyword","text":"get"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Use a ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle","isActive":true,"type":"reference"},{"text":" instance to customize the lexical","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"representation of a date as a string. Use the format style’s"},{"type":"text","text":" "},{"code":"attributed","type":"codeVoice"},{"type":"text","text":" property to customize the visual representation of the"},{"type":"text","text":" "},{"type":"text","text":"date as a string. Attributed strings can represent the subcomponent"},{"text":" ","type":"text"},{"type":"text","text":"characters, words, and phrases of a string with a custom combination"},{"text":" ","type":"text"},{"type":"text","text":"of font size, weight, and color."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, the function below uses a date format style to create a"},{"type":"text","text":" "},{"type":"text","text":"custom lexical representation of a date, then retrieves an attributed"},{"type":"text","text":" "},{"text":"string representation of the same date and applies a visual emphasis","type":"text"},{"type":"text","text":" "},{"text":"to the year component of the date.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["private func makeAttributedString() -> AttributedString {","    let date = Date()","    let formatStyle = Date.FormatStyle(date: .abbreviated, time: .standard)","    var attributedString = formatStyle.attributed.format(date)","    for run in attributedString.runs {","        if let dateFieldAttribute = run.attributes.foundation.dateField,","           dateFieldAttribute == .year {","            attributedString[run.range].inlinePresentationIntent = [.emphasized, .stronglyEmphasized]","        }","    }","    return attributedString","}"],"syntax":"swift"}]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://FoundationInternationalization/documentation/FoundationInternationalization/FoundationEssentials/Date/FormatStyle":{"url":"\/documentation\/foundationinternationalization\/foundationessentials\/date\/formatstyle","title":"Date.FormatStyle","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"FormatStyle","kind":"identifier"}],"navigator