{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationinternationalization\/foundationessentials\/date\/formatstyle\/attributed-swift.property"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle"]]},"abstract":[{"type":"text","text":"A type-erased attributed variant of this style."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"attributed"},{"kind":"text","text":": "},{"preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date","kind":"typeIdentifier"},{"kind":"text","text":"."},{"preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE15AttributedStyleV","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/AttributedStyle","text":"AttributedStyle","kind":"typeIdentifier"},{"kind":"text","text":" { "},{"text":"get","kind":"keyword"},{"kind":"text","text":" }"}],"languages":["swift"]}]},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle","isActive":true},{"type":"text","text":" instance to customize the lexical"},{"type":"text","text":" "},{"type":"text","text":"representation of a date as a string. Use the format style’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"attributed"},{"type":"text","text":" property to customize the visual representation of the"},{"type":"text","text":" "},{"type":"text","text":"date as a string. Attributed strings can represent the subcomponent"},{"type":"text","text":" "},{"type":"text","text":"characters, words, and phrases of a string with a custom combination"},{"type":"text","text":" "},{"type":"text","text":"of font size, weight, and color."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, the function below uses a date format style to create a"},{"type":"text","text":" "},{"type":"text","text":"custom lexical representation of a date, then retrieves an attributed"},{"type":"text","text":" "},{"type":"text","text":"string representation of the same date and applies a visual emphasis"},{"type":"text","text":" "},{"type":"text","text":"to the year component of the date."}]},{"type":"codeListing","syntax":"swift","code":["private func makeAttributedString() -> AttributedString {","    let date = Date()","    let formatStyle = Date.FormatStyle(date: .abbreviated, time: .standard)","    var attributedString = formatStyle.attributed.format(date)","    for run in attributedString.runs {","        if let dateFieldAttribute = run.attributes.foundation.dateField,","           dateFieldAttribute == .year {","            attributedString[run.range].inlinePresentationIntent = [.emphasized, .stronglyEmphasized]","        }","    }","    return attributedString","}"]}],"kind":"content"}],"identifier":{"url":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle\/attributed-swift.property","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"attributed","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"ty