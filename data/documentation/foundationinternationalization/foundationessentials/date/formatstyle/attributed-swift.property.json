{"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"attributed","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":"."},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/AttributedStyle","kind":"typeIdentifier","text":"AttributedStyle","preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE15AttributedStyleV"},{"kind":"text","text":" { "},{"text":"get","kind":"keyword"},{"kind":"text","text":" }"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use a ","type":"text"},{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle","isActive":true,"type":"reference"},{"text":" instance to customize the lexical","type":"text"},{"text":" ","type":"text"},{"text":"representation of a date as a string. Use the format style’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"attributed"},{"text":" property to customize the visual representation of the","type":"text"},{"text":" ","type":"text"},{"text":"date as a string. Attributed strings can represent the subcomponent","type":"text"},{"text":" ","type":"text"},{"text":"characters, words, and phrases of a string with a custom combination","type":"text"},{"text":" ","type":"text"},{"text":"of font size, weight, and color.","type":"text"}]},{"inlineContent":[{"text":"For example, the function below uses a date format style to create a","type":"text"},{"text":" ","type":"text"},{"text":"custom lexical representation of a date, then retrieves an attributed","type":"text"},{"text":" ","type":"text"},{"text":"string representation of the same date and applies a visual emphasis","type":"text"},{"text":" ","type":"text"},{"text":"to the year component of the date.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["private func makeAttributedString() -> AttributedString {","    let date = Date()","    let formatStyle = Date.FormatStyle(date: .abbreviated, time: .standard)","    var attributedString = formatStyle.attributed.format(date)","    for run in attributedString.runs {","        if let dateFieldAttribute = run.attributes.foundation.dateField,","           dateFieldAttribute == .year {","            attributedString[run.range].inlinePresentationIntent = [.emphasized, .stronglyEmphasized]","        }","    }","    return attributedString","}"],"type":"codeListing"}],"kind":"content"}],"abstract":[{"text":"A type-erased attributed variant of this style.","type":"text"}],"sections":[],"variants":[{"paths":["\/documentation\/foundationinternationalization\/foundationessentials\/date\/formatstyle\/attributed-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle"]]},"metadata":{"externalID":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV10attributedAcDE010AttributedF0Vvp","symbolKind":"property","title":"attributed","modules":[{"name":"FoundationInternationalization"}],"role":"symbol","platforms":[{"deprecated":false,"introducedAt":"15.0","deprecatedAt":"18.0","name":"iOS","beta":false,"unavailable":false,"message":"Use at