{"text":"Use a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle"},{"text":" instance to customize the lexical","type":"text"},{"text":" ","type":"text"},{"text":"representation of a date as a string. Use the format style’s","type":"text"},{"text":" ","type":"text"},{"code":"attributed","type":"codeVoice"},{"text":" property to customize the visual representation of the","type":"text"},{"text":" ","type":"text"},{"text":"date as a string. Attributed strings can represent the subcomponent","type":"text"},{"text":" ","type":"text"},{"text":"characters, words, and phrases of a string with a custom combination","type":"text"},{"text":" ","type":"text"},{"text":"of font size, weight, and color.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, the function below uses a date format style to create a"},{"type":"text","text":" "},{"type":"text","text":"custom lexical representation of a date, then retrieves an attributed"},{"type":"text","text":" "},{"text":"string representation of the same date and applies a visual emphasis","type":"text"},{"text":" ","type":"text"},{"text":"to the year component of the date.","type":"text"}]},{"code":["private func makeAttributedString() -> AttributedString {","    let date = Date()","    let formatStyle = Date.FormatStyle(date: .abbreviated, time: .standard)","    var attributedString = formatStyle.attributed.format(date)","    for run in attributedString.runs {","        if let dateFieldAttribute = run.attributes.foundation.dateField,","           dateFieldAttribute == .year {","            attributedString[run.range].inlinePresentationIntent = [.emphasized, .stronglyEmphasized]","        }","    }","    return attributedString","}"],"type":"codeListing","syntax":"swift"}]}],"sections":[],"metadata":{"roleHeading":"Instance Property","modules":[{"name":"FoundationInternationalization"}],"externalID":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV10attributedAcDE010AttributedF0Vvp","title":"attributed","platforms":[{"name":"iOS","deprecatedAt":"18.0","message":"Use attributedStyle instead","unavailable":false,"introducedAt":"15.0","deprecated":false,"beta":false},{"name":"iPadOS","deprecatedAt":"18.0","message":"Use attributedStyle instead","unavailable":false,"introducedAt":"15.0","deprecated":false,"beta":false},{"name":"Mac Catalyst","deprecatedAt":"18.0","message":"Use attributedStyle instead","unavailable":false,"introducedAt":"15.0","deprecated":false,"beta":false},{"name":"macOS","deprecatedAt":"15.0","message":"Use attributedStyle instead","unavailable":false,"introducedAt":"12.0","deprecated":false,"beta":false},{"name":"tvOS","deprecatedAt":"18.0","message":"Use attributedStyle instead","unavailable":false,"introducedAt":"15.0","deprecated":false,"beta":false},{"name":"watchOS","deprecatedAt":"11.0","message":"Use attributedStyle instead","unavailable":false,"introducedAt":"8.0","deprecated":false,"beta":false}],"role":"symbol","symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"attributed"},{"text":": ","kind":"text"},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"AttributedStyle","preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE15AttributedStyleV","kind":"typeIdentifier"}]},"kind":"symbol","references":{"doc://FoundationInternationalization/documentation/FoundationInternationalization":{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization","abstract":[{"text":"Manage and present data in forms appropriate for people around the world.","type":"text"}],"type":"topic","title":"FoundationInternationalization","kind":"symbol","url":"\/documentation\/foundationint