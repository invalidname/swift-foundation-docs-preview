{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle\/attributed-swift.property"},"sections":[],"hierarchy":{"paths":[["doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date","doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle"]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationinternationalization\/foundationessentials\/date\/formatstyle\/attributed-swift.property"]}],"deprecationSummary":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use attributedStyle instead"}]}],"metadata":{"role":"symbol","modules":[{"name":"FoundationInternationalization"}],"externalID":"s:20FoundationEssentials4DateV0A20InternationalizationE11FormatStyleV10attributedAcDE010AttributedF0Vvp","roleHeading":"Instance Property","platforms":[{"beta":false,"introducedAt":"15.0","deprecated":false,"deprecatedAt":"18.0","unavailable":false,"name":"iOS","message":"Use attributedStyle instead"},{"beta":false,"introducedAt":"15.0","deprecated":false,"deprecatedAt":"18.0","unavailable":false,"name":"iPadOS","message":"Use attributedStyle instead"},{"beta":false,"introducedAt":"15.0","deprecated":false,"deprecatedAt":"18.0","unavailable":false,"name":"Mac Catalyst","message":"Use attributedStyle instead"},{"beta":false,"introducedAt":"12.0","deprecated":false,"deprecatedAt":"15.0","unavailable":false,"name":"macOS","message":"Use attributedStyle instead"},{"deprecatedAt":"18.0","message":"Use attributedStyle instead","beta":false,"unavailable":false,"name":"tvOS","introducedAt":"15.0","deprecated":false},{"deprecatedAt":"11.0","message":"Use attributedStyle instead","beta":false,"unavailable":false,"name":"watchOS","introducedAt":"8.0","deprecated":false}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"attributed"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"AttributedStyle","preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE15AttributedStyleV"}],"symbolKind":"property","title":"attributed"},"abstract":[{"type":"text","text":"A type-erased attributed variant of this style."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"attributed"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV0A20InternationalizationE15AttributedStyleV","text":"AttributedStyle","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/AttributedStyle"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Use a "},{"isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle","type":"reference"},{"type":"text","text":" instance to customize the lexical"},{"type":"text","text":" "},{"type":"text","text":"representation of a date as a string. Use the format style’s"},{"type":"text","text":" "},{"code":"attributed","type":"codeVoice"},{"type":"text","text":" property to customize the visual representation of the"},{"type":"text","text":" "},{"type":"text","text":"date as a string. Attributed strings can represent the subcomponent"},{"type":"text","text":" "},{"type":"text","text":"characters, words, and phrases of a string with a custom combination"},{"type":"text","text":" "},{"type":"text","text":"of font size, weight, and color."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, the function below uses a date format style to create a"},{"type":"text","text":" "},{"type":"text","text":"custom lexical representation of a date, then retrieves an attributed"},{"type":"text","text":" "},{"type":"text","text":"string representation of the same date and applies a visual emphasis"},{"type":"text","text":" "},{"type":"text","text":"to the year component of the date."}],"type":"paragraph"},{"code":["private func makeAttributedString() -> AttributedString {","    let date = Date()","    let formatStyle = Date.FormatStyle(date: .abbreviated, time: .standard)","    var attributedString = formatStyle.attributed.format(date)","    for run in attributedString.runs {","        if let dateFieldAttribute = run.attributes.foundation.dateField,","           dateFieldAttribute == .year {","            attributedString[run.range].inlinePresentationIntent = [.emphasized, .stronglyEmphasized]","        }","    }","    return attributedString","}"],"type":"codeListing","syntax":"swift"}]}],"references":{"doc://FoundationInternationalization/documentation/FoundationInternationalization/FoundationEssentials/Date/FormatStyle":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FormatStyle","kind":"identifier"}],"navigatorTitle":[{"text":"FormatStyle","kind":"identifier"}],"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternat