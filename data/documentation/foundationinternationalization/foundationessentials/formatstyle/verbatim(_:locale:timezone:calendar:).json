/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/VerbatimFormatStyle","isActive":true},{"type":"text","text":". You typically do this when calling the"},{"type":"text","text":" "},{"code":"Date\/formatted(_:)","type":"codeVoice"},{"type":"text","text":" method of "},{"type":"reference","identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example formats the current date with a verbatim format that uses a"},{"type":"text","text":" "},{"type":"text","text":"two-digit month, two-digit day, and default-digits year, separated by slashes. This"},{"type":"text","text":" "},{"type":"text","text":"style isn’t localized — it uses this format in any locale, ignoring locale-appropriate"},{"type":"text","text":" "},{"type":"text","text":"conventions."}]},{"type":"codeListing","code":["let date = Date()","let formatted = date.formatted(","    .verbatim(\"\\(month: .twoDigits)\/\\(day: .twoDigits)\/\\(year: .defaultDigits)\" as Date.FormatString,","              locale: .autoupdatingCurrent,","              timeZone: .current,","              calendar: .current)) \/\/ 12\/05\/2022"],"syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/foundationinternationalization\/foundationessentials\/formatstyle\/verbatim(_:locale:timezone:calendar:)"]}],"references":{"doc://FoundationInternationalization/documentation/FoundationInternationalization":{"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization","type":"topic","abstract":[{"type":"text","text":"Manage and present data in forms appropriate for people around the world."}],"url":"\/documentation\/foundationinternationalization","kind":"symbol","role":"collection","title":"FoundationInternationalization"},"do