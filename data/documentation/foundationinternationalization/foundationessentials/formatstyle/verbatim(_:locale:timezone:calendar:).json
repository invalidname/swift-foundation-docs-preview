n formatting a date."}]}]},{"name":"locale","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The locale to use when formatting. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}]},{"name":"timeZone","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The time zone to use when formatting."}]}]},{"name":"calendar","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The calendar to use when formatting."}]}]}]},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A date format style that uses the provided format string and timekeeping"},{"type":"text","text":" "},{"type":"text","text":"parameters."}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this format style only when you need to produce or parse an exact format, such as"},{"type":"text","text":" "},{"type":"text","text":"when working with programmatically-produced date strings. For formatting dates that"},{"type":"text","text":" "},{"type":"text","text":"people read, use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/FormatStyle\/dateTime"},{"type":"text","text":" to get a localized "},{"type":"reference","isActive":true,"identifier":"doc:\/\/FoundationInternationalization\/documentation\/FoundationInternationalization\/FoundationEssentials\/Date\/FormatStyle"},{"type":"text","text":" "},{"type":"text","text":"instead. To use the ISO-8601 standard, use "},{"type":"codeVoice","code":"FormatStyle\/iso8601"},{"type":"text","text":" to get a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Date\/ISO8601FormatStyle"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"